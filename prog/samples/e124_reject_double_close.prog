; e124_reject_double_close.chiral — E124 NEGATIVE 2 of 3 (stands alone, no E107).
;
; The adopted Fd cap is consumed by the FIRST fd-close; nothing threads it back,
; so closing it a second time uses a spent binder. The checker REJECTS the
; double-close (quantity-1 exceeded) — a CHECKER rejection, not a lowering error.
(import "prelude/prelude")

(porttype Fd)
(extern open-rw  (=> Bytes I64))
(extern adopt-fd (=> I64 Fd))   ; E159: a linear result must be minted by a crossing
(extern fd-close (=> (1 f Fd) Unit))

(def devnull Bytes (bcat (str->bytes "/dev/null") (bslice (pack-u32 0) 0 1)))

; f closed once, then closed AGAIN in the continuation -> used twice -> REJECTED.
(def bad (=> (1 f Fd) I64)
  (lam (f)
    (case (fd-close f)
      (unit (case (fd-close f)
              (unit 42))))))

(def compile-main (=> I64 I64)
  (lam (n)
    (let (raw (open-rw devnull))
      (bad (adopt-fd raw)))))
