; manas-flow-branch-live.chiral -- MANAS-L0 slice 3 gate (b): LIVE flow-branch + backtrack.
;
; Actuates the flow-branch arm of run-flow against the mesh (100.64.0.5:11434), and
; proves the fractal heart: a branch runs its perspectivist, then runs a sub-flow ONCE
; PER emitted perspective (recursion via run-flow), then runs its backtrack (consolidate
; + audit). Two live cases:
;
;   BRANCH  -- perspectivist (>=2 angles) -> per-perspective = ONE flow-step (coverage-
;              vs-spec) -> backtrack = flow-chain([curate-merge consolidate, auditor]).
;              Proof from the FLAT manifest: N = perspectives parsed from the
;              perspectivist's raw output; the manifest has exactly 1 (perspectivist)
;              + N (per-perspective, once EACH) + 2 (backtrack consolidate+audit) calls.
;              So per-perspective-calls = N (>=2) and backtrack-calls = 2, checked.
;
;   NESTED  -- THE composability proof: a flow-branch whose per-perspective is ITSELF a
;              flow-chain (coverage-vs-spec -> cross-doc-drift). Recursion nests a chain
;              inside a branch. Expected calls = 1 + 2N + 2 (each perspective runs a
;              2-step chain). Runs end-to-end; exit 0 iff the count matches.
;
; Backend is a q1 linear handle: opened once per case, threaded through the whole run,
; discharged with backend-close (moved exactly once -- B1 enforces it).
;
; Exit 0 iff BOTH cases pass their expected call counts (and N>=2). Non-zero otherwise.
;
; Build (closure = flow + doc-refine experts + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" prapanca/core/flow prapanca/profile/doc-refine ports > blob
;   cat scaffold/samples/manas-flow-branch-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                  ; str-cat, str-len, i64->str, +, =i, <=i, and, case, do, let
(import "prapanca/backend")                  ; backend-open / backend-close (E137 linear porttype)
(import "prapanca/core/flow")          ; run-flow, flow-branch, flow-chain, flow-step, Ty ctors,
                                    ; Perspective, parse-perspectives, manifest-calls
(import "prapanca/core/types")         ; Expert, Config, Binding (+ ctors), RunManifest, RawCall, ExpertCall
(import "prapanca/profile/doc-refine") ; expert-pool, coverage-vs-spec/cross-doc-drift/curate-merge (by id)
(import "ports/ports")                    ; put

; ---------------------------------------------------------- the run input (small -- tiny-model friendly)
(def the-doc Str
  "# widget config\n\nThe loader reads `/etc/widget/config.toml` at boot.\n\n```\nwidget --start\n```\n\nExample: `widget --start` brings the service up.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "spec" "docs/widget-SPEC.md")
  (cons (pair "sibling_docs" "docs/widget-overview.md")
        nil)))

; ---------------------------------------------------------- the two NEW slot experts (LOCAL to this sample)
; Defined HERE, not in the shared profile pool -- the ⊕ perspectivist / auditor slots
; live in the sample so doc-refine's pool/config stay pristine (CONFORM holds).
(def branch-perspectivist Expert
  (expert "branch-perspectivist"
    "list 3 DISTINCT review angles for this document, each a short review question"
    "{ doc }"
    "3 objects, each {kind:\"angle\", body:\"<the review question>\"}"
    "perspectivist"
    (cons "read" nil)))

(def branch-auditor Expert
  (expert "branch-auditor"
    "does this consolidated result hold, or is there a contradiction/gap? one short verdict"
    "{ consolidated_result }"
    "verdict: holds|gap + one reason"
    "auditor"
    (cons "read" nil)))

; the pool = the two new experts + the existing doc-refine pool (find-expert scans it).
(def test-pool (List Expert)
  (cons branch-perspectivist (cons branch-auditor expert-pool)))

; a config binding EVERY slot the two branches touch to the tiny resident model.
(def test-config Config
  (config "branch-smoke"
    (cons (binding "perspectivist" "qwen2.5:0.5b" 16384)
    (cons (binding "reasoner"      "qwen2.5:0.5b" 16384)
    (cons (binding "combiner"      "qwen2.5:0.5b" 16384)
    (cons (binding "auditor"       "qwen2.5:0.5b" 16384) nil))))))

; ---------------------------------------------------------- the Flows
; backtrack = consolidate (combiner slot) -> audit (auditor slot): a 2-step chain.
(def the-backtrack Flow
  (flow-chain (cons (flow-step "curate-merge"   ty-text ty-text)
              (cons (flow-step "branch-auditor" ty-text ty-verdict) nil))))

; BRANCH: perspectivist -> per-perspective = ONE step -> backtrack.
(def the-branch Flow
  (flow-branch "branch-perspectivist" ty-doc
    (flow-step "coverage-vs-spec" ty-doc ty-text)
    the-backtrack))

; NESTED: per-perspective is ITSELF a flow-chain (recursion depth 2). THE proof that a
; Flow nests in any composite at any level.
(def nested-branch Flow
  (flow-branch "branch-perspectivist" ty-doc
    (flow-chain (cons (flow-step "coverage-vs-spec" ty-doc  ty-text)
                (cons (flow-step "cross-doc-drift"  ty-text ty-text) nil)))
    the-backtrack))

; ---------------------------------------------------------- evidence accessors
(def raw-response (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) rp))))
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare rawlen (-> (List RawCall) I64))
(def rawlen (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (rawlen t))))))
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))
(declare persp-count (-> (List Perspective) I64))
(def persp-count (lam (ps) (case ps (nil 0) ((cons h t) (+ 1 (persp-count t))))))

; N = the number of perspectives the branch actually ran (re-parse the perspectivist's
; raw output = raws[0], which is the SAME text the branch parsed). 0 if no raws.
(def n-perspectives (-> (List RawCall) I64)
  (lam (raws)
    (case raws
      (nil 0)
      ((cons r0 rest) (persp-count (parse-perspectives (raw-response r0)))))))

; ---------------------------------------------------------- report BRANCH (=>)
; expected total calls = 1 (perspectivist) + N (per-perspective, once each) + 2 (backtrack).
(def report-branch (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((n (n-perspectives raws)))
      (let ((calls (ecall-len (manifest-calls m))))
        (let ((expected (+ 1 (+ n 2))))
          (do (put (str-cat "BRANCH perspectives (N): " (str-cat (i64->str n) "\n")))
          (do (put (str-cat "BRANCH per-perspective calls (once per perspective): " (str-cat (i64->str n) "\n")))
          (do (put "BRANCH backtrack calls (consolidate + audit): 2\n")
          (do (put (str-cat "BRANCH total manifest calls: " (str-cat (i64->str calls)
                     (str-cat " (expected " (str-cat (i64->str expected) ")\n")))))
              (case (and (<=i 2 n) (=i calls expected)) (true 0) (false 1)))))))))))

; ---------------------------------------------------------- report NESTED (=>)
; per-perspective is a 2-step chain, so expected = 1 + 2N + 2.
(def report-nested (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((n (n-perspectives raws)))
      (let ((calls (ecall-len (manifest-calls m))))
        (let ((expected (+ 1 (+ (+ n n) 2))))
          (do (put (str-cat "NESTED perspectives (N): " (str-cat (i64->str n) "\n")))
          (do (put (str-cat "NESTED total manifest calls: " (str-cat (i64->str calls)
                     (str-cat " (expected 1+2N+2 = " (str-cat (i64->str expected) ")\n")))))
              (case (and (<=i 2 n) (=i calls expected)) (true 0) (false 1)))))))))

; ---------------------------------------------------------- the two live runs (=>)
(def run-branch-demo (=> I64 I64)
  (lam (_)
    (case (run-flow (backend-open "http://100.64.0.5:11434")
             the-branch "branch demo: perspectives then consolidate+audit"
             nil test-pool test-config the-doc the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-branch m raws))))))

(def run-nested-demo (=> I64 I64)
  (lam (_)
    (case (run-flow (backend-open "http://100.64.0.5:11434")
             nested-branch "nested demo: a chain inside each perspective"
             nil test-pool test-config the-doc the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-nested m raws))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((a (run-branch-demo 0)))
      (let ((b (run-nested-demo 0)))
        (case (=i (+ a b) 0) (true 0) (false 1))))))
