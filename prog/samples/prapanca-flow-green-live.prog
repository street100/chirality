; manas-flow-green-live.chiral -- MANAS-L0 slice 5 gate (b): LIVE TINY-MODEL-GREEN acceptance gate.
;
; Actuates manifest-all-green? -- the runtime acceptance gate (MANAS-L0-SPEC §0/§4) --
; against the mesh (100.64.0.5:11434) on the 0.5b `smoke-local` model. The principle:
; a composition PASSES iff EVERY leaf ran GREEN on the tiny model. Two live cases:
;
;   GREEN   -- a WELL-DECOMPOSED Flow (a 2-step chain of tiny ty-doc->ty-doc steps:
;              coverage-vs-spec -> cross-doc-drift) run via run-flow-stop under
;              smoke-local-config (every slot on qwen2.5:0.5b). Both leaves complete on
;              the 0.5b, so every ExpertCall is parsed-ok and no seam refine-fails ->
;              manifest-all-green? = TRUE. The gate ACCEPTS the composition.
;
;   NOT-GREEN -- a flow-step assigned (via config) a model the local/tiny tier CANNOT
;              serve ("no-such-model:0.5b" -- absent from the mesh). The leaf cannot run
;              green on its bound model: be-chat returns a non-2xx -> chat-bad ->
;              expert-bad -> the ExpertCall's parsed-ok is FALSE. So manifest-all-green?
;              = FALSE. The gate REJECTS -- catching a leaf that did not run green (an
;              under-provisioned / under-decomposed step needing a bigger tier).
;
; NOTE on the signal: parsed-ok means "the leaf's be-chat call succeeded on its bound
; model" (runner.chiral) -- so on a healthy mesh a well-formed tiny step is always green,
; and the gate goes FALSE exactly when a leaf cannot complete on its assigned tier. The
; typed-seam refine-fail is the SECOND non-green signal manifest-all-green? honours (it
; routes "flow-refine-fail:<ty>"); that path is exercised deterministically in the PURE
; test (flow-test.chiral), since a live tiny model rarely emits output that fails the
; lenient refine-ok validators.
;
; Backend is a q1 linear handle: opened once per case, threaded through the whole run,
; discharged with backend-close (moved exactly once -- B1 enforces it).
;
; Exit 0 iff GREEN => true AND NOT-GREEN => false. Non-zero otherwise.
;
; Build (closure = flow + doc-refine experts + profiles + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" prapanca/core/flow prapanca/profile/doc-refine prapanca/profile/profiles ports > blob
;   cat scaffold/samples/manas-flow-green-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                  ; str-cat, +, =i, and, case, do, let
(import "prapanca/backend")                  ; backend-open / backend-close (E137 linear porttype)
(import "prapanca/core/flow")          ; run-flow-stop, flow-chain, flow-step, Ty ctors, manifest-all-green?, manifest-calls
(import "prapanca/core/types")         ; Config, Binding (+ ctors), StopPolicy (stop-single), RunManifest, ExpertCall
(import "prapanca/profile/doc-refine") ; expert-pool, coverage-vs-spec / cross-doc-drift (by id, slot reasoner)
(import "prapanca/profile/profiles")   ; smoke-local-config (every slot -> qwen2.5:0.5b)
(import "ports/ports")                    ; put

; ---------------------------------------------------------- the run input (small -- tiny-model friendly)
(def the-doc Str
  "# widget config\n\nThe loader reads `/etc/widget/config.toml` at boot.\n\n```\nwidget --start\n```\n\nExample: `widget --start` brings the service up.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "spec_or_requirements" "docs/widget-SPEC.md")
  (cons (pair "sibling_docs" "docs/widget-overview.md")
        nil)))

; ---------------------------------------------------------- GREEN: a well-decomposed 2-step chain
; two tiny ty-doc->ty-doc leaves; each completes on the 0.5b, so every call is parsed-ok.
(def green-flow Flow
  (flow-chain (cons (flow-step "coverage-vs-spec" ty-doc ty-doc)
              (cons (flow-step "cross-doc-drift"  ty-doc ty-doc) nil))))

; ---------------------------------------------------------- NOT-GREEN: a leaf on an unservable model
; ONE flow-step, but its slot (reasoner) is bound to a model the mesh does NOT have, so
; the leaf's be-chat fails -> parsed-ok=false -> the composition is not green.
(def ungreen-flow Flow
  (flow-step "coverage-vs-spec" ty-doc ty-doc))
(def unservable-config Config
  (config "unservable"
    (cons (binding "reasoner" "no-such-model:0.5b" 16384) nil)))

; ---------------------------------------------------------- helpers
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))

; run a Flow via run-flow-stop (stop-single = one pass), close the backend, and return
; whether the gate ACCEPTS it (manifest-all-green?). Prints the verdict + call count.
(def gate-run (=> Flow Config Str Bool)
  (lam (flow config tag)
    (case (run-flow-stop (backend-open "http://100.64.0.5:11434")
             flow (stop-single) tag nil expert-pool config the-doc the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2)
          (let ((green (manifest-all-green? m)))
            (let ((ncalls (ecall-len (manifest-calls m))))
              (do (put (str-cat tag (str-cat " manifest-all-green?: " (str-cat (bool->str green)
                         (str-cat "   (leaf calls: " (str-cat (i64->str ncalls) ")\n"))))))
                  green))))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((green   (gate-run green-flow   smoke-local-config "GREEN     (well-decomposed, tiny model)")))
      (let ((ungreen (gate-run ungreen-flow unservable-config "NOT-GREEN (leaf on unservable model)  ")))
        (do (put (str-cat "\nACCEPT green composition:  " (str-cat (bool->str green) "\n")))
        (do (put (str-cat "REJECT non-green composition: " (str-cat (bool->str (not ungreen)) "\n")))
            (case (and green (not ungreen)) (true 0) (false 1))))))))
