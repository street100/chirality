; manas-run-log.chiral -- E139 be-log LIVE persistence proof.
; MANAS-STATE-VS-GOAL §8.E -- the be-log crossing is now LIVE (no longer deferred).
; Drives the same doc-refine run as manas-run.chiral (smoke-local profile, E140, every
; slot on qwen2.5:0.5b) against the model endpoint (100.64.0.5:11434), then persists
; the completed RunManifest to the manas WORKER (a SEPARATE service: :8080) via be-log
; (E139): one LOG-01 /internal/log interactions row + one LEARN-01 /internal/log/expert
; row per fired expert. Fire-and-forget -- the run already succeeded before be-log runs,
; and a failed log POST returns Unit without aborting.
;
; Two endpoints, two seams: the MODEL Backend (linear porttype, :11434) is opened,
; used by guarded-run, and backend-closed; the WORKER (plain worker-base Str, :8080) is
; a log sink be-log POSTs to directly. run-key "chirality-be-log-live" keys both the
; interactions session_id and the expert_calls run_id, so both rows are queryable back.
;
; Build (mirrors manas-run.chiral; add prapanca/pipeline/log to the chirality_blob roots):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" prapanca/pipeline/guarded prapanca/profile/profiles \
;     prapanca/profile/doc-refine prapanca/contract/manifest prapanca/pipeline/log json > blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   cat scaffold/samples/manas-run-log.chiral >> blob; echo >> blob
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > manas-run-log.elf; chmod +x ...
(import "prelude/prelude")                  ; str-cat, List, Pair, pair, cons, nil
(import "prapanca/backend")                  ; backend-open / backend-close (E137 linear porttype)
(import "prapanca/pipeline/guarded")   ; guarded-run
(import "prapanca/profile/profiles")   ; smoke-local-config
(import "prapanca/profile/doc-refine") ; doc-refine-pipeline, expert-pool
(import "prapanca/pipeline/log")       ; be-log (E139 worker persistence)

; same real doc + extra as manas-run.chiral (fires all four doc-refine GATE rules).
(def the-doc Str
  "# widget config\n\nThe loader reads `/etc/widget/config.toml` at boot.\n\n```\nwidget --start\n```\n\nExample: `widget --start` brings the service up.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "spec" "docs/widget-SPEC.md")
  (cons (pair "sibling_docs" "docs/widget-overview.md")
        nil)))

; the WORKER base (fire-and-forget log sink) -- SEPARATE from the model endpoint.
; Overridable at build time by editing this literal; default = the mesh worker :8080.
(def worker-base Str "http://100.64.0.5:8080")

; the entry: open the MODEL backend, run the pipeline under the breaker, close the
; model handle, then be-log the completed manifest to the WORKER. Print the yield.
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((1 b (backend-open "http://100.64.0.5:11434"))   ; E159: a linear handle binds at q1
          (req "refine this doc: check it against reality, sharpen anchors, complete its examples"))
      (case (guarded-run b 0 req
              (cons doc-refine-pipeline nil) expert-pool smoke-local-config
              the-doc the-extra)
        ((grun-r fails yield m raws b2)
          (do (backend-close b2)                       ; discharge the linear model handle
              (do (be-log worker-base "chirality-be-log-live" m raws)   ; LIVE worker persistence (real corpus text via raws)
                  (do (put "=== LOGGED TO WORKER (be-log, E139) ===\n")
                      (put "=== FINAL YIELD ===\n")
                      (put yield)
                      (put "\n")
                      0))))))))
