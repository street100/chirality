; manas-research-live.chiral -- T2 LIVE gate: the research FRACTAL runs tiny-model-green,
; and a SPECIALIZATION of it (a feasibility research type) runs green with its context reaching
; the model.
;
; Actuates the whole research fractal (research.chiral) against the mesh
; (100.64.0.5:11434) under research-config (every slot on the 0.5b `qwen2.5:0.5b`). The
; input is a small real research QUESTION with a few lines of surrounding context -- the exact
; shape a research skill fans over its angles (definitions / prior-art / counter-evidence /
; open-questions). Two live cases:
;
;   FRACTAL -- run-flow-stop research-flow (stop-single) on the question. Proof:
;     (a) manifest-all-green? = true (every tiny step ran GREEN on the 0.5b -- no typed-seam
;         refine-fail, every call parsed-ok), AND
;     (b) the manifest shows the fractal executed: 1 (perspectivist) + 2N (per-angle chain,
;         investigate+assess once EACH of N angles) + 2 (backtrack synthesize+audit). N is
;         re-parsed from the perspectivist's raw output (raws[0]). Prints N + the call count.
;     With the branch-drop fix (139ded7) live, a silently-swallowed angle can no longer hide a
;     green -- so this green is HONEST (a dropped angle turns the composite routing non-green).
;
;   SPECIALIZE -- library [skill-base "research" research-flow (stop-single)] +
;     specialize-skill "research" "research-feasibility"
;       "research type: FEASIBILITY - focus on whether it can be built with available resources".
;     run-skill "research-feasibility" resolves the base flow, injects the context as
;     context-0 into `extra`, runs the fractal on the 0.5b. Proof: green AND the FEASIBILITY
;     research-type context appears in a SENT PROMPT (grep the raws' prompts) -- the
;     specialization reached the model, so the SAME fractal now researches for feasibility.
;
; Backend is a q1 linear handle: opened once per case, threaded through, discharged with
; backend-close (moved exactly once -- B1 enforces it).
;
; Exit 0 iff BOTH cases pass. If the mesh is DOWN, be-chat returns chat-bad => parsed_ok=false
; => manifest-all-green? = false => this reports NON-green honestly (a real signal, not a fake).
;
; Build (closure = research + skill + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" prapanca/profile/research prapanca/core/skill ports > blob
;   cat scaffold/samples/manas-research-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                    ; str-cat, str-len, i64->str, +, =i, <=i, and, case, do, let
(import "prapanca/backend")                    ; backend-open / backend-close (E137 linear porttype)
(import "prapanca/core/flow")            ; run-flow-stop, manifest-all-green?, manifest-calls,
                                      ; parse-perspectives, Perspective, str-has
(import "prapanca/core/types")           ; StopPolicy (stop-single), RawCall, RunManifest, ExpertCall
(import "prapanca/core/skill")           ; Skill (skill-base), specialize-skill, run-skill
(import "prapanca/profile/research")     ; research-flow, research-pool, research-config
(import "ports/ports")                      ; put

; ---------------------------------------------------------- the run inputs (small, real question -- tiny-model friendly)
; A concrete research question with a little surrounding context, suited to all four angles.
(def the-text Str
  "Research question: are persistent (immutable) data structures a good fit for an undo system?\nNotes:\n- An undo system must restore any earlier state on demand.\n- The current editor mutates its buffer in place.\n- We can afford some extra memory but latency must stay low.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "scope" "answer for a single-user text editor; ignore distributed or multi-user cases")
  (cons (pair "prior_notes" "persistent structures share unchanged subtrees, so each edit keeps old versions cheaply")
        nil)))

; ---------------------------------------------------------- evidence accessors
(def raw-prompt   (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) p))))
(def raw-response (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) rp))))
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare rawlen (-> (List RawCall) I64))
(def rawlen (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (rawlen t))))))
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))
(declare persp-count (-> (List Perspective) I64))
(def persp-count (lam (ps) (case ps (nil 0) ((cons h t) (+ 1 (persp-count t))))))

; N = the angles the branch actually ran (re-parse raws[0] = the perspectivist output).
(def n-perspectives (-> (List RawCall) I64)
  (lam (raws)
    (case raws
      (nil 0)
      ; R3: a MODEL perspectivist's fan is CAPPED, so the expected call count is over the
      ; perspectives actually RUN, not over every line the model emitted.
      ((cons r0 rest)
        (let ((emitted (persp-count (parse-perspectives (raw-response r0)))))
          (case (<i max-model-perspectives emitted) (true max-model-perspectives) (false emitted)))))))

; does ANY sent prompt contain the marker? (the specialization-reached-the-model probe)
(declare any-prompt-has (-> (List RawCall) Str Bool))
(def any-prompt-has
  (lam (raws marker)
    (case raws
      (nil false)
      ((cons r rest)
        (case (str-has (raw-prompt r) marker)
          (true true)
          (false (any-prompt-has rest marker)))))))

; ---------------------------------------------------------- FRACTAL case (=>)
; expected total calls = 1 (perspectivist) + 2N (per-angle chain: investigate+assess) + 2 (backtrack).
(def report-fractal (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((n (n-perspectives raws)))
      (let ((calls (ecall-len (manifest-calls m))))
        (let ((expected (+ 1 (+ (+ n n) 2))))
          (let ((green (manifest-all-green? m)))
            (do (put (str-cat "FRACTAL research angles (N): " (str-cat (i64->str n) "\n")))
            (do (put (str-cat "FRACTAL per-angle calls (investigate+assess, once each): " (str-cat (i64->str (+ n n)) "\n")))
            (do (put "FRACTAL backtrack calls (collect-angles [code] + audit): 2\n")
            (do (put (str-cat "FRACTAL total manifest calls: " (str-cat (i64->str calls)
                       (str-cat " (expected 1+2N+2 = " (str-cat (i64->str expected) ")\n")))))
            (do (put (str-cat "FRACTAL manifest-all-green? (tiny-model-green on 0.5b): " (str-cat (bool->str green) "\n")))
                (case (and green (and (<=i 1 n) (=i calls expected))) (true 0) (false 1)))))))))))))

(def run-fractal-demo (=> I64 I64)
  (lam (_)
    (case (run-flow-stop (backend-open "http://100.64.0.5:11434")
             research-flow (stop-single)
             "research fractal: question -> per-angle investigate+assess -> synthesize+audit"
             nil research-pool research-config the-text the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-fractal m raws))))))

; ---------------------------------------------------------- SPECIALIZE case (=>)
(def the-marker Str "FEASIBILITY")
(def research-lib (List Skill)
  (cons (skill-base "research" research-flow (stop-single))
  (cons (specialize-skill "research" "research-feasibility" "research type: FEASIBILITY - focus on whether it can be built with available resources")
        nil)))

(def report-specialize (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((green (manifest-all-green? m)))
      (let ((found (any-prompt-has raws the-marker)))
        (do (put (str-cat "SPECIALIZE prompts sent: " (str-cat (i64->str (rawlen raws)) "\n")))
        (do (put (str-cat "SPECIALIZE manifest-all-green? (0.5b): " (str-cat (bool->str green) "\n")))
        (do (put (str-cat "SPECIALIZE feasibility research-type present in a sent prompt: " (str-cat (bool->str found) "\n")))
            (case (and green found) (true 0) (false 1)))))))))

(def run-specialize-demo (=> I64 I64)
  (lam (_)
    (case (run-skill (backend-open "http://100.64.0.5:11434")
             "research-feasibility" research-lib
             "research fractal specialized to a FEASIBILITY research type"
             nil research-pool research-config the-text the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-specialize m raws))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((a (run-fractal-demo 0)))
      (let ((b (run-specialize-demo 0)))
        (case (=i (+ a b) 0) (true 0) (false 1))))))
