; manas-evidence-sift-live.chiral -- T3 LIVE gate: the evidence-sift FRACTAL runs tiny-model-green,
; and a SPECIALIZATION of it (a stricter reference level) runs green with its context reaching
; the model.
;
; Actuates the whole evidence-sift fractal (evidence-sift.chiral) against the mesh
; (100.64.0.5:11434) under evidence-sift-config (every slot on the 0.5b `qwen2.5:0.5b`). The
; input is a small text of MIXED flagged items from a prior cheap pass -- some real EVIDENCE
; (a cited measurement, a CVE + changelog record) and some SPECULATION ("probably inspired
; by", "users likely prefer") -- the exact noisy shape a 0.5b throws off. Two live cases:
;
;   FRACTAL -- run-flow-stop evidence-sift-flow (stop-single) on the mixed text. Proof:
;     (a) manifest-all-green? = true (every tiny step ran GREEN on the 0.5b -- no typed-seam
;         refine-fail, every call parsed-ok), AND
;     (b) the manifest shows the fractal executed: 1 (perspectivist) + 2N (per-item chain,
;         reasoner+classify once EACH of N items) + 2 (backtrack consolidate+audit). N is
;         re-parsed from the perspectivist's raw output (raws[0]). Prints N + the call count.
;     With the branch-drop fix (139ded7) live, a silently-swallowed item can no longer hide a
;     green -- so this green is HONEST (a dropped angle turns the composite routing non-green).
;
;   SPECIALIZE -- library [skill-base "evidence-sift" evidence-sift-flow (stop-single)] +
;     specialize-skill "evidence-sift" "evidence-sift-rigorous"
;       "reference level: RIGOROUS - evidence must cite a source".
;     run-skill "evidence-sift-rigorous" resolves the base flow, injects the context as
;     context-0 into `extra`, runs the fractal on the 0.5b. Proof: green AND the RIGOROUS
;     reference-level context appears in a SENT PROMPT (grep the raws' prompts) -- the
;     specialization reached the model, so the SAME fractal now sifts at a stricter level.
;
; Backend is a q1 linear handle: opened once per case, threaded through, discharged with
; backend-close (moved exactly once -- B1 enforces it).
;
; Exit 0 iff BOTH cases pass. If the mesh is DOWN, be-chat returns chat-bad => parsed_ok=false
; => manifest-all-green? = false => this reports NON-green honestly (a real signal, not a fake).
;
; Build (closure = evidence-sift + skill + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" manas/profile/evidence-sift manas/core/skill ports > blob
;   cat scaffold/samples/manas-evidence-sift-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                    ; str-cat, str-len, i64->str, +, =i, <=i, and, case, do, let
(import "manas/backend")                    ; backend-open / backend-close (E137 linear porttype)
(import "manas/core/flow")            ; run-flow-stop, manifest-all-green?, manifest-calls,
                                      ; parse-perspectives, Perspective, str-has
(import "manas/core/types")           ; StopPolicy (stop-single), RawCall, RunManifest, ExpertCall
(import "manas/core/skill")           ; Skill (skill-base), specialize-skill, run-skill
(import "manas/profile/evidence-sift"); evidence-sift-flow, evidence-sift-pool, evidence-sift-config
(import "ports/ports")                      ; put

; ---------------------------------------------------------- the run inputs (small, MIXED -- tiny-model friendly)
; Four flagged items: 1 + 3 are cited/recorded (evidence), 2 + 4 are associations (speculation).
(def the-text Str
  "Prior cheap-pass flags to sort:\n1. The 2019 benchmark logged a 37 percent throughput gain (table 4, measured).\n2. The library was probably inspired by an older Erlang design.\n3. CVE-2021-1234 was patched in release 2.3.0, per the published changelog.\n4. Users likely prefer the new API because it feels cleaner.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "reference_level" "an item is evidence only if the text cites a source, a measurement, or a record")
  (cons (pair "prior_pass" "a 0.5b flagged these as possibly-relevant; sort real evidence from speculation, keep both tracks")
        nil)))

; ---------------------------------------------------------- evidence accessors
(def raw-prompt   (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) p))))
(def raw-response (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) rp))))
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare rawlen (-> (List RawCall) I64))
(def rawlen (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (rawlen t))))))
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))
(declare persp-count (-> (List Perspective) I64))
(def persp-count (lam (ps) (case ps (nil 0) ((cons h t) (+ 1 (persp-count t))))))

; N = the flagged items the branch actually ran (re-parse raws[0] = the perspectivist output).
(def n-perspectives (-> (List RawCall) I64)
  (lam (raws)
    (case raws
      (nil 0)
      ((cons r0 rest) (persp-count (parse-perspectives (raw-response r0)))))))

; does ANY sent prompt contain the marker? (the specialization-reached-the-model probe)
(declare any-prompt-has (-> (List RawCall) Str Bool))
(def any-prompt-has
  (lam (raws marker)
    (case raws
      (nil false)
      ((cons r rest)
        (case (str-has (raw-prompt r) marker)
          (true true)
          (false (any-prompt-has rest marker)))))))

; ---------------------------------------------------------- FRACTAL case (=>)
; expected total calls = 1 (perspectivist) + 2N (per-item chain: reasoner+classify) + 2 (backtrack).
(def report-fractal (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((n (n-perspectives raws)))
      (let ((calls (ecall-len (manifest-calls m))))
        (let ((expected (+ 1 (+ (+ n n) 2))))
          (let ((green (manifest-all-green? m)))
            (do (put (str-cat "FRACTAL flagged items (N): " (str-cat (i64->str n) "\n")))
            (do (put (str-cat "FRACTAL per-item calls (reasoner+classify, once each): " (str-cat (i64->str (+ n n)) "\n")))
            (do (put "FRACTAL backtrack calls (two-track consolidate + audit): 2\n")
            (do (put (str-cat "FRACTAL total manifest calls: " (str-cat (i64->str calls)
                       (str-cat " (expected 1+2N+2 = " (str-cat (i64->str expected) ")\n")))))
            (do (put (str-cat "FRACTAL manifest-all-green? (tiny-model-green on 0.5b): " (str-cat (bool->str green) "\n")))
                (case (and green (and (<=i 1 n) (=i calls expected))) (true 0) (false 1)))))))))))))

(def run-fractal-demo (=> I64 I64)
  (lam (_)
    (case (run-flow-stop (backend-open "http://100.64.0.5:11434")
             evidence-sift-flow (stop-single)
             "evidence-sift fractal: items -> per-item reason+classify -> two-track consolidate+audit"
             nil evidence-sift-pool evidence-sift-config the-text the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-fractal m raws))))))

; ---------------------------------------------------------- SPECIALIZE case (=>)
(def the-marker Str "RIGOROUS")
(def evidence-sift-lib (List Skill)
  (cons (skill-base "evidence-sift" evidence-sift-flow (stop-single))
  (cons (specialize-skill "evidence-sift" "evidence-sift-rigorous" "reference level: RIGOROUS - evidence must cite a source")
        nil)))

(def report-specialize (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((green (manifest-all-green? m)))
      (let ((found (any-prompt-has raws the-marker)))
        (do (put (str-cat "SPECIALIZE prompts sent: " (str-cat (i64->str (rawlen raws)) "\n")))
        (do (put (str-cat "SPECIALIZE manifest-all-green? (0.5b): " (str-cat (bool->str green) "\n")))
        (do (put (str-cat "SPECIALIZE rigorous reference-level present in a sent prompt: " (str-cat (bool->str found) "\n")))
            (case (and green found) (true 0) (false 1)))))))))

(def run-specialize-demo (=> I64 I64)
  (lam (_)
    (case (run-skill (backend-open "http://100.64.0.5:11434")
             "evidence-sift-rigorous" evidence-sift-lib
             "evidence-sift fractal specialized to a RIGOROUS reference level"
             nil evidence-sift-pool evidence-sift-config the-text the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-specialize m raws))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((a (run-fractal-demo 0)))
      (let ((b (run-specialize-demo 0)))
        (case (=i (+ a b) 0) (true 0) (false 1))))))
