; manas-project-builder-live.chiral -- SG5 LIVE gate: the META recursion, proven.
;
; The tool-builder (SG4) SPECIALIZED per PROJECT via the SAME specialize-skill (SG2) — one
; level up from the object-level doc-edit@<context> (SG3). run-skill "tool-builder@chirality"
; resolves the base tool-builder Flow, injects the PROJECT context (chirality's language/code
; idioms, carrying the grep-able marker PROJ-MARKER-abc) into the author step's prompt via
; the `extra` channel (assemble-prompt's "# Extra" section), and runs it on the mesh 0.5b.
;
; We then GREP the run's raws (the actual prompts SENT to the model) for PROJ-MARKER-abc:
;   present => the project context reached the builder's author step => the builder is
;   specialized PER PROJECT. That is the SG5 PASS criterion — the meta recursion.
;
; We ALSO run accept-gate on the author's emitted text and report it HONESTLY. As with SG4,
; a 0.5b almost never emits a whole valid+typed Flow in one shot, so the gate REJECTS (none)
; — the wall correctly protecting the library. The SG5 verdict does NOT depend on a valid
; emit; it depends on the project context reaching the author step (the marker).
;
; Backend = a q1 linear handle: opened once, threaded through run-skill, discharged with
; backend-close (moved exactly once -- B1 enforces it). If the mesh is DOWN the chat fails
; but the PROMPT WAS STILL ASSEMBLED + captured in the RawCall, so the marker is present
; regardless -- the injection is what is proven here.
;
; Exit 0 iff PROJ-MARKER-abc is found in at least one sent prompt. Non-zero otherwise.
;
; Build (closure = builder + skill + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" manas/core/builder ports > blob
;   cat scaffold/samples/manas-project-builder-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                ; str-cat, i64->str, +, case, do, let, some, none
(import "manas/backend")                ; backend-open / backend-close (E137 linear porttype)
(import "manas/core/flow")        ; str-has, RawCall
(import "manas/core/types")       ; StopPolicy (stop-single), RawCall, RunManifest
(import "manas/core/skill")       ; Skill (skill-base), run-skill
(import "manas/core/builder")     ; tool-builder-flow, tool-builder-pool, tool-builder-config, project-builder, accept-gate
(import "ports/ports")                  ; put

; ---------------------------------------------------------- the project context (carries the marker)
(def chirality-ctx Str "PROJECT: chirality; code idiom marker PROJ-MARKER-abc")

; ---------------------------------------------------------- the skill request (the doc the author sees)
(def the-request Str
  "Author a Flow for a skill that reads a document and proposes ONE minimal edit. Emit it as Flow JSON keyed by kind: a chain of two steps, ty-doc->ty-patch then ty-patch->ty-verdict.\n")

; ---------------------------------------------------------- the library: base tool-builder + per-project spec
(def tb-base Skill (skill-base "tool-builder" tool-builder-flow (stop-single)))
(def tb-chirality Skill (project-builder "tool-builder@chirality" chirality-ctx))
(def library (List Skill) (cons tb-base (cons tb-chirality nil)))

; ---------------------------------------------------------- evidence: grep raws' prompts for the marker
(def raw-prompt (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) p))))
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare rawlen (-> (List RawCall) I64))
(def rawlen (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (rawlen t))))))
(declare any-prompt-has (-> (List RawCall) Str Bool))
(def any-prompt-has
  (lam (raws marker)
    (case raws
      (nil false)
      ((cons r rest)
        (case (str-has (raw-prompt r) marker)
          (true true)
          (false (any-prompt-has rest marker)))))))

; ---------------------------------------------------------- report the SG4 accept-gate outcome, honestly
; returns Unit (a non-final `do` statement must be Unit-typed, like `put`); purely informational.
(def report-gate (=> Str Unit)
  (lam (emitted)
    (do (put (str-cat "BUILDER author emitted length: " (str-cat (i64->str (str-len emitted)) "\n")))
    (case (accept-gate emitted)
      ((some f) (put "BUILDER accept-gate: ACCEPTED (emitted Flow decoded AND type-checked)\n"))
      (none     (put "BUILDER accept-gate: REJECTED (none) -- a 0.5b rarely emits a whole valid+typed Flow; the wall correctly kept it OUT (SG4 known finding, not the SG5 criterion)\n"))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (case (run-skill (backend-open "http://100.64.0.5:11434")
             "tool-builder@chirality" library
             "tool-builder: emit a Flow JSON for the requested skill"
             nil tool-builder-pool tool-builder-config the-request nil)
      ((run-r y m raws b2)
        (do (backend-close b2)
          (let ((found (any-prompt-has raws "PROJ-MARKER-abc")))
            (do (put (str-cat "raws captured (prompts sent): " (str-cat (i64->str (rawlen raws)) "\n")))
            (do (put (str-cat "PROJ-MARKER-abc present in a sent prompt (project context reached the builder): " (str-cat (bool->str found) "\n")))
            (do (report-gate y)
                (case found (true 0) (false 1)))))))))))
