; manas-flow-stop-live.chiral -- MANAS-L0 slice 4 gate (b): LIVE run-flow-stop (the STOP loop).
;
; Actuates run-flow-stop against the mesh (100.64.0.5:11434) and proves StopPolicy is now
; LIVE (it was inert before this slice -- run-pipeline/run-flow were one-shot). The Flow
; under test is ONE flow-step (coverage-vs-spec, slot reasoner), so the manifest carries
; EXACTLY ONE expert-call per iteration -> manifest-call-count == iteration-count, a clean
; direct readout of how many times the loop ran.
;
;   SINGLE     -- stop-single      -> 1 iteration (the baseline single-pass call count).
;   CAPPED-2   -- stop-capped 2    -> exactly 2 iterations = 2x the single-pass count
;                 (feed-forward: iteration 1 runs on iteration 0's output).
;   UNTIL-DRY  -- stop-until-dry 3 -> BOUNDED by the cap: iterations <= 3 (and >= 1). Even
;                 if the tiny model never stabilizes its output, the cap terminates it.
;
; Backend is a q1 linear handle: opened once per case, threaded through EVERY iteration of
; the loop, discharged with backend-close (moved exactly once per path -- B1 enforces it).
;
; Exit 0 iff: CAPPED-2 count == 2 * SINGLE count, AND SINGLE count == 1, AND UNTIL-DRY count
; is in [1, 3] (bounded by the cap). Non-zero otherwise.
;
; Build (closure = flow + doc-refine experts + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" manas/core/flow manas/profile/doc-refine ports > blob
;   cat scaffold/samples/manas-flow-stop-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                  ; str-cat, str-len, i64->str, +, =i, <=i, and, case, do, let
(import "manas/backend")                  ; backend-open / backend-close (E137 linear porttype)
(import "manas/core/flow")          ; run-flow-stop, flow-step, Ty ctors, manifest-calls
(import "manas/core/types")         ; Config, Binding (+ ctors), RunManifest, ExpertCall, StopPolicy (stop-single/stop-capped/stop-until-dry)
(import "manas/profile/doc-refine") ; expert-pool, coverage-vs-spec (by id, slot reasoner)
(import "ports/ports")                    ; put

; ---------------------------------------------------------- the run input (small -- tiny-model friendly)
(def the-doc Str
  "# widget config\n\nThe loader reads `/etc/widget/config.toml` at boot.\n\n```\nwidget --start\n```\n\nExample: `widget --start` brings the service up.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "spec_or_requirements" "docs/widget-SPEC.md") nil))

; ---------------------------------------------------------- the Flow: ONE tiny step (1 call/iter)
; A single flow-step -> the manifest has exactly ONE expert-call per loop iteration, so the
; call count IS the iteration count. ty-doc -> ty-doc so the refined yield feeds forward.
(def the-step Flow
  (flow-step "coverage-vs-spec" ty-doc ty-doc))

; a config binding the reasoner slot (coverage-vs-spec's slot) to the tiny resident model.
(def test-config Config
  (config "stop-smoke"
    (cons (binding "reasoner" "qwen2.5:0.5b" 16384) nil)))

; ---------------------------------------------------------- evidence accessors
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))

; run the loop under a policy, return the iteration count (= manifest call count for a
; single flow-step). Backend opened + closed inside (moved exactly once).
(def run-under (=> StopPolicy Str I64)
  (lam (policy tag)
    (case (run-flow-stop (backend-open "http://100.64.0.5:11434")
             the-step policy tag nil expert-pool test-config the-doc the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2)
          (let ((n (ecall-len (manifest-calls m))))
            (do (put (str-cat tag (str-cat " iterations (= manifest calls): " (str-cat (i64->str n) "\n"))))
                n)))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((single (run-under (stop-single)      "SINGLE   ")))
      (let ((capped (run-under (stop-capped 2)   "CAPPED-2 ")))
        (let ((dry    (run-under (stop-until-dry 3) "UNTIL-DRY")))
          (do (put (str-cat "CHECK single==1:            " (str-cat (i64->str single) "\n")))
          (do (put (str-cat "CHECK capped == 2*single:   " (str-cat (i64->str capped)
                     (str-cat " vs " (str-cat (i64->str (+ single single)) "\n")))))
          (do (put (str-cat "CHECK until-dry <= cap(3):  " (str-cat (i64->str dry) "\n")))
              (case (and (=i single 1)
                    (and (=i capped (+ single single))
                    (and (<=i 1 dry) (<=i dry 3))))
                (true 0) (false 1))))))))))
