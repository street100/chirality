; manas-flow-live.chiral -- MANAS-L0 slice 2 gate (b): LIVE flow-chain + flow-fan.
;
; Actuates the two new run-flow arms against the mesh (100.64.0.5:11434), from
; EXISTING doc-refine experts + the curate-merge combiner. Proves the two things
; slice 2 must show live:
;   CHAIN  — step-2's prompt CONTAINS step-1's output (the seam threads output->input:
;            assemble-prompt embeds the input under "# Document", and chain-run feeds
;            the refined step-1 yield as step-2's input). Checked by str-has.
;   FAN    — the merged manifest has BOTH sub-calls + the combiner call (3 expert-calls:
;            2 fan children + 1 synthesized combiner-ecall).
; Backend is a q1 linear handle: opened once per demo, threaded through the whole run,
; discharged with backend-close (moved exactly once — B1 enforces it).
;
; Exit 0 iff BOTH the chain threaded (step2-prompt contains step1-output, step1 output
; non-empty) AND the fan produced 3 expert-calls. Non-zero otherwise.
;
; Build (closure = flow + profiles + doc-refine + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" manas/core/flow manas/profile/profiles \
;     manas/profile/doc-refine ports > blob
;   cat scaffold/samples/manas-flow-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                  ; str-cat, str-len, i64->str, +, =i, and, case, do, let
(import "manas/backend")                  ; backend-open / backend-close (E137 linear porttype)
(import "manas/core/flow")          ; run-flow, flow-step, flow-chain, flow-fan, Ty ctors, refine-ok, str-nonempty, str-has, manifest-calls
(import "manas/core/types")         ; RunManifest, RawCall, ExpertCall, Finding
(import "manas/profile/profiles")   ; smoke-local-config
(import "manas/profile/doc-refine") ; expert-pool
(import "ports/ports")                    ; put

; ---------------------------------------------------------- the run inputs (small — tiny-model friendly)
(def the-doc Str
  "# widget config\n\nThe loader reads `/etc/widget/config.toml` at boot.\n\n```\nwidget --start\n```\n\nExample: `widget --start` brings the service up.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "spec" "docs/widget-SPEC.md")
  (cons (pair "sibling_docs" "docs/widget-overview.md")
        nil)))

; ---------------------------------------------------------- the two Flows (existing experts)
; CHAIN: example-completeness (reasoner, EMITS) -> curate-merge (combiner, CONSUMES).
; step-1 out-ty ty-text (the opaque escape hatch: any non-empty text refines OK, so the
; chain proceeds and we can observe the threading regardless of the tiny model's shape);
; the seam ty-text = ty-text type-checks (cod step1 = dom step2).
(def the-chain Flow
  (flow-chain (cons (flow-step "example-completeness" ty-doc ty-text)
              (cons (flow-step "curate-merge" ty-text ty-doc) nil))))

; FAN: coverage-vs-spec + cross-doc-drift (both reasoner, shared dom ty-doc) -> curate-merge.
(def the-fan Flow
  (flow-fan (cons (flow-step "coverage-vs-spec" ty-doc ty-findings)
            (cons (flow-step "cross-doc-drift"  ty-doc ty-findings) nil))
            "curate-merge" ty-doc))

; ---------------------------------------------------------- evidence accessors
(def raw-prompt   (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) p))))
(def raw-response (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) rp))))
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare rawlen (-> (List RawCall) I64))
(def rawlen (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (rawlen t))))))
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))

; ---------------------------------------------------------- report the CHAIN threading (=>)
; raws = [raw1, raw2] in step order; raw2's prompt must contain raw1's response.
(def report-chain (=> Str (List RawCall) I64)
  (lam (yield raws)
    (case raws
      (nil (do (put "CHAIN: 0 raws -> did not thread\n") 1))
      ((cons r1 rest1)
        (case rest1
          (nil (do (put "CHAIN: 1 raw -> did not reach step 2\n") 1))
          ((cons r2 rest2)
            (let ((resp1 (raw-response r1)))
              (let ((prompt2 (raw-prompt r2)))
                (let ((threaded (and (str-nonempty resp1) (str-has prompt2 resp1))))
                  (do (put (str-cat "CHAIN raws: " (str-cat (i64->str (rawlen raws)) "\n")))
                  (do (put (str-cat "CHAIN step1-output-len: " (str-cat (i64->str (str-len resp1)) "\n")))
                  (do (put (str-cat "CHAIN step2-prompt-contains-step1-output: " (str-cat (bool->str threaded) "\n")))
                      (case threaded (true 0) (false 1))))))))))))))

; ---------------------------------------------------------- report the FAN merge (=>)
; manifest expert-calls = 2 fan children + 1 combiner-ecall = 3.
(def report-fan (=> RunManifest I64)
  (lam (m)
    (let ((n (ecall-len (manifest-calls m))))
      (do (put (str-cat "FAN expert-calls (2 children + combiner): " (str-cat (i64->str n) "\n")))
          (case (=i n 3) (true 0) (false 1))))))

; ---------------------------------------------------------- the two live runs (=>)
(def run-chain-demo (=> I64 I64)
  (lam (_)
    (case (run-flow (backend-open "http://100.64.0.5:11434")
             the-chain "chain demo: complete then merge" nil expert-pool smoke-local-config the-doc the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-chain y raws))))))

(def run-fan-demo (=> I64 I64)
  (lam (_)
    (case (run-flow (backend-open "http://100.64.0.5:11434")
             the-fan "fan demo: two lenses merged" nil expert-pool smoke-local-config the-doc the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-fan m))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((c (run-chain-demo 0)))
      (let ((f (run-fan-demo 0)))
        (case (=i (+ c f) 0) (true 0) (false 1))))))
