; manas-decision-live.chiral -- T4 LIVE gate: the decision FRACTAL runs tiny-model-green,
; and a SPECIALIZATION of it (a risk-first decision lens) runs green with its context reaching
; the model.
;
; Actuates the whole decision fractal (decision.chiral) against the mesh
; (100.64.0.5:11434) under decision-config (every slot on the 0.5b `qwen2.5:0.5b`). The
; input is a small real DECISION with a few named options and a couple lines of context -- the
; exact shape a decision skill fans over its criteria (risk / cost / user-impact / ...). Two
; live cases:
;
;   FRACTAL -- run-flow-stop decision-flow (stop-single) on the decision. Proof:
;     (a) manifest-all-green? = true (every tiny step ran GREEN on the 0.5b -- no typed-seam
;         refine-fail, every call parsed-ok), AND
;     (b) the manifest shows the fractal executed: 1 (perspectivist) + 2N (per-criterion chain,
;         assess+score once EACH of N criteria) + 2 (backtrack weigh+audit). N is
;         re-parsed from the perspectivist's raw output (raws[0]). Prints N + the call count.
;     With the branch-drop fix (139ded7) live, a silently-swallowed criterion can no longer hide
;     a green -- so this green is HONEST (a dropped criterion turns the composite routing non-green).
;
;   SPECIALIZE -- library [skill-base "decision" decision-flow (stop-single)] +
;     specialize-skill "decision" "decision-risk-first"
;       "decision lens: RISK-FIRST - weight downside risk above all other criteria".
;     run-skill "decision-risk-first" resolves the base flow, injects the context as
;     context-0 into `extra`, runs the fractal on the 0.5b. Proof: green AND the RISK-FIRST
;     decision-lens context appears in a SENT PROMPT (grep the raws' prompts) -- the
;     specialization reached the model, so the SAME fractal now weighs the decision risk-first.
;
; Backend is a q1 linear handle: opened once per case, threaded through, discharged with
; backend-close (moved exactly once -- B1 enforces it).
;
; Exit 0 iff BOTH cases pass. If the mesh is DOWN, be-chat returns chat-bad => parsed_ok=false
; => manifest-all-green? = false => this reports NON-green honestly (a real signal, not a fake).
;
; Build (closure = decision + skill + ports; append the sys leaves):
;   . bin/chirality-resolve.sh
;   chirality_blob "lib:prog" manas/profile/decision manas/core/skill ports > blob
;   cat scaffold/samples/manas-decision-live.chiral >> blob; echo >> blob
;   for l in tal-ir crossing-wraps sys-check target-linux sys-tal sys-linkage; do \
;     cat scaffold/lib/$l.chiral >> blob; echo >> blob; done
;   ulimit -s unlimited; ./scaffold/build/B1 < blob > t.elf && chmod +x t.elf && ./t.elf; echo $?
(import "prelude/prelude")                    ; str-cat, str-len, i64->str, +, =i, <=i, and, case, do, let
(import "manas/backend")                    ; backend-open / backend-close (E137 linear porttype)
(import "manas/core/flow")            ; run-flow-stop, manifest-all-green?, manifest-calls,
                                      ; parse-perspectives, Perspective, str-has
(import "manas/core/types")           ; StopPolicy (stop-single), RawCall, RunManifest, ExpertCall
(import "manas/core/skill")           ; Skill (skill-base), specialize-skill, run-skill
(import "manas/profile/decision")     ; decision-flow, decision-pool, decision-config
(import "ports/ports")                      ; put

; ---------------------------------------------------------- the run inputs (small, real decision -- tiny-model friendly)
; A concrete decision with a few named options and a little surrounding context, suited to all criteria.
(def the-text Str
  "Decision: which structure for the editor's undo stack?\nOptions:\n- (A) a persistent tree\n- (B) a mutable array of snapshots\n- (C) a command log replayed forward\nNotes:\n- The undo system must restore any earlier state on demand.\n- We can afford some extra memory but latency must stay low.\n")
(def the-extra (List (Pair Str Str))
  (cons (pair "options" "A = persistent tree; B = mutable array of snapshots; C = command log replayed forward")
  (cons (pair "constraints" "single-user editor; extra memory ok but undo latency must stay low")
        nil)))

; ---------------------------------------------------------- evidence accessors
(def raw-prompt   (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) p))))
(def raw-response (-> RawCall Str) (lam (r) (case r ((raw-call e s m p rp) rp))))
(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))
(declare rawlen (-> (List RawCall) I64))
(def rawlen (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (rawlen t))))))
(declare ecall-len (-> (List ExpertCall) I64))
(def ecall-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (ecall-len t))))))
(declare persp-count (-> (List Perspective) I64))
(def persp-count (lam (ps) (case ps (nil 0) ((cons h t) (+ 1 (persp-count t))))))

; N = the criteria the branch actually ran (re-parse raws[0] = the perspectivist output).
(def n-perspectives (-> (List RawCall) I64)
  (lam (raws)
    (case raws
      (nil 0)
      ; R3: a MODEL perspectivist's fan is CAPPED, so the expected call count is over the
      ; perspectives actually RUN, not over every line the model emitted.
      ((cons r0 rest)
        (let ((emitted (persp-count (parse-perspectives (raw-response r0)))))
          (case (<i max-model-perspectives emitted) (true max-model-perspectives) (false emitted)))))))

; does ANY sent prompt contain the marker? (the specialization-reached-the-model probe)
(declare any-prompt-has (-> (List RawCall) Str Bool))
(def any-prompt-has
  (lam (raws marker)
    (case raws
      (nil false)
      ((cons r rest)
        (case (str-has (raw-prompt r) marker)
          (true true)
          (false (any-prompt-has rest marker)))))))

; ---------------------------------------------------------- FRACTAL case (=>)
; expected total calls = 1 (perspectivist) + 2N (per-criterion chain: assess+score) + 2 (backtrack).
(def report-fractal (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((n (n-perspectives raws)))
      (let ((calls (ecall-len (manifest-calls m))))
        (let ((expected (+ 1 (+ (+ n n) 2))))
          (let ((green (manifest-all-green? m)))
            (do (put (str-cat "FRACTAL decision criteria (N): " (str-cat (i64->str n) "\n")))
            (do (put (str-cat "FRACTAL per-criterion calls (assess+score, once each): " (str-cat (i64->str (+ n n)) "\n")))
            (do (put "FRACTAL backtrack calls (collect-angles [code] + audit): 2\n")
            (do (put (str-cat "FRACTAL total manifest calls: " (str-cat (i64->str calls)
                       (str-cat " (expected 1+2N+2 = " (str-cat (i64->str expected) ")\n")))))
            (do (put (str-cat "FRACTAL manifest-all-green? (tiny-model-green on 0.5b): " (str-cat (bool->str green) "\n")))
                (case (and green (and (<=i 1 n) (=i calls expected))) (true 0) (false 1)))))))))))))

(def run-fractal-demo (=> I64 I64)
  (lam (_)
    (case (run-flow-stop (backend-open "http://100.64.0.5:11434")
             decision-flow (stop-single)
             "decision fractal: decision -> per-criterion assess+score -> weigh+audit"
             nil decision-pool decision-config the-text the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-fractal m raws))))))

; ---------------------------------------------------------- SPECIALIZE case (=>)
(def the-marker Str "RISK-FIRST")
(def decision-lib (List Skill)
  (cons (skill-base "decision" decision-flow (stop-single))
  (cons (specialize-skill "decision" "decision-risk-first" "decision lens: RISK-FIRST - weight downside risk above all other criteria")
        nil)))

(def report-specialize (=> RunManifest (List RawCall) I64)
  (lam (m raws)
    (let ((green (manifest-all-green? m)))
      (let ((found (any-prompt-has raws the-marker)))
        (do (put (str-cat "SPECIALIZE prompts sent: " (str-cat (i64->str (rawlen raws)) "\n")))
        (do (put (str-cat "SPECIALIZE manifest-all-green? (0.5b): " (str-cat (bool->str green) "\n")))
        (do (put (str-cat "SPECIALIZE risk-first decision-lens present in a sent prompt: " (str-cat (bool->str found) "\n")))
            (case (and green found) (true 0) (false 1)))))))))

(def run-specialize-demo (=> I64 I64)
  (lam (_)
    (case (run-skill (backend-open "http://100.64.0.5:11434")
             "decision-risk-first" decision-lib
             "decision fractal specialized to a RISK-FIRST decision lens"
             nil decision-pool decision-config the-text the-extra)
      ((run-r y m raws b2)
        (do (backend-close b2) (report-specialize m raws))))))

; ---------------------------------------------------------- entry (effectful)
(def compile-main (=> I64 I64)
  (lam (n)
    (let ((a (run-fractal-demo 0)))
      (let ((b (run-specialize-demo 0)))
        (case (=i (+ a b) 0) (true 0) (false 1))))))
