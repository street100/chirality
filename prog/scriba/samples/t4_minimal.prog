; T4 minimal (E111) — a fresh linear (Grid n): right dims, cursor home.
; Native: grid-new mints a Pool-backed 3x3 grid, we inspect dims/cursor, then
; free the region. Exit 0 on pass, -1 otherwise.
(import "prelude/prelude")
(import "protocol/grid")

(def compile-main (=> I64 I64)
  (lam (arg)
    (case (grid-new 144 3 3)
      ((grid rows cols store cur pen)
        (case cur
          ((cursor cr cc)
            (case (pool-close 144 store)
              (unit
                (case (and (and (=i rows 3) (=i cols 3)) (and (=i cr 0) (=i cc 0)))
                  (true 0)
                  (false -1))))))))))
