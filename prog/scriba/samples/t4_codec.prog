; T4 codec conformance (E111) — the 16-byte Cell⇄bytes round-trip.
;   For each Color variant (default / indexed / rgb) and all six attrs, a Cell
;   encodes to exactly 16 bytes and decodes back to a structurally identical
;   Cell. Pure — no Pool needed. Exit 42 on all-pass, -1 on any mismatch.
(import "prelude")
(import "grid")

(declare compile-main (-> Unit I64))
(declare booleq  (-> Bool Bool Bool))
(declare color-eq (-> Color Color Bool))
(declare attrs-eq (-> Attrs Attrs Bool))
(declare cell-eq (-> Cell Cell Bool))
(declare rt      (-> Cell Bool))

(def booleq (lam (a b) (case a (true b) (false (not b)))))

(def color-eq
  (lam (a b)
    (case a
      (color-default      (case b (color-default true) (_ false)))
      ((color-indexed i)  (case b ((color-indexed j) (=i i j)) (_ false)))
      ((color-rgb r g bb) (case b ((color-rgb r2 g2 b2)
                            (and (and (=i r r2) (=i g g2)) (=i bb b2))) (_ false))))))

(def attrs-eq
  (lam (x y)
    (case x
      ((attrs b1 u1 i1 r1 k1 s1 f1 g1)
        (case y
          ((attrs b2 u2 i2 r2 k2 s2 f2 g2)
            (and (and (and (booleq b1 b2) (booleq u1 u2)) (and (booleq i1 i2) (booleq r1 r2)))
                 (and (and (booleq k1 k2) (booleq s1 s2)) (and (color-eq f1 f2) (color-eq g1 g2))))))))))

(def cell-eq
  (lam (a b)
    (case a
      ((cell c1 r1 w1)
        (case b
          ((cell c2 r2 w2)
            (and (and (=i c1 c2) (=i w1 w2)) (attrs-eq r1 r2))))))))

; round-trip: encode to 16 bytes, decode, and require both structural equality
; AND that the encoding is exactly cell-bytes wide.
(def rt
  (lam (c)
    (and (=i (blen (cell->bytes c)) cell-bytes)
         (cell-eq c (bytes->cell (cell->bytes c))))))

(def compile-main
  (lam (_)
    (let (c1 (cell 65 blank-attrs 1))                                  ; default colors, no attrs
    (let (c2 (cell 128512 (attrs true true true true true true
                            (color-indexed 5) (color-indexed 200)) 2)) ; all attrs, indexed, wide
    (let (c3 (cell 97 (attrs false true false true false true
                        (color-rgb 10 20 30) (color-rgb 40 50 60)) 1)) ; rgb fg+bg
    (let (c4 (cell 32 (attrs true false false false false false
                        color-default (color-rgb 255 128 0)) 1))       ; mixed default/rgb
      (case (and (and (rt c1) (rt c2)) (and (rt c3) (rt c4)))
        (true 42)
        (false -1))))))))
