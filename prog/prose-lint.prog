; prose-lint -- the doc tier's prose sorter, in chirality.
;
; Reads a NEWLINE-SEPARATED LIST OF PATHS on stdin, opens each, counts the tics
; that make a document read as machine-written, and writes one
; `path <TAB> check <TAB> count` row per nonzero check plus a TOTAL line.
;
;   find docs .planning -name '*.md' | chirality run prog/prose-lint.prog
;
; ── Why stdin and not a directory walk ──────────────────────────────────────
;
; Enumeration is the ONE piece of this tool the language cannot express today.
; `getdents64` is E148, not built, and the catalog already names three standing
; workarounds waiting on it (scriba's flook, the manas setup index.json, and
; test-runner's bundled manifest). This makes four, and that is worth writing
; down rather than hiding: the count of workarounds IS E148's justification.
;
; Reading a path list on stdin is the tree's existing idiom. `chirality-bin <
; blob` does it, and `wield.prog` reads a path on stdin the same way. It needs
; zero new crossings. When E148 lands, the `find` in front of the pipe is the
; only thing that goes away; nothing in this file changes.
;
; ── The patterns are values ─────────────────────────────────────────────────
;
; Each check is ONE `Pat` from `lib/text/matcher.chiral`, built by constructor
; application. A shape the shell version spells as a regex is spelled here as a
; tree, so a malformed pattern has no representation. `count-matches` walks a
; line once per check and returns leftmost-longest non-overlapping spans, which
; is what mawk's `gsub` counts.
;
; Code is skipped before any pattern sees a line. `line-step` carries the fence
; state and gets `ls-prose` back at every file, because the state arrives as an
; argument and the file boundary is the caller's to know. `blank-spans` turns an
; inline span into spaces of the same length. The shell version DELETES the span
; (`tools/prose-lint/prose-lint.sh:93`), which shortens the line and can glue the
; two sides of a span into a match the source never held. The two tools disagree
; there by design, and the blanking side is the honest one.

(import "prelude/prelude")            ; str-len, str-find-from, str-cat, i64->str
(import "prelude/list")               ; length
(import "prelude/string")             ; str-split
(import "ports/ports")                ; put
(import "lowering/compile-all")       ; read-fd-all, byte ops
(import "text/matcher")               ; Pat, count-matches, line-step, blank-spans

(extern openat (=> Bytes I64))        ; NUL-terminated path bytes -> fd, or negative errno

(def nul-byte Bytes (bslice (pack-u32 0) 0 1))

; ── the checks ──────────────────────────────────────────────────────────────
; Measured against this corpus before they were written: the generic slop word
; list scored ~0 here (delve 0, tapestry 0, seamless 0, Furthermore 0) while the
; structural tics scored in the thousands. `robust` and `leverage` DID score and
; are deliberately absent: they are technical here (`robust-shares` is a T3 rung,
; "highest-leverage row" is a noun), and a linter you learn to ignore is worse
; than none.
;
; Each pattern below is the shell version's regex, arm for arm. The eight are
; the eight `tools/prose-lint/prose-lint.sh:95-102` counts; `:103-104` holds two
; more that this tool prints as NOT-CHECKED rather than dropping.

; `[Dd]`, spelled as a class so the alternation stays one node per word.
(def cls-Dd Cls (c-or (c-byte 68) (c-byte 100)))
(def cls-Tt Cls (c-or (c-byte 84) (c-byte 116)))
(def cls-Ss Cls (c-or (c-byte 83) (c-byte 115)))
(def cls-Pp Cls (c-or (c-byte 80) (c-byte 112)))
(def cls-Mm Cls (c-or (c-byte 77) (c-byte 109)))
(def cls-Ii Cls (c-or (c-byte 73) (c-byte 105)))
(def cls-Aa Cls (c-or (c-byte 65) (c-byte 97)))
(def cls-Nn Cls (c-or (c-byte 78) (c-byte 110)))

; `[a-z]+`
(def p-lower1 Pat (p-cat (p-cls cls-lower) (p-star (p-cls cls-lower))))

; /—/
(def pat-em Pat (p-lit "—"))

; /, (but |and |though |yet )?(not|never|rather than) [a-z]/
(def p-conj Pat
  (p-alt (p-nil)
    (p-alt (p-lit "but ")
      (p-alt (p-lit "and ")
        (p-alt (p-lit "though ") (p-lit "yet "))))))

(def p-anti-kw Pat
  (p-alt (p-lit "not") (p-alt (p-lit "never") (p-lit "rather than"))))

(def pat-antithesis Pat
  (p-cat (p-lit ", ")
    (p-cat p-conj
      (p-cat p-anti-kw
        (p-cat (p-lit " ") (p-cls cls-lower))))))

; /(is|are|was|were|isn.t|aren.t) not (just |merely |simply )?[a-z]/
; The `.` is one byte, which is what mawk's dot is: mawk 1.3.4 has no multibyte
; mode, so `isn` + U+2019 + `t` fails there and fails here for the same reason.
(def p-cop-verb Pat
  (p-alt (p-lit "is")
    (p-alt (p-lit "are")
      (p-alt (p-lit "was")
        (p-alt (p-lit "were")
          (p-alt (p-cat (p-lit "isn") (p-cat (p-cls (c-any)) (p-lit "t")))
                 (p-cat (p-lit "aren") (p-cat (p-cls (c-any)) (p-lit "t")))))))))

(def p-cop-adv Pat
  (p-alt (p-nil)
    (p-alt (p-lit "just ") (p-alt (p-lit "merely ") (p-lit "simply ")))))

(def pat-copula Pat
  (p-cat p-cop-verb
    (p-cat (p-lit " not ")
      (p-cat p-cop-adv (p-cls cls-lower)))))

; /[Nn]o [a-z]+, no [a-z]+|[Nn]ever [a-z]+, never /
(def pat-parallel Pat
  (p-alt
    (p-cat (p-cls cls-Nn)
      (p-cat (p-lit "o ")
        (p-cat p-lower1 (p-cat (p-lit ", no ") p-lower1))))
    (p-cat (p-cls cls-Nn)
      (p-cat (p-lit "ever ")
        (p-cat p-lower1 (p-lit ", never "))))))

; /[Dd]elve|[Tt]apestry|[Ss]eamless|[Ss]howcase|testament to|[Pp]lethora|
;  [Mm]yriad|[Pp]ivotal/
(def pat-slop Pat
  (p-alt (p-cat (p-cls cls-Dd) (p-lit "elve"))
    (p-alt (p-cat (p-cls cls-Tt) (p-lit "apestry"))
      (p-alt (p-cat (p-cls cls-Ss) (p-lit "eamless"))
        (p-alt (p-cat (p-cls cls-Ss) (p-lit "howcase"))
          (p-alt (p-lit "testament to")
            (p-alt (p-cat (p-cls cls-Pp) (p-lit "lethora"))
              (p-alt (p-cat (p-cls cls-Mm) (p-lit "yriad"))
                     (p-cat (p-cls cls-Pp) (p-lit "ivotal"))))))))))

; /worth noting|important to note|[Ii]n essence|[Aa]t its core|[Ii]n other words/
(def pat-throat Pat
  (p-alt (p-lit "worth noting")
    (p-alt (p-lit "important to note")
      (p-alt (p-cat (p-cls cls-Ii) (p-lit "n essence"))
        (p-alt (p-cat (p-cls cls-Aa) (p-lit "t its core"))
               (p-cat (p-cls cls-Ii) (p-lit "n other words")))))))

; /Furthermore|Moreover|Additionally,/
(def pat-connective Pat
  (p-alt (p-lit "Furthermore")
    (p-alt (p-lit "Moreover") (p-lit "Additionally,"))))

; /not [a-z]+ but / lives in the matcher as `pat-not-but`, where it doubles as
; that module's smoke value. Naming it twice would be one shape in two homes.

; ── reporting ───────────────────────────────────────────────────────────────

; join three fields into one tab-separated line. Built by sequential `let`s
; rather than nested `str-cat`s: the paren depth stays at one per line, which is
; the difference between a balance you can see and one you have to count.
(def tsv3 (-> Str Str Str Str)
  (lam (a b c)
    (let (x (str-cat a "\t"))
      (let (y (str-cat x b))
        (let (z (str-cat y "\t"))
          (let (w (str-cat z c))
            (str-cat w "\n")))))))

(def row (=> Str Str I64 Unit)
  (lam (path name n)
    (case (=i n 0)
      (true unit)
      (false (put (tsv3 path name (i64->str n)))))))

; ── the line pass ───────────────────────────────────────────────────────────

(def tick Str "`")

; The lines a pattern is allowed to see, already blanked. Structural on `ls`:
; every recursive call takes the tail.
;
; A line holding no backtick is byte-identical to its blanked copy, so the guard
; skips a per-byte rebuild on nearly every line of the corpus.
(def keep-lines (-> LState (List Str) (List Str))
  (lam (st ls)
    (case ls
      (nil nil)
      ((cons h t)
        (case (line-step st h)
          ((pair st2 keep)
            (case keep
              (false (keep-lines st2 t))
              (true
                (let (b (case (<i (str-find-from h tick 0) 0)
                          (true h)
                          (false (blank-spans h))))
                  (cons b (keep-lines st2 t)))))))))))

; one check over every kept line. Structural on `ls`.
(def count-pat (-> (List Str) Pat I64)
  (lam (ls p)
    (case ls
      (nil 0)
      ((cons h t) (+ (count-matches p (str->bytes h)) (count-pat t p))))))

; scan one already-read document, emit its rows, return its hit total. The fence
; state starts at `ls-prose` here, which is this tool's answer to the shell
; version's `FNR == 1 { fence = 0 }`.
(def scan-doc (=> Str Str I64)
  (lam (path body)
    (let (ls (keep-lines (ls-prose) (str-split "\n" body)))
      (let (em (count-pat ls pat-em))
        (let (anti (count-pat ls pat-antithesis))
          (let (cop (count-pat ls pat-copula))
            (let (nb (count-pat ls pat-not-but))
              (let (par (count-pat ls pat-parallel))
                (let (slop (count-pat ls pat-slop))
                  (let (thr (count-pat ls pat-throat))
                    (let (conn (count-pat ls pat-connective))
                      (do (row path "em-dash" em)
                        (do (row path "antithesis" anti)
                          (do (row path "copula-negation" cop)
                            (do (row path "not-but" nb)
                              (do (row path "parallel-no" par)
                                (do (row path "slop-word" slop)
                                  (do (row path "throat-clearing" thr)
                                    (do (row path "connective" conn)
                                      (+ em (+ anti (+ cop (+ nb (+ par (+ slop (+ thr conn)))))))
                                      )))))))))))))))))))

; open a path, read it, scan it. A path that will not open is REPORTED, never
; skipped silently: a file the linter could not read is not a clean file.
(def do-path (=> Str I64)
  (lam (path)
    (case (=i (str-len path) 0)
      (true 0)
      (false
        (let (fd (openat (bcat (str->bytes path) nul-byte)))
          (case (<i fd 0)
            (true (do (put (tsv3 path "UNREADABLE" "1")) 0))
            (false (scan-doc path (bytes->str (read-fd-all fd))))))))))

(def do-paths (=> (List Str) I64)
  (lam (ps)
    (case ps
      (nil 0)
      ((cons h t) (+ (do-path h) (do-paths t))))))

; The shell version carries ten checks and this one counts eight. The two it
; leaves out are PRINTED by name every run. A check that silently vanishes is a
; gate that reports ok forever, which is the same rule the test runner follows
; for its 5 unported phases. Closing the gap is recorded as E173 residue, so
; the gap has an owner and a home.
(def compile-main (=> I64 I64)
  (lam (n)
    (let (paths (str-split "\n" (bytes->str (read-fd-all 0))))
      (let (total (do-paths paths))
        (do (put (tsv3 "TOTAL" "hits" (i64->str total)))
          (do (put (tsv3 "NOT-CHECKED" "self-reference" "E173 residue; 7 hits at baseline"))
            (do (put (tsv3 "NOT-CHECKED" "first-person" "E173 residue; 6 hits at baseline"))
              0)))))))
