; persist.chiral — a PURE JSON codec for Pipeline and Config values.
;
; The foundation slice (P1) of scriba's manas-setup persistence: value <-> JSON
; so a later slice can save an edited setup to disk and reload it. NO file I/O,
; NO scriba, NO mesh here — just the codec + a round-trip unit test.
;
; Composes lib/protocol/json.chiral (Json tree + json-show/json-parse + the
; obj-get/as-str/as-int/as-arr accessors) rather than reinventing serialization.
; Experts are NOT serialized: a Pipeline references its pool by id (expert-ids +
; combiner are id strings); the compiled-in pool resolves them on load.
;
; TOTALITY is the deliverable: every decoder is (-> Json (Maybe _)) and returns
; an honest `none` on ANY malformed input — a missing key, a wrong Json variant,
; or an unknown tag fails the whole decode (the boundary-as-closed-sum discipline
; — no partial patterns, no silent defaults).
;
; JSON schema (P2/P3 must match this):
;   Pipeline -> {"kind":"pipeline","id":Str,"when":Str,
;                "gate":[{"condition":Str,"ids":[Str]}],
;                "order":"fan-out"|"chain"|"branch","expert-ids":[Str],
;                "combiner":Str,"stop":<stop>,"yield":Str}
;   <stop>   -> {"kind":"single"} | {"kind":"capped","cap":Int}
;             | {"kind":"until-dry","cap":Int}
;   Config   -> {"kind":"config","id":Str,"bindings":[<bind>]}
;   <bind>   -> {"slot":Str,"model":Str,"num-ctx":Int}

(import "prelude/prelude")            ; Str, Bool, List, Maybe, Pair, str-eq, cons, nil, some, none, i64->str
(import "protocol/json")               ; Json (+ ctors), json-show, obj-get, as-str, as-int, as-arr
(import "manas/core/types")   ; Pipeline, GateRule, Order, StopPolicy, Config, Binding

; ============================================================ encode helpers
; (List Str) -> a JSON array of strings.
(def str-list->jsons (-> (List Str) (List Json))
  (lam (xs) (case xs
    (nil nil)
    ((cons h t) (cons (j-str h) (str-list->jsons t))))))

(def str-list->jarr (-> (List Str) Json)
  (lam (xs) (j-arr (str-list->jsons xs))))

; ============================================================ encoders

(def order->json (-> Order Json)
  (lam (o) (case o
    (order-fan-out (j-str "fan-out"))
    (order-chain   (j-str "chain"))
    (order-branch  (j-str "branch")))))

(def stop->json (-> StopPolicy Json)
  (lam (sp) (case sp
    (stop-single
      (j-obj (cons (pair "kind" (j-str "single")) nil)))
    ((stop-capped c)
      (j-obj (cons (pair "kind" (j-str "capped"))
              (cons (pair "cap"  (j-num (i64->str c))) nil))))
    ((stop-until-dry c)
      (j-obj (cons (pair "kind" (j-str "until-dry"))
              (cons (pair "cap"  (j-num (i64->str c))) nil)))))))

(def gate-rule->json (-> GateRule Json)
  (lam (g) (case g
    ((gate-rule cond ids)
      (j-obj (cons (pair "condition" (j-str cond))
              (cons (pair "ids"       (str-list->jarr ids)) nil)))))))

(def gate-list->jsons (-> (List GateRule) (List Json))
  (lam (gs) (case gs
    (nil nil)
    ((cons h t) (cons (gate-rule->json h) (gate-list->jsons t))))))

(def binding->json (-> Binding Json)
  (lam (b) (case b
    ((binding slot model nctx)
      (j-obj (cons (pair "slot"    (j-str slot))
              (cons (pair "model"   (j-str model))
              (cons (pair "num-ctx" (j-num (i64->str nctx))) nil))))))))

(def binding-list->jsons (-> (List Binding) (List Json))
  (lam (bs) (case bs
    (nil nil)
    ((cons h t) (cons (binding->json h) (binding-list->jsons t))))))

(def pipeline->json (-> Pipeline Json)
  (lam (p) (case p
    ((pipeline id whn gate order eids cmb stp yd)
      (j-obj
        (cons (pair "kind"       (j-str "pipeline"))
        (cons (pair "id"         (j-str id))
        (cons (pair "when"       (j-str whn))
        (cons (pair "gate"       (j-arr (gate-list->jsons gate)))
        (cons (pair "order"      (order->json order))
        (cons (pair "expert-ids" (str-list->jarr eids))
        (cons (pair "combiner"   (j-str cmb))
        (cons (pair "stop"       (stop->json stp))
        (cons (pair "yield"      (j-str yd)) nil))))))))))))))

(def config->json (-> Config Json)
  (lam (c) (case c
    ((config id binds)
      (j-obj
        (cons (pair "kind"     (j-str "config"))
        (cons (pair "id"       (j-str id))
        (cons (pair "bindings" (j-arr (binding-list->jsons binds))) nil))))))))

; ============================================================ decode helpers
; (List Json) -> (Maybe (List Str)): fails if ANY element is not a j-str.
(def jsons->strs (-> (List Json) (Maybe (List Str)))
  (lam (js) (case js
    (nil (some nil))
    ((cons h t)
      (case (as-str h)
        (none none)
        ((some s)
          (case (jsons->strs t)
            (none none)
            ((some rest) (some (cons s rest))))))))))

; ============================================================ decoders

(def json->order (-> Json (Maybe Order))
  (lam (j) (case (as-str j)
    (none none)
    ((some s)
      (cond ((str-eq s "fan-out") (some (order-fan-out)))
            ((str-eq s "chain")   (some (order-chain)))
            ((str-eq s "branch")  (some (order-branch)))
            (else none))))))

(def json->stop (-> Json (Maybe StopPolicy))
  (lam (j) (case (obj-get j "kind")
    (none none)
    ((some kj) (case (as-str kj)
      (none none)
      ((some kind)
        (cond
          ((str-eq kind "single") (some (stop-single)))
          ((str-eq kind "capped")
            (case (obj-get j "cap")
              (none none)
              ((some cj) (case (as-int cj)
                (none none)
                ((some n) (some (stop-capped n)))))))
          ((str-eq kind "until-dry")
            (case (obj-get j "cap")
              (none none)
              ((some cj) (case (as-int cj)
                (none none)
                ((some n) (some (stop-until-dry n)))))))
          (else none))))))))

(def json->gate-rule (-> Json (Maybe GateRule))
  (lam (j)
    (case (obj-get j "condition")
      (none none)
      ((some cj) (case (as-str cj)
        (none none)
        ((some cond)
          (case (obj-get j "ids")
            (none none)
            ((some idsj) (case (as-arr idsj)
              (none none)
              ((some arr) (case (jsons->strs arr)
                (none none)
                ((some ids) (some (gate-rule cond ids))))))))))))))

(def jsons->gate-rules (-> (List Json) (Maybe (List GateRule)))
  (lam (js) (case js
    (nil (some nil))
    ((cons h t)
      (case (json->gate-rule h)
        (none none)
        ((some g)
          (case (jsons->gate-rules t)
            (none none)
            ((some rest) (some (cons g rest))))))))))

(def json->binding (-> Json (Maybe Binding))
  (lam (j)
    (case (obj-get j "slot")
      (none none)
      ((some sj) (case (as-str sj)
        (none none)
        ((some slot)
          (case (obj-get j "model")
            (none none)
            ((some mj) (case (as-str mj)
              (none none)
              ((some model)
                (case (obj-get j "num-ctx")
                  (none none)
                  ((some nj) (case (as-int nj)
                    (none none)
                    ((some n) (some (binding slot model n))))))))))))))))

(def jsons->bindings (-> (List Json) (Maybe (List Binding)))
  (lam (js) (case js
    (nil (some nil))
    ((cons h t)
      (case (json->binding h)
        (none none)
        ((some b)
          (case (jsons->bindings t)
            (none none)
            ((some rest) (some (cons b rest))))))))))

(def json->pipeline (-> Json (Maybe Pipeline))
  (lam (j)
    (case (obj-get j "id")
      (none none)
      ((some idj) (case (as-str idj)
        (none none)
        ((some id)
    (case (obj-get j "when")
      (none none)
      ((some wj) (case (as-str wj)
        (none none)
        ((some whn)
    (case (obj-get j "gate")
      (none none)
      ((some gj) (case (as-arr gj)
        (none none)
        ((some garr) (case (jsons->gate-rules garr)
          (none none)
          ((some gate)
    (case (obj-get j "order")
      (none none)
      ((some oj) (case (json->order oj)
        (none none)
        ((some order)
    (case (obj-get j "expert-ids")
      (none none)
      ((some ej) (case (as-arr ej)
        (none none)
        ((some earr) (case (jsons->strs earr)
          (none none)
          ((some eids)
    (case (obj-get j "combiner")
      (none none)
      ((some cj) (case (as-str cj)
        (none none)
        ((some cmb)
    (case (obj-get j "stop")
      (none none)
      ((some spj) (case (json->stop spj)
        (none none)
        ((some stp)
    (case (obj-get j "yield")
      (none none)
      ((some yj) (case (as-str yj)
        (none none)
        ((some yd)
          (some (pipeline id whn gate order eids cmb stp yd))
        ))))))))))))))))))))))))))))))))))))))

(def json->config (-> Json (Maybe Config))
  (lam (j)
    (case (obj-get j "id")
      (none none)
      ((some idj) (case (as-str idj)
        (none none)
        ((some id)
          (case (obj-get j "bindings")
            (none none)
            ((some bj) (case (as-arr bj)
              (none none)
              ((some barr) (case (jsons->bindings barr)
                (none none)
                ((some binds) (some (config id binds))))))))))))))
