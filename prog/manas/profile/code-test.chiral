; ==================================================== manas code-test — a FRACTAL template (T1)
; T1 of the TEMPLATE LIBRARY (MANAS-SKILL-GROWER.md L204): a hand-authored fractal skill
; (like SG3's doc-edit) that PRODUCES reasoned TESTS for a code snippet, built at the
; NARROW-LINE-OF-THOUGHT grain — one focused reasoning move per leaf (not a token, not a
; multi-part question), sized for a 0.5b. Every expert is a read-only PRODUCER of a proposed
; test / a verdict, so the whole fractal runs tiny-model-green.
;
; The shape (the fractal pair, MANAS-SKILL-GROWER L18):
;   code-test-flow = flow-branch
;     perspectivist  "reason the distinct test angles this code needs …"  -> ty-perspectives
;     in-ty          ty-doc                                               ; code arrives as text
;     per-perspective = flow-chain [                                      ; ONE sub-pipeline per angle
;        code-test-reasoner  "for THIS angle, reason what could go wrong" -> ty-text  (reasoner)
;        code-test-proposer  "propose ONE concrete test for that"         -> ty-patch (editor)
;     ]
;     backtrack = flow-chain [                                            ; collect + audit
;        flow-pure (pf-collect-angles "test")   ; CODE combiner: joined per-angle proposed tests
;                                               ; -> one {kind,target,body} per angle -> ty-findings
;        code-test-audit       "audit the suite: coverage gaps or redundant tests?" -> ty-verdict (auditor)
;     ]
; flow-ty derives the whole arrow: code-test-flow : ty-doc -> ty-verdict (the backtrack's cod).
;
; STRICTLY ADDITIVE — parallel to doc-edit.chiral; doc-edit / doc-refine / profiles / flow /
; skill are UNTOUCHED. Only new defs live here (code-test.chiral) + code-test-test.prog + a
; live sample. Every `lens` is ONE small ask (no " and " / " then " / ";" / " & ", <=160 chars,
; non-empty `sees`) so lint-expert returns nil for each — one narrow line of thought per leaf.
;
; Composes:
;   types.chiral  — Expert (+ ctor), Config, Binding (the run surface; imported, never redefined).
;   flow.chiral   — Flow ctors (flow-branch/flow-chain/flow-step) + Ty ctors (ty-doc/ty-findings/
;                  ty-patch/ty-verdict/ty-perspectives). The fractal is a VALUE built from these.

(import "prelude/prelude")               ; List, cons, nil
(import "manas/core/types")      ; Expert (expert id lens sees returns slot tools), Config, Binding
(import "manas/core/flow")       ; Flow (flow-branch/flow-chain/flow-step/flow-pure), PureFn (pf-collect-angles), Ty (ty-doc/ty-text/ty-patch/ty-findings/ty-verdict/ty-perspectives)

; ---------------------------------------------------------- the tiny-step experts
; Each (expert id lens sees returns slot tools). LENS is ONE narrow reasoning move
; (lint-clean); SEES is rich context; TOOLS is least-privilege (read only — producing a
; proposed test never writes; running it is a later effect). Ids are unique across the
; closure (prefixed "code-test-" — no collision with doc-edit's pool).

; perspectivist ⊕ : emit the test angles the branch fans over (one sub-pipeline each).
(def code-test-perspectivist Expert
  (expert "code-test-perspectivist"
    "reason the distinct test angles this code needs (happy path, boundaries, failure modes, invariants)"
    "{ code }"
    "objects, each {kind:\"angle\", body:\"<the test angle>\"}"
    "perspectivist"
    (cons "read" nil)))

; reasoner : for THE angle in hand, reason what could go wrong (a single narrow move).
; out-ty is ty-text (a free reasoning move is PROSE) — NOT ty-findings. ty-findings'
; seam validator (refine-ok) demands a JSON-ish shape ("[" or "kind"); a 0.5b's prose
; reasoning intermittently lacks it, refine-failing the seam, and the branch SILENTLY
; SWALLOWS that per-angle chain (empty-manifest, routing lost) — so the angle vanishes
; while manifest-all-green? still reads true off the composite. Typing this narrow
; reasoning ty-text (lenient non-empty, doc-edit's proven-green seam) keeps every angle.
(def code-test-reasoner Expert
  (expert "code-test-reasoner"
    "for THIS angle, reason what could go wrong"
    "{ code, angle }"
    "a short reasoning: what could break under this angle + one reason"
    "reasoner"
    (cons "read" nil)))

; editor ⊕ : propose ONE concrete test for that finding (a proposed test, not run).
(def code-test-proposer Expert
  (expert "code-test-proposer"
    "propose ONE concrete test for that"
    "{ code, angle, finding }"
    "one concrete proposed test as a patch"
    "editor"
    (cons "read" nil)))

; NOTE (DC-1b slice 4): there is no `code-test-consolidate` model combiner any more — the
; COMBINE is code (a flow-pure `pf-collect-angles` in the backtrack, below). code-test is the
; skill this fits BEST: its per-angle chain already ends in the PROPOSER, so the individuals
; the combiner receives are the proposed tests themselves — collecting them one-per-angle loses
; nothing a 0.5b merge would have added, and cannot hallucinate.

; auditor ⊕ : audit the merged suite — coverage gaps or redundant tests across the angles?
(def code-test-audit Expert
  (expert "code-test-audit"
    "audit the suite: coverage gaps or redundant tests?"
    "{ suite }"
    "verdict: gap|redundant|clean + one reason"
    "auditor"
    (cons "read" nil)))

; the pool: the 4 tiny-step experts code-test fires, in declaration order (the 5th, the
; combiner, is now code — see the note above).
(def code-test-pool (List Expert)
  (cons code-test-perspectivist
  (cons code-test-reasoner
  (cons code-test-proposer
  (cons code-test-audit nil)))))

; ---------------------------------------------------------- the fractal Flow
; per-perspective : a 2-step chain run ONCE PER angle — reason what breaks, then propose a
; test. dom = ty-doc (the angle-injected code), seam ty-text (the reasoning move is prose;
; see code-test-reasoner), cod = ty-patch. Type-checks: cod(reasoner)=ty-text == dom(proposer)=ty-text.
(def code-test-per-perspective Flow
  (flow-chain (cons (flow-step "code-test-reasoner" ty-doc   ty-text)
              (cons (flow-step "code-test-proposer" ty-text  ty-patch) nil))))

; backtrack : COLLECT the per-angle tests (code) -> audit the suite (model). dom = ty-patch
; (the joined per-angle proposed tests), seam ty-findings (one finding per angle), cod =
; ty-verdict. Type-checks: cod(collect)=ty-findings == dom(audit)=ty-findings.
(def code-test-backtrack Flow
  (flow-chain (cons (flow-pure (pf-collect-angles "test") ty-patch ty-findings)
              (cons (flow-step "code-test-audit"         ty-findings ty-verdict) nil))))

; code-test-flow : the fractal. flow-ty derives (arrow ty-doc <backtrack-cod=ty-verdict>).
(def code-test-flow Flow
  (flow-branch "code-test-perspectivist" ty-doc
    code-test-per-perspective
    code-test-backtrack))

; ---------------------------------------------------------- the tiny-model Config
; binds EVERY slot code-test-pool uses (perspectivist / reasoner / editor / auditor)
; to the 0.5b smoke tier — the whole fractal runs on the tiny model. Additive Config; the four
; shared profiles (profiles.chiral) are UNTOUCHED. Selecting THIS config IS the model choice.
(def code-test-config Config
  (config "code-test-smoke"
    (cons (binding "perspectivist" "qwen2.5:0.5b" 16384)
    (cons (binding "reasoner"      "qwen2.5:0.5b" 16384)
    (cons (binding "editor"        "qwen2.5:0.5b" 16384)
    (cons (binding "auditor"       "qwen2.5:0.5b" 16384) nil))))))
