; skills-test.prog — O3 gate for the plannable skill MENU. PURE, mesh-free, exit 0.
;
; Three proofs over plannable-skills (the (name, one-line description) menu the planner
; ranges over), all deterministic value transforms — no PTY, no network, no backend:
;   (1) COUNT — plannable-skills has EXACTLY 6 entries (DC-1a dropped the plain evidence-sift;
;       R2 added deep-research, the fractal variant for a broad ask).
;   (2) NON-EMPTY — every entry's description is a non-empty string, and plannable-desc
;       round-trips each name to a some (never a none) description.
;   (3) NO DRIFT — every plannable-skills NAME resolves via skill-by-name against all-skills
;       to a some (the consistency guard: the menu never names a skill the registry lacks).
;
; Build+run (deterministic, no mesh):
;   chirality run prog/manas/profile/skills-test.prog

(import "prelude/prelude")             ; List, Pair, pair, Maybe, some, none, Bool, and, not, case, str-eq, str-cat, do, unit, Unit
(import "manas/profile/skills")  ; plannable-skills, plannable-names, plannable-desc, all-skills, skill-by-name
(import "ports/ports")               ; put (stdout only — mesh-free)

; length of the menu.
(declare menu-len (-> (List (Pair Str Str)) I64))
(def menu-len
  (lam (ps) (case ps (nil 0) ((cons p rest) (+ 1 (menu-len rest))))))

; (2a) every entry's description is non-empty.
(declare all-desc-nonempty (-> (List (Pair Str Str)) Bool))
(def all-desc-nonempty
  (lam (ps)
    (case ps
      (nil true)
      ((cons p rest)
        (case p ((pair nm ds)
          (and (not (str-eq ds "")) (all-desc-nonempty rest))))))))

; (2b) plannable-desc round-trips each menu name to a some whose text matches the entry.
(declare all-desc-roundtrip (-> (List (Pair Str Str)) Bool))
(def all-desc-roundtrip
  (lam (ps)
    (case ps
      (nil true)
      ((cons p rest)
        (case p ((pair nm ds)
          (and (case (plannable-desc nm) (none false) ((some d) (str-eq d ds)))
               (all-desc-roundtrip rest))))))))

; (3) NO DRIFT: every menu name resolves in the registry (skill-by-name ... all-skills = some).
(declare all-resolve (-> (List (Pair Str Str)) Bool))
(def all-resolve
  (lam (ps)
    (case ps
      (nil true)
      ((cons p rest)
        (case p ((pair nm ds)
          (and (case (skill-by-name nm all-skills) (none false) ((some s) true))
               (all-resolve rest))))))))

; print each menu row (name — description).
(declare show-menu (=> (List (Pair Str Str)) Unit))
(def show-menu
  (lam (ps)
    (case ps
      (nil unit)
      ((cons p rest)
        (case p ((pair nm ds)
          (do (put (str-cat "  " (str-cat nm (str-cat "  —  " (str-cat ds "\n")))))
              (show-menu rest))))))))

(def compile-main (=> I64 I64)
  (lam (n)
    (do (put "-- O3 plannable skill menu --\n")
    (do (show-menu plannable-skills)
    (case (and (=i (menu-len plannable-skills) 6)         ; (1) exactly 5 (DC-1a)
          (and (all-desc-nonempty plannable-skills)       ; (2a) non-empty descriptions
          (and (all-desc-roundtrip plannable-skills)      ; (2b) plannable-desc round-trips
               (all-resolve plannable-skills))))          ; (3) no drift vs all-skills
      (true 0)
      (false 1))))))
