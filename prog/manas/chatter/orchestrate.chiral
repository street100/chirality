; ==================================================== manas Chatter — O1 the ORCHESTRATOR (Plan + pure planner)
; The chatter today is route-to-ONE-skill-OR-DEAD-END: route-message picks one Intent,
; intent->skill maps four intents to one skill each, and social/clarify/unknown fall to a
; hardcoded template with ZERO model, ZERO passes (turn.chiral no-skill-reply). "Hello" and a
; codebase ask both dead-end there.
;
; O1 kills the dead-end at the TYPE level, with NO model. A `Plan` is a CLOSED SUM — the
; executor (O2) cases it totally — and `plan-of-intent` maps EVERY message to a Plan. There is
; no longer a "route or dead-end" funnel: there is always a Plan. This slice is PURE, TOTAL,
; mesh-free, unit-testable; it does NOT wire into turn/execution (that is O2), calls no model,
; touches no Backend, and touches no scriba.
;
; MODULE GRAPH (critical): O2 makes turn.chiral import orchestrate.chiral (for execute-plan),
; so orchestrate MUST NOT import turn — that would be circular. The social/clarify reply
; templates are therefore defined HERE directly (their wording copied from turn.chiral's
; no-skill-reply for consistency), NOT pulled from turn. orchestrate imports prelude +
; manas/chatter/router (Intent / ConvState / resolve-intent / str-lower) + O5's parse-plan deps
; manas/core/flow (str-has) and manas/profile/skills (plannable-skills / plannable-names) — none
; of which import orchestrate, so the graph stays acyclic. The chatter closure resolves skills via
; manas/profile/skills, never manas/core/skill.
;
; Boundary-as-closed-sum (docs/pattern-boundary-sums.md): the answer SHAPE is a closed `Plan`,
; not a sentinel or a Maybe-skill — every message yields a first-class Plan value.

(import "prelude/prelude")               ; Str, List, Bool, case, str-cat, str-eq, not, some, none, Maybe
(import "manas/chatter/router")  ; Intent (+ ctors), ConvState (+ ctors), resolve-intent, str-lower
(import "manas/core/flow")       ; O5: str-has (substring test, for the lenient plan parser)
(import "manas/profile/skills")  ; O5: plannable-skills (the menu), plannable-names

; ------------------------------------------------------------------- Plan : the closed sum
; The four answer shapes the executor (O2/O4) cases TOTALLY. A Plan is a VALUE — never a
; sentinel, never a dead-end. plan-chain/plan-fan complete the sum NOW (O2/O4 add their
; executors); O1's pure planner only ever emits plan-single / plan-reply.
;   plan-single skill        — run ONE skill (== today's single-skill behavior).
;   plan-chain  [skill…]     — run skills SEQUENTIALLY, each output feeding the next (turn-seq).
;   plan-fan    [skill…] synth — run skills on the message in PARALLEL, then SYNTHESIZE one reply.
;   plan-reply  text         — the honest templated floor (social / clarify) — no skill, but a
;                              real, non-empty reply, NOT a dead-end.
(data Plan ()
  (plan-single (skill Str))
  (plan-chain  (skills (List Str)))
  (plan-fan    (skills (List Str)) (synth Str))
  (plan-reply  (text Str)))

; ------------------------------------------------------------------- reply templates (defined HERE, not imported from turn)
; Copied verbatim from turn.chiral no-skill-reply so the two paths stay consistent while the
; module graph stays acyclic (orchestrate must not import turn — see header). unknown does NOT
; get a template: per the RESOLVED author call (CHATTER-ORCHESTRATOR-SCOPE §6) it ATTEMPTS an
; answer via plan-single "research", surfacing (not refusing) the supply/retrieval limit.
(def social-reply Str
  "Hi! I route each ask to a pipeline — try 'sort these...', 'should I X or Y', 'summarize this...', or 'what is ...'.")
(def clarify-reply Str
  "Could you say a bit more? I couldn't tell what you're asking.")

; ------------------------------------------------------------------- intent->plan : the pure Intent -> Plan map
; PURE, TOTAL, exhaustive over the seven Intent ctors — NEVER a dead-end. The four skill intents
; mirror intent->skill (router.chiral) but yield a plan-single instead of a Maybe-skill; unknown
; ALSO plans research (attempt, not template); social/clarify yield a plan-reply carrying the
; honest floor text. This is factored out of plan-of-intent so the mapping is enumerable + unit-
; testable over Intent directly, independent of the router's marker vocabulary.
(def intent->plan (-> Intent Plan)
  (lam (i)
    (case i
      (in-analyze   (plan-single "evidence-sift-refined")) ; DC-1a: the REFINED (model-free, deterministic) sift — rich two-track sentence, ~0.03s
      (in-decide    (plan-single "decision"))
      (in-transform (plan-single "doc-edit"))
      (in-factual   (plan-single "research"))
      (in-unknown   (plan-single "research"))     ; RESOLVED: attempt an answer, NOT a dead-end template
      (in-social    (plan-reply social-reply))
      (in-clarify   (plan-reply clarify-reply)))))

; ------------------------------------------------------------------- plan-of-intent : message -> Plan (ConvState-aware)
; The O1 entry: resolve the Intent THROUGH conversation memory (resolve-intent — a bare follow-up
; reuses the prior turn's Intent, C6a) then map it to a Plan. Every message yields a Plan; nothing
; dead-ends. PURE, TOTAL — no model, no Backend.
(def plan-of-intent (-> ConvState Str Plan)
  (lam (cs msg) (intent->plan (resolve-intent cs msg))))

; ------------------------------------------------------------------- plan-tag : a stable display/debug tag
; A short tag for tests + a later UI (O7). PURE, TOTAL, exhaustive over the Plan sum.
(def plan-tag (-> Plan Str)
  (lam (p)
    (case p
      ((plan-single s)   (str-cat "single:" s))
      ((plan-chain ss)   "chain")
      ((plan-fan ss syn) "fan")
      ((plan-reply t)    "reply"))))

; ==================================================== O5 — parse-plan : the LENIENT model-reply parser
; The O5 model planner (turn.chiral plan-message) asks the 0.5b to name the skill(s) that handle a
; message; parse-plan turns that free-text reply into a Plan. PURE, TOTAL, mesh-free, unit-testable
; on canned strings — the deterministic committed half of O5 (the be-chat call itself is turn's).
; Mirrors parse-perspectives' LENIENCE (flow.chiral): scan the reply for menu skill NAMES present as
; substrings (case-normalized via str-lower — menu names are already lowercase), then:
;   0 names  ⇒ FALLBACK to the O1 pure planner (plan-of-intent cs message) — never a dead-end.
;   1 name   ⇒ plan-single <name>.
;   2+ names ⇒ plan-fan <names> "fuse" (independent skills, fused by O4b's synth).
; SUBSTRING SUBSUMPTION: "evidence-sift" is a substring of "evidence-sift-refined", so a reply naming
; only the refined skill would otherwise double-count. name-shadowed? drops a name when a LONGER menu
; name that CONTAINS it also appears in the reply — so "evidence-sift-refined" alone yields ONE name,
; not a spurious fan. General + total over the menu (no evidence-sift special case).

; is `nm` shadowed by a longer menu name (one that CONTAINS nm) that also appears in the reply?
(declare name-shadowed? (-> Str Str (List Str) Bool))
(def name-shadowed?
  (lam (nm reply others)
    (case others
      (nil false)
      ((cons o rest)
        (case (and (not (str-eq o nm))
              (and (str-has o nm)         ; nm is a substring of o (o is the longer, containing name)
                   (str-has reply o)))    ; and o actually appears in the reply
          (true  true)
          (false (name-shadowed? nm reply rest)))))))

; walk the menu names; keep each name present in the (lowered) reply and NOT shadowed. Preserves
; menu order, so a fan lists skills in registry order. `allnames` = the full menu (for shadow checks).
(declare plan-found-names (-> Str (List Str) (List Str) (List Str)))
(def plan-found-names
  (lam (reply names allnames)
    (case names
      (nil nil)
      ((cons nm rest)
        (case (and (str-has reply nm) (not (name-shadowed? nm reply allnames)))
          (true  (cons nm (plan-found-names reply rest allnames)))
          (false (plan-found-names reply rest allnames)))))))

; ==================================================== O6 — think-robust parse
; qwen3:4b (the O6 planner model, turn.chiral synth-model) is a THINKING model. Ollama returns
; reasoning in a SEPARATE field so be-chat's `content` is already clean, but make parse FORMAT-
; AGNOSTIC anyway: if the reply carries a `</think>` tag, scan ONLY the substring AFTER the LAST
; one (the final answer) — otherwise a reasoning block that mentions several skill names would
; trip the 2+ -> plan-fan rule. No tag -> scan the whole reply, exactly as before. PURE, TOTAL.

; last-index-go : the index of the LAST occurrence of `needle` in `hay` (advancing past each match),
; or `best` (seeded -1) when none remain. str-find-from returns a NEGATIVE index when not found.
(declare last-index-go (-> Str Str I64 I64 I64))
(def last-index-go
  (lam (hay needle from best)
    (let ((j (str-find-from hay needle from)))
      (case (<i j 0)
        (true best)
        (false (last-index-go hay needle (+ j (str-len needle)) j))))))

; after-last-think : the substring AFTER the last `</think>` (the model's final answer), or the whole
; reply when there is no such tag. str-sub is (START, END) END-EXCLUSIVE; START = last-tag-end is
; guarded (<i START len) so a tag at the very end yields "" — never an out-of-bounds read. PURE, TOTAL.
(def after-last-think (-> Str Str)
  (lam (reply)
    (let ((tag "</think>"))
      (let ((li (last-index-go reply tag 0 (- 0 1))))
        (case (<i li 0)
          (true reply)                                   ; no think block -> scan the whole reply
          (false
            (let ((start (+ li (str-len tag))))
              (case (<i start (str-len reply))
                (true  (str-sub reply start (str-len reply)))
                (false "")))))))))                        ; nothing after the tag -> empty -> fallback

; parse-plan : model-reply + ConvState + message -> Plan. 0 names -> O1 fallback; 1 -> single; 2+ -> fan.
; O6: lowercase, then keep only the text AFTER any final </think> (format-agnostic), then scan for names.
(def parse-plan (-> Str ConvState Str Plan)
  (lam (reply cs message)
    (let ((names (plannable-names plannable-skills)))
      (let ((found (plan-found-names (after-last-think (str-lower reply)) names names)))
        (case found
          (nil (plan-of-intent cs message))
          ((cons a rest)
            (case rest
              (nil            (plan-single a))
              ((cons b more)  (plan-fan found "fuse")))))))))
