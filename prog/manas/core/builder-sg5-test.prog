; builder-sg5-test.prog — SG5 PURE gate: the META recursion (specialize the tool-builder
; per PROJECT). Mesh-free. Proves the OBJECT-level specialize mechanism (SG2) composes at
; the META level — the identical `specialize-skill`, one level up, on the tool-builder (SG4).
;
; The library (the exact SG5 fixture):
;   [ skill-base "tool-builder" tool-builder-flow (stop-single),
;     skill-spec "tool-builder@chirality" "tool-builder" "PROJECT: chirality; code idiom marker PROJ-MARKER-abc" ]
; The specialization is minted by `project-builder` (= specialize-skill with base pinned to
; "tool-builder"). Assertions:
;   (1) resolve-collects — resolve-skill "tool-builder@chirality" = some, carrying the BASE
;       tool-builder-flow AND a contexts list CONTAINING the project string. The project
;       context reached the resolution => it will reach the author step's prompt (run-skill).
;   (2) missing base      — resolve-skill "tool-builder@none" (spec over an absent base) = none.
; compile-main returns 0 iff every assertion passes (exit 0).
;
; Build+run (fast — links builder's flow/skill/backend closure but never CALLS the backend;
; the transforms under test are pure, so mesh-free at runtime):
;   chirality run prog/manas/core/builder-sg5-test.prog

(import "prelude/prelude")                 ; Bool, Unit, unit, and, some, none, case, str-eq, cons, nil, pair
(import "protocol/json")                    ; json-show
(import "manas/core/types")        ; StopPolicy (stop-single)
(import "manas/core/flow")         ; Flow, flow->json  (encoding-equality on the resolved flow)
(import "manas/core/flow-persist") ; flow->json
(import "manas/core/skill")        ; Skill (skill-base, skill-spec), resolve-skill
(import "manas/core/builder")      ; tool-builder-flow, project-builder  (SG5 helper under test)

; ─── the project context string (carries the grep-able idiom marker) ──────────
(def chirality-ctx Str "PROJECT: chirality; code idiom marker PROJ-MARKER-abc")

; ─── the SG5 library: base tool-builder + a per-project specialization ────────
(def lib (List Skill)
  (cons (skill-base "tool-builder" tool-builder-flow (stop-single))
  (cons (project-builder "tool-builder@chirality" chirality-ctx) nil)))

; a spec whose base is absent (for the honest-none check).
(def lib-missing (List Skill)
  (cons (project-builder "tool-builder@none" chirality-ctx) nil))   ; base "tool-builder" NOT in this lib

; ─── helpers ──────────────────────────────────────────────────────────────────
(def flow-str (-> Flow Str) (lam (f) (json-show (flow->json f))))

(declare list-has (-> (List Str) Str Bool))
(def list-has
  (lam (xs want)
    (case xs
      (nil false)
      ((cons h t)
        (case (str-eq h want)
          (true true)
          (false (list-has t want)))))))

; ─── (1) resolve collects the base flow AND the project context ───────────────
(def resolve-collects-ok (-> Unit Bool)
  (lam (_)
    (case (resolve-skill "tool-builder@chirality" lib)
      (none false)
      ((some r)
        (case r
          ((pair fl rest)
            (case rest
              ((pair st ctxs)
                (and (str-eq (flow-str fl) (flow-str tool-builder-flow))
                     (list-has ctxs chirality-ctx))))))))))

; ─── (2) a spec over an absent base resolves to honest none ───────────────────
(def resolve-missing-ok (-> Unit Bool)
  (lam (_) (case (resolve-skill "tool-builder@none" lib-missing) (none true) ((some r) false))))

; ─── entry ────────────────────────────────────────────────────────────────────
(def compile-main (=> I64 I64)
  (lam (n)
    (case (and (resolve-collects-ok unit)
               (resolve-missing-ok unit))
      (true 0)
      (false 1))))
