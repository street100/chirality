; ==================================================== manas tool-builder + accept-gate (SG4)
; SG4 of the skill-grower (MANAS-SKILL-GROWER.md L3/L4): SAFE agent-authoring. A Flow
; whose expert EMITS a new Part (a Flow) as JSON, plus THE WALL that keeps anything an
; agent produces out of the library unless it DECODES + TYPE-CHECKS (+ ideally runs
; green). Agent output is NEVER trusted — it is decoded and typed, and only a Flow that
; survives BOTH is admitted.
;
; The deliverable that matters is `accept-gate` — the static decode->type-check wall:
;   json-parse-str  (rejects text that is not JSON)          -> none
;   json->flow      (SG1 total decoder; rejects malformed / unknown-kind / bad child) -> none
;   flow-ty         (the compositional checker; rejects a structurally-valid but
;                    ILL-TYPED Flow — arrows that don't compose)                        -> none
;   otherwise       -> (some flow)
; TOTAL: every failure path returns `none`, never a crash (each step is a Maybe fold).
;
; The DEEPER runtime gate is TINY-MODEL-GREEN (MANAS-L0-SPEC §0 / MANAS-SKILL-GROWER L4):
; once a Flow is accepted here, `run-flow-stop` it under a smoke-local (0.5b) config and
; check `manifest-all-green?` (both from flow.chiral, reused by SG3's live gate) — a step
; that needs a bigger model is under-decomposed and rejected. The STATIC decode+flow-ty
; gate is SG4's CORE (a pure value transform, unit-testable offline); tiny-model-green is
; the follow-on RUNTIME check layered on top (see the LIVE sample, which runs it).
;
; STRICTLY ADDITIVE — flow / flow-persist / skill / types are UNTOUCHED; only new defs
; live here (builder.chiral) + builder-test.prog (PURE) + a live sample.
;
; Composes:
;   json.chiral          — json-parse-str (Str -> Maybe Json).
;   flow.chiral          — Flow, flow-ty (the checker), Ty ctors (ty-doc / ty-part).
;   flow-persist.chiral  — json->flow (SG1 total decoder — reused, not reinvented).
;   types.chiral         — Expert (+ ctor), Config (+ config/binding ctors) for the author slot.

(import "prelude/prelude")                 ; Maybe, some, none, Bool, case, List, cons, nil
(import "protocol/json")                    ; json-parse-str (Str -> Maybe Json)
(import "manas/core/types")        ; Expert (expert ...), Config (config ...), Binding (binding ...)
(import "manas/core/flow")         ; Flow, flow-ty, Ty (ty-doc, ty-part)
(import "manas/core/flow-persist") ; json->flow  (the SG1 total decoder — reused, not reinvented)
(import "manas/core/skill")        ; Skill, specialize-skill  (SG2 — the reuse engine, applied one level UP for SG5)

; ------------------------------------------------------------------- accept-gate : THE WALL
; The safety core. Agent output (a produced text) is admitted to the library ONLY if it
; decodes to a Flow AND that Flow type-checks. Any failure => `none` (rejected). TOTAL —
; three nested Maybe folds, every branch closed, no partial pattern, no crash path.
(def accept-gate (-> Str (Maybe Flow))
  (lam (produced)
    (case (json-parse-str produced)            ; (1) not JSON at all -> reject
      (none none)
      ((some j)
        (case (json->flow j)                   ; (2) malformed / unknown-kind / bad child -> reject
          (none none)
          ((some f)
            (case (flow-ty f)                  ; (3) structurally valid but ILL-TYPED -> reject
              (none none)
              ((some ar) (some f)))))))))       ; decoded AND typed -> ADMIT

; ------------------------------------------------------------------- the author slot (tiny step)
; tool-builder-author ⊕ : the single tiny-step expert that EMITS a Flow (a new Part) as
; JSON for the requested skill. lens is ONE small ask (lint-clean: no " and " / " then " /
; ";" / " & ", <=160 chars); sees is non-empty; tools least-privilege (read only — emitting
; a Flow never writes; admitting it to the library is the gated step, done by accept-gate).
; id prefixed "tool-builder-" (no collision with flow / skill / doc-edit expert ids).
(def tool-builder-author Expert
  (expert "tool-builder-author"
    "emit a Flow JSON for the requested skill"
    "{ request }"
    "one Flow as JSON keyed by kind: step|gate|fan|chain|branch"
    "author"
    (cons "read" nil)))

; the pool the builder fires (one tiny step).
(def tool-builder-pool (List Expert)
  (cons tool-builder-author nil))

; ------------------------------------------------------------------- tool-builder-flow : the author Flow
; A minimal author-slot Flow: one tiny step that reads the request (ty-doc) and produces a
; Part (ty-part). flow-ty tool-builder-flow = some (arrow ty-doc ty-part). The emitted text
; is what accept-gate then decodes + type-checks before it may enter the library.
(def tool-builder-flow Flow
  (flow-step "tool-builder-author" ty-doc ty-part))

; ------------------------------------------------------------------- tool-builder-config : the tiny model
; binds the `author` slot to the 0.5b smoke tier — the builder runs on the tiny model.
; Additive Config; selecting THIS config IS the model choice for the builder.
(def tool-builder-config Config
  (config "tool-builder-smoke"
    (cons (binding "author" "qwen2.5:0.5b" 16384) nil)))

; ------------------------------------------------------------------- project-builder : the META recursion (SG5)
; The whole vision's hinge: the SAME `specialize-skill` operation (SG2) that narrowed the
; OBJECT-level doc-edit per doc-context (SG3), applied to the tool-builder (SG4) itself —
; one level UP. `project-builder new-name project-context` mints a per-PROJECT specialization
; of the base "tool-builder" skill; `run-skill` then injects `project-context` (the project's
; language / code idioms) into the author step's prompt via the `extra` channel — identical
; to the object-level path, no new mechanism. The base "tool-builder" must be present in the
; library as (skill-base "tool-builder" tool-builder-flow <stop>). This is a THIN convenience
; over specialize-skill with the base name pinned to "tool-builder"; the mechanism IS SG2.
(def project-builder (-> Str Str Skill)
  (lam (new-name project-context)
    (specialize-skill "tool-builder" new-name project-context)))
