; flow-persist.chiral — a PURE, TOTAL, RECURSIVE JSON codec for Flow (+ Ty, Arrow).
;
; SG1 of the skill-grower (MANAS-SKILL-GROWER.md): value <-> JSON so a skill (a
; persisted Flow fractal) can be saved, loaded, duplicated and specialized, and so
; scriba can load + render one (SG6). It EXTENDS P1's Pipeline/Config codec
; (manas/pipeline/persist.chiral) over the RECURSIVE Flow tree — same shape (a total
; encoder + a total decoder whose round-trip is a string-level fixpoint), now with
; the encoder/decoder RECURSING on Flow children (flow-chain/flow-fan/flow-branch).
;
; NO file I/O, NO scriba, NO mesh here — just the codec + its round-trip unit test
; (flow-persist-test.prog). STRICTLY ADDITIVE: flow.chiral and persist.chiral are
; UNTOUCHED; only new defs live here.
;
; Composes:
;   json.chiral     — Json tree + json-show/json-parse-str + obj-get/as-str/as-arr.
;   persist.chiral  — gate-list->jsons / jsons->gate-rules (GateRule codec, reused —
;                    NOT re-implemented) + the total-decoder idiom this mirrors.
;   flow.chiral     — Ty, Arrow, Flow (+ ctors) + ty-name (the Ty->tag-string map).
;
; TOTALITY is the deliverable: every decoder is (-> Json (Maybe _)) and returns an
; honest `none` on ANY malformed input — a missing key, a wrong Json variant, an
; unknown tag, OR a child that fails to decode (fail-if-any, like P1's jsons->strs).
; No partial patterns, no silent defaults (the boundary-as-closed-sum discipline).
;
; JSON schema (SG2 duplicate/specialize + SG6 scriba-load MUST match this):
;   Ty     -> "ty-doc"|"ty-span"|"ty-findings"|"ty-patch"|"ty-verdict"
;           | "ty-perspectives"|"ty-part"|"ty-text"                 (a bare JSON string)
;   Arrow  -> {"dom":<ty>,"cod":<ty>}
;   Flow   -> one of, keyed by "kind":
;     step   -> {"kind":"step","expert-id":Str,"in-ty":<ty>,"out-ty":<ty>}
;     pure   -> {"kind":"pure","fn":<purefn>,"in-ty":<ty>,"out-ty":<ty>}
;              <purefn> -> {"fn":"has-any","needles":[Str],"yes":Str,"no":Str}
;                        | {"fn":"all-present","needles":[Str],"yes":Str,"no":Str}
;                        | {"fn":"tally","needle-a":Str,"needle-b":Str,"label-a":Str,"label-b":Str}
;                        | {"fn":"line-after","marker":Str}
;     gate   -> {"kind":"gate","rules":[<gate-rule>],"combiner":Str,
;               "in-ty":<ty>,"out-ty":<ty>}
;     fan    -> {"kind":"fan","steps":[<flow>],"combiner":Str,"out-ty":<ty>}
;     chain  -> {"kind":"chain","steps":[<flow>]}
;     branch-pure -> {"kind":"branch-pure","splitter":<purefn>,"in-ty":<ty>,
;                    "per-perspective":<flow>,"backtrack":<flow>}
;     branch -> {"kind":"branch","perspectivist":Str,"in-ty":<ty>,
;               "per-perspective":<flow>,"backtrack":<flow>}
;   <gate-rule> -> {"condition":Str,"ids":[Str]}   (P1's shape, reused verbatim)

(import "prelude/prelude")               ; Bool, Str, List, Maybe, Pair, pair, cons, nil, some, none, str-eq, cond, case
(import "protocol/json")                  ; Json (+ ctors j-str/j-obj/j-arr), json-show, json-parse-str, obj-get, as-str, as-arr
(import "manas/core/types")      ; GateRule (+ gate-rule ctor)
(import "manas/core/flow")       ; Ty (+ the 8 named Tys), Arrow (+ arrow ctor), Flow (+ 5 ctors), ty-name
(import "manas/pipeline/persist"); gate-list->jsons, jsons->gate-rules  (GateRule codec — reused, not reinvented)

; ============================================================ Ty codec
; encode: the Ty's canonical tag string (ty-name is flow.chiral's own Ty->Str map).
(def ty->json (-> Ty Json)
  (lam (t) (j-str (ty-name t))))

; decode: tag string -> variant; unknown tag -> none (never a silent default).
(def json->ty (-> Json (Maybe Ty))
  (lam (j)
    (case (as-str j)
      (none none)
      ((some s)
        (cond
          ((str-eq s "ty-doc")          (some ty-doc))
          ((str-eq s "ty-span")         (some ty-span))
          ((str-eq s "ty-findings")     (some ty-findings))
          ((str-eq s "ty-patch")        (some ty-patch))
          ((str-eq s "ty-verdict")      (some ty-verdict))
          ((str-eq s "ty-perspectives") (some ty-perspectives))
          ((str-eq s "ty-part")         (some ty-part))
          ((str-eq s "ty-text")         (some ty-text))
          (else none))))))

; ============================================================ Arrow codec
(def arrow->json (-> Arrow Json)
  (lam (a)
    (case a
      ((arrow d c)
        (j-obj (cons (pair "dom" (ty->json d))
                (cons (pair "cod" (ty->json c)) nil)))))))

(def json->arrow (-> Json (Maybe Arrow))
  (lam (j)
    (case (obj-get j "dom")
      (none none)
      ((some dj) (case (json->ty dj)
        (none none)
        ((some d)
          (case (obj-get j "cod")
            (none none)
            ((some cj) (case (json->ty cj)
              (none none)
              ((some c) (some (arrow d c))))))))))))

; ============================================================ PureFn codec (a flow-pure's transform)
; A closed sum, keyed by "fn". pf-has-any carries a Str list (needles) + two verdict tags.
(declare pf-strs->jsons (-> (List Str) (List Json)))
(def pf-strs->jsons
  (lam (ss) (case ss (nil nil) ((cons h t) (cons (j-str h) (pf-strs->jsons t))))))
(declare pf-jsons->strs (-> (List Json) (Maybe (List Str))))   ; fail-if-any (total)
(def pf-jsons->strs
  (lam (js)
    (case js
      (nil (some nil))
      ((cons h t)
        (case (as-str h)
          (none none)
          ((some s) (case (pf-jsons->strs t) (none none) ((some rest) (some (cons s rest))))))))))

(def purefn->json (-> PureFn Json)
  (lam (p)
    (case p
      ((pf-has-any needles yk nk)
        (j-obj (cons (pair "fn"      (j-str "has-any"))
                (cons (pair "needles" (j-arr (pf-strs->jsons needles)))
                (cons (pair "yes"     (j-str yk))
                (cons (pair "no"      (j-str nk)) nil))))))
      ((pf-all-present needles yk nk)
        (j-obj (cons (pair "fn"      (j-str "all-present"))
                (cons (pair "needles" (j-arr (pf-strs->jsons needles)))
                (cons (pair "yes"     (j-str yk))
                (cons (pair "no"      (j-str nk)) nil))))))
      ((pf-line-after marker)
        (j-obj (cons (pair "fn"     (j-str "line-after"))
                (cons (pair "marker" (j-str marker)) nil))))
      ((pf-split-numbered)
        (j-obj (cons (pair "fn" (j-str "split-numbered")) nil)))
      ((pf-collect-angles kind)
        (j-obj (cons (pair "fn"   (j-str "collect-angles"))
                (cons (pair "kind" (j-str kind)) nil))))
      ((pf-tally na nb la lb)
        (j-obj (cons (pair "fn"      (j-str "tally"))
                (cons (pair "needle-a" (j-str na))
                (cons (pair "needle-b" (j-str nb))
                (cons (pair "label-a"  (j-str la))
                (cons (pair "label-b"  (j-str lb)) nil))))))))))

; the shared {needles, yes, no} triple -> (needles, (yes, no)); both has-any / all-present use it.
(def decode-nyn (-> Json (Maybe (Pair (List Str) (Pair Str Str))))
  (lam (j)
    (case (obj-get j "needles")
      (none none)
      ((some nj) (case (as-arr nj)
        (none none)
        ((some narr) (case (pf-jsons->strs narr)
          (none none)
          ((some needles)
            (case (obj-get j "yes")
              (none none)
              ((some yj) (case (as-str yj)
                (none none)
                ((some yk)
                  (case (obj-get j "no")
                    (none none)
                    ((some nkj) (case (as-str nkj)
                      (none none)
                      ((some nk) (some (pair needles (pair yk nk)))))))))))))))))))

(def decode-tally (-> Json (Maybe PureFn))
  (lam (j)
    (case (obj-get j "needle-a") (none none) ((some aj) (case (as-str aj) (none none) ((some na)
    (case (obj-get j "needle-b") (none none) ((some bj) (case (as-str bj) (none none) ((some nb)
    (case (obj-get j "label-a")  (none none) ((some cj) (case (as-str cj) (none none) ((some la)
    (case (obj-get j "label-b")  (none none) ((some dj) (case (as-str dj) (none none) ((some lb)
      (some (pf-tally na nb la lb))))))))))))))))))))

(def json->purefn (-> Json (Maybe PureFn))
  (lam (j)
    (case (obj-get j "fn")
      (none none)
      ((some fj) (case (as-str fj)
        (none none)
        ((some fn)
          (cond
            ((str-eq fn "has-any")
              (case (decode-nyn j) (none none)
                ((some p) (case p ((pair ns yn) (case yn ((pair yk nk) (some (pf-has-any ns yk nk)))))))))
            ((str-eq fn "all-present")
              (case (decode-nyn j) (none none)
                ((some p) (case p ((pair ns yn) (case yn ((pair yk nk) (some (pf-all-present ns yk nk)))))))))
            ((str-eq fn "tally") (decode-tally j))
            ((str-eq fn "line-after")
              (case (obj-get j "marker") (none none)
                ((some mj) (case (as-str mj) (none none) ((some marker) (some (pf-line-after marker)))))))
            ((str-eq fn "split-numbered") (some (pf-split-numbered)))
            ((str-eq fn "collect-angles")
              (case (obj-get j "kind") (none none)
                ((some kj) (case (as-str kj) (none none) ((some kind) (some (pf-collect-angles kind)))))))
            (else none))))))))

; ============================================================ Flow encoder (recursive)
; flow->json recurses on Flow children (chain/fan steps, branch's per-perspective +
; backtrack) via flows->jsons — mutually recursive, so forward-declare the list pair.
(declare flows->jsons (-> (List Flow) (List Json)))

(def flow->json (-> Flow Json)
  (lam (f)
    (case f
      ((flow-step eid ity oty)
        (j-obj (cons (pair "kind"      (j-str "step"))
                (cons (pair "expert-id" (j-str eid))
                (cons (pair "in-ty"     (ty->json ity))
                (cons (pair "out-ty"    (ty->json oty)) nil))))))
      ((flow-gate rls cmb ity oty)
        (j-obj (cons (pair "kind"     (j-str "gate"))
                (cons (pair "rules"    (j-arr (gate-list->jsons rls)))
                (cons (pair "combiner" (j-str cmb))
                (cons (pair "in-ty"    (ty->json ity))
                (cons (pair "out-ty"   (ty->json oty)) nil)))))))
      ((flow-fan steps cmb oty)
        (j-obj (cons (pair "kind"     (j-str "fan"))
                (cons (pair "steps"    (j-arr (flows->jsons steps)))
                (cons (pair "combiner" (j-str cmb))
                (cons (pair "out-ty"   (ty->json oty)) nil))))))
      ((flow-pure fn ity oty)
        (j-obj (cons (pair "kind"   (j-str "pure"))
                (cons (pair "fn"     (purefn->json fn))
                (cons (pair "in-ty"  (ty->json ity))
                (cons (pair "out-ty" (ty->json oty)) nil))))))
      ((flow-chain steps)
        (j-obj (cons (pair "kind"  (j-str "chain"))
                (cons (pair "steps" (j-arr (flows->jsons steps))) nil))))
      ((flow-branch p a pp bt)
        (j-obj (cons (pair "kind"           (j-str "branch"))
                (cons (pair "perspectivist"  (j-str p))
                (cons (pair "in-ty"          (ty->json a))
                (cons (pair "per-perspective" (flow->json pp))
                (cons (pair "backtrack"      (flow->json bt)) nil)))))))
      ((flow-branch-pure sp a pp bt)
        (j-obj (cons (pair "kind"           (j-str "branch-pure"))
                (cons (pair "splitter"       (purefn->json sp))
                (cons (pair "in-ty"          (ty->json a))
                (cons (pair "per-perspective" (flow->json pp))
                (cons (pair "backtrack"      (flow->json bt)) nil))))))))))

(def flows->jsons
  (lam (fs)
    (case fs
      (nil nil)
      ((cons h t) (cons (flow->json h) (flows->jsons t))))))

; ============================================================ Flow decoder (recursive, TOTAL)
; json->flow reads "kind" and dispatches; the composite kinds RECURSE on children via
; json->flow / jsons->flows (fail-if-any). Any missing key / wrong variant / unknown
; kind / child-decode-none => none. Mutually recursive — forward-declare both, plus the
; per-kind decoders reference json->flow before its definition.
(declare json->flow (-> Json (Maybe Flow)))
(declare jsons->flows (-> (List Json) (Maybe (List Flow))))

(def decode-step (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "expert-id")
      (none none)
      ((some ej) (case (as-str ej)
        (none none)
        ((some eid)
          (case (obj-get j "in-ty")
            (none none)
            ((some ij) (case (json->ty ij)
              (none none)
              ((some ity)
                (case (obj-get j "out-ty")
                  (none none)
                  ((some oj) (case (json->ty oj)
                    (none none)
                    ((some oty) (some (flow-step eid ity oty))))))))))))))))

(def decode-gate (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "rules")
      (none none)
      ((some rj) (case (as-arr rj)
        (none none)
        ((some rarr) (case (jsons->gate-rules rarr)
          (none none)
          ((some rules)
            (case (obj-get j "combiner")
              (none none)
              ((some cj) (case (as-str cj)
                (none none)
                ((some cmb)
                  (case (obj-get j "in-ty")
                    (none none)
                    ((some ij) (case (json->ty ij)
                      (none none)
                      ((some ity)
                        (case (obj-get j "out-ty")
                          (none none)
                          ((some oj) (case (json->ty oj)
                            (none none)
                            ((some oty) (some (flow-gate rules cmb ity oty))))))))))))))))))))))

(def decode-fan (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "steps")
      (none none)
      ((some sj) (case (as-arr sj)
        (none none)
        ((some sarr) (case (jsons->flows sarr)
          (none none)
          ((some steps)
            (case (obj-get j "combiner")
              (none none)
              ((some cj) (case (as-str cj)
                (none none)
                ((some cmb)
                  (case (obj-get j "out-ty")
                    (none none)
                    ((some oj) (case (json->ty oj)
                      (none none)
                      ((some oty) (some (flow-fan steps cmb oty))))))))))))))))))

(def decode-pure (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "fn")
      (none none)
      ((some fj) (case (json->purefn fj)
        (none none)
        ((some fn)
          (case (obj-get j "in-ty")
            (none none)
            ((some ij) (case (json->ty ij)
              (none none)
              ((some ity)
                (case (obj-get j "out-ty")
                  (none none)
                  ((some oj) (case (json->ty oj)
                    (none none)
                    ((some oty) (some (flow-pure fn ity oty))))))))))))))))

(def decode-chain (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "steps")
      (none none)
      ((some sj) (case (as-arr sj)
        (none none)
        ((some sarr) (case (jsons->flows sarr)
          (none none)
          ((some steps) (some (flow-chain steps))))))))))

(def decode-branch-pure (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "splitter")
      (none none)
      ((some sj) (case (json->purefn sj)
        (none none)
        ((some sp)
          (case (obj-get j "in-ty")
            (none none)
            ((some ij) (case (json->ty ij)
              (none none)
              ((some a)
                (case (obj-get j "per-perspective")
                  (none none)
                  ((some ppj) (case (json->flow ppj)
                    (none none)
                    ((some pp)
                      (case (obj-get j "backtrack")
                        (none none)
                        ((some btj) (case (json->flow btj)
                          (none none)
                          ((some bt) (some (flow-branch-pure sp a pp bt))))))))))))))))))))

(def decode-branch (-> Json (Maybe Flow))
  (lam (j)
    (case (obj-get j "perspectivist")
      (none none)
      ((some pj) (case (as-str pj)
        (none none)
        ((some p)
          (case (obj-get j "in-ty")
            (none none)
            ((some ij) (case (json->ty ij)
              (none none)
              ((some a)
                (case (obj-get j "per-perspective")
                  (none none)
                  ((some ppj) (case (json->flow ppj)
                    (none none)
                    ((some pp)
                      (case (obj-get j "backtrack")
                        (none none)
                        ((some btj) (case (json->flow btj)
                          (none none)
                          ((some bt) (some (flow-branch p a pp bt))))))))))))))))))))

(def jsons->flows
  (lam (js)
    (case js
      (nil (some nil))
      ((cons h t)
        (case (json->flow h)
          (none none)
          ((some f)
            (case (jsons->flows t)
              (none none)
              ((some rest) (some (cons f rest))))))))))

(def json->flow
  (lam (j)
    (case (obj-get j "kind")
      (none none)
      ((some kj) (case (as-str kj)
        (none none)
        ((some kind)
          (cond
            ((str-eq kind "step")   (decode-step j))
            ((str-eq kind "pure")   (decode-pure j))
            ((str-eq kind "gate")   (decode-gate j))
            ((str-eq kind "fan")    (decode-fan j))
            ((str-eq kind "chain")  (decode-chain j))
            ((str-eq kind "branch") (decode-branch j))
            ((str-eq kind "branch-pure") (decode-branch-pure j))
            (else none))))))))
