; flow-test.prog — PURE (mesh-free) unit gate for the flow-ty type-checker.
;
; Proves the composability guarantee (MANAS-L0-SPEC §0.5/§7.1a) offline — no PTY,
; no network, no fork. flow-ty is PURE, so every case is decided on hand-built Flow
; values with zero backend linkage exercised. compile-main returns 0 iff every
; assertion passes (exit 0):
;   1. flow-ty (pipeline->flow doc-refine-pipeline) = some(arrow ty-doc ty-doc)
;   2. a well-typed flow-chain type-checks: some(arrow ty-doc ty-doc)
;   3. an ill-typed flow-chain (cod != next dom) -> none
;   4. a flow-fan with mismatched child doms -> none
;   5. refine (the typed seam) — ty-doc non-empty=true / empty=false; ty-findings
;      a JSON-array/"kind" shape=true / a bare word=false (slice 2, MANAS-L0-SPEC §7.2)
;   6. the tiny-step discipline (slice 5, MANAS-L0-SPEC §4/§0) — lint-expert on a
;      BIG-question expert (conjunction + >160 chars + empty sees) flags all three,
;      on a tiny well-formed expert flags nothing; manifest-all-green? = true on an
;      all-parsed-ok manifest + FALSE on a zero-call one (nothing ran; Audit F1), false on a call with parsed-ok=false,
;      and false on a flow-refine-fail-routed manifest (the typed-seam rejection).
;      lint-pool over doc-refine's real expert-pool is PRINTED (advisory baseline).
;
; Build+run (fast — links backend but never CALLS it, so mesh-free at runtime; ports
; is linked for `put` — stdout only, still mesh-free):
;   chirality run prog/prapanca/core/flow-test.prog

(import "prelude/prelude")                 ; Bool, and, some, none, case, unit, Unit, str-cat, do
(import "prapanca/pipeline/runner")   ; ret-json-findings (the one JSON ask, asserted un-drifted)
(import "prapanca/core/flow")         ; Ty, Arrow, Flow, flow-ty, pipeline->flow, refine (+ ctors), ty-return-instruction, stop-continue?, lint-expert, lint-pool, manifest-all-green?, calls-manifest
(import "prapanca/core/types")        ; StopPolicy, Expert, ExpertCall, RunManifest (+ ctors)
(import "prapanca/profile/doc-refine"); doc-refine-pipeline, coverage-vs-spec, expert-pool
(import "ports/ports")                   ; put  (advisory-baseline print; stdout only)

; ─── (Maybe Arrow) expectation helpers ──────────────────────────────────────
; is-arrow: the (Maybe Arrow) is some(arrow d c) with both ends ty-eq. is-none:
; the checker REJECTED (an ill-typed composition must be `none`, never a default).
(def is-arrow (-> (Maybe Arrow) Ty Ty Bool)
  (lam (m d c)
    (case m
      (none false)
      ((some a) (and (ty-eq (arrow-dom a) d) (ty-eq (arrow-cod a) c))))))

(def is-none (-> (Maybe Arrow) Bool)
  (lam (m) (case m (none true) ((some a) false))))

; ─── the four Flow fixtures ─────────────────────────────────────────────────
; well-typed chain: doc -> findings -> doc  (seams compatible)
(def good-chain Flow
  (flow-chain (cons (flow-step "a" ty-doc ty-findings)
              (cons (flow-step "b" ty-findings ty-doc) nil))))

; ill-typed chain: doc -> findings , then patch -> doc  (findings != patch at the seam)
(def bad-chain Flow
  (flow-chain (cons (flow-step "a" ty-doc ty-findings)
              (cons (flow-step "b" ty-patch ty-doc) nil))))

; fan with mismatched child doms: one takes doc, the other takes span
(def bad-fan Flow
  (flow-fan (cons (flow-step "a" ty-doc ty-findings)
            (cons (flow-step "b" ty-span ty-findings) nil))
            "curate-merge" ty-doc))

; ─── parse-perspectives fixtures (slice 3, MANAS-L0-SPEC §1/§7.3) ────────────
; count perspectives in a parsed list (structural recursion — map-list may not
; lower in an isolated leaf blob, so a hand fold; mirrors the sample's rawlen).
(declare persp-count (-> (List Perspective) I64))
(def persp-count (lam (ps) (case ps (nil 0) ((cons h t) (+ 1 (persp-count t))))))

; ─── slice 5 fixtures: the tiny-step lint + the acceptance gate ──────────────
; a BIG-question expert: lens CONJOINS asks (" and "), is >160 chars, and its sees
; is EMPTY — so lint-expert must flag ALL THREE (lens-conjunction, lens-too-long,
; sees-empty). The lens is deliberately one over-scoped run-on question.
(def big-expert Expert
  (expert "big-question"
    "does each cited symbol exist in its named source and does every path resolve and does the spec cover every requirement and are all examples complete and are all sibling documents consistent everywhere"
    ""                                            ; sees empty -> no context on all sides
    "everything" "reasoner" nil))

; a str-list membership + length (hand folds — a leaf blob may not lower map/any).
(declare str-list-len (-> (List Str) I64))
(def str-list-len (lam (xs) (case xs (nil 0) ((cons h t) (+ 1 (str-list-len t))))))
(declare str-list-has (-> (List Str) Str Bool))
(def str-list-has
  (lam (xs s) (case xs (nil false)
    ((cons h t) (case (str-eq h s) (true true) (false (str-list-has t s)))))))

; hand-built RunManifests for the acceptance gate (built via flow.chiral's calls-
; manifest — routing is its 2nd arg). green/red ExpertCalls differ only in parsed-ok.
(def green-call ExpertCall (expert-call "a" "reasoner" "m" 0 "" "" true  true 0))
(def red-call   ExpertCall (expert-call "b" "reasoner" "m" 0 "" "" false true 0))
(def all-green-manifest RunManifest
  (calls-manifest "req" "flow-fan" (cons green-call (cons green-call nil)) "y"))
(def has-red-manifest RunManifest
  (calls-manifest "req" "flow-fan" (cons green-call (cons red-call nil)) "y"))
(def refine-fail-manifest RunManifest
  (calls-manifest "req" "flow-refine-fail:ty-findings" nil ""))   ; typed-seam rejection
(def empty-zero-call-manifest RunManifest
  (calls-manifest "req" "flow-step" nil ""))     ; zero calls, success routing: nothing ran -> NON-green
                                                 ; (Audit F1: this used to read green, the gate hole)

; ─── branch-drop propagation fixtures (the silent-swallow fix, MANAS-L0-SPEC §0) ──
; A CLEAN per-perspective sub-run fires >=1 call; a DROPPED one returns an empty
; manifest (zero calls) with an error-marked routing. perspective-failed? detects
; both signals; flow-branch's composite routing goes HONEST on a drop so the EXISTING
; manifest-all-green? already reads false — the dropped angle is never swallowed.
(def has-call-clean-manifest RunManifest
  (calls-manifest "req" "flow-step" (cons green-call nil) "y"))       ; clean sub-run: >=1 call
(def no-expert-manifest RunManifest
  (calls-manifest "req" "flow-step-no-expert" nil ""))               ; drop: zero calls + error routing
(def err-routed-with-call RunManifest
  (calls-manifest "req" "flow-step-no-expert" (cons green-call nil) "y")) ; drop by routing marker (has a call)
; the composite a flow-branch emits: DROPPED (routing honest, calls still all-green)
; vs CLEAN — proving the tag alone flips the gate, and a clean branch stays green.
(def branch-drop-composite RunManifest
  (calls-manifest "req" "flow-refine-fail:branch-drop" (cons green-call (cons green-call nil)) "y"))
(def branch-clean-composite RunManifest
  (calls-manifest "req" "flow-branch" (cons green-call (cons green-call nil)) "y"))

; advisory baseline: print the doc-refine pool's lint flags (flags are OK here — the
; shipped experts predate the discipline; this is INFORMATIONAL, never a gate).
(def join-flags (-> (List Str) Str)
  (lam (fs)
    (case fs
      (nil "(clean)")
      ((cons f rest)
        (case rest
          (nil f)
          ((cons g gs) (str-cat f (str-cat ", " (join-flags rest)))))))))
(declare print-pool-flags (=> (List (Pair Str (List Str))) Unit))
(def print-pool-flags
  (lam (rows)
    (case rows
      (nil unit)
      ((cons r rest)
        (case r
          ((pair id flags)
            (do (put (str-cat "  " (str-cat id (str-cat ": " (str-cat (join-flags flags) "\n")))))
                (print-pool-flags rest))))))))

; ─── entry: 0 iff every assertion holds (prints the advisory baseline first) ──
; ─── R3 : the MODEL fan's cap ────────────────────────────────────────────────────
; `take-perspectives` bounds how many sub-runs a model perspectivist can buy. Measured: an
; expander whose lens asked for "3-5" returned 18, and each one drives a whole sub-flow. The cap
; belongs to the MODEL branch only — a pure splitter's count comes from the user's data, where
; dropping the 7th item would be a correctness bug, not a saving.
(declare persp-take-len (-> (List Perspective) I64))
(def persp-take-len (lam (ps) (case ps (nil 0) ((cons h t) (+ 1 (persp-take-len t))))))
(def big-list Str "q one\nq two\nq three\nq four\nq five\nq six\nq seven\nq eight\nq nine\nq ten")

(def cap-ok (-> Unit Bool)
  (lam (_)
    (and (=i (persp-count (parse-perspectives big-list)) 10)             ; the parser keeps them all ...
    (and (=i (persp-take-len (take-perspectives (parse-perspectives big-list) max-model-perspectives)) 6)
    (and (=i (persp-take-len (take-perspectives (parse-perspectives "only one") max-model-perspectives)) 1)
         (=i (persp-take-len (take-perspectives nil max-model-perspectives)) 0))))))  ; ... the CAP bounds the fan

; ─── DC-4a : the fractal child's SLICE of its parent's grant ─────────────────────
; `attenuate` is what a per-perspective sub-run is granted. Declaring nothing inherits (the
; pre-DC-4a behavior, so nothing live narrows by surprise); declaring keys grants EXACTLY those —
; a strict subset, with the undeclared keys GONE, not merely unmentioned.
(def parent-grant (List (Pair Str Str))
  (cons (pair "prior-message" "the whole conversation")
  (cons (pair "chunk_data" "lane A's private payload")
  (cons (pair "prior_analyze" "lane A's typed result") nil))))

(declare grant-len (-> (List (Pair Str Str)) I64))
(def grant-len (lam (g) (case g (nil 0) ((cons h t) (+ 1 (grant-len t))))))
(declare grant-has-key (-> (List (Pair Str Str)) Str Bool))
(def grant-has-key
  (lam (g k)
    (case g
      (nil false)
      ((cons pr rest) (case pr ((pair kk vv) (case (str-eq kk k) (true true) (false (grant-has-key rest k)))))))))

(def attenuate-ok (-> Unit Bool)
  (lam (_)
    (and (=i (grant-len (attenuate nil parent-grant)) 3)              ; declared nothing -> inherit
    (and (=i (grant-len (attenuate (cons "prior_analyze" nil) parent-grant)) 1)   ; declared one -> ONE
    (and (grant-has-key (attenuate (cons "prior_analyze" nil) parent-grant) "prior_analyze")
    (and (not (grant-has-key (attenuate (cons "prior_analyze" nil) parent-grant) "chunk_data"))
    (and (not (grant-has-key (attenuate (cons "prior_analyze" nil) parent-grant) "prior-message"))
    (and (=i (grant-len (attenuate (cons "nope" nil) parent-grant)) 0)  ; declared an absent key -> nothing
         ; and the `sees` declaration is now REACHABLE from a perspectivist's JSON reply
         (=i (persp-count (parse-perspectives "[{\"body\":\"check security\",\"sees\":[\"prior_analyze\"]}]")) 1)))))))))

(def sees-parsed-ok (-> Unit Bool)
  (lam (_)
    (case (parse-perspectives "[{\"body\":\"check security\",\"sees\":[\"prior_analyze\",\"chunk_data\"]}]")
      (nil false)
      ((cons p rest)
        (and (=i (grant-len (attenuate (persp-sees p) parent-grant)) 2)   ; the declared two, only
        (and (grant-has-key (attenuate (persp-sees p) parent-grant) "chunk_data")
             (not (grant-has-key (attenuate (persp-sees p) parent-grant) "prior-message"))))))))

; ─── run-pure / pf-collect-angles : the CODE combiner (DC-1b slice 3) ────────────
; The branch's joined per-angle individuals -> one {kind,target,body} finding per angle, in
; branch order, JSON-escaped. Deterministic, so asserted BYTE-EXACT (no model in this path).
(def collect-angles-ok (-> Unit Bool)
  (lam (_)
    (let ((ca2 (pure-collect-angles "angle" "alpha one\n\n---\n\nbeta two")))
      (and (str-eq ca2 "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"alpha one\"},{\"kind\":\"angle\",\"target\":\"angle-2\",\"body\":\"beta two\"}]")
      (and (str-eq (pure-collect-angles "angle" "only one")     ; rule absent -> ONE angle
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"only one\"}]")
      (and (str-eq (pure-collect-angles "angle" "") "")          ; nothing to collect -> "" (seam refine-FAILS)
      (and (str-eq (pure-collect-angles "angle" "   ") "")       ; whitespace-only -> nothing, not a blank angle
      (and (str-eq (pure-collect-angles "angle" "first a\n\n---\n\n   \n\n---\n\nthen b")   ; blank chunk DROPPED and
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"first a\"},{\"kind\":\"angle\",\"target\":\"angle-2\",\"body\":\"then b\"}]") ; numbering stays contiguous
      (and (str-has (pure-collect-angles "angle" "he said \"hi\"") "\\\"hi\\\"")  ; MODEL PROSE is JSON-escaped
      ; a per-angle yield is usually a FENCED JSON array (the runner forces every leaf into JSON);
      ; unwrap-chunk takes the body text, so the collected finding is PROSE, not a nested blob.
      (and (str-eq (pure-collect-angles "angle" "```json\n[{\"kind\":\"note\",\"target\":\"t\",\"body\":\"it holds\"}]\n```")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"it holds\"}]")
      (and (str-eq (pure-collect-angles "angle" "plain prose\n\n---\n\n[{\"body\":\"parsed out\"}]")  ; mixed: verbatim + unwrapped
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"plain prose\"},{\"kind\":\"angle\",\"target\":\"angle-2\",\"body\":\"parsed out\"}]")
      ; REGRESSION (the "\r"-is-'r' reader trap): str-trim must not eat trailing r's.
      (and (str-eq (pure-collect-angles "angle" "write a test for the parser")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"write a test for the parser\"}]")
      ; a SINGLE-TOKEN chunk is a label, not a finding — "high" (the bare confidence word) and
      ; "perspective" (the angle's own label) are dropped; the real finding beside them survives.
      (and (str-eq (pure-collect-angles "angle" "high\n\n---\n\ntypes come from lambda calculus\n\n---\n\nperspective")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"types come from lambda calculus\"}]")
      (and (str-eq (pure-collect-angles "angle" "high") "")   ; nothing but a label -> the seam refine-FAILS
      ; a newline-only chunk is whitespace -> dropped (LF is in the trim set)
      (and (str-eq (pure-collect-angles "angle" "\n \n") "")
      ; an EMPTY array said nothing — the angle is DROPPED, not rendered as a literal "[]".
      (and (str-eq (pure-collect-angles "angle" "[]") "")
      ; a bare STRING array (`["high","..."]`, the 0.5b's other off-contract shape) reads as its
      ; elements — minus the ones that say nothing. Measured live: an angle answered
      ; `["80%","high","medium","<the real finding>"]`; the tokens are noise, the sentence is the
      ; answer, and the outer one-word check cannot see inside a joined chunk.
      (and (str-eq (pure-collect-angles "angle" "[\"high\",\"it holds now\"]")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"it holds now\"}]")
      (and (str-eq (pure-collect-angles "angle" "[\"80%\",\"high\",\"types are propositions\",\"low\"]")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"types are propositions\"}]")
      ; an OFF-CONTRACT object — well-formed JSON with no "body"/"target" at all, the 0.5b's
      ; `[{"text":…,"reason":…}]` — reads as its string VALUES, not as raw JSON. (It used to fall
      ; through to VERBATIM and the scaffolding landed in the user's reply.)
      (and (str-eq (pure-collect-angles "angle" "[{\"text\":\"pg is fast\",\"reason\":\"low cost\"}]")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"pg is fast; low cost\"}]")
      ; INVALID JSON (a 0.5b's unescaped inner quotes) still recovers its body via bodies-scan
      ; instead of dumping the blob — the measured live failure this closes.
      (and (str-eq (pure-collect-angles "angle" "[{\"kind\":\"answer\",\"body\":\"it is \"pure\" and total\"}]")
                   "[{\"kind\":\"angle\",\"target\":\"angle-1\",\"body\":\"it is \\\"pure\\\" and total\"}]")
           (refine-ok ty-findings ca2)))))))))))))))))))))                 ; ... and the result passes the ty-findings seam

; ─── Change 1 : the ASK follows the leaf's out-Ty ────────────────────────────────
; ty-return-instruction is refine-ok read in the other direction, so the property to
; assert is COHERENCE between the pair, per Ty: whatever the ask demands, the seam
; must accept. A prose Ty demanding a JSON array is the exact defect this closes
; (CHATTER-ANSWER-QUALITY Change 1) — research-investigate is ty-text *because* a free
; reasoning move is prose, and was ordered to answer in JSON anyway.
(def demands-json (-> Ty Bool) (lam (t) (str-has (ty-return-instruction t) "JSON array")))
(def ask-ok (-> Unit Bool)
  (lam (_)
    ; 1. the PROSE Tys must NOT demand JSON — the defect, asserted directly.
    (and (not (demands-json ty-text))
    (and (not (demands-json ty-doc))
    (and (not (demands-json ty-span))
    (and (not (demands-json ty-patch))
    ; 2. the JSON-shaped Tys still do — parse-findings reads that shape back.
    (and (demands-json ty-findings)
    (and (demands-json ty-verdict)
    (and (demands-json ty-part)
    (and (demands-json ty-perspectives)          ; parse-perspectives' documented preferred shape
    ; 3. the JSON ask is the RUNNER's one constant, not a copy that can drift.
    (and (str-eq (ty-return-instruction ty-findings) ret-json-findings)
    ; 4. COHERENCE: a compliant answer to each ask passes that Ty's seam.
    (and (refine-ok ty-text "Quantitative Type Theory tracks how many times a variable is used.")
    (and (refine-ok ty-doc "the revised paragraph")
    (and (refine-ok ty-patch "--- a/x\n+++ b/x\n@@\n-old\n+new")
    (and (refine-ok ty-findings "[{\"kind\":\"gap\",\"target\":\"x\",\"body\":\"y\"}]")
    ; 5. every ask is non-empty and starts the two-newline separator it appends with.
    (and (str-has (ty-return-instruction ty-text) "\n\n")
         (str-has (ty-return-instruction ty-findings) "\n\n")))))))))))))))))

(def compile-main (=> I64 I64)
  (lam (n)
    (do (put "-- doc-refine expert-pool lint (advisory baseline; flags are informational) --\n")
    (do (print-pool-flags (lint-pool expert-pool))
    (case (and (ask-ok unit)                                  ; Change 1: ask == what the seam accepts
          (and (cap-ok unit)                                  ; R3 model-fan cap
          (and (attenuate-ok unit)                            ; DC-4a child slice
          (and (sees-parsed-ok unit)                          ; DC-4a `sees` declaration reachable
          (and (collect-angles-ok unit)                       ; run-pure pf-collect-angles (DC-1b slice 3)
          (and (is-arrow (flow-ty (pipeline->flow doc-refine-pipeline)) ty-doc ty-doc)
          (and (is-arrow (flow-ty good-chain) ty-doc ty-doc)
          (and (is-none  (flow-ty bad-chain))
          (and (is-none  (flow-ty bad-fan))
          (and (refine-ok ty-doc "revised text")                 ; ty-doc, non-empty  -> true
          (and (not (refine-ok ty-doc ""))                       ; ty-doc, empty      -> false
          (and (refine-ok ty-findings "[{\"kind\":\"gap\"}]")    ; findings shape     -> true
          (and (not (refine-ok ty-findings "just a sentence"))   ; not findings       -> false
          (and (not (refine-ok ty-findings "kind"))              ; the bare word is not findings
          ; parse-perspectives: multi-line text -> one perspective per non-empty line
          (and (=i (persp-count (parse-perspectives "check security\ncheck performance\ncheck correctness")) 3)
          (and (=i (persp-count (parse-perspectives "one angle only")) 1)  ; single line -> 1
          (and (=i (persp-count (parse-perspectives "")) 0)                ; empty -> none
          (and (=i (persp-count (parse-perspectives "a\n\n\nb\n")) 2)      ; blank lines dropped -> 2
          (and ; JSON array (the runner's forced shape): one perspective per object
               (=i (persp-count (parse-perspectives "[{\"body\":\"angle x\"},{\"body\":\"angle y\"}]")) 2)
          ; ─── stop-continue? : the STOP loop decision (slice 4, MANAS-L0-SPEC §7.4) ───
          (and (not (stop-continue? (stop-single) 0 "" ""))         ; single -> false at iter 0
          (and (stop-continue? (stop-capped 2) 0 "" "")             ; capped 2, iter0 -> true
          (and (not (stop-continue? (stop-capped 2) 1 "" ""))       ; capped 2, iter1 -> false (2 runs done, stop)
          (and (not (stop-continue? (stop-capped 2) 2 "" ""))       ; capped 2, iter2 -> false (past cap)
          (and (not (stop-continue? (stop-until-dry 3) 0 "a" "a"))  ; until-dry, DRY (cur==prev) -> false
          (and (stop-continue? (stop-until-dry 3) 0 "a" "b")        ; until-dry, changed & under cap -> true
          (and (not (stop-continue? (stop-until-dry 3) 2 "a" "b"))  ; until-dry, changed but AT cap -> false
          ; ─── slice 5 : the tiny-step lint + the acceptance gate (MANAS-L0-SPEC §4/§0) ───
          (and (str-list-has (lint-expert big-expert) "lens-conjunction") ; big-question -> flagged
          (and (str-list-has (lint-expert big-expert) "lens-too-long")
          (and (str-list-has (lint-expert big-expert) "sees-empty")
          (and (=i (str-list-len (lint-expert big-expert)) 3)             ; exactly the three flags
          (and (=i (str-list-len (lint-expert coverage-vs-spec)) 0)       ; tiny well-formed -> nil
          (and (manifest-all-green? all-green-manifest)                   ; all parsed-ok -> true
          (and (not (manifest-all-green? empty-zero-call-manifest))       ; zero calls = nothing ran -> false (Audit F1)
          (and (not (manifest-all-green? has-red-manifest))               ; a parsed-ok=false call -> false
          (and (not (manifest-all-green? refine-fail-manifest))           ; typed-seam refine-fail -> false
          ; ─── the branch-drop propagation (the silent-swallow fix, MANAS-L0-SPEC §0) ───
          (and (perspective-failed? no-expert-manifest)                   ; zero-call sub-run -> a DROP
          (and (perspective-failed? refine-fail-manifest)                 ; error routing + zero calls -> a DROP
          (and (perspective-failed? err-routed-with-call)                 ; error-marked routing (has a call) -> a DROP
          (and (not (perspective-failed? has-call-clean-manifest))        ; a clean >=1-call sub-run -> NOT a drop
          (and (not (manifest-all-green? branch-drop-composite))          ; dropped angle -> composite NOT green (THE FIX)
               (manifest-all-green? branch-clean-composite)))))))))))))))))  ; clean branch -> STILL green
               ))))))))))))))))))))))))
      (true 0)
      (false 1))))))
