; skill-test.prog — SG2 PURE unit gate for the Skill reuse engine (skill.chiral).
;
; Mesh-free (no PTY, no network, no fork): proves the pure Skill transforms.
;   (1) resolve chain      — a 3-skill library [base "b", spec "s1"->"b" ctxA,
;       spec "s2"->"s1" ctxB]; resolve-skill "s2" = some with b's Flow + b's
;       StopPolicy AND contexts = ["ctxA","ctxB"] in the DOCUMENTED base-inward order.
;   (2) missing            — resolve-skill "missing" = none.
;   (3) cycle-safe         — [spec "x"->"y", spec "y"->"x"] resolves to none (no hang;
;       fuel-bounded by library size).
;   (4) duplicate          — duplicate-skill yields a skill with the NEW name + same content.
;   (5) round-trip         — skill->json -> show -> parse -> json->skill -> re-encode is a
;       string-level fixpoint over a skill-base (flow + StopPolicy both survive).
; compile-main returns 0 iff every assertion passes (exit 0).
;
; Build+run (fast — links skill's backend/runner closure but never CALLS it; the transforms
; under test are pure, so mesh-free at runtime):
;   chirality run prog/prapanca/core/skill-test.prog

(import "prelude/prelude")                 ; Bool, Unit, unit, and, some, none, case, str-eq, cons, nil, pair
(import "protocol/json")                    ; json-show, json-parse-str
(import "prapanca/core/types")        ; StopPolicy (stop-capped)
(import "prapanca/core/flow")         ; Flow (flow-step), Ty ctors (ty-doc, ty-findings)
(import "prapanca/core/flow-persist") ; flow->json  (for the flow-equality-by-encoding check)
(import "prapanca/core/skill")        ; Skill (+ ctors), resolve-skill, duplicate-skill, specialize-skill,
                                   ; skill-name, skill->json, json->skill, stop->json

; ─── fixtures ────────────────────────────────────────────────────────────────
(def base-flow Flow (flow-step "reader" ty-doc ty-findings))
(def base-stop StopPolicy (stop-capped 3))          ; exercises the StopPolicy number codec

(def lib (List Skill)
  (cons (skill-base "b" base-flow base-stop)
  (cons (skill-spec "s1" "b" "ctxA")
  (cons (skill-spec "s2" "s1" "ctxB") nil))))

(def cyc-lib (List Skill)
  (cons (skill-spec "x" "y" "cx")
  (cons (skill-spec "y" "x" "cy") nil)))

; ─── helpers (equality by canonical encoding — no structural eq on Flow) ──────
(def flow-str (-> Flow Str) (lam (f) (json-show (flow->json f))))
(def stop-str (-> StopPolicy Str) (lam (s) (json-show (stop->json s))))
(def skill-str (-> Skill Str) (lam (s) (json-show (skill->json s))))

(declare list-str-eq (-> (List Str) (List Str) Bool))
(def list-str-eq
  (lam (a b)
    (case a
      (nil (case b (nil true) ((cons hb tb) false)))
      ((cons ha ta)
        (case b
          (nil false)
          ((cons hb tb) (and (str-eq ha hb) (list-str-eq ta tb))))))))

; ─── (1) resolve chain: base flow + stop + accumulated contexts in order ──────
(def resolve-ok (-> Unit Bool)
  (lam (_)
    (case (resolve-skill "s2" lib)
      (none false)
      ((some r)
        (case r
          ((pair fl rest)
            (case rest
              ((pair st ctxs)
                (and (str-eq (flow-str fl) (flow-str base-flow))
                (and (str-eq (stop-str st) (stop-str base-stop))
                     (list-str-eq ctxs (cons "ctxA" (cons "ctxB" nil)))))))))))))

; ─── (2) missing base -> none ─────────────────────────────────────────────────
(def resolve-missing-ok (-> Unit Bool)
  (lam (_) (case (resolve-skill "missing" lib) (none true) ((some r) false))))

; ─── (3) cycle -> none (fuel-bounded, no hang) ────────────────────────────────
(def cycle-ok (-> Unit Bool)
  (lam (_) (case (resolve-skill "x" cyc-lib) (none true) ((some r) false))))

; ─── (4) duplicate: new name + same content (via canonical encoding) ──────────
(def dup-ok (-> Unit Bool)
  (lam (_)
    (and (str-eq (skill-name (duplicate-skill (skill-base "b" base-flow base-stop) "b-copy")) "b-copy")
         (str-eq (skill-str (duplicate-skill (skill-base "b" base-flow base-stop) "b-copy"))
                 (skill-str (skill-base "b-copy" base-flow base-stop))))))

; ─── (5) round-trip a skill-base (flow + StopPolicy survive) ──────────────────
(def rt-ok (-> Unit Bool)
  (lam (_)
    (let ((enc (json-show (skill->json (skill-base "b" base-flow base-stop)))))
      (case (json-parse-str enc)
        (none false)
        ((some jv)
          (case (json->skill jv)
            (none false)
            ((some s2) (str-eq enc (json-show (skill->json s2))))))))))

; ─── entry ────────────────────────────────────────────────────────────────────
(def compile-main (=> I64 I64)
  (lam (n)
    (case (and (resolve-ok unit)
          (and (resolve-missing-ok unit)
          (and (cycle-ok unit)
          (and (dup-ok unit)
               (rt-ok unit)))))
      (true 0)
      (false 1))))
