; ============================================================ golden conformance
; E141, Wave 6 (METIS-PORT-SPEC §8). The prapanca test ORACLE: structurally compare a
; live run's RunManifest against the frozen golden. P5 — two independent truths
; compared; disagreement is how divergence gets noticed. PURE (->) — the membrane
; PROVES the oracle cannot call a model or touch the network while judging a run.
;
; STRUCTURAL vs IGNORED (SPEC decision #1). A model call is non-deterministic, so
; the oracle compares only the routing/binding STRUCTURE, never the response text:
;   STRUCTURAL  pipeline-id, config-id, routing-decision, fired-expert-ids;
;               per-ExpertCall expert-id / slot / bound-model (pairwise, length in).
;   IGNORED     run-id, request, doc/artifact-path, pipeline-choice, config-binds,
;               context-chunks-used, combiner-patches, final-yield, generated-at;
;               per-call num-ctx, prompt-sha256, response-sha256, parsed-ok,
;               accepted-into-merge, duration-ms.
; Accessors live in manifest.chiral (imported) — no name is redefined here.

(import "prelude/prelude")                 ; Str, Bool, List, str-eq, and, case
(import "prapanca/core/types")        ; RunManifest, ExpertCall
(import "prapanca/contract/manifest") ; manifest-* / ec-* accessors

; ------------------------------------------------------------- list equality
; two (List Str) equal pairwise (length included). Structural recursion — total.
(def str-list-eq (-> (List Str) (List Str) Bool)
  (lam (xs ys)
    (case xs
      (nil (case ys (nil true) ((cons h t) false)))
      ((cons x xt)
        (case ys
          (nil false)
          ((cons y yt)
            (and (str-eq x y) (str-list-eq xt yt))))))))

; ------------------------------------------------------------- expert-call struct
; two ExpertCalls agree on the STABLE per-call fields only (NOT shas/duration).
(def ec-struct-eq (-> ExpertCall ExpertCall Bool)
  (lam (g a)
    (and (str-eq (ec-expert-id g) (ec-expert-id a))
    (and (str-eq (ec-slot g) (ec-slot a))
         (str-eq (ec-bound-model g) (ec-bound-model a))))))

; two expert-call lists match pairwise, length included.
(def ec-list-match (-> (List ExpertCall) (List ExpertCall) Bool)
  (lam (gs as)
    (case gs
      (nil (case as (nil true) ((cons h t) false)))
      ((cons g gt)
        (case as
          (nil false)
          ((cons a at)
            (and (ec-struct-eq g a) (ec-list-match gt at))))))))

; ------------------------------------------------------------- manifest-conforms
; STRUCTURAL agreement of a live run (`actual`) vs the `golden`. Pure (->). True
; iff every STRUCTURAL field agrees; every IGNORED field may differ freely.
(def manifest-conforms (-> RunManifest RunManifest Bool)
  (lam (golden actual)
    (and (str-eq (manifest-pipeline-id golden) (manifest-pipeline-id actual))
    (and (str-eq (manifest-config-id golden) (manifest-config-id actual))
    (and (str-eq (manifest-routing-decision golden) (manifest-routing-decision actual))
    (and (str-list-eq (manifest-fired-expert-ids golden) (manifest-fired-expert-ids actual))
         (ec-list-match (manifest-expert-calls golden) (manifest-expert-calls actual))))))))
