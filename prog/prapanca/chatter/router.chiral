; ==================================================== prapanca Chatter — C1 the PURE ROUTER
; The "general chatter" has NO general mode: EVERY user message is CLASSIFIED and
; ROUTED to a named pipeline (a Flow-based skill). This is the crown element — the
; router — and it is a PURE, TOTAL, DETERMINISTIC function.
;
; THESIS: routing is a CLASSIFICATION = symbol-manipulation over a message. Per the
; refinement pass, a tiny model coin-flips a classification (SYMBOL-MANIPULATION is
; exactly what a 0.5b is unreliable at), so the router DECIDES IN CODE: deterministic
; keyword/marker detection over the message text. The model is NOT involved in this
; slice at all — route-message is a value transform, fully offline-testable. (A later
; slice may add tiny-model intent-detectors as a FAN; not now — additive.)
;
; Boundary-as-closed-sum (docs/pattern-boundary-sums.md): the ask categories are a
; CLOSED SUM `Intent`, parsed ONCE; the route table maps Intent -> skill NAME (a Str
; the skill registry resolves via skill-by-name). The router does NOT import the flows.

(import "prelude/prelude")            ; Maybe, some, none, Bool, true, false, case, and, or, not, =i, <i, <=i, +, -, str-len, str-sub, str-eq, str-find, str-cat, str->bytes, bytes->str, bget, blen, bslice, List, cons, nil
(import "prapanca/core/flow")    ; str-has, str-find, pure-has-any (does any needle occur in the input?)
(import "prelude/string")       ; str-lower (E151b: the owner, no longer a local copy)

; ==================================================== O0 — str-lower : ASCII-lowercase normalization
; The marker vocabularies below are all lowercase, but pure-has-any matches CASE-SENSITIVELY,
; so "Hello"/"Hey there"/"SORT THESE" miss the lowercase markers and fall to in-unknown (the
; historical limitation once documented at the marker vocabularies). O0 fixes it: a pure, total,
; ASCII-lowercase pass ('A'..'Z' -> 'a'..'z', every other byte unchanged) applied ONLY at the
; marker-MATCHING points — the message text routed/displayed/split downstream keeps the user's
; casing. ASCII-lowercase is LENGTH-PRESERVING (1 byte -> 1 byte), so an index found on the
; lowered copy is valid on the ORIGINAL string (used by split-conjunctions below).
;
; E151b: the implementation is now IMPORTED from string-utils, the owner — the
; local lc-alpha / str-lower-go / str-lower copy this module used to carry is
; RETIRED. Same function, byte for byte: the same 65..90 -> alphabet-table map
; over the same byte face, so the length-preservation the split relies on holds
; exactly as before.

; ------------------------------------------------------------------- Intent : the closed sum
; The broad ask categories. CLOSED (a new category is an added constructor, never a
; string sentinel). Every message maps to EXACTLY one — in-unknown/in-clarify are the
; honest catch-alls (no forced misclassification).
(data Intent ()
  (in-social) (in-analyze) (in-decide) (in-transform) (in-factual) (in-clarify) (in-unknown))

; ------------------------------------------------------------------- marker vocabularies
; Each category is a list of representative lowercase substring markers. CASE NOTE (O0): the
; message is ASCII-lowercased (str-lower, above) BEFORE matching, so a shouted "SORT THESE" or
; a capitalized "Hello" now matches the lowercase markers (was an in-unknown miss pre-O0). The
; markers are chosen to avoid substring traps: greeting "hi " carries a trailing space so
; "this"/"which"/"his" do NOT trip social.
(def social-markers (List Str)
  (cons "hi " (cons "hello" (cons "hey " (cons "thanks" (cons "thank you"
  (cons "who are you" (cons "what can you do" nil))))))))
(def decide-markers (List Str)
  (cons " vs " (cons " or " (cons "should i" (cons "which is better" (cons "decide" nil))))))
(def analyze-markers (List Str)
  (cons "sort " (cons "classify" (cons "is this " (cons "fact-check"
  (cons "what's wrong" (cons "evidence" nil)))))))
(def transform-markers (List Str)
  (cons "summarize" (cons "rewrite" (cons "translate" (cons "edit "
  (cons "write a test" (cons "fix " nil)))))))
(def factual-markers (List Str)
  (cons "what is" (cons "how does" (cons "when did" (cons "who was" (cons "explain " nil))))))

; ------------------------------------------------------------------- depth markers (R4)
; A factual ask can want ONE answer or MANY. "what is a monad" wants one; "tell me some different
; specific ways type theory developed" wants a survey — and answering it in one pass is what
; produced the wall of mush that prompted the fractal skill. These markers are the MULTIPLICITY
; signal, chosen narrowly: every one of them says "more than one of something", so they cannot
; fire on an ordinary question. Deliberately NOT "tell me about" — that is how half of all
; questions open, and routing them all through a 15-40s fan would be a cost bug wearing a feature's
; clothes. Code decides this (the D2 posture): it is a marker match, not a judgement.
(def depth-markers (List Str)
  (cons "different ways" (cons "different perspectives" (cons "some different"
  (cons "various ways" (cons "several ways" (cons "ways that"
  (cons "in depth" (cons "deep dive" (cons "compare and contrast"
  (cons "survey of" (cons "aspects of" nil))))))))))))

; wants-depth? : does this message ask for MANY answers rather than one? PURE, TOTAL, and matched
; against the ASCII-lowercased copy like every other marker set (O0).
(def wants-depth? (-> Str Bool)
  (lam (msg) (pure-has-any depth-markers (str-lower msg))))

; ------------------------------------------------------------------- non-space char count
; The clarify trigger: a message with FEWER than 3 non-space characters is too thin to
; route ("", "ok", "  ?") — ask for clarification rather than guess. PURE, TOTAL.
(declare nonspace-go (-> Str I64 I64 I64))
(def nonspace-go
  (lam (s i acc)
    (case (=i i (str-len s))
      (true acc)
      (false
        (let ((c (str-sub s i (+ i 1))))
          (nonspace-go s (+ i 1) (case (str-eq c " ") (true acc) (false (+ acc 1)))))))))
(def nonspace-count (-> Str I64) (lam (s) (nonspace-go s 0 0)))

; ------------------------------------------------------------------- route-message : the classifier
; PURE, TOTAL. PRIORITY ORDER (first match wins) — chosen so the more-specific/social
; intents win over the broad factual catch-all:
;   1. social    — greeting / gratitude / meta ("who are you") → templated reply later
;   2. decide    — a choice between options (" vs ", " or ", "should i", "which is better")
;   3. analyze   — sort/classify/verify a body of items (evidence-sift territory)
;   4. transform — rewrite/summarize/translate/edit/fix a given text (doc-edit territory)
;   5. factual   — an explanatory question ("what is", "how does", "explain ") (research)
;   6. clarify   — < 3 non-space chars: too thin to route, ask for more
;   7. unknown   — none of the above: honest fall-through (no forced guess)
; social is FIRST so "hi there, thanks!" is a greeting, not misread as factual; the short
; clarify check is LATE so a real greeting like "hi" still classifies before the length gate.
(def route-message (-> Str Intent)
  (lam (msg)
    (let ((lm (str-lower msg)))   ; O0: match markers against the ASCII-lowercased copy (msg keeps its casing downstream)
    (case (pure-has-any social-markers lm)
      (true (in-social))
      (false (case (pure-has-any decide-markers lm)
        (true (in-decide))
        (false (case (pure-has-any analyze-markers lm)
          (true (in-analyze))
          (false (case (pure-has-any transform-markers lm)
            (true (in-transform))
            (false (case (pure-has-any factual-markers lm)
              (true (in-factual))
              (false (case (<i (nonspace-count msg) 3)
                (true (in-clarify))
                (false (in-unknown))))))))))))))))

; ------------------------------------------------------------------- intent->skill : the route table
; Maps an Intent to the skill NAME (a Str resolvable by skill-by-name in the registry) —
; NOT the Flow itself (no flow imports; the router stays a pure classifier). social /
; clarify / unknown route to NO skill: they are handled by templated / clarify / fallback
; paths in a later slice, not a Flow-based skill. Returning (Maybe Str) makes "no skill"
; a value, not a sentinel.
(def intent->skill (-> Intent (Maybe Str))
  (lam (i)
    (case i
      (in-analyze   (some "evidence-sift"))
      (in-decide    (some "decision"))
      (in-transform (some "doc-edit"))
      (in-factual   (some "research"))
      (in-social    none)
      (in-clarify   none)
      (in-unknown   none))))

; ------------------------------------------------------------------- intent-name : the display tag
; A stable short tag for tests + a later UI. PURE, TOTAL, exhaustive.
(def intent-name (-> Intent Str)
  (lam (i)
    (case i
      (in-social    "social")
      (in-analyze   "analyze")
      (in-decide    "decide")
      (in-transform "transform")
      (in-factual   "factual")
      (in-clarify   "clarify")
      (in-unknown   "unknown"))))

; ==================================================== C6a — ConvState + follow-up resolution
; The one-shot router (route-message) is CONTEXT-FREE: every message is classified from
; scratch, so a bare referential fragment ("the second one", "what about the third?") has
; no markers of its own and falls to in-unknown. That is exactly the "N independent one-
; shots" problem — the chat never "gets somewhere". C6a threads a small conversation memory,
; ConvState, so turn N+1 SEES turn N: a follow-up REUSES the prior turn's Intent instead of
; routing blind, and the prior context is serialized into the routed Flow's `extra` slot so
; its leaves can SEE it. All of this is PURE + TOTAL (no model — the model is still only
; reached inside a routed skill's Flow). Compound-intent decomposition is C6b, NOT here.

; ------------------------------------------------------------------- ConvState : the memory value
; A CLOSED SUM. conv-empty = the start of a conversation (no prior turn). conv-state carries
; the LAST turn's resolved Intent (for follow-up reuse), its message + reply (serialized into
; the next turn's `extra` so the Flow's leaves see prior context), and a turn counter. Small,
; monomorphic, total — no polymorphism, no unbounded growth (only the LAST turn is retained;
; a richer recent-turns window is future work, additive).
(data ConvState ()
  (conv-empty)
  (conv-state (last-intent Intent) (last-message Str) (last-reply Str) (turn-count I64)))

; ------------------------------------------------------------------- follow-up markers
; Bare referential fragments that point BACK at the prior turn's items rather than naming a
; fresh ask. Same case-sensitive substring discipline as the intent markers (no str-lower).
(def followup-markers (List Str)
  (cons "the second" (cons "the third" (cons "the first" (cons "the fourth"
  (cons "the last one" (cons "the next one" (cons "what about" (cons "and that"
  (cons "that one" (cons "and the" nil)))))))))))

; is-followup? : does the message read as a bare referential fragment (a follow-up to the
; prior turn) rather than a fresh, self-contained ask? PURE, TOTAL — a marker cascade,
; mirroring pure-has-any as route-message does. O0: matches the ASCII-lowercased copy so
; "What about the second one?" resolves as a follow-up like its lowercase form.
(def is-followup? (-> Str Bool)
  (lam (msg) (pure-has-any followup-markers (str-lower msg))))

; ------------------------------------------------------------------- resolve-intent : the pre-check
; The context-AWARE classifier: the follow-up pre-check in FRONT of route-message. With no
; prior turn (conv-empty) it is exactly route-message. With a prior turn, a bare follow-up
; REUSES the prior Intent (so "the second one" after an analyze stays analyze instead of
; falling to in-unknown); anything self-contained still routes fresh. PURE, TOTAL.
(def resolve-intent (-> ConvState Str Intent)
  (lam (cs msg)
    (case cs
      ((conv-empty) (route-message msg))
      ((conv-state li lm lr tc)
        (case (is-followup? msg)
          (true li)
          (false (route-message msg)))))))

; ------------------------------------------------------------------- conv-update : advance the memory
; Fold the just-finished turn (its RESOLVED intent, message, reply) into the memory, bumping
; the turn counter. PURE, TOTAL — the C5 loop calls this after each turn and threads the
; result into the next turn.
(def conv-update (-> ConvState Intent Str Str ConvState)
  (lam (cs intent msg reply)
    (case cs
      ((conv-empty) (conv-state intent msg reply 1))
      ((conv-state li lm lr tc) (conv-state intent msg reply (+ tc 1))))))

; ------------------------------------------------------------------- conv->extra : serialize for the Flow
; Turn the memory into the `extra`/`sees` pair list run-flow-stop threads to every leaf, so a
; routed Flow can SEE the prior turn's intent/message/reply (the same tagged-pair channel the
; perspective sees-extra uses). conv-empty -> nil (a fresh, memory-free run). PURE, TOTAL.
(def conv->extra (-> ConvState (List (Pair Str Str)))
  (lam (cs)
    (case cs
      ((conv-empty) nil)
      ((conv-state li lm lr tc)
        (cons (pair "prior-intent" (intent-name li))
          (cons (pair "prior-message" lm)
            (cons (pair "prior-reply" lr) nil)))))))

; ==================================================== DC-3a — the M2 ESCALATION LADDER (D2 = code-prior)
; D2 RESOLVED 2026-08-21 (author): **code-prior**. Markers decide the cases code is sure of; the
; model planner handles ONLY the residue. Recorded here rather than in a comment elsewhere because
; this predicate IS the decision — the posture is a value the code cases on, not a convention.
;
; Why code-prior and not model-primary (all measured this arc, none of it aspiration):
;   · a 0.5b planner picked doc-edit/code-test for "sort these…" and NEVER evidence-sift — worse
;     than the marker table on exactly the messages the marker table decides (DC-0a);
;   · O6's qwen3:4b cured that systematic miss but became capable enough to plan a FAN for a bare
;     "hello", which is why social/clarify already had to be gated in code;
;   · every structural decision since has been code and has held: the divider's markers (DC-2a),
;     the per-chunk ASSIGN (DC-2b), the dep-derived context grant (DC-4a);
;   · and it is not free to ask: the planner runs on the orchestrator tier while the skills run on
;     0.5b, and Ollama keeps ONE model resident (DC-0a), so every avoided planner call also
;     removes a full model reload from the turn.
;
; The ladder has exactly two rungs, and `Routed` is the rung as a closed value (boundary-sums):
;   routed-sure    — a marker (or the clarify threshold, or C6a's follow-up reuse) fired. CODE
;                    decides; the model is not asked what code already knows.
;   routed-residue — NOTHING fired: the resolved intent is the honest catch-all. THAT is the
;                    residue, and the only place the model planner earns its call.
(data Routed () (routed-sure (intent Intent)) (routed-residue))

; routed-of : the ladder, read through conversation memory (so a bare follow-up whose intent C6a
; RESOLVES is `sure` — the reuse rule is deterministic, hence code-certain). PURE, TOTAL.
(def routed-of (-> ConvState Str Routed)
  (lam (cs message)
    (let ((i (resolve-intent cs message)))
      (case i
        (in-unknown (routed-residue))
        (in-social    (routed-sure i))
        (in-clarify   (routed-sure i))
        (in-analyze   (routed-sure i))
        (in-decide    (routed-sure i))
        (in-transform (routed-sure i))
        (in-factual   (routed-sure i))))))

(def routed-name (-> Routed Str)
  (lam (r) (case r ((routed-sure i) (intent-name i)) ((routed-residue) "residue"))))

; ==================================================== C6b — compound-intent decomposition (the PURE splitter)
; A single message can CHAIN several asks — "research X then decide Y". A flat one-shot can
; only route the WHOLE string to ONE intent; a real conversation runs the CHAIN: X's ask
; first, THEN Y's ask WITH X's result carried into ConvState (C6a's mechanism). The split
; itself is PURE symbol-manipulation over conjunction markers, consistent with the refinement
; thesis (routing decided in code, no model). Only the SEQUENCED execution — each part run
; through `turn` — touches a Backend, and that lives in turn.chiral. The common case (NO
; conjunction) returns a ONE-element list, so a plain message stays a single one-shot with
; ZERO behavior change. This is the last chatter slice: the "chain of asks".

; ------------------------------------------------------------------- conjunction markers
; Surface phrases that CHAIN two asks. Each verbal marker carries surrounding spaces so it
; matches a real conjunction, not a substring inside a word ("then" inside "authentication",
; "or" is NOT a conjunction here — that stays a decide marker). " and then " is listed FIRST
; so the earliest-index rule below prefers it over the " then " it contains (a clean split,
; no dangling "and"). "; " (then bare ";") splits an explicit list. Same case-sensitive
; discipline as the intent markers (no str-lower).
(def conj-markers (List Str)
  (cons " and then " (cons " then " (cons " after that " (cons "; " (cons ";" nil))))))

; ------------------------------------------------------------------- find-earliest-conj : the winning marker
; Scan the markers, return (index, length) of the EARLIEST-occurring conjunction marker in
; msg — index = its str-find position, length = str-len of the winning marker (so the caller
; skips past the whole marker). No marker present -> (-1, 0). PURE, TOTAL (structural on the
; marker list). Ties (same index) keep the first marker in the list (why "; " precedes ";").
(declare find-earliest-conj-go (-> Str (List Str) I64 I64 (Pair I64 I64)))
(def find-earliest-conj-go
  (lam (msg ms best-i best-len)
    (case ms
      (nil (pair best-i best-len))
      ((cons m rest)
        (let ((i (str-find msg m)))
          (case (<i i 0)
            (true (find-earliest-conj-go msg rest best-i best-len))
            (false
              (case (<i best-i 0)
                (true (find-earliest-conj-go msg rest i (str-len m)))
                (false
                  (case (<i i best-i)
                    (true  (find-earliest-conj-go msg rest i (str-len m)))
                    (false (find-earliest-conj-go msg rest best-i best-len))))))))))))
(def find-earliest-conj (-> Str (Pair I64 I64))
  (lam (msg) (find-earliest-conj-go msg conj-markers -1 0)))

; ------------------------------------------------------------------- split-conjunctions : the splitter
; Split a message into its chained parts at conjunction markers. NO conjunction -> a ONE-
; element list (the common case: a plain message routes as ONE turn, unchanged). Each split
; strips the prefix + the whole marker, so `fuel` (= initial str-len, a strict upper bound on
; the number of splits) guarantees totality without relying on measure recursion. str-sub is
; (START, END) END-EXCLUSIVE throughout: prefix = (0, i); rest = (i+len, str-len) — the END is
; always a real index (i < str-len, i+len <= str-len), never a length-as-END, so no OOB.
(declare split-conj-go (-> Str I64 (List Str)))
(def split-conj-go
  (lam (msg fuel)
    (case (<=i fuel 0)
      (true (cons msg nil))
      (false
        ; O0: find the conjunction on the ASCII-lowercased copy so "X AND THEN Y" splits, but
        ; str-sub the ORIGINAL msg so each part keeps its casing (lowercase is length-preserving,
        ; so an index found on the lowered copy is valid on the original).
        (case (find-earliest-conj (str-lower msg))
          ((pair i len)
            (case (<i i 0)
              (true (cons msg nil))
              (false
                (cons (str-sub msg 0 i)
                  (split-conj-go (str-sub msg (+ i len) (str-len msg)) (- fuel 1)))))))))))
(def split-conjunctions (-> Str (List Str))
  (lam (msg) (split-conj-go msg (str-len msg))))
