; divide-test.prog — DC-2a PURE unit gate for the semantic divider (divide.chiral).
;
; MESH-FREE: every assertion here exercises the CODE pass (divide-code / structured? / the
; splitters), which is pure and total. The PORT leg is model-backed and therefore non-deterministic
; — it is exercised LIVE by samples/manas-divide-live (NOT MIGRATED -- ../metis-the-lang/scaffold/samples/manas-divide-live.metis), reported not asserted.
;
;   (1) a plain message -> ONE chunk, no payload, its own intent, no deps.
;   (2) a SEQUENCING message ("… and then …") -> two chunks, the second waiting on the first.
;   (3) a PARALLEL message (", and ") -> two chunks, NEITHER waiting (independent siblings).
;   (4) sequencing THEN parallel -> group 2's siblings both wait on group 1 (a barrier), and the
;       siblings do not wait on each other.
;   (5) the ask/payload split at ":" — text is the ask, data is the payload, and a colon with
;       nothing after it does NOT split.
;   (6) per-chunk INTENTS differ inside one message (the whole point of dividing).
;   (7) structured? — the PORT GATE: true for a multi-chunk or payload-carrying message, false
;       for a plain one (only then may the model be dialed).
;   (8) totality/floor: a message with no content divides into ZERO chunks — honestly
;       "nothing to ask", never a blank sub-request.
;
; Build+run:
;   chirality run prog/prapanca/chatter/divide-test.prog

(import "prelude/prelude")                  ; Bool, and, not, case, do, let, str-cat, str-eq, i64->str, cons, nil
(import "prapanca/chatter/divide")     ; Chunk (+ accessors), Divided, divide-code, structured?, split-payload, Origin
(import "prapanca/chatter/router")     ; Intent (+ ctors), intent-name
(import "ports/ports")                    ; put

(def bool->str (-> Bool Str) (lam (b) (case b (true "true") (false "false"))))

; ─── list helpers (indexing + dep membership) ────────────────────────────────────
(declare nth-chunk (-> (List Chunk) I64 (Maybe Chunk)))
(def nth-chunk
  (lam (cs i)
    (case cs
      (nil none)
      ((cons h t) (case (=i i 0) (true (some h)) (false (nth-chunk t (- i 1))))))))

(declare deps-len (-> (List I64) I64))
(def deps-len (lam (ds) (case ds (nil 0) ((cons h t) (+ 1 (deps-len t))))))
(declare deps-has (-> (List I64) I64 Bool))
(def deps-has (lam (ds x) (case ds (nil false) ((cons h t) (case (=i h x) (true true) (false (deps-has t x)))))))

; field probes on the i-th chunk (a missing index fails the assertion honestly, never crashes)
(def text-at (-> (List Chunk) I64 Str)
  (lam (cs i) (case (nth-chunk cs i) (none "<MISSING>") ((some c) (chunk-text c)))))
(def data-at (-> (List Chunk) I64 Str)
  (lam (cs i) (case (nth-chunk cs i) (none "<MISSING>") ((some c) (chunk-data c)))))
(def intent-at (-> (List Chunk) I64 Str)
  (lam (cs i) (case (nth-chunk cs i) (none "<MISSING>") ((some c) (intent-name (chunk-intent c))))))
(def ndeps-at (-> (List Chunk) I64 I64)
  (lam (cs i) (case (nth-chunk cs i) (none (- 0 1)) ((some c) (deps-len (chunk-deps c))))))
(def dep-at (-> (List Chunk) I64 I64 Bool)
  (lam (cs i x) (case (nth-chunk cs i) (none false) ((some c) (deps-has (chunk-deps c) x)))))

; ─── the fixtures ────────────────────────────────────────────────────────────────
(def m-plain Str "what is a monad")
(def m-seq   Str "sort these claims and then decide whether to adopt it")
(def m-par   Str "summarize this doc, and also write a test for the parser")
(def m-both  Str "sort these claims and then summarize the result, and also decide whether to adopt it")
(def m-load  Str "sort these claims by evidence vs speculation: (a) the 2019 benchmark, (b) it feels faster")
(def m-colon Str "explain this:")

(def plain (List Chunk) (divide-code m-plain))
(def seqd  (List Chunk) (divide-code m-seq))
(def pard  (List Chunk) (divide-code m-par))
(def bothd (List Chunk) (divide-code m-both))
(def loadd (List Chunk) (divide-code m-load))
(def colon (List Chunk) (divide-code m-colon))

; ─── (1) plain -> ONE chunk, no payload, no deps ─────────────────────────────────
(def plain-ok (-> Unit Bool)
  (lam (_)
    (and (=i (chunk-count plain) 1)
    (and (str-eq (text-at plain 0) m-plain)
    (and (str-eq (data-at plain 0) "")
         (=i (ndeps-at plain 0) 0))))))

; ─── (2) sequencing -> 2 chunks, the SECOND waits on the first ───────────────────
(def seq-ok (-> Unit Bool)
  (lam (_)
    (and (=i (chunk-count seqd) 2)
    (and (str-eq (text-at seqd 0) "sort these claims")
    (and (str-eq (text-at seqd 1) "decide whether to adopt it")
    (and (=i (ndeps-at seqd 0) 0)
    (and (=i (ndeps-at seqd 1) 1)
         (dep-at seqd 1 0))))))))

; ─── (3) parallel -> 2 chunks, NEITHER waits ─────────────────────────────────────
(def par-ok (-> Unit Bool)
  (lam (_)
    (and (=i (chunk-count pard) 2)
    (and (str-eq (text-at pard 0) "summarize this doc")
    (and (str-eq (text-at pard 1) "write a test for the parser")
    (and (=i (ndeps-at pard 0) 0)
         (=i (ndeps-at pard 1) 0)))))))

; ─── (4) sequencing THEN parallel -> a BARRIER, siblings independent of each other ─
(def both-ok (-> Unit Bool)
  (lam (_)
    (and (=i (chunk-count bothd) 3)
    (and (=i (ndeps-at bothd 0) 0)
    (and (=i (ndeps-at bothd 1) 1)          ; both siblings of group 2 ...
    (and (=i (ndeps-at bothd 2) 1)
    (and (dep-at bothd 1 0)                 ; ... wait on group 1 ...
    (and (dep-at bothd 2 0)
         (not (dep-at bothd 2 1)))))))))) ; ... and NOT on each other

; ─── (5) the ask/payload split ───────────────────────────────────────────────────
(def payload-ok (-> Unit Bool)
  (lam (_)
    (and (=i (chunk-count loadd) 1)
    (and (str-eq (text-at loadd 0) "sort these claims by evidence vs speculation")
    (and (str-eq (data-at loadd 0) "(a) the 2019 benchmark, (b) it feels faster")
    (and (=i (chunk-count colon) 1)
    (and (str-eq (text-at colon 0) "explain this")   ; a dangling ":" is trimmed, not a split
         (str-eq (data-at colon 0) ""))))))))

; ─── (6) per-chunk INTENTS differ inside ONE message ─────────────────────────────
(def intents-ok (-> Unit Bool)
  (lam (_)
    (and (str-eq (intent-at pard 0) "transform")      ; "summarize this doc"
    (and (str-eq (intent-at pard 1) "transform")      ; "write a test for the parser"
    (and (str-eq (intent-at seqd 0) "analyze")        ; "sort these claims"
         (str-eq (intent-at seqd 1) "decide"))))))    ; "decide whether to adopt it"

; ─── (7) structured? — the PORT GATE ─────────────────────────────────────────────
(def gate-ok (-> Unit Bool)
  (lam (_)
    (and (structured? seqd)                            ; multi-chunk  -> port SHUT
    (and (structured? pard)
    (and (structured? loadd)                           ; payload      -> port SHUT
         (not (structured? plain)))))))                ; plain        -> port may open

; ─── (8) the floor: nothing to ask -> ZERO chunks, honestly (never a blank sub-request) ──
(def floor-ok (-> Unit Bool)
  (lam (_)
    (and (=i (chunk-count (divide-code "")) 0)
    (and (=i (chunk-count (divide-code "   ")) 0)
    (and (not (structured? (divide-code "")))
         (=i (chunk-count (divide-code "; ; ;")) 0))))))   ; markers only, no content

; ─── entry ───────────────────────────────────────────────────────────────────────
(def compile-main (=> I64 I64)
  (lam (n)
    (do (put (str-cat "DIVIDE plain (1 chunk, no payload)   : " (str-cat (bool->str (plain-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE sequencing (2, second waits)  : " (str-cat (bool->str (seq-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE parallel (2, independent)     : " (str-cat (bool->str (par-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE seq+par (barrier, not sibling): " (str-cat (bool->str (both-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE ask/payload split at ':'      : " (str-cat (bool->str (payload-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE per-chunk intents differ      : " (str-cat (bool->str (intents-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE structured? (the port gate)   : " (str-cat (bool->str (gate-ok unit)) "\n")))
    (do (put (str-cat "DIVIDE empty-message floor           : " (str-cat (bool->str (floor-ok unit)) "\n")))
    (case (and (plain-ok unit) (and (seq-ok unit) (and (par-ok unit) (and (both-ok unit)
          (and (payload-ok unit) (and (intents-ok unit) (and (gate-ok unit) (floor-ok unit))))))))
      (true  (do (put "DC-2a divider gate: PASS\n") 0))
      (false (do (put "DC-2a divider gate: FAIL\n") 1)))))))))))))
