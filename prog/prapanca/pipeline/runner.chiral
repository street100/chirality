; ================================================== prapanca run-loop EFFECTFUL shell
; E138, Waves 3–4 (METIS-PORT-SPEC §1/§4). The imperative shell over the pure spine
; (prapanca/pipeline/plan). This is the ONLY prapanca-pipeline module that crosses the
; backend seam — its effect row is exactly the be-chat crossing, and the membrane
; proves it. call-expert/call-combiner wrap be-chat (=>); run-pipeline is
;   plan-run (PURE) -> fan-out call-expert over the fired experts -> call-combiner
;   -> assemble-manifest (PURE).
; SCOPE (SPEC decisions #2/#3/#4/#5): plain-data Backend (E137 upgrades to the
; linear porttype + Exit/LocalZone); non-streaming be-chat (not be-chat-stream, so
; no on-delta fn-param); no retrieval (assemble-prompt's context arg is nil);
; parse-findings parses a structured JSON array of {kind,target,body} objects, with
; a raw-finding FALLBACK for any non-conforming response. The LIVE run against a
; model is a deferred integration step — this module's gate is that B1 LOWERS it.

(import "prelude/prelude")             ; str-cat, i64->str, List, Pair
(import "prelude/list")
(import "prelude/string")
(import "prapanca/backend")             ; be-chat / be-chat-stream (=> … [(=> Str Unit)] ChatR), Msg, msg, ChatR
(import "protocol/json")                ; json-parse-str, Json (j-arr), obj-get, as-str
(import "prapanca/core/assemble") ; assemble-prompt
(import "prapanca/pipeline/plan") ; plan-run, assemble-manifest, PlanOutcome, empty-manifest,
                               ; exp-slot, bnd-model, ids-of-experts (+ the types)

; ----------------------------------------------------------------- parse-findings
; A model response -> structured findings. PURE (->): no crossing, so the test can
; drive it on a canned string with zero network. field-or-empty reads a string
; field (obj-get composed with as-str), defaulting a missing / non-string field to
; "" (the same shape as prapanca/contract/manifest.chiral's og-str, inlined here to
; avoid a duplicate top-level def when both modules land in one blob).
(def field-or-empty (-> Json Str Str)
  (lam (j k)
    (case (obj-get j k)
      (none "")
      ((some v) (case (as-str v) (none "") ((some s) s))))))
(def obj->finding (-> Json Finding)
  (lam (j) (finding (field-or-empty j "kind") (field-or-empty j "target") (field-or-empty j "body"))))
(def objs->findings (-> (List Json) (List Finding))
  (lam (items) (map-list Json Finding obj->finding items)))
; the FALLBACK: the whole response as one raw finding (a 0.5b model will often
; miss the JSON shape — that path must never regress or crash).
(def raw-finding (-> Str (List Finding))
  (lam (t) (cons (finding "raw" "" t) nil)))
(def parse-findings (-> Str (List Finding))
  (lam (t)
    (case (json-parse-str t)
      (none (raw-finding t))
      ((some j)
        (case j
          ((j-arr items)
            (case items
              (nil (raw-finding t))               ; empty array -> fall back
              ((cons h rest) (objs->findings items))))
          (_ (raw-finding t)))))))               ; not an array -> fall back

; ------------------------------------------------ E137 linear-handle result carriers
; be-* now consume + return the q1 Backend handle (ChatR carries it). Each pipeline
; step that touches the backend re-boxes its PURE outcome BESIDE the threaded handle
; so the whole run is a proven-unbroken linear chain. The outcomes (ExpertOutcome /
; CombinerOutcome / RunManifest) stay pure — they get stored in lists + folded; only
; the handle is linear, so it rides in its own carrier field, never inside a pure sum.
; CallR / FanR / RunR also carry the RAW training record(s) captured this call —
; a plain (non-linear) RawCall / (List RawCall) riding beside the linear handle, so
; be-log ships the real SEES prompt + model response (worker LEARN-01 corpus columns)
; without touching the digest-only manifest (E141 golden intact).
(data CallR () (call-r  (oc ExpertOutcome)   (raw RawCall)                (1 b Backend)))
(data CombR () (comb-r  (oc CombinerOutcome) (1 b Backend)))
(data FanR  () (fan-r   (outcomes (List ExpertOutcome)) (raws (List RawCall)) (1 b Backend)))
(data RunR  () (run-r   (yield Str) (manifest RunManifest) (raws (List RawCall)) (1 b Backend)))

; ------------------------------------------------- the RETURN instruction (the ASK)
; What a leaf is told to hand back. THE INVARIANT (CHATTER-ANSWER-QUALITY Change 1):
; ask for exactly what the seam will ACCEPT. This constant is the JSON-findings ask —
; the one parse-findings above reads, and the one the flat (untyped) Pipeline path
; uses. The per-Ty MAPPING lives beside its validator in prapanca/core/flow
; (`ty-return-instruction` next to `refine-ok`), and hands this same string back for
; the JSON-shaped Tys, so the ask and the parser cannot drift apart. Leading "\n\n"
; so it appends straight onto an assembled prompt.
(def ret-json-findings Str
  "\n\nReturn ONLY a JSON array of objects, each with string fields \"kind\", \"target\", \"body\". No prose.")

; ----------------------------------------------------------------- one expert call
; assemble the SEES prompt (context nil — no retrieval, first cut) + the caller's
; RETURN instruction `ret`, be-chat, then parse-findings the response. `ret` is a
; parameter, not a constant, because the ask must match the CALLER's declared out-Ty
; (ty-return-instruction, prapanca/core/flow) — a leaf whose seam wants prose must not be
; ordered to answer in JSON. The flat Pipeline path passes ret-json-findings above. A chat-ok ALWAYS yields
; expert-ok (parse-findings never fails — it falls back to one raw finding), so
; parsed_ok stays TRUE on a successful call: parsed_ok means "the be-chat call
; succeeded" (the circuit breaker counts a false parsed_ok as a backend failure),
; NOT "the JSON parsed". A chat-bad is a recoverable expert-bad VALUE carrying the
; raw body + reason. Threads the handle out in CallR. Row: (be-chat).
; The RawCall captures the SEES prompt actually sent (`prompt`, WITHOUT the `ret`
; suffix — the corpus wants the lens prompt) + the raw model text: `t`
; on success, the error body `r` on a chat-bad (the prompt WAS sent, so the row is
; still a real training datum). eid/slot come from the Expert (exp-id/exp-slot,
; imported from plan).
(def call-expert (=> (1 b Backend) Expert Str (List (Pair Str Str)) Str Str CallR)
  (lam (b ex doc extra model ret)
    (let ((prompt (assemble-prompt ex doc extra nil)))
      (case (be-chat b model
              (cons (msg "user" (str-cat prompt ret))
                    nil))
        ((chat-ok t b2)    (call-r (expert-ok (parse-findings t) t)
                                   (raw-call (exp-id ex) (exp-slot ex) model prompt t) b2))
        ((chat-bad s r b2) (call-r (expert-bad r (str-cat "http-" (i64->str s)))
                                   (raw-call (exp-id ex) (exp-slot ex) model prompt r) b2))))))

; ---------------------------------------------------- one expert call, STREAMING (S17)
; call-expert's byte-for-byte twin, with be-chat -> be-chat-stream + the on-delta
; threaded as one extra parameter. drain-stream's acc (backend.chiral:113-120)
; accumulates the full assistant text and returns it in (chat-ok acc) — the SAME
; string be-chat returns — so parse-findings runs on the same text and the
; ExpertOutcome is EQUAL to call-expert's given the same final response (the
; byte-identical-manifest invariant, S17 SPEC §5). ADDITIVE: call-expert is unchanged.
(def call-expert-stream (=> (1 b Backend) Expert Str (List (Pair Str Str)) Str Str (=> Str Unit) CallR)
  (lam (b ex doc extra model ret on-delta)
    (let ((prompt (assemble-prompt ex doc extra nil)))
      (case (be-chat-stream b model
              (cons (msg "user" (str-cat prompt ret))
                    nil)
              on-delta)
        ((chat-ok t b2)    (call-r (expert-ok (parse-findings t) t)
                                   (raw-call (exp-id ex) (exp-slot ex) model prompt t) b2))
        ((chat-bad s r b2) (call-r (expert-bad r (str-cat "http-" (i64->str s)))
                                   (raw-call (exp-id ex) (exp-slot ex) model prompt r) b2))))))

; ----------------------------------------------------------------- the combiner call
; render the fired agents' findings into one prompt body.
(def render-findings (-> (List Finding) Str)
  (lam (fs)
    (str-join "\n"
      (map-list Finding Str (lam (f) (case f ((finding k tg bd) bd))) fs))))

; call-combiner: findings -> be-chat -> CombinerOutcome. First cut accepts ALL fired
; ids on success (a real combiner reports which it merged). Row: (be-chat).
(def call-combiner (=> (1 b Backend) Expert (List Finding) (List Str) Str CombR)
  (lam (b ex findings fired-ids model)
    (case (be-chat b model (cons (msg "user" (assemble-prompt ex (render-findings findings) nil nil)) nil))
      ((chat-ok t b2)    (comb-r (combiner-ok t fired-ids t) b2))
      ((chat-bad s r b2) (comb-r (combiner-bad r (str-cat "http-" (i64->str s))) b2)))))

; ------------------------------------------------------ the combiner call, STREAMING (S17)
; call-combiner's byte-for-byte twin (be-chat -> be-chat-stream + on-delta). Same
; render-findings / assemble-prompt / CombinerOutcome mapping, so the yield is
; identical to call-combiner's given the same final response. ADDITIVE: call-combiner
; is unchanged.
(def call-combiner-stream (=> (1 b Backend) Expert (List Finding) (List Str) Str (=> Str Unit) CombR)
  (lam (b ex findings fired-ids model on-delta)
    (case (be-chat-stream b model
            (cons (msg "user" (assemble-prompt ex (render-findings findings) nil nil)) nil)
            on-delta)
      ((chat-ok t b2)    (comb-r (combiner-ok t fired-ids t) b2))
      ((chat-bad s r b2) (comb-r (combiner-bad r (str-cat "http-" (i64->str s))) b2)))))

; ----------------------------------------------------------------- the fan-out
; call-expert once per fired expert, each on its slot's bound model. Threads an
; accumulator (effect order explicit via let, mirroring manas.chiral's drive-batch);
; structural recursion on the fired list -> total. Row: (be-chat), N times.
; Threads TWO accumulators: the pure ExpertOutcomes (for the manifest) and the raw
; training records (for be-log's corpus rows). Both are reversed at the end to fired
; order, so raws[i] is the RawCall for outcomes[i] / the manifest's ExpertCall i.
(declare fan-experts
  (=> (1 b Backend) (List Expert) (List Binding) Str (List (Pair Str Str)) (List ExpertOutcome) (List RawCall) FanR))
(def fan-experts
  (lam (b exps bindings doc extra acc racc)
    (case exps
      (nil (fan-r (reverse ExpertOutcome acc) (reverse RawCall racc) b))  ; done — hand the handle back
      ((cons e rest)
        (case (call-expert b e doc extra (bnd-model bindings (exp-slot e)) ret-json-findings)
          ((call-r oc raw b2)                         ; thread the fresh handle onward
            (fan-experts b2 rest bindings doc extra (cons oc acc) (cons raw racc))))))))

; gather every fired expert's findings for the combiner (expert-bad contributes none).
(def gather-findings (-> (List ExpertOutcome) (List Finding))
  (lam (ocs)
    (foldl ExpertOutcome (List Finding)
      (lam (acc oc) (case oc
                      ((expert-ok fs raw) (append Finding acc fs))
                      ((expert-bad raw reason) acc)))
      nil ocs)))

; ----------------------------------------------------------------- run-pipeline
; the full loop: plan-run (PURE) -> fan-out -> combiner -> assemble-manifest (PURE).
; A routing failure (no-route / no-fire / unbound) yields an empty run record and
; an empty yield — a VALUE, never a halt. On success the yield is the combiner's
; text (or "" if the combiner call failed). Effect row: exactly (be-chat).
(def run-pipeline
  (=> (1 b Backend) Str (List Pipeline) (List Expert) Config Str (List (Pair Str Str)) RunR)
  (lam (b req pipes pool config doc extra)
    (case (plan-run req pipes pool config doc extra)
      ; a routing failure fires no be-chat, so the handle is untouched — thread it out.
      ; No expert ran, so the raw-corpus list is empty (nil).
      ((plan-no-route listing)    (run-r "" (empty-manifest req "no-route") nil b))
      ((plan-no-fire reason)      (run-r "" (empty-manifest req reason) nil b))
      ((plan-unbound missing cid) (run-r "" (empty-manifest req "unbound") nil b))
      ((plan-ok pid cid routing fired comb bindings)
        (case (fan-experts b fired bindings doc extra nil nil)
          ((fan-r outcomes raws b2)
            (case (call-combiner b2 comb (gather-findings outcomes)
                    (ids-of-experts fired) (bnd-model bindings (exp-slot comb)))
              ((comb-r comb-oc b3)
                (let ((m (assemble-manifest req pid cid routing fired bindings outcomes comb-oc)))
                  (case comb-oc
                    ((combiner-ok y a r)     (run-r y m raws b3))
                    ((combiner-bad r reason) (run-r "" m raws b3))))))))))))
