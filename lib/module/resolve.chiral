; resolve.chiral — multi-module import resolver, chirality-native.
; E87: replaces bin/chirality-resolve.sh. Reads one root module, follows
; (import "...") transitively, concatenates in dependency order with dedup.
; Zero Python. Zero shell.
;
; Search path (E155): the resolver takes a LIST of roots, not one libdir. An
; import names a ROOT-RELATIVE PATH, so it is looked for under each root in
; order and the first root that holds it wins -- an earlier root shadows a
; later one. There is NO importer-directory leg: the key IS the path, so a
; sibling is named by its path like anything else, and a second probing leg
; would be a second way to spell one module.
;
; Extensions. Three of the five kinds are IMPORTABLE and exactly those three are
; probed, in this order: `.chiral` (module), `.port` (port registry),
; `.manifest` (data). `.prog` and `.profile` are NOT import targets -- an entry
; cannot be imported (two entries in one blob is `duplicate label`) and a
; profile names a module set the build consumes -- so they are never probed, and
; `(import "prog/compiler")` is a not-found. Keep this list byte-for-byte in step
; with bin/chirality-resolve.sh: the two providers are pinned against each other.
;
; This file is a LIBRARY. The `compile-main` entry and the stdin protocol it
; parses live in prog/resolve.prog, which is the file you compile to get a
; `resolve` binary; the split (2026-08-25, E170 W0.1) is what lets a program
; with an entry of its own IMPORT the resolver. Usage:
;   printf -- '-L lib\n-L prog\nscriba/scriba-main\n' | ./resolve > blob.chiral
;   chirality-bin < blob.chiral > program.elf
; With no -L line the search path is the default roots `lib` then `prog`:
;   echo scriba/scriba-main | ./resolve > blob.chiral
;
; Module identity. A module's KEY is its ROOT-RELATIVE PATH -- `ports/process`
; and `runtime/proc` are two keys, and `lowering/mach/mach`, `lowering/x64/mach`
; and `lowering/listing/mach` are three. (`lowering/c/mach` was a fourth until
; the C backend was dropped on 2026-09-01.) The directory is the identity,
; which is what makes the old basename-collision class UNREACHABLE rather than
; merely named: two different modules cannot claim one key. Resolution is
; deterministic per key, so the same key seen again IS the same module: deduped,
; and that dedup is what terminates the DFS on cycles and diamonds.
;
; What a path CAN still do is exist under two importable extensions in one root
; (`x.chiral` beside `x.port`): one key, two identities. That is a NAMED ERROR
; (`re-ext-collision`), never a silent pick. bin/chirality-resolve.sh implements
; the same rule.
(import "prelude/prelude")
(import "ports/ports")          ; read, close, fd-write
(import "surface/sexp")           ; read-all-str, Sexp, AllR

; openat: open a file by NUL-terminated Bytes path → fd (or negative errno).
; Declared here instead of importing self-wield to avoid pulling in compile-all.
(extern openat (=> Bytes I64))
(extern close (=> I64 Unit))   ; close(fd)

; ── File I/O helpers ──

(def nul-byte Bytes (bslice (pack-u32 0) 0 1))

; slurp-fd: read an open fd into one Bytes. 64KB chunks until EOF.
;
; NOT named `read-fd-all`, and the rename is load-bearing rather than taste:
; compile-all.chiral:47 defines a `read-fd-all` of its own, and as of E170 W0.2
; this module and that one meet in ONE blob (lib/evidence/test-floor.chiral imports both), where
; two defs of one name is `duplicate label`. The resolver copy is the one that
; moved because compile-all is in the compiler own import closure and this one
; is not -- renaming there would put a self-host fixpoint check on a rename.
(def slurp-fd (=> I64 Bytes)
  (lam (fd)
    (let (chunk (read fd 65536))
      (case (=i (blen chunk) 0)
        (true  (str->bytes ""))
        (false (bcat chunk (slurp-fd fd)))))))

; ── Import parsing ──

; collect-imports: walk a list of Sexp forms, collecting import target strings.
(def collect-imports (-> (List Sexp) (List Str))
  (lam (forms)
    (case forms
      (nil nil)
      ((cons f rest)
        (case f
          ((s-list items)
            (case items
              ((cons head tail)
                (case head
                  ((s-sym h)
                    (case (str-eq h "import")
                      (true (case tail
                        ((cons target nil)
                          (case target
                            ((s-str name)
                              (cons name (collect-imports rest)))
                            (_ (collect-imports rest))))
                        (_ (collect-imports rest))))
                      (false (collect-imports rest))))
                  (_ (collect-imports rest))))
              (nil (collect-imports rest))))
          (_ (collect-imports rest)))))))

; parse-imports: extract module names from (import "name") forms.
; Uses E1's read-all-str to get the Sexp list, then calls collect-imports.
; Pure (->) — no file I/O, works on already-loaded source text.
(def parse-imports (-> Str (List Str))
  (lam (src)
    (case (read-all-str src)
      ((a-err m p) nil)
      ((a-ok forms)
        (collect-imports forms)))))

; ── Pure core: dependency-ordered walk with dedup ──

; A resolved module: its KEY (the root-relative path), the file it resolved
; to (key + extension), and its source text.
(data Mod ()
  (mod (name Str) (path Str) (src Str)))

; Resolution errors.
(data ResErr ()
  (re-not-found (name Str) (from Str))
  (re-read-err  (path Str))
  ; The key is the root-relative PATH, so two DIFFERENT modules can no longer
  ; claim one key -- that collision class is unreachable, not merely named. What
  ; a path CAN still do is exist under two IMPORTABLE extensions in one root
  ; (`x.chiral` beside `x.port`): one key, two identities. Named, never dropped.
  (re-ext-collision (key Str) (path-a Str) (path-b Str)))

; Per-module resolution result.
(data ModR ()
  (mod-ok  (m Mod))
  (mod-err (e ResErr)))

; Overall result sum: seen set + resolved modules, or an error.
; Carries the seen set so resolve-all-list can thread dedup state between deps.
; The seen set holds whole Mods, not bare names: deciding "same module again"
; vs "different module, same basename" needs the identity, not just the key.
(data ResR ()
  (res-ok  (seen (List Mod)) (mods (List Mod)))
  (res-err (err ResErr)))

; seen-insert: return (pair seen was-new?) where was-new? = name not already present.
(def seen-insert (-> (List Str) Str (Pair (List Str) Bool))
  (lam (seen name)
    (case seen
      (nil (pair (cons name nil) true))
      ((cons h t)
        (case (str-eq h name)
          (true  (pair seen false))
          (false (case (seen-insert t name)
                   ((pair t2 was-new)
                    (pair (cons h t2) was-new)))))))))

; lookup-mod: find a Mod by name in an alist.
(def lookup-mod (-> (List Mod) Str (Maybe Mod))
  (lam (mods name)
    (case mods
      (nil (none))
      ((cons m rest)
        (case m ((mod mname mpath msrc)
          (case (str-eq mname name)
            (true  (some m))
            (false (lookup-mod rest name)))))))))

; walk-imports: recursively walk one module's imports, accumulating ordered mods.
; Pure (->) — threads seen set and accumulating order list.
; Forward-declared for mutual recursion with walk-list.
(declare walk-imports
  (-> (List Str) (List Mod) (List Mod) Mod (Pair (List Str) (List Mod))))

; walk-list: walk a list of dependency names.
; Forward-declared for mutual recursion with walk-imports.
(declare walk-list
  (-> (List Str) (List Mod) (List Mod) (List Str) (Pair (List Str) (List Mod))))
(def walk-imports
  (lam (seen all order mod)
    (case mod ((mod name path src)
      (case (seen-insert seen name) ((pair seen2 is-new)
        (case is-new
          (false (pair seen2 order))
          (true
            (let (deps (parse-imports src))
              (let (r (walk-list seen2 all order deps))
                (case r ((pair seen3 order2)
                  (pair seen3 (cons mod order2))))))))))))))

; walk-list: walk a list of dependency names.
(def walk-list
  (lam (seen all order deps)
    (case deps
      (nil (pair seen order))
      ((cons d rest)
        (case (lookup-mod all d)
          ((none)    (walk-list seen all order rest))
          ((some m)  (case (walk-imports seen all order m)
                       ((pair seen2 order2)
                         (walk-list seen2 all order2 rest)))))))))

; ── Effectful driver ──

; open-ext: attempt to open <root>/<name><ext>. fd, or negative.
(def open-ext (=> Str Str Str I64)
  (lam (root name ext)
    (let (full (str-cat root (str-cat "/" (str-cat name ext))))
      (openat (bcat (str->bytes full) nul-byte)))))

; close-if: close an fd that was actually opened. A negative fd is a miss, not
; a descriptor, and closing it would be closing whatever -errno happens to name.
(def close-if (=> I64 Unit)
  (lam (fd)
    (case (<i fd 0)
      (true  (unit))
      (false (close fd)))))

; The outcome of a search-path probe: a closed sum, not a sentinel fd.
(data OpenR ()
  (open-hit   (rel Str) (fd I64))
  (open-miss)
  ; one key, two importable extensions under ONE root -- see re-ext-collision.
  (open-ambig (path-a Str) (path-b Str)))

; try-exts: probe <root>/<name> under the three IMPORTABLE extensions.
; Exactly one hit is a hit; two is the named ambiguity; none is a miss. Every fd
; this opens is either returned in the hit or closed here.
(def try-exts (=> Str Str OpenR)
  (lam (root name)
    (let (fc (open-ext root name ".chiral"))
      (let (fp (open-ext root name ".port"))
        (let (fm (open-ext root name ".manifest"))
          (case (<i fc 0)
            (false
              (case (<i fp 0)
                (false (let (_ (close-if fc)) (let (_ (close-if fp)) (let (_ (close-if fm))
                         (open-ambig (str-cat name ".chiral") (str-cat name ".port"))))))
                (true
                  (case (<i fm 0)
                    (false (let (_ (close-if fc)) (let (_ (close-if fm))
                             (open-ambig (str-cat name ".chiral") (str-cat name ".manifest")))))
                    (true (open-hit (str-cat name ".chiral") fc))))))
            (true
              (case (<i fp 0)
                (false
                  (case (<i fm 0)
                    (false (let (_ (close-if fp)) (let (_ (close-if fm))
                             (open-ambig (str-cat name ".port") (str-cat name ".manifest")))))
                    (true (open-hit (str-cat name ".port") fp))))
                (true
                  (case (<i fm 0)
                    (false (open-hit (str-cat name ".manifest") fm))
                    (true (open-miss))))))))))))

; try-roots: probe <root>/<name>.{chiral,port,manifest} for each search root IN
; ORDER. First root that holds the key wins -- that is what makes a multi-root
; search path a search path (an earlier root shadows a later one) rather than a
; collision. An ambiguity inside ONE root is not shadowable and stops the walk.
(def try-roots (=> (List Str) Str OpenR)
  (lam (roots name)
    (case roots
      (nil (open-miss))
      ((cons r rest)
        (case (try-exts r name)
          ((open-miss)        (try-roots rest name))
          ((open-hit rel fd)  (open-hit rel fd))
          ((open-ambig a b)   (open-ambig a b)))))))

; resolve-mod: read one module source from the filesystem. The module's KEY is
; the name as written in the import -- the root-relative path -- so there is
; nothing to derive and no second spelling to reconcile.
(def resolve-mod (=> (List Str) Str Str ModR)
  (lam (roots name from-name)
    (case (try-roots roots name)
      ((open-miss)      (mod-err (re-not-found name from-name)))
      ((open-ambig a b) (mod-err (re-ext-collision name a b)))
      ((open-hit rel fd)
        (let (src-bytes (slurp-fd fd))
          (let (_ (close fd))
            (let (src (bytes->str src-bytes))
              (mod-ok (mod name rel src)))))))))

; resolve-all: recursively resolve a root module and all its transitive imports.
; Forward-declared for mutual recursion with resolve-all-list.
(declare resolve-all (=> (List Str) Str Str (List Mod) (List Mod) ResR))

; resolve-all-list: resolve a list of dependency names with importer context.
(declare resolve-all-list (=> (List Str) (List Str) Str (List Mod) (List Mod) ResR))

(def resolve-all
  (lam (roots root-name from-name seen acc)
    (case (lookup-mod seen root-name)
      ; Key already claimed. The key is the root-relative PATH and resolution is
      ; deterministic per key, so a repeat key IS the same module: a re-import,
      ; deduped. That dedup is what terminates the DFS on cycles and diamonds,
      ; and it must stay. (It is checked BEFORE the open, so a diamond costs one
      ; read of its shared vertex rather than one per edge into it.)
      ((some _) (res-ok seen acc))
      ((none)
        (case (resolve-mod roots root-name from-name)
          ((mod-err e) (res-err e))
          ((mod-ok mod)
            (case mod ((mod mod-key mod-path mod-src)
              (let (seen2 (cons mod seen))
                (let (deps (parse-imports mod-src))
                  ; Resolve deps first, then cons this module onto the FRONT.
                  ; This accumulates the list in reverse dependency order
                  ; (dependents before their deps) -- the standard cons-accumulate
                  ; idiom. `bundle` applies the single terminal `rev-mods` so the
                  ; emitted blob is dependency-first (deps before dependents),
                  ; which the single-pass loader requires.
                  (case (resolve-all-list roots deps mod-path seen2 acc)
                    ((res-err e) (res-err e))
                    ((res-ok seen3 mods)
                      (res-ok seen3 (cons mod mods))))))))))))))

; resolve-all-list: resolve a list of dependency names, threading seen set.
(def resolve-all-list
  (lam (roots deps from-name seen acc)
    (case deps
      (nil (res-ok seen acc))
      ((cons d rest)
        (case (resolve-all roots d from-name seen acc)
          ((res-err e) (res-err e))
          ((res-ok seen2 acc2)
            (resolve-all-list roots rest from-name seen2 acc2)))))))

; rev-mods: reverse a module list (accumulator, O(n)). resolve-all builds the
; list by cons-prepending each module as its subtree completes, so the raw list
; is reverse-topological (dependents ahead of deps). One reverse restores
; dependency order for the single-pass loader. Local + monomorphic to keep the
; resolver's import set minimal (mirrors seen-insert / lookup-mod).
(def rev-mods (-> (List Mod) (List Mod) (List Mod))
  (lam (xs acc)
    (case xs
      (nil acc)
      ((cons h t) (rev-mods t (cons h acc))))))

; concat-mods: flatten the resolved modules into one blob.
;
; E161 -- the DECLARED module extent. Concatenation is where module identity is
; destroyed: the provider knows every boundary and the compiler, being pure
; (Str -> ELF), sees none of them. So the boundary is written down here, as one
; `(end-module "<name>")` form after each module's source, naming that module's
; KEY -- `Mod`'s `name` field, which is the root-relative path the import named.
; Downstream, the loader closes the module's coordinate at that form instead of
; guessing from an `import`, and a file's own `(module <path> ...)` coordinate is
; checked against it.
;
; Keep this byte-for-byte identical to bin/chirality-resolve.sh's emit loop: the two
; providers are pinned against each other AND against a fixed expected blob,
; because two providers agreeing on the same wrong marker is a failure a
; differential alone cannot see.
(def concat-mods (-> (List Mod) Str)
  (lam (mods)
    (case mods
      (nil "")
      ((cons m rest)
        (case m ((mod name _ src)
          (str-cat src
            (str-cat "\n(end-module \""
              (str-cat name
                (str-cat "\")\n" (concat-mods rest)))))))))))

; ── Entry point ──

; Final bundler output.
(data BundleR ()
  (bundle-ok  (blob Str))
  (bundle-err (err ResErr)))

; bundle: the main bundler. search path + root module name → flat source.
(def bundle (=> (List Str) Str BundleR)
  (lam (roots root-name)
    (case (resolve-all roots root-name "" nil nil)
      ((res-err e) (bundle-err e))
      ((res-ok _ mods)
        (bundle-ok (concat-mods (rev-mods mods nil)))))))

; bundle-src: the ARBITRARY-PATH ROOT case -- bin/chirality-resolve.sh's
; `chirality_blob_file`, in chirality. `bundle` above takes a MODULE NAME and finds it on
; the search path; a caller holding a file that is not a module of any search root
; (a test root under samples/, a fixture in a mktemp dir) has no module
; key to offer, so it hands over the root's SOURCE and this resolves the imports
; that source declares.
;
; The root is appended LAST and gets NO `(end-module ...)` marker, byte-for-byte
; as the shell provider does it and for the reason chirality_blob_file states in its
; own words: a file at an arbitrary path has no resolver key, so naming its extent
; after its filename would make E161's coordinate/extent check compare a declared
; coordinate against a mktemp name. Its one trailing extent runs to EOF.
;
; It opens NO file -- the caller already holds the bytes. That is what lets
; test-floor's `observe` keep two diagnoses apart: `ob-nofile` is about the ROOT,
; which `observe` opened itself, and `ob-nobuild` is about the IMPORTS, which this
; resolved. A path-taking bundler would collapse both into one error arm, and
; "the file was not there" is not what "the imports did not resolve" means.
;
; Deps are resolved with an EMPTY importer directory, matching chirality_blob_file's
; `chirality_blob "$rootspec" $deps`: the root is not on the search path, so there is no
; importer-directory leg to try for it.
(def bundle-src (=> (List Str) Str BundleR)
  (lam (roots src)
    (case (resolve-all-list roots (parse-imports src) "" nil nil)
      ((res-err e) (bundle-err e))
      ((res-ok _ mods)
        (bundle-ok (str-cat (concat-mods (rev-mods mods nil))
                     (str-cat src "\n")))))))

; ── The library ENDS here ──
;
; The stdin protocol, its parser and the `compile-main` entry moved to
; prog/resolve.prog on 2026-08-25 (E170 W0.1). Reason: five
; modules define `compile-main` (`grep -ln "def compile-main" prog/*.prog`),
; so any program that IMPORTS this file collides on the entry symbol at its own
; root. lib/evidence/test-floor.chiral is the first such importer -- `observe`
; resolves a root's imports through this library -- and the split is the
; tree's own precedent, the one compile-all.chiral states in its own words:
; "A library that also defines the entry symbol makes every program embedding
; the compiler collide on it". Same shape as compile-all / compile-driver and
; closconv / closconv-driver.
;
; `res-err-msg` stays HERE and not in the driver: it renders a `ResErr` and the
; driver is not its only caller any more -- `observe` needs the same sentence to
; say "the imports did not resolve" instead of "no such file".

(def res-err-msg (-> ResErr Str)
  (lam (e)
    (case e
      ((re-not-found name from)
        (str-cat "resolve: module not found: " (str-cat name "\n")))
      ((re-read-err path)
        (str-cat "resolve: cannot read: " (str-cat path "\n")))
      ((re-ext-collision key path-a path-b)
        (str-cat "resolve: module extension collision on '"
          (str-cat key
            (str-cat "': "
              (str-cat path-a
                (str-cat " and "
                  (str-cat path-b
                    " both resolve it -- one key, two identities; rename one\n"))))))))))
