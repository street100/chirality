; resolve.metis — multi-module import resolver, metis-native.
; E87: replaces metis-resolve.sh. Reads one root module, follows (import "...")
; transitively, concatenates in dependency order with basename deduplication.
; Zero Python. Zero shell.
;
; Search path (E155): the resolver takes a LIST of roots, not one libdir. An
; import is looked for under <importer-dir> in every root, in order, then under
; the bare name in every root, in order; first hit wins, so an earlier root
; shadows a later one. The importer-directory leg is what lets scriba's
; subdirectory modules import their siblings, and matches the shell resolver.
;
; This file is a LIBRARY. The `compile-main` entry and the stdin protocol it
; parses live in scaffold/lib/resolve-driver.metis, which is the file you
; compile to get a `resolve` binary; the split (2026-08-25, E170 W0.1) is what
; lets a program with an entry of its own IMPORT the resolver. Usage is
; unchanged:
;   printf -- '-L scaffold/lib\nscriba/scriba-main\n' | ./resolve > blob.metis
;   B1 < blob.metis > program.elf
; With no -L line the search path is the single default root `scaffold/lib`:
;   echo scriba/scriba-main | ./resolve > blob.metis
;
; Module identity (E155). A module's KEY is its basename: `ports/proc` and
; `proc` are one key, `proc`. First-occurrence-wins on that key would SILENTLY
; DROP one of two distinct modules, so the key is paired with an IDENTITY --
; here the module's source text, the only identity this substrate can read
; (there is no realpath/stat crossing, and `scaffold/lib/scriba/prelude.metis`
; is a symlink to `scaffold/lib/prelude.metis`, so a path string is not an
; identity). Same key + same source = a re-import: deduped, and that dedup is
; what terminates the DFS on cycles and diamonds. Same key + DIFFERENT source =
; a collision, and a collision is a NAMED ERROR (`re-collision`), never a drop.
; `bin/metis-resolve.sh` implements the same rule (canonical path, then bytes).

(import "prelude")
(import "ports")          ; read, close, fd-write
(import "sexp")           ; read-all-str, Sexp, AllR

; openat: open a file by NUL-terminated Bytes path → fd (or negative errno).
; Declared here instead of importing self-wield to avoid pulling in compile-all.
(extern openat (=> Bytes I64))
(extern close (=> I64 Unit))   ; close(fd)

; ── File I/O helpers ──

(def nul-byte Bytes (bslice (pack-u32 0) 0 1))

; dir-of: extract the directory portion of a module path.
; "scriba/scriba-main" -> "scriba", "prelude" -> "", "" -> ""
(def dir-of (-> Str Str)
  (lam (s)
    (let (idx (str-find s "/"))
      (case (<i idx 0)
        (true "")
        (false (str-sub s 0 idx))))))

; last-slash: index of the LAST "/" in s, or -1. Scans forward with
; str-find-from, keeping the newest hit; `from` strictly increases, so total.
(def last-slash (-> Str I64 I64 I64)
  (lam (s from best)
    (let (i (str-find-from s "/" from))
      (case (<i i 0)
        (true  best)
        (false (last-slash s (+ i 1) i))))))

; base-of: the module KEY -- everything after the last "/".
; "ports/proc" -> "proc", "proc" -> "proc", "a/b/c" -> "c"
(def base-of (-> Str Str)
  (lam (s)
    (let (i (last-slash s 0 (- 0 1)))
      (case (<i i 0)
        (true  s)
        (false (str-sub s (+ i 1) (str-len s)))))))

; slurp-fd: read an open fd into one Bytes. 64KB chunks until EOF.
;
; NOT named `read-fd-all`, and the rename is load-bearing rather than taste:
; compile-all.metis:47 defines a `read-fd-all` of its own, and as of E170 W0.2
; this module and that one meet in ONE blob (test-floor.metis imports both), where
; two defs of one name is `duplicate label`. The resolver copy is the one that
; moved because compile-all is in the compiler own import closure and this one
; is not -- renaming there would put a self-host fixpoint check on a rename.
(def slurp-fd (=> I64 Bytes)
  (lam (fd)
    (let (chunk (read fd 65536))
      (case (=i (blen chunk) 0)
        (true  (str->bytes ""))
        (false (bcat chunk (slurp-fd fd)))))))

; ── Import parsing ──

; collect-imports: walk a list of Sexp forms, collecting import target strings.
(def collect-imports (-> (List Sexp) (List Str))
  (lam (forms)
    (case forms
      (nil nil)
      ((cons f rest)
        (case f
          ((s-list items)
            (case items
              ((cons head tail)
                (case head
                  ((s-sym h)
                    (case (str-eq h "import")
                      (true (case tail
                        ((cons target nil)
                          (case target
                            ((s-str name)
                              (cons name (collect-imports rest)))
                            (_ (collect-imports rest))))
                        (_ (collect-imports rest))))
                      (false (collect-imports rest))))
                  (_ (collect-imports rest))))
              (nil (collect-imports rest))))
          (_ (collect-imports rest)))))))

; parse-imports: extract module names from (import "name") forms.
; Uses E1's read-all-str to get the Sexp list, then calls collect-imports.
; Pure (->) — no file I/O, works on already-loaded source text.
(def parse-imports (-> Str (List Str))
  (lam (src)
    (case (read-all-str src)
      ((a-err m p) nil)
      ((a-ok forms)
        (collect-imports forms)))))

; ── Pure core: dependency-ordered walk with dedup ──

; A resolved module: its KEY (basename), the path it resolved to, source text.
(data Mod ()
  (mod (name Str) (path Str) (src Str)))

; Resolution errors.
(data ResErr ()
  (re-not-found (name Str) (from Str))
  (re-read-err  (path Str))
  ; E155: two DIFFERENT modules claimed one basename. Named, not dropped.
  (re-collision (base Str) (path-a Str) (path-b Str)))

; Per-module resolution result.
(data ModR ()
  (mod-ok  (m Mod))
  (mod-err (e ResErr)))

; Overall result sum: seen set + resolved modules, or an error.
; Carries the seen set so resolve-all-list can thread dedup state between deps.
; The seen set holds whole Mods, not bare names: deciding "same module again"
; vs "different module, same basename" needs the identity, not just the key.
(data ResR ()
  (res-ok  (seen (List Mod)) (mods (List Mod)))
  (res-err (err ResErr)))

; seen-insert: return (pair seen was-new?) where was-new? = name not already present.
(def seen-insert (-> (List Str) Str (Pair (List Str) Bool))
  (lam (seen name)
    (case seen
      (nil (pair (cons name nil) true))
      ((cons h t)
        (case (str-eq h name)
          (true  (pair seen false))
          (false (case (seen-insert t name)
                   ((pair t2 was-new)
                    (pair (cons h t2) was-new)))))))))

; lookup-mod: find a Mod by name in an alist.
(def lookup-mod (-> (List Mod) Str (Maybe Mod))
  (lam (mods name)
    (case mods
      (nil (none))
      ((cons m rest)
        (case m ((mod mname mpath msrc)
          (case (str-eq mname name)
            (true  (some m))
            (false (lookup-mod rest name)))))))))

; walk-imports: recursively walk one module's imports, accumulating ordered mods.
; Pure (->) — threads seen set and accumulating order list.
; Forward-declared for mutual recursion with walk-list.
(declare walk-imports
  (-> (List Str) (List Mod) (List Mod) Mod (Pair (List Str) (List Mod))))

; walk-list: walk a list of dependency names.
; Forward-declared for mutual recursion with walk-imports.
(declare walk-list
  (-> (List Str) (List Mod) (List Mod) (List Str) (Pair (List Str) (List Mod))))
(def walk-imports
  (lam (seen all order mod)
    (case mod ((mod name path src)
      (case (seen-insert seen name) ((pair seen2 is-new)
        (case is-new
          (false (pair seen2 order))
          (true
            (let (deps (parse-imports src))
              (let (r (walk-list seen2 all order deps))
                (case r ((pair seen3 order2)
                  (pair seen3 (cons mod order2))))))))))))))

; walk-list: walk a list of dependency names.
(def walk-list
  (lam (seen all order deps)
    (case deps
      (nil (pair seen order))
      ((cons d rest)
        (case (lookup-mod all d)
          ((none)    (walk-list seen all order rest))
          ((some m)  (case (walk-imports seen all order m)
                       ((pair seen2 order2)
                         (walk-list seen2 all order2 rest)))))))))

; ── Effectful driver ──

; open-at-root: attempt to open <root>/<subdir>/<name>.metis. fd, or negative.
(def open-at-root (=> Str Str Str I64)
  (lam (root subdir name)
    (let (fname (str-cat name ".metis"))
      (let (full
            (case (str-eq subdir "")
              (true (str-cat root (str-cat "/" fname)))
              (false (str-cat root
                       (str-cat "/" (str-cat subdir (str-cat "/" fname)))))))
        (openat (bcat (str->bytes full) nul-byte))))))

; The outcome of a search-path probe: a closed sum, not a sentinel fd.
(data OpenR ()
  (open-hit  (rel Str) (fd I64))
  (open-miss))

; try-roots: probe <root>/<subdir>/<name>.metis for each search root IN ORDER.
; First hit wins — that is what makes a multi-root search path a search path
; (an earlier root shadows a later one) rather than a collision.
(def try-roots (=> (List Str) Str Str OpenR)
  (lam (roots subdir name)
    (case roots
      (nil (open-miss))
      ((cons r rest)
        (let (fd (open-at-root r subdir name))
          (case (<i fd 0)
            (true  (try-roots rest subdir name))
            (false (open-hit
                     (case (str-eq subdir "")
                       (true name)
                       (false (str-cat subdir (str-cat "/" name))))
                     fd))))))))

; resolve-mod: read one module source from the filesystem.
; Tries the importer's directory under every search root first, then the bare
; name under every search root. Returns the module's KEY (basename) plus the
; path it resolved to and its source.
(def resolve-mod (=> (List Str) Str Str ModR)
  (lam (roots name from-name)
    (let (from-dir (dir-of from-name))
      (let (hit
            (case (str-eq from-dir "")
              (true (try-roots roots "" name))
              (false
                (case (try-roots roots from-dir name)
                  ((open-miss)       (try-roots roots "" name))
                  ((open-hit rel fd) (open-hit rel fd))))))
        (case hit
          ((open-miss) (mod-err (re-not-found name from-name)))
          ((open-hit rel fd)
            (let (src-bytes (slurp-fd fd))
              (let (_ (close fd))
                (let (src (bytes->str src-bytes))
                  (mod-ok (mod (base-of name) rel src)))))))))))

; resolve-all: recursively resolve a root module and all its transitive imports.
; Forward-declared for mutual recursion with resolve-all-list.
(declare resolve-all (=> (List Str) Str Str (List Mod) (List Mod) ResR))

; resolve-all-list: resolve a list of dependency names with importer context.
(declare resolve-all-list (=> (List Str) (List Str) Str (List Mod) (List Mod) ResR))

(def resolve-all
  (lam (roots root-name from-name seen acc)
    (case (resolve-mod roots root-name from-name)
      ((mod-err e)
        ; Unresolvable from HERE. If the key is already in the blob the module
        ; was reached from another importer directory — still a re-import, not
        ; a miss. Only an unseen key is a genuine not-found.
        (case (lookup-mod seen (base-of root-name))
          ((some _) (res-ok seen acc))
          ((none)   (res-err e))))
      ((mod-ok mod)
        (case mod ((mod mod-base mod-path mod-src)
          (case (lookup-mod seen mod-base)
            ; Key already claimed — same source is a re-import, different
            ; source is the collision this element exists to refuse.
            ((some prev)
              (case prev ((mod _ prev-path prev-src)
                (case (str-eq prev-src mod-src)
                  (true  (res-ok seen acc))
                  (false (res-err (re-collision mod-base prev-path mod-path)))))))
            ((none)
              (let (seen2 (cons mod seen))
                (let (deps (parse-imports mod-src))
                  ; Resolve deps first, then cons this module onto the FRONT.
                  ; This accumulates the list in reverse dependency order
                  ; (dependents before their deps) — the standard cons-accumulate
                  ; idiom. `bundle` applies the single terminal `rev-mods` so the
                  ; emitted blob is dependency-first (deps before dependents),
                  ; which the single-pass loader requires.
                  (case (resolve-all-list roots deps mod-path seen2 acc)
                    ((res-err e) (res-err e))
                    ((res-ok seen3 mods)
                      (res-ok seen3 (cons mod mods))))))))))))))

; resolve-all-list: resolve a list of dependency names, threading seen set.
(def resolve-all-list
  (lam (roots deps from-name seen acc)
    (case deps
      (nil (res-ok seen acc))
      ((cons d rest)
        (case (resolve-all roots d from-name seen acc)
          ((res-err e) (res-err e))
          ((res-ok seen2 acc2)
            (resolve-all-list roots rest from-name seen2 acc2)))))))

; rev-mods: reverse a module list (accumulator, O(n)). resolve-all builds the
; list by cons-prepending each module as its subtree completes, so the raw list
; is reverse-topological (dependents ahead of deps). One reverse restores
; dependency order for the single-pass loader. Local + monomorphic to keep the
; resolver's import set minimal (mirrors seen-insert / lookup-mod).
(def rev-mods (-> (List Mod) (List Mod) (List Mod))
  (lam (xs acc)
    (case xs
      (nil acc)
      ((cons h t) (rev-mods t (cons h acc))))))

; concat-mods: flatten the resolved modules into one blob.
;
; E161 -- the DECLARED module extent. Concatenation is where module identity is
; destroyed: the provider knows every boundary and the compiler, being pure
; (Str -> ELF), sees none of them. So the boundary is written down here, as one
; `(end-module "<name>")` form after each module's source, naming that module's
; KEY -- `Mod`'s `name` field, which resolve-mod already fills with `base-of`,
; the same E155 basename the dedup uses. Downstream, the loader closes the
; module's coordinate at that form instead of guessing from an `import`.
;
; Keep this byte-for-byte identical to bin/metis-resolve.sh's emit loop: the two
; providers are pinned against each other AND against a fixed expected blob,
; because two providers agreeing on the same wrong marker is a failure a
; differential alone cannot see.
(def concat-mods (-> (List Mod) Str)
  (lam (mods)
    (case mods
      (nil "")
      ((cons m rest)
        (case m ((mod name _ src)
          (str-cat src
            (str-cat "\n(end-module \""
              (str-cat name
                (str-cat "\")\n" (concat-mods rest)))))))))))

; ── Entry point ──

; Final bundler output.
(data BundleR ()
  (bundle-ok  (blob Str))
  (bundle-err (err ResErr)))

; bundle: the main bundler. search path + root module name → flat source.
(def bundle (=> (List Str) Str BundleR)
  (lam (roots root-name)
    (case (resolve-all roots root-name "" nil nil)
      ((res-err e) (bundle-err e))
      ((res-ok _ mods)
        (bundle-ok (concat-mods (rev-mods mods nil)))))))

; bundle-src: the ARBITRARY-PATH ROOT case -- bin/metis-resolve.sh's
; `metis_blob_file`, in metis. `bundle` above takes a MODULE NAME and finds it on
; the search path; a caller holding a file that is not a module of any search root
; (a test root under scaffold/samples/, a fixture in a mktemp dir) has no module
; key to offer, so it hands over the root's SOURCE and this resolves the imports
; that source declares.
;
; The root is appended LAST and gets NO `(end-module ...)` marker, byte-for-byte
; as the shell provider does it and for the reason metis_blob_file states in its
; own words: a file at an arbitrary path has no resolver key, so naming its extent
; after its filename would make E161's coordinate/extent check compare a declared
; coordinate against a mktemp name. Its one trailing extent runs to EOF.
;
; It opens NO file -- the caller already holds the bytes. That is what lets
; test-floor's `observe` keep two diagnoses apart: `ob-nofile` is about the ROOT,
; which `observe` opened itself, and `ob-nobuild` is about the IMPORTS, which this
; resolved. A path-taking bundler would collapse both into one error arm, and
; "the file was not there" is not what "the imports did not resolve" means.
;
; Deps are resolved with an EMPTY importer directory, matching metis_blob_file's
; `metis_blob "$libdir" $deps`: the root is not on the search path, so there is no
; importer-directory leg to try for it.
(def bundle-src (=> (List Str) Str BundleR)
  (lam (roots src)
    (case (resolve-all-list roots (parse-imports src) "" nil nil)
      ((res-err e) (bundle-err e))
      ((res-ok _ mods)
        (bundle-ok (str-cat (concat-mods (rev-mods mods nil))
                     (str-cat src "\n")))))))

; ── The library ENDS here ──
;
; The stdin protocol, its parser and the `compile-main` entry moved to
; scaffold/lib/resolve-driver.metis on 2026-08-25 (E170 W0.1). Reason: five
; modules define `compile-main` (`grep -ln "def compile-main" scaffold/lib/*.metis`),
; so any program that IMPORTS this file collides on the entry symbol at its own
; root. scaffold/lib/test-floor.metis is the first such importer -- `observe`
; resolves a root's imports through this library -- and the split is the
; tree's own precedent, the one compile-all.metis states in its own words:
; "A library that also defines the entry symbol makes every program embedding
; the compiler collide on it". Same shape as compile-all / compile-driver and
; closconv / closconv-driver.
;
; `res-err-msg` stays HERE and not in the driver: it renders a `ResErr` and the
; driver is not its only caller any more -- `observe` needs the same sentence to
; say "the imports did not resolve" instead of "no such file".

(def res-err-msg (-> ResErr Str)
  (lam (e)
    (case e
      ((re-not-found name from)
        (str-cat "resolve: module not found: " (str-cat name "\n")))
      ((re-read-err path)
        (str-cat "resolve: cannot read: " (str-cat path "\n")))
      ((re-collision base path-a path-b)
        (str-cat "resolve: module basename collision on '"
          (str-cat base
            (str-cat "': already resolved "
              (str-cat path-a
                (str-cat ".metis, now resolving "
                  (str-cat path-b
                    ".metis -- two DIFFERENT modules cannot share a basename; rename one\n"))))))))))
