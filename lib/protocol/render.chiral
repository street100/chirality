(import "prelude/prelude")
(import "ports/ports")
(import "protocol/utf8")

; ─── Data declarations ───

(data Rendering ()
  (r-text   (content Str) (bold Bool))
  (r-table  (headers (List Str)) (rows (List (List Rendering))))
  (r-section (title Str) (collapsed Bool) (body Rendering))
  (r-stream (source-id Str))
  (r-tree   (children (List Rendering)) (selected Rendering))
  (r-lines  (children (List Rendering)))
  (r-hole   (label Str))
  (r-face   (face Str) (body Rendering))
  ; ─── E174: the ninth constructor — HORIZONTAL composition ───
  ; The sibling r-lines never had. Its children are laid left to right on one
  ; row, each starting exactly where the previous one ENDED — which is why this
  ; constructor cannot exist without `rnd-cols` below.
  ;
  ; NO IMPLICIT SEPARATOR, deliberately. The two horizontal placers this module
  ; already had each bake a gap in (a 2-column header gutter, a 16-column cell
  ; grid) and the measured consequence is one r-table value with two layouts. A
  ; combinator with a baked-in gap cannot express "no gap", which is exactly
  ; what two adjacent tagged spans need. A caller who wants a gap writes one
  ; more child: (r-text " " false).
  ;
  ; A STACKED CHILD IS ALLOWED, and it is allowed rather than accidental: a
  ; multi-row child (r-lines, r-tree, an open r-section, a table) makes the row
  ; occupy several rows, and the next sibling still starts at the child's
  ; widest column. That is what `rnd-cols` returning the widest row means.
  (r-row    (children (List Rendering))))

(data RendererFn ()
  (rf (fn (-> Str (Pair I64 I64) I64 Rendering))))

(data Face ()
  (face (name Str) (fg I64) (bg I64) (attrs I64)))

; A mode binds a port-kind to its view: the renderer that actually renders the
; buffer content, plus the face set that renderer emits.
(data Mode ()
  (mode (renderer RendererFn) (faces (List (Pair Str Face)))))

(data Diff ()
  (diff-same)
  (diff-changed (node Rendering)))

; ─── Forward declares — all type signatures before any def body ───

(declare lookup-mode
  (-> (List (Pair Str Mode)) Str (Maybe Mode)))

(declare register-mode
  (-> (List (Pair Str Mode)) Str Mode (List (Pair Str Mode))))

(declare lookup-face (-> (List (Pair Str Face)) Str Face))

(declare sgr-code (-> I64 Str))

(declare face-sgr (-> Face Str))

(declare face-join (-> Face Face Face))

(declare rnd-restore (=> Face Unit))

(declare bool-eq (-> Bool Bool Bool))

(declare list-all-eq-str (-> (List Str) (List Str) Bool))

(declare diff-node (-> Rendering Rendering Diff))

(declare list-all-diff-same (-> (List Rendering) (List Rendering) Bool))

(declare rnd-append-list (-> (List Rendering) (List Rendering) (List Rendering)))

(declare rnd-flatten-rows (-> (List (List Rendering)) (List Rendering) (List Rendering)))

(declare rnd-diff-table (-> (List Str) (List Str) (List Rendering) (List Rendering) Rendering Diff))

(declare rnd-diff-tree (-> Rendering Rendering (List Rendering) (List Rendering) Rendering Diff))

(declare ansi-goto (-> I64 I64 Str))

; ─── E174: the width function (pure) — declares ───

(declare cp-count (-> (List I64) I64 I64))

(declare str-cols (-> Str I64))

(declare rnd-cols (-> Rendering I64))

(declare rnd-cols-max (-> (List Rendering) I64 I64))

(declare rnd-hdr-cols (-> (List Str) I64 I64))

(declare rnd-row-cells (-> (List (List Rendering)) I64 I64 I64))

(declare rnd-cols-sum (-> (List Rendering) I64 I64))

(declare render-row (=> (List Rendering) (Pair I64 I64) I64 I64 I64 I64 Face Unit))

(declare render-to-ansi
  (=> Rendering (Pair I64 I64) (Maybe Rendering)
      I64 I64 I64 I64 Face Unit))

(declare render-table (=> (List Str) (List (List Rendering)) (Pair I64 I64) I64 I64 Face Unit))

(declare rnd-emit-headers (=> (List Str) I64 I64 Face Unit))

(declare rnd-emit-rows (=> (List (List Rendering)) (Pair I64 I64) I64 I64 Face Unit))

(declare rnd-emit-one-row (=> (List Rendering) (Pair I64 I64) I64 I64 Face Unit))

(declare render-section (=> Str Bool Rendering (Pair I64 I64) I64 I64 I64 I64 Face Unit))

(declare rnd-is-selected (-> Rendering Rendering Bool))

(declare render-tree (=> (List Rendering) Rendering (Pair I64 I64) I64 I64 I64 I64 Face Unit))

(declare render-lines (=> (List Rendering) (Pair I64 I64) I64 I64 I64 I64 Face Unit))

(declare render-to-ansi-full (=> Rendering (Pair I64 I64) Unit))

(declare render-to-ansi-delta (=> Rendering Rendering (Pair I64 I64) Unit))

; ─── Renderer registry (pure) — inline alist lookup, no collections import ───

(def lookup-mode
  (lam (reg name)
    (case reg
      (nil none)
      ((cons h rest)
        (case h
          ((pair k v)
            (case (str-eq k name)
              (true (some v))
              (false (lookup-mode rest name)))))))))

(def register-mode
  (lam (reg type-name m)
    (cons (pair type-name m) reg)))

; ─── Face registry (pure) ─────────────────────────────────────────────────

; The default face table. fg/bg are SGR color indices 0-7, -1 = default.
; attrs is a bitmask: 1 = bold, 2 = underline, 4 = italic.
(def default-faces (List (Pair Str Face))
  (cons (pair "default" (face "default" -1 -1 0))
  (cons (pair "comment" (face "comment" 2 -1 0))
  (cons (pair "keyword" (face "keyword" 1 -1 1))
  (cons (pair "string"  (face "string" 3 -1 0))
  (cons (pair "error"   (face "error" 1 -1 2))
  (cons (pair "manas-tag"    (face "manas-tag"    1 -1 1))
  (cons (pair "manas-field"  (face "manas-field"  4 -1 1))
  (cons (pair "manas-header" (face "manas-header" 7 -1 1))
  ; S15 run-view: a good expert row (green) and a failed / routing-failure row (red).
  (cons (pair "manas-ok"   (face "manas-ok"   2 -1 1))
  (cons (pair "manas-bad"  (face "manas-bad"  1 -1 2))
  ; N1 outline: the navigable cursor row — reverse video (attr bit 8 = SGR 7).
  (cons (pair "manas-cursor" (face "manas-cursor" -1 -1 8))
  nil))))))))))))

(def lookup-face
  (lam (reg name)
    (case reg
      (nil (face name -1 -1 0))
      ((cons h rest)
        (case h
          ((pair k v)
            (case (str-eq k name)
              (true v)
              (false (lookup-face rest name)))))))))

; ESC = byte 27. chirality string escapes are only \n \t \" \\ (any other \X is the
; literal byte X), so there is no \x1b escape — build the escape byte explicitly.
(def ansi-esc Str (bytes->str (bslice (pack-u32 27) 0 1)))

; One SGR parameter code: ESC[<n>m.
(def sgr-code
  (lam (n)
    (str-cat (str-cat (str-cat ansi-esc "[") (i64->str n)) "m")))

; Build the full SGR prefix for a face (attr codes, then fg, then bg).
; attrs bitmask: 1 = bold, 2 = underline, 4 = italic, 8 = reverse video (SGR 7 —
; the cursor/selection highlight; reverse renders on any terminal and is visible
; in the raw byte stream as ESC[7m regardless of the palette).
(def face-sgr
  (lam (f)
    (case f
      ((face name fg bg attrs)
        (let ((b (case (=i (band attrs 1) 1) (true (sgr-code 1)) (false ""))))
          (let ((u (case (=i (band attrs 2) 2) (true (sgr-code 4)) (false ""))))
            (let ((i (case (=i (band attrs 4) 4) (true (sgr-code 3)) (false ""))))
              (let ((rv (case (=i (band attrs 8) 8) (true (sgr-code 7)) (false ""))))
                (let ((fc (case (<i fg 0) (true "") (false (sgr-code (+ 30 fg))))))
                  (let ((bc (case (<i bg 0) (true "") (false (sgr-code (+ 40 bg))))))
                    (str-cat b (str-cat u (str-cat i (str-cat rv (str-cat fc bc)))))))))))))))

; ─── Pure helpers ───

(def bool-eq
  (lam (a b)
    (case a
      (true (case b (true true) (false false)))
      (false (case b (true false) (false true))))))

(def list-all-eq-str
  (lam (a b)
    (case a
      (nil (case b (nil true) (_ false)))
      ((cons ha ta)
        (case b
          (nil false)
          ((cons hb tb)
            (and (str-eq ha hb) (list-all-eq-str ta tb))))))))

(def rnd-append-list
  (lam (xs acc)
    (case xs
      (nil acc)
      ((cons h t) (rnd-append-list t (cons h acc))))))

(def rnd-flatten-rows
  (lam (rows acc)
    (case rows
      (nil acc)
      ((cons row rest)
        (rnd-flatten-rows rest (rnd-append-list row acc))))))

(def list-all-diff-same
  (lam (xs ys)
    (case xs
      (nil (case ys (nil true) (_ false)))
      ((cons hx tx)
        (case ys
          (nil false)
          ((cons hy ty)
            (case (diff-node hx hy)
              (diff-same (list-all-diff-same tx ty))
              (_ false))))))))

(def rnd-diff-table
  (lam (h1 h2 rows1f rows2f new-node)
    (case (list-all-eq-str h1 h2)
      (true
        (case (list-all-diff-same rows1f rows2f)
          (true diff-same)
          (false (diff-changed new-node))))
      (false (diff-changed new-node)))))

(def rnd-diff-tree
  (lam (s1 s2 ch1f ch2f new-node)
    (case (diff-node s1 s2)
      (diff-same
        (case (list-all-diff-same ch1f ch2f)
          (true diff-same)
          (false (diff-changed new-node))))
      (_ (diff-changed new-node)))))

; ─── diff-node — structural Rendering comparison ───

(def diff-node
  (lam (old new)
    (case old
      ((r-text s1 b1)
        (case new
          ((r-text s2 b2)
            (case (and (str-eq s1 s2) (bool-eq b1 b2))
              (true diff-same)
              (false (diff-changed new))))
          (_ (diff-changed new))))
      ((r-table h1 rows1)
        (case new
          ((r-table h2 rows2)
            (let ((f1 (rnd-flatten-rows rows1 nil)))
              (let ((f2 (rnd-flatten-rows rows2 nil)))
                (rnd-diff-table h1 h2 f1 f2 new))))
          (_ (diff-changed new))))
      ((r-section t1 c1 b1)
        (case new
          ((r-section t2 c2 b2)
            (case (and (str-eq t1 t2) (bool-eq c1 c2))
              (true (diff-node b1 b2))
              (false (diff-changed new))))
          (_ (diff-changed new))))
      ((r-stream _)
        (case new
          ((r-stream _) (diff-changed new))
          (_ (diff-changed new))))
      ((r-tree ch1 s1)
        (case new
          ((r-tree ch2 s2)
            (rnd-diff-tree s1 s2 ch1 ch2 new))
          (_ (diff-changed new))))
      ((r-lines ch1)
        (case new
          ((r-lines ch2)
            (case (list-all-diff-same ch1 ch2)
              (true diff-same)
              (false (diff-changed new))))
          (_ (diff-changed new))))
      ((r-row ch1)
        (case new
          ((r-row ch2)
            (case (list-all-diff-same ch1 ch2)
              (true diff-same)
              (false (diff-changed new))))
          (_ (diff-changed new))))
      ((r-face f1 b1)
        (case new
          ((r-face f2 b2)
            (case (str-eq f1 f2)
              (true (diff-node b1 b2))
              (false (diff-changed new))))
          (_ (diff-changed new))))
      ((r-hole l1)
        (case new
          ((r-hole l2)
            (case (str-eq l1 l2)
              (true diff-same)
              (false (diff-changed new))))
          (_ (diff-changed new)))))))

; ─── ANSI helpers (pure) ───

(def ansi-clear      Str (str-cat ansi-esc "[2J"))
(def ansi-home       Str (str-cat ansi-esc "[H"))
(def ansi-reset      Str (str-cat ansi-esc "[0m"))
(def ansi-red        Str (str-cat ansi-esc "[31m"))
(def ansi-bold       Str (str-cat ansi-esc "[1m"))
(def ansi-underline  Str (str-cat ansi-esc "[4m"))
(def ansi-inverse    Str (str-cat ansi-esc "[7m"))
(def ansi-clear-line Str (str-cat ansi-esc "[K"))
; Disable/enable terminal auto-wrap (DECAWM). With wrap ON, a line longer than
; the terminal width wraps in the terminal and the next line's ansi-goto
; overwrites the wrapped tail, garbling the display. With wrap OFF the terminal
; clips the overflow at the right edge, so per-line ansi-goto rendering stays
; aligned. Emitted once at startup and restored on exit.
(def ansi-nowrap     Str (str-cat ansi-esc "[?7l"))
(def ansi-wrap       Str (str-cat ansi-esc "[?7h"))
; Alternate screen buffer (what vim/less/htop use): switch to a blank private
; screen on entry, switch back on exit so the terminal restores exactly what was
; there before scriba launched — no leftover editor frame, no trailing % from a
; mashed shell prompt.
(def ansi-altscreen-on  Str (str-cat ansi-esc "[?1049h"))
(def ansi-altscreen-off Str (str-cat ansi-esc "[?1049l"))

; ─── E175: the ambient face, and the close that RESTORES it ────────────────
;
; A face's OPEN has always been a DELTA. `face-sgr` emits only the bits that are
; set and nothing at all for a colour of -1, so it has no vocabulary for "off"
; and the terminal composes it over whatever is already on. The CLOSE was a
; REPLACEMENT — an unconditional ansi-reset — so a faced node's SIBLING lost the
; enclosing face and the emitter contradicted itself. E175 changes only the
; close. ⚑ These three live BELOW the ansi-* block on purpose: `ansi-reset`
; (above) is a bare `def` with no `declare`, so a `rnd-restore` written above it
; forward-references an undeclared name and the module fails to load.

; face-join — a DESCRIPTION of what the emitter ALREADY DOES, written down so
; the close can agree with the open, NOT a new policy. Attributes accumulate
; (the terminal never cleared the outer's bits), and a colour the inner states
; wins while an unstated one (-1 = "no opinion") inherits the outer's. The
; joined face's NAME is the INNER's: nothing reads it, and carrying the outer's
; would make a debug print lie about which face is on top.
(def face-join
  (lam (outer inner)
    (case outer
      ((face oname ofg obg oat)
        (case inner
          ((face iname ifg ibg iat)
            (face iname
                  (case (<i ifg 0) (true ofg) (false ifg))
                  (case (<i ibg 0) (true obg) (false ibg))
                  (bor oat iat))))))))

; The ambient at depth 0. ⚑ `face-sgr` of this face is "" — measured — and that
; is what makes depth 0 fall OUT of the general rule instead of needing a case
; for it: (rnd-restore rnd-face-plain) is (str-cat ansi-reset ""), which is
; exactly the four bytes every close used to emit. No bottom-of-stack sentinel,
; no (case depth (0 ...)) — the difference between an invariant and a guard.
(def rnd-face-plain Face (face "default" -1 -1 0))

; rnd-restore — the ONE new emitter, and the only place ansi-reset may be
; spelled inside the tree walk after this element. Reset THEN REAPPLY, not six
; per-attribute off codes: `face-sgr` has no "off" vocabulary, the ambient is in
; hand either way, and one expression cannot drift out of step with face-sgr's
; six on-codes the way six hand-written off-codes would.
;
; ⚑ A faced leaf's close is now LONGER than it was by exactly `face-sgr amb`,
; and the enclosing r-face's own close then wipes it. The invariant this element
; holds is therefore the SCREEN, not the byte stream — a trailing SGR paints no
; cell — which is why Phase 16 grades a cell map and not a byte diff.
(def rnd-restore
  (lam (amb)
    (put (str-cat ansi-reset (face-sgr amb)))))

(def ansi-goto
  (lam (row col)
    (str-cat (str-cat (str-cat (str-cat ansi-esc "[") (i64->str row)) ";")
             (str-cat (i64->str col) "H"))))

; ─── E174: the eight layout constants, read by BOTH the emitter and rnd-cols ─
;
; Every one of these was a bare literal inside an emitter: the 2 at
; render-section's body indent, the 2 at render-tree's child indent, the 16 at
; rnd-emit-one-row's cell step, the 2 at rnd-emit-headers' gutter, and the four
; decoration strings render-to-ansi prints around a node's own content.
;
; Two literals that must agree across a function boundary is a bolted-on
; invariant; ONE `def` read by both sides is the substrate version. The emitters
; below are edited to read these names — hoisting the constant without
; repointing its emitter buys nothing, and Phase 15's M11 is the row that proves
; the two readers are wired to one definition.
(def rnd-tree-indent     I64 2)
(def rnd-section-indent  I64 2)
(def rnd-table-cell      I64 16)
(def rnd-header-gutter   I64 2)
(def rnd-collapsed-mark  Str " [+]")
(def rnd-hole-mark       Str "<?>")
(def rnd-stream-open     Str "[")
(def rnd-stream-close    Str " — live stream]")

; ─── E174: str-cols — a Str's width in TERMINAL COLUMNS ─────────────────────
;
; THE UNIT IS IN THE NAME, deliberately. `str-len` counts BYTES (it lowers to
; nb-blen); this module's own `" — live stream]"` is 17 bytes and 15 columns, so
; a byte count is a measured wrong answer for the one non-ASCII literal the
; module already owns.
;
; The body counts CODEPOINTS, via protocol/utf8's decoder. That is strictly
; better than bytes and it is still not the final answer:
;   · CJK / full-width codepoints occupy 2 cells, counted here as 1;
;   · combining marks and ZWJ occupy 0 cells, counted here as 1;
;   · U+2014 (the em dash above) is East-Asian AMBIGUOUS — 1 column narrow,
;     2 in CJK-legacy — the one class where wcwidth implementations legitimately
;     disagree, so the table has to take a stance rather than copy one.
; The wide-cell table is E177, with E174 as its first consumer: E177 changes the
; BODY of this function. The seam and the signature do not move.
;
; Cost, stated: O(n) per call where str-len was O(1), once per node per render.
(def cp-count
  (lam (cps acc)
    (case cps
      (nil acc)
      ((cons c t) (cp-count t (+ acc 1))))))

(def str-cols
  (lam (s) (cp-count (decode-utf8 (str->bytes s)) 0)))

; ─── E174: rnd-cols — the per-node advance width ────────────────────────────
;
; ⚑ THE ELEMENT IS THIS, not the constructor. `r-row` lays its children left to
; right, so it must know how far each child advances the column. Nothing in
; `Rendering` ever had to answer that: r-lines steps the row and HOLDS the
; column, r-table uses a hardcoded grid, r-face does not move the cursor at all.
;
;   rnd-cols n  =  the number of terminal columns n advances the cursor by,
;                  measured from n's own `col`.
;
; It is an ADVANCE, and for a node that occupies several rows it is the widest
; of them — the only number under which `r-row` can place a stacked child beside
; something else without the two overlapping.
;
; ⚑ PRECONDITION, and it is a precondition rather than an imprecision: NOTHING
; IN `Rendering` REFLOWS. No constructor carries a width field, render-to-ansi
; clips by ROW (rd-in-view, below — `col` does not appear in it) and never wraps
; by column, and ansi-nowrap turns the terminal's own wrapping off. So one `I64`
; is the whole answer. If a wrapping constructor ever lands, THIS SIGNATURE IS
; WRONG rather than merely imprecise, and a min/max measurement pair replaces it.
;
; Every arm is DERIVED from what the emitter below actually draws, through the
; eight shared constants — never re-spelled here. No `_` arm: a new constructor
; must break this function, which is the entire reason the cost of adding one is
; knowable.
; the children end to end: a row is as wide as the SUM of its children, with no
; separator between them. This is the arm r-row exists for, and it is a sum and
; not a max because the children abut.
(def rnd-cols-sum
  (lam (xs acc)
    (case xs
      (nil acc)
      ((cons h t) (rnd-cols-sum t (+ acc (rnd-cols h)))))))

(def rnd-cols-max
  (lam (xs acc)
    (case xs
      (nil acc)
      ((cons h t) (rnd-cols-max t (max acc (rnd-cols h)))))))

; rnd-emit-headers puts header h at c and then advances c by str-len h PLUS the
; gutter — including after the LAST header, whose advance the nil case consumes
; and nothing is ever drawn in. So the header row's advance is
; Σ widths + gutter × (n−1): n−1 gutters, not n. Folding n would bake a trailing
; two-column separator into a width function whose own rule is that a row has no
; implicit separator.
;
; RESIDUE, named rather than smoothed over: the emitter advances by `str-len`
; (bytes) while this counts columns. They agree for every header the tree
; actually produces (ASCII), and the disagreement is E177's unit story, not a
; second definition here.
(def rnd-hdr-cols
  (lam (hs acc)
    (case hs
      (nil acc)
      ((cons h t)
        (case t
          (nil (+ acc (str-cols h)))
          ((cons h2 t2)
            (rnd-hdr-cols t (+ acc (+ (str-cols h) rnd-header-gutter)))))))))

; The widest row's CELL COUNT. `cur` counts the row being walked, `best` is the
; max so far; a row ends when its cell list runs out. (Three arguments, where
; the SPEC wrote two: counting cells per row and maxing across rows needs two
; accumulators, and a second top-level helper would have been an eighteenth name
; for the census to carry.)
(def rnd-row-cells
  (lam (rows cur best)
    (case rows
      (nil (max best cur))
      ((cons cells rest)
        (case cells
          (nil (rnd-row-cells rest 0 (max best cur)))
          ((cons c cs) (rnd-row-cells (cons cs rest) (+ cur 1) best)))))))

(def rnd-cols
  (lam (node)
    (case node
      ; the leaf: its own content, and bold is SGR, which paints no cell.
      ((r-text content bold) (str-cols content))
      ; ⚑ DEFINED against the GRID, not derived from the content. rnd-emit-headers
      ; advances by content + gutter; rnd-emit-one-row advances by a fixed
      ; rnd-table-cell and ignores the content entirely. The same r-table value
      ; therefore has two column layouts, which is a measured defect and is E178.
      ; The grid is what a body cell actually obeys, so the grid is the answer
      ; here; E178 owns the fix, and Phase 15's table row is narrowed to the
      ; region where the two agree and says so.
      ((r-table headers rows)
        (max (rnd-hdr-cols headers 0)
             (* rnd-table-cell (rnd-row-cells rows 0 0))))
      ; collapsed: the title and the fold mark, on one row. Open: the title, and
      ; the body indented one level under it — the wider of the two.
      ((r-section title collapsed body)
        (case collapsed
          (true  (+ (str-cols title) (str-cols rnd-collapsed-mark)))
          (false (max (str-cols title) (+ rnd-section-indent (rnd-cols body))))))
      ; A stream RESERVES NOTHING for content it does not carry: the emitter
      ; draws a fixed placeholder, so the width is derived like every other arm.
      ; A renderer that one day draws live content in place would need a declared
      ; reservation FIELD on the constructor — a change to the constructor.
      ((r-stream source-id)
        (+ (str-cols rnd-stream-open)
           (+ (str-cols source-id) (str-cols rnd-stream-close))))
      ; render-tree indents EVERY child by rnd-tree-indent — but draws nothing at
      ; all for nil, so an empty tree advances 0 and not a bare indent.
      ((r-tree children selected)
        (case children
          (nil 0)
          ((cons c cs) (+ rnd-tree-indent (rnd-cols-max children 0)))))
      ; a vertical stack is as wide as its widest row.
      ((r-lines children) (rnd-cols-max children 0))
      ; ...and a horizontal row is as wide as all of its children laid end to end.
      ((r-row children) (rnd-cols-sum children 0))
      ((r-hole label) (+ (str-cols rnd-hole-mark) (str-cols label)))
      ; SGR bytes are NON-PRINTING, so a face occupies exactly its body — and
      ; this arm is invariant under E175 (nested faces restoring the outer face
      ; instead of resetting): no E175 fix changes one number in this function.
      ((r-face face-name body) (rnd-cols body)))))

; ─── cursor geometry (pure) ────────────────────────────────────────────────

; Walk the buffer prefix text[0:limit], tracking the 1-indexed terminal
; (row, col) for the visible block. Row starts at 1, col at 1; a '\n' (byte 10)
; advances the row and resets col to 1, any other char advances col.
; Walks BYTES via bget (O(1), no per-char allocation) — the previous version
; did `(str-sub s i (+ i 1))` per char, allocating a 1-char string O(offset)
; times, which dominated movement latency on large files.
(def crc-walk (-> Bytes I64 I64 I64 I64 (Pair I64 I64))
  (lam (bs i row col limit)
    (case (<i i limit)
      (true
        (case (=i (bget bs i) 10)
          (true (crc-walk bs (+ i 1) (+ row 1) 1 limit))
          (false (crc-walk bs (+ i 1) row (+ col 1) limit))))
      (false (pair row col)))))

; cursor-row-col : (text, offset) -> 1-indexed (row, col) for ansi-goto.
;
; KNOWN LIMITATION (do not half-fix): this counts raw characters, not terminal
; columns. A line longer than the terminal width wraps on screen but the block
; is computed as if it did not, so the cursor desyncs past the first wrapped
; line. Fixing it needs a cell-grid renderer (the dropped vt-core/grid work),
; not a column clamp here.
(def cursor-row-col (-> Str I64 (Pair I64 I64))
  (lam (text offset)
    (crc-walk (str->bytes (str-sub text 0 offset)) 0 1 1 offset)))

; rows from dims (Pair rows cols).
(def rd-rows (-> (Pair I64 I64) I64)
  (lam (d)
    (case d
      ((pair rows cols) rows))))

; ─── rnd-is-selected (pure) — defined before render-tree which calls it ───

(def rnd-is-selected
  (lam (child selected)
    (case (diff-node child selected)
      (diff-same true)
      (_ false))))

; ─── Effectful render helpers ───

(def rnd-emit-headers
  (lam (hs r c amb)
    (case hs
      (nil unit)
      ((cons h rest)
        (let ((_ (put (ansi-goto r c))))
          (let ((_ (put ansi-bold)))
            (let ((_ (put h)))
              (let ((_ (rnd-restore amb)))
                (rnd-emit-headers rest r (+ c (+ (str-len h) rnd-header-gutter)) amb)))))))))

(def rnd-emit-one-row
  (lam (cells dims row col amb)
    (case cells
      (nil unit)
      ((cons cell rest)
        (let ((_ (render-to-ansi cell dims none row col row col amb)))
          (rnd-emit-one-row rest dims row (+ col rnd-table-cell) amb))))))

(def rnd-emit-rows
  (lam (rows dims row col amb)
    (case rows
      (nil unit)
      ((cons row-cells rest)
        (let ((_ (rnd-emit-one-row row-cells dims row col amb)))
          (rnd-emit-rows rest dims (+ row 1) col amb))))))

(def render-table
  (lam (headers rows dims row col amb)
    (let ((_ (rnd-emit-headers headers row col amb)))
      (rnd-emit-rows rows dims (+ row 2) col amb))))

(def render-section
  (lam (title collapsed body dims row col drow dcol amb)
    ; ⚑ E174 / FLAG A: the ansi-goto this arm has NEVER had. render-section took
    ; `row` and `col` and read neither to position itself — it read `col` once,
    ; only to indent the body — while every other drawing arm (each table
    ; header, r-text, r-stream, r-hole) opens with exactly this line. The title
    ; landed at (1,1) purely because ansi-home had put the cursor there, so a
    ; section drawn anywhere but first-on-row drew at the ambient cursor.
    ;
    ; Without it `r-row`'s contract — child n draws at col + Σ widths — is void
    ; for an r-section child no matter what rnd-cols returns. The fix REMOVES a
    ; special case rather than adding one, and Phase 15's G5 pins that a section
    ; rendered first-on-row lands exactly where it landed before it.
    (let ((_ (put (ansi-goto row col))))
    (let ((_ (put ansi-bold)))
      (let ((_ (put title)))
        (let ((_ (case collapsed (true (put rnd-collapsed-mark)) (false (put "")))))
          (let ((_ (rnd-restore amb)))
            (case collapsed
              (true unit)
              (false
                (render-to-ansi body dims none (+ row 1) (+ col rnd-section-indent) drow dcol amb))))))))))

(def render-tree
  (lam (children selected dims row col drow dcol amb)
    (case children
      (nil unit)
      ((cons child rest)
        (let ((is-sel (rnd-is-selected child selected)))
          (let ((_ (case is-sel (true (put ansi-bold)) (false unit))))
            (let ((_ (render-to-ansi child dims none row (+ col rnd-tree-indent) drow dcol amb)))
              (let ((_ (case is-sel (true (rnd-restore amb)) (false unit))))
                (render-tree rest selected dims (+ row 1) col drow dcol amb)))))))))

; render-lines: vertical flat list — each child on its own row at the SAME
; column (no +2 tree indentation). The text-buffer primitive: buffer rows are
; siblings, not nested children, so a chirality buffer renders at column 1 and the
; cursor block (computed from the raw text offset) tracks it one-for-one.
(def render-lines
  (lam (children dims row col drow dcol amb)
    (case children
      (nil unit)
      ((cons child rest)
        (let ((_ (render-to-ansi child dims none row col drow dcol amb)))
          (render-lines rest dims (+ row 1) col drow dcol amb))))))


; render-row: horizontal flat list — every child on the SAME row, each starting
; exactly where the previous one ended. The column step is `rnd-cols` and
; nothing else: if the width function and this walk ever disagree, the second
; segment lands on top of the first, which is what Phase 15 reads directly off
; the emitted byte stream.
;
; A CONTAINER, so it emits no ansi-goto of its own and does not clip — the same
; discipline render-lines and render-tree follow, and for the reason stated at
; render-to-ansi below: a container's row can be the scrolled offset, so
; clipping here would clip the whole subtree.
(def render-row
  (lam (children dims row col drow dcol amb)
    (case children
      (nil unit)
      ((cons child rest)
        (let ((_ (render-to-ansi child dims none row col drow dcol amb)))
          (render-row rest dims row (+ col (rnd-cols child)) drow dcol amb))))))

; ─── render-to-ansi — recursive tree walk with ANSI emission ───

; Is row within the content viewport (1..rows-1; the last row is the status bar)?
(def rd-in-view (-> (Pair I64 I64) I64 Bool)
  (lam (dims row)
    (and (<=i 1 row) (<=i row (- (rd-rows dims) 1)))))

(def render-to-ansi
  (lam (node dims prev row col drow dcol amb)
    ; Containers (r-lines / r-tree) recurse WITHOUT clipping and WITHOUT an
    ; ansi-goto: they do not draw at their own row, and with scroll their row is
    ; the scrolled-offset (possibly negative), so clipping the container would
    ; clip the whole subtree. Leaf/drawing nodes clip themselves via rd-in-view.
    (case node
      ((r-lines children)
        (render-lines children dims row col drow dcol amb))
      ((r-tree children selected)
        (render-tree children selected dims row col drow dcol amb))
      ; r-row is a CONTAINER too: no ansi-goto of its own and no clip, for the
      ; same reason r-lines has none. The children draw, and each clips itself.
      ((r-row children)
        (render-row children dims row col drow dcol amb))
      ((r-text content bold)
        (case (rd-in-view dims row)
          (false unit)
          (true
            (let ((_ (put (ansi-goto row col))))
              (let ((_ (case bold (true (put ansi-bold)) (false unit))))
                (let ((_ (put content)))
                  (rnd-restore amb)))))))
      ((r-table headers rows)
        (case (rd-in-view dims row)
          (false unit)
          (true (render-table headers rows dims row col amb))))
      ((r-section title collapsed body)
        (case (rd-in-view dims row)
          (false unit)
          (true (render-section title collapsed body dims row col drow dcol amb))))
      ((r-stream source-id)
        (case (rd-in-view dims row)
          (false unit)
          (true
            (let ((_ (put (ansi-goto row col))))
              (let ((_ (put ansi-bold)))
                (let ((_ (put rnd-stream-open)))
                  (let ((_ (put source-id)))
                    (let ((_ (put rnd-stream-close)))
                      (rnd-restore amb)))))))))
      ((r-hole label)
        (case (rd-in-view dims row)
          (false unit)
          (true
            (let ((_ (put (ansi-goto row col))))
              (let ((_ (put rnd-hole-mark)))
                (let ((_ (put label)))
                  (put "")))))))
      ((r-face face-name body)
        (case (rd-in-view dims row)
          (false unit)
          (true
            (let ((f (lookup-face default-faces face-name)))
              (let ((_ (put (face-sgr f))))
                (let ((_ (render-to-ansi body dims none row col drow dcol (face-join amb f))))
                  (rnd-restore amb))))))))))

; ─── render-to-ansi-full — clear screen, render from (1,1) ───

(def render-to-ansi-full
  (lam (tree dims)
    (let ((_ (put ansi-clear)))
      (let ((_ (put ansi-home)))
        (render-to-ansi tree dims none 1 1 1 1 rnd-face-plain)))))

; ─── render-to-ansi-delta — Phase 1: full-reset re-render ───

(def render-to-ansi-delta
  (lam (prev new dims)
    (case (diff-node prev new)
      (diff-same unit)
      ((diff-changed _) (render-to-ansi-full new dims)))))
