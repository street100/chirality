; ports/stdio — the standard-stream registry.
;
; The three crossings that write text without naming a descriptor. Their whole
; content is "somebody downstream decides where this goes", which is exactly
; why they are not in ports/fd: a module that only needs to say something does
; not need to be able to name fd 7.

(import "prelude")

(extern print (=> Str Unit))
(extern put (=> Str Unit))             ; write to stdout with NO trailing newline
(extern trace (=> Str Unit))
