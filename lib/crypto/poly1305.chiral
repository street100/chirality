; Poly1305 and the AEAD composition, RFC 8439. N1 slice 2.
;
; Preconditions, stated rather than typed (N01 SPEC decision 2): the MAC key
; is 32 bytes (r then s), the AEAD key is 32 bytes, the nonce is 12 bytes.
; Word reads on those go through unpack-u32 under the stated contract, the
; chacha.chiral precedent; every loose byte read goes through pl-at, the
; guarded read in the at-byte shape. The cost is named and accepted: a short
; key makes a wrong tag with no signal beyond this contract; the RFC vector
; rows in tools/test/crypto.sh pin correct-length behavior.
;
; Limb bounds, the whole arithmetic argument: five 26-bit limbs, the donna
; shape. A block add lifts an h limb toward 2^27, so each product in f-mul
; stays under 2^53 and each five-term sum with its weight-5 folds under
; 21 * 2^53 < 2^58. Signed I64 holds every intermediate; no mulhi.

(import "prelude/prelude")
(import "crypto/chacha")

; Pure, category A, checked form. Binds no extern of its own -- prelude
; i64/bytes ops plus crypto/chacha only -- so the crossings row is empty by
; derivation. M32 is chacha's; a second spelling of the constant would drift.
(module crypto/poly1305 (cat A) (alt upper))

; ─── the guarded byte read ──────────────────────────────────────────────────
; An out-of-range index is a byte value here, not a which-of-N classification
; (pattern-boundary-sums, the at-byte carve-out). 0 keeps every lane in 0..255.
(def pl-at (-> Bytes I64 I64)
  (lam (bs i)
    (cond ((<i i 0) 0)
          ((<i i (blen bs)) (bget bs i))
          (else 0))))

; one byte as a Bytes of length 1 (the e151 idiom)
(def pl-b1 (-> I64 Bytes) (lam (b) (bslice (pack-u32 b) 0 1)))

(def pl-empty Bytes (bslice (pack-u32 0) 0 0))

; n zero bytes; n of 0 stays off brepeat and yields the empty Bytes
(def pl-zeros (-> I64 Bytes)
  (lam (n)
    (case (<i 0 n)
      (true (brepeat (pl-b1 0) n))
      (false pl-empty))))

; ─── five 26-bit limbs ──────────────────────────────────────────────────────
(data F () (f5 (l0 I64) (l1 I64) (l2 I64) (l3 I64) (l4 I64)))

(def M26 I64 67108863)            ; 2^26 - 1

; four LE u32 words to limbs; hi is 0 or 16777216 (2^24), the 2^128 pad bit
; landing at bit 24 of limb 4 (limb 4 holds bits 104..129)
(def f-load4 (-> I64 I64 I64 I64 I64 F)
  (lam (w0 w1 w2 w3 hi)
    (f5 (band w0 M26)
        (band (bor (shr w0 26) (shl w1 6)) M26)
        (band (bor (shr w1 20) (shl w2 12)) M26)
        (band (bor (shr w2 14) (shl w3 18)) M26)
        (bor (shr w3 8) hi))))

; r is key bytes 0..15 under the RFC 8439 §2.5 clamp, LE words in decimal:
; word 0 keeps its low 28 bits (268435455), words 1..3 keep 28 bits and drop
; their two low bits (268435452)
(def clamp-r (-> Bytes F)
  (lam (key)
    (f-load4 (band (unpack-u32 key 0) 268435455)
             (band (unpack-u32 key 4) 268435452)
             (band (unpack-u32 key 8) 268435452)
             (band (unpack-u32 key 12) 268435452)
             0)))

; limb-wise add, no carry: the caller multiplies right after, and the mul's
; bound already budgets the lifted limbs
(def f-add (-> F F F)
  (lam (a b)
    (case a ((f5 a0 a1 a2 a3 a4)
      (case b ((f5 b0 b1 b2 b3 b4)
        (f5 (+ a0 b0) (+ a1 b1) (+ a2 b2) (+ a3 b3) (+ a4 b4))))))))

; h * r mod 2^130 - 5. Limbs above the top fold back at weight 5. Then the
; carry chain: shr/band up the limbs, the top carry folded into limb 0 at
; weight 5 (w5), one more carry out of limb 0. Output limbs sit at M26 plus
; a small carry, inside the next block add's budget.
(def f-mul (-> F F F)
  (lam (h r)
    (case h ((f5 h0 h1 h2 h3 h4)
      (case r ((f5 r0 r1 r2 r3 r4)
        (let ((t0 (+ (* h0 r0) (+ (* 5 (* h1 r4)) (+ (* 5 (* h2 r3))
                     (+ (* 5 (* h3 r2)) (* 5 (* h4 r1)))))))
              (t1 (+ (* h0 r1) (+ (* h1 r0) (+ (* 5 (* h2 r4))
                     (+ (* 5 (* h3 r3)) (* 5 (* h4 r2)))))))
              (t2 (+ (* h0 r2) (+ (* h1 r1) (+ (* h2 r0)
                     (+ (* 5 (* h3 r4)) (* 5 (* h4 r3)))))))
              (t3 (+ (* h0 r3) (+ (* h1 r2) (+ (* h2 r1)
                     (+ (* h3 r0) (* 5 (* h4 r4)))))))
              (t4 (+ (* h0 r4) (+ (* h1 r3) (+ (* h2 r2)
                     (+ (* h3 r1) (* h4 r0))))))
              (c0 (shr t0 26)) (u0 (band t0 M26))
              (s1 (+ t1 c0)) (c1 (shr s1 26)) (u1 (band s1 M26))
              (s2 (+ t2 c1)) (c2 (shr s2 26)) (u2 (band s2 M26))
              (s3 (+ t3 c2)) (c3 (shr s3 26)) (u3 (band s3 M26))
              (s4 (+ t4 c3)) (c4 (shr s4 26)) (u4 (band s4 M26))
              (w5 (* 5 c4))
              (x0 (+ u0 w5))
              (c5 (shr x0 26)) (v0 (band x0 M26)) (v1 (+ u1 c5)))
          (f5 v0 v1 u2 u3 u4))))))))

; final reduction: one full carry pass folding the bit-130 carry at weight 5
; (the value lands under 2^130), then h + 5; a carry out of limb 4 says
; h >= p and selects the banded g. The select is a branch, not masked
; arithmetic: constant time is N5's checked claim, not this slice's.
(def f-final (-> F F)
  (lam (h)
    (case h ((f5 h0 h1 h2 h3 h4)
      (let ((c1 (shr h0 26)) (a0 (band h0 M26))
            (b1 (+ h1 c1)) (c2 (shr b1 26)) (a1 (band b1 M26))
            (b2 (+ h2 c2)) (c3 (shr b2 26)) (a2 (band b2 M26))
            (b3 (+ h3 c3)) (c4 (shr b3 26)) (a3 (band b3 M26))
            (b4 (+ h4 c4)) (c5 (shr b4 26)) (a4 (band b4 M26))
            (d0 (+ a0 (* 5 c5)))
            (c6 (shr d0 26)) (e0 (band d0 M26))
            (d1 (+ a1 c6)) (c7 (shr d1 26)) (e1 (band d1 M26))
            (d2 (+ a2 c7)) (c8 (shr d2 26)) (e2 (band d2 M26))
            (d3 (+ a3 c8)) (c9 (shr d3 26)) (e3 (band d3 M26))
            (e4 (+ a4 c9))
            (g0 (+ e0 5)) (k0 (shr g0 26))
            (g1 (+ e1 k0)) (k1 (shr g1 26))
            (g2 (+ e2 k1)) (k2 (shr g2 26))
            (g3 (+ e3 k2)) (k3 (shr g3 26))
            (g4 (+ e4 k3)))
        (case (<i g4 67108864)
          (true (f5 e0 e1 e2 e3 e4))
          (false (f5 (band g0 M26) (band g1 M26) (band g2 M26)
                     (band g3 M26) (band g4 M26)))))))))

; one 16-byte block (built by the caller, always exactly 16 bytes) to limbs
(def f-block (-> Bytes I64 F)
  (lam (blk hi)
    (f-load4 (unpack-u32 blk 0) (unpack-u32 blk 4)
             (unpack-u32 blk 8) (unpack-u32 blk 12) hi)))

; the short final chunk padded to 16: msg bytes base.. then 1 then zeros.
; RFC 8439 §2.5: the 1 is the length marker; no 2^128 pad bit on this block.
(def pl-last (-> Bytes I64 Bytes)
  (lam (msg base)
    (let ((n (- (blen msg) base)))
      (bcat (bslice msg base (blen msg))
            (bcat (pl-b1 1) (pl-zeros (- 15 n)))))))

; the accumulator walk, 16 bytes a step. The index climbs under
; (<i base (blen msg)): the symbolic-bound shape the numeric measure proves
; (cx-blocks is the step-16 precedent at step 64).
(def pl-loop (-> F F Bytes I64 F)
  (lam (h r msg base)
    (case (<i base (blen msg))
      (true
        (case (<=i 16 (- (blen msg) base))
          (true (pl-loop
                  (f-mul (f-add h (f-block (bslice msg base (+ base 16))
                                           16777216)) r)
                  r msg (+ base 16)))
          (false (f-mul (f-add h (f-block (pl-last msg base) 0)) r))))
      (false h))))

; the tag: h mod 2^128 as four LE words, plus s (key bytes 16..31) with the
; carry run across all four u32 words, truncated (§2.5: the s-add is mod
; 2^128, so the carry out of word 3 drops)
(def pl-tag (-> F Bytes Bytes)
  (lam (h key)
    (case h ((f5 h0 h1 h2 h3 h4)
      (let ((w0 (band (bor h0 (shl h1 26)) M32))
            (w1 (band (bor (shr h1 6) (shl h2 20)) M32))
            (w2 (band (bor (shr h2 12) (shl h3 14)) M32))
            (w3 (band (bor (shr h3 18) (shl h4 8)) M32))
            (x0 (+ w0 (unpack-u32 key 16)))
            (x1 (+ (+ w1 (unpack-u32 key 20)) (shr x0 32)))
            (x2 (+ (+ w2 (unpack-u32 key 24)) (shr x1 32)))
            (x3 (+ (+ w3 (unpack-u32 key 28)) (shr x2 32))))
        (bcat (pack-u32 (band x0 M32)) (bcat (pack-u32 (band x1 M32))
        (bcat (pack-u32 (band x2 M32)) (pack-u32 (band x3 M32))))))))))

; ─── the MAC ────────────────────────────────────────────────────────────────
; key first, then message: the suite's argument order (SPEC §1)
(def poly1305-mac (-> Bytes Bytes Bytes)
  (lam (key msg)
    (pl-tag (f-final (pl-loop (f5 0 0 0 0 0) (clamp-r key) msg 0)) key)))

; ─── the AEAD composition, RFC 8439 §2.8 ────────────────────────────────────
; an I64 as eight LE bytes (SPEC decision 4: single consumer, lives here)
(def le-u64 (-> I64 Bytes)
  (lam (n) (bcat (pack-u32 (band n M32)) (pack-u32 (shr n 32)))))

; zero-pad to the next 16-byte boundary; a multiple of 16 (empty included)
; passes through untouched
(def pad16 (-> Bytes Bytes)
  (lam (bs)
    (let ((r (% (blen bs) 16)))
      (case (=i r 0)
        (true bs)
        (false (bcat bs (pl-zeros (- 16 r))))))))

; the MAC input: padded aad, padded ciphertext, both lengths LE64
(def pl-mac-data (-> Bytes Bytes Bytes)
  (lam (aad ct)
    (bcat (pad16 aad)
          (bcat (pad16 ct)
                (bcat (le-u64 (blen aad)) (le-u64 (blen ct)))))))

; the one-time MAC key: the first 32 bytes of the counter-0 block (§2.6)
(def pl-otk (-> Bytes Bytes Bytes)
  (lam (key nonce) (bslice (chacha-block key nonce 0) 0 32)))

; seal: ciphertext under counter 1, the 16-byte tag appended
(def aead-seal (-> Bytes Bytes Bytes Bytes Bytes)
  (lam (key nonce aad pt)
    (let ((ct (chacha-xor key nonce 1 pt)))
      (bcat ct (poly1305-mac (pl-otk key nonce) (pl-mac-data aad ct))))))

; open returns a closed sum; a bad tag is a value the caller cases on
(data OpenR () (op-ok (pt Bytes)) (op-bad))

; sixteen byte pairs xored, folded into one bor, one test at the end: the
; compare's shape reads every byte wherever a mismatch sits
(def te-fold (-> Bytes Bytes I64 I64 Bool)
  (lam (a b i acc)
    (case (<i i 16)
      (true (te-fold a b (+ i 1) (bor acc (bxor (pl-at a i) (pl-at b i)))))
      (false (=i acc 0)))))

(def tag-eq (-> Bytes Bytes Bool)
  (lam (a b) (te-fold a b 0 0)))

; open: verify the tag over aad and ciphertext, decrypt only on a match.
; A sealed blob shorter than its own tag is op-bad, not a slice trap.
(def aead-open (-> Bytes Bytes Bytes Bytes OpenR)
  (lam (key nonce aad sealed)
    (case (<i (blen sealed) 16)
      (true (op-bad))
      (false
        (let ((clen (- (blen sealed) 16))
              (ct (bslice sealed 0 clen))
              (tag (bslice sealed clen (blen sealed))))
          (case (tag-eq tag (poly1305-mac (pl-otk key nonce)
                                          (pl-mac-data aad ct)))
            (true (op-ok (chacha-xor key nonce 1 ct)))
            (false (op-bad))))))))
