; Matching and spans over Bytes. Shard D of the text bank: a total, pure,
; span-returning matcher over Antimirov partial derivatives, with the live
; set bounded by a call to norm.
;
; Bytes throughout. A UTF-8 lead byte is >= 194 and fails every ASCII range,
; and lib/protocol/utf8.chiral owns codepoint classes.
;
; E173 slice 1: no captures. Slice 2 carries tagged derivatives.

(import "prelude/prelude")
(import "prelude/list")
(import "prelude/ord")
(import "prelude/string")

; All pure, category A, checked form. The port-set half is DERIVED on this
; module's datasheet from what it binds, and this module binds no extern, so
; its `crossings` is empty by derivation.
(module text/matcher (cat A) (alt upper))

; ─── Cls: a byte class as a value ─────────────────────────────────────────────
; Bytes throughout. A UTF-8 lead byte is >= 194 and fails every ASCII range,
; which is the answer prose-lint.prog:43-45 wants. Codepoint classes belong to
; lib/protocol/utf8.chiral and stay there.
(data Cls ()
  (c-byte  (b I64))                     ; exactly this byte
  (c-range (lo I64) (hi I64))           ; lo..hi inclusive
  (c-any)                               ; any byte except 10, which is awk's dot
  (c-not   (inner Cls))
  (c-or    (l Cls) (r Cls)))

; The class constants the corpus needs. \w is spelled once here instead of 85
; times across the Python corpus.
(def cls-lower Cls (c-range 97 122))
(def cls-digit Cls (c-range 48 57))
(def cls-word Cls
  (c-or (c-range 48 57)
    (c-or (c-range 65 90) (c-or (c-range 97 122) (c-byte 95)))))

; Total: structural on c. Both recursive arms take a strict subterm, which is
; the criterion totality.md:48-53 applies.
(declare cls-has (-> Cls I64 Bool))
(def cls-has
  (lam (c b)
    (case c
      ((c-byte  x)     (=i b x))
      ((c-range lo hi) (and (<=i lo b) (<=i b hi)))
      ((c-any)         (not (=i b 10)))
      ((c-not inner)   (not (cls-has inner b)))
      ((c-or l r)      (or (cls-has l b) (cls-has r b))))))

; ─── Assert: the whole zero-width budget the corpus needs ─────────────────────
; The census over the Python corpus found 21 word-boundary sites, three
; one-byte-class lookaround sites and zero backreferences. These five cover all
; of them, so Assert is closed at five and a general lookaround engine is never
; built.
(data Assert ()
  (a-bol)                               ; prev byte is 10, or offset 0
  (a-eol)                               ; here byte is 10, or off the end
  (a-wordb)                             ; \b : prev and here differ on cls-word
  (a-not-before (c Cls))                ; (?![...])
  (a-not-after  (c Cls)))               ; (?<![...])

; The one-byte window an Assert decides against. -1 means off the end.
; Named Win and not Ctx: the loader holds ONE namespace for data declarations,
; and lib/typing/kernel.chiral:404 already spends Ctx on the typing context.
; prog/prose-lint.prog pulls both modules into one blob, so the two names would
; collide at load and the entry would not load at all.
(data Win () (win (prev I64) (here I64)))

; Total: one case over a five-constructor sum, with no recursion. The window is
; destructured once at the top, so every arm reads the same two bytes.
(declare holds (-> Win Assert Bool))
(def holds
  (lam (k a)
    (case k
      ((win p h)
        (case a
          ((a-bol) (or (<i p 0) (=i p 10)))
          ((a-eol) (or (<i h 0) (=i h 10)))
          ((a-wordb)                    ; \b : exactly one side is a word byte
            (case (cls-has cls-word p)
              (true  (not (cls-has cls-word h)))
              (false (cls-has cls-word h))))
          ((a-not-before c) (not (cls-has c h)))
          ((a-not-after  c) (not (cls-has c p))))))))

; ─── Pat: the pattern is a value, so escaping does not exist ──────────────────
; p-lit sits beside p-cls so a literal run stays one node: the driver's
; prefilter can hand it straight to the str-find-from primitive
; (prelude.chiral:82 -> nb-bfind-from, bytes.chiral:355), which is what closes
; prose-lint's 2.4x gap.
(data Pat ()
  (p-nil)                               ; matches the empty string
  (p-lit  (s Str))
  (p-cls  (c Cls))
  (p-ast  (a Assert))                   ; zero-width
  (p-cat  (l Pat) (r Pat))
  (p-alt  (l Pat) (r Pat))
  (p-star (inner Pat)))

; prose-lint's not-but check, spelled as a value. Every Pat constructor except
; p-alt and p-ast appears here, so it doubles as the module's smoke value.
(def pat-not-but Pat
  (p-cat (p-lit "not ")
    (p-cat (p-cls cls-lower)
      (p-cat (p-star (p-cls cls-lower)) (p-lit " but ")))))

; ─── nullable: can p accept here, with assertions decided against the window ──
; Structural on p. Every recursive call takes a strict subterm, so this proves
; under the structural rule with no declared measure (totality.md:48-53).
(declare nullable (-> Win Pat Bool))
(def nullable
  (lam (k p)
    (case p
      ((p-nil)     true)
      ((p-lit s)   (=i 0 (str-len s)))
      ((p-cls c)   false)
      ((p-ast a)   (holds k a))
      ((p-cat l r) (and (nullable k l) (nullable k r)))
      ((p-alt l r) (or  (nullable k l) (nullable k r)))
      ((p-star q)  true))))

; ─── pd: the partial derivative, and the whole algorithm ──────────────────────
; pd k b p is the set of residual patterns after consuming byte b at window k.
; Structural on p in every arm. The p-star arm rebuilds `(p-star q)` in the
; RESULT and recurses only into q, which is why the star terminates.
;
; pd-cat is defined ahead of its caller because the loader resolves names in
; blob order, the same reason ms-take precedes ms-sort-n in
; lib/prelude/list.chiral.
(declare pd-cat (-> (List Pat) Pat (List Pat)))
(def pd-cat
  (lam (ps r)
    (case ps
      (nil nil)
      ((cons h t) (cons (p-cat h r) (pd-cat t r))))))

(declare pd (-> Win I64 Pat (List Pat)))
(def pd
  (lam (k b p)
    (case p
      ((p-nil)   nil)
      ((p-cls c) (case (cls-has c b) (true (cons (p-nil) nil)) (false nil)))
      ((p-ast a) nil)                   ; zero-width, so it consumes nothing
      ((p-lit s)                        ; peel one byte; the tail stays a p-lit
        (case (<i 0 (str-len s))
          (false nil)
          (true
            (case (=i b (bget (str->bytes s) 0))
              (true  (cons (p-lit (str-sub s 1 (str-len s))) nil))
              (false nil)))))
      ((p-alt l r) (append Pat (pd k b l) (pd k b r)))
      ((p-cat l r)
        (append Pat (pd-cat (pd k b l) r)
          (case (nullable k l) (true (pd k b r)) (false nil))))
      ((p-star q) (pd-cat (pd k b q) (p-star q))))))

; ─── the total order on Pat, which is what lets the live set be deduped ───────
; Rank by constructor first, then by fields, structural on the left argument.
; The shape is lib/typing/ty-cmp.chiral:29-38 over a different sum.
(declare ord-then (-> Ord Ord Ord))
(def ord-then (lam (o k) (case o ((eq) k) ((lt) (lt)) ((gt) (gt)))))

(declare cls-rank (-> Cls I64))
(def cls-rank
  (lam (c)
    (case c
      ((c-byte b) 0) ((c-range lo hi) 1) ((c-any) 2)
      ((c-not inner) 3) ((c-or l r) 4))))

(declare cls-cmp-go (-> Cls Cls Ord))
(def cls-cmp-go
  (lam (a b)
    (case (i64-cmp (cls-rank a) (cls-rank b))
      ((lt) (lt))
      ((gt) (gt))
      ((eq)
        (case a
          ((c-byte x)      (case b ((c-byte y) (i64-cmp x y)) (_ (eq))))
          ((c-range lo hi)
            (case b
              ((c-range mo mi) (ord-then (i64-cmp lo mo) (i64-cmp hi mi)))
              (_ (eq))))
          ((c-any)         (eq))
          ((c-not ia)      (case b ((c-not ib) (cls-cmp-go ia ib)) (_ (eq))))
          ((c-or la ra)
            (case b
              ((c-or lb rb) (ord-then (cls-cmp-go la lb) (cls-cmp-go ra rb)))
              (_ (eq)))))))))

(declare ast-rank (-> Assert I64))
(def ast-rank
  (lam (a)
    (case a
      ((a-bol) 0) ((a-eol) 1) ((a-wordb) 2)
      ((a-not-before c) 3) ((a-not-after c) 4))))

(declare ast-cmp (-> Assert Assert Ord))
(def ast-cmp
  (lam (a b)
    (case (i64-cmp (ast-rank a) (ast-rank b))
      ((lt) (lt))
      ((gt) (gt))
      ((eq)
        (case a
          ((a-bol)   (eq))
          ((a-eol)   (eq))
          ((a-wordb) (eq))
          ((a-not-before ca)
            (case b ((a-not-before cb) (cls-cmp-go ca cb)) (_ (eq))))
          ((a-not-after ca)
            (case b ((a-not-after cb) (cls-cmp-go ca cb)) (_ (eq)))))))))

(declare pat-rank (-> Pat I64))
(def pat-rank
  (lam (p)
    (case p
      ((p-nil) 0) ((p-lit s) 1) ((p-cls c) 2) ((p-ast a) 3)
      ((p-cat l r) 4) ((p-alt l r) 5) ((p-star inner) 6))))

(declare pat-cmp-go (-> Pat Pat Ord))
(def pat-cmp-go
  (lam (a b)
    (case (i64-cmp (pat-rank a) (pat-rank b))
      ((lt) (lt))
      ((gt) (gt))
      ((eq)
        (case a
          ((p-nil)     (eq))
          ((p-lit sa)  (case b ((p-lit sb) (str-cmp sa sb))    (_ (eq))))
          ((p-cls ca)  (case b ((p-cls cb) (cls-cmp-go ca cb)) (_ (eq))))
          ((p-ast aa)  (case b ((p-ast ab) (ast-cmp aa ab))    (_ (eq))))
          ((p-cat la ra)
            (case b
              ((p-cat lb rb) (ord-then (pat-cmp-go la lb) (pat-cmp-go ra rb)))
              (_ (eq))))
          ((p-alt la ra)
            (case b
              ((p-alt lb rb) (ord-then (pat-cmp-go la lb) (pat-cmp-go ra rb)))
              (_ (eq))))
          ((p-star qa) (case b ((p-star qb) (pat-cmp-go qa qb)) (_ (eq)))))))))

; The wrapper is what keeps the comparator out of the value-poison shape:
; totality.md:105 poisons a RECURSIVE definition passed as a value, and
; str-cmp over su-cmp-bytes (lib/prelude/string.chiral:91-92) is the tree's
; live dodge. Only these three wrappers reach a call site as arguments.
(declare pat-cmp (-> Pat Pat Ord))
(def pat-cmp (lam (a b) (pat-cmp-go a b)))

; ─── Thread: a residual pattern with the offset it started at ────────────────
; A named nullary type instead of (Pair I64 Pat): list-sort takes its erased
; type argument at the call site (lib/typing/row-infer.chiral:103-104 passes
; Str), and multi-parameter type application at a call site is E100.
(data Span   () (span (from I64) (to I64)))       ; `to` is exclusive
(data Thread () (th (from I64) (pat Pat)))

; Two comparators, one norm. list-sort takes its comparator at
; lib/prelude/list.chiral:143 and list-dedup-adj takes its own at :184-186, so
; one composition sorts on a wider key than it dedups on.
(declare thread-cmp (-> Thread Thread Ord))       ; the DEDUP key: pat alone
(def thread-cmp
  (lam (a b) (case a ((th fa pa) (case b ((th fb pb) (pat-cmp pa pb)))))))

(declare thread-key-cmp (-> Thread Thread Ord))   ; the SORT key: pat, then from
(def thread-key-cmp
  (lam (a b)
    (case a
      ((th fa pa)
        (case b ((th fb pb) (ord-then (pat-cmp pa pb) (i64-cmp fa fb))))))))

; ─── norm: the line the bound lives in ───────────────────────────────────────
; Antimirov: the reachable state set has at most ‖pat‖ + 1 members. The dedup
; key is `pat` alone, so at most one thread survives per distinct residual and
; the live set stays at that bound. Delete this call and the matcher is a
; backtracker wearing a set.
;
; THE SURVIVOR IS THE LEAST START, and the sort key is the whole reason. The
; sort orders `from` ascending inside each `pat` run, so the least start heads
; its run, and list-dedup-adj keeps the head (lib/prelude/list.chiral:184-186).
; The order the driver appended threads in carries no weight here: norm
; reorders its own output every step, so the live list entering the next step
; is in `pat` order and unrelated to `from`.
(declare norm (-> (List Thread) (List Thread)))
(def norm
  (lam (ts)
    (list-dedup-adj Thread thread-cmp (list-sort Thread thread-key-cmp ts))))

; ─── stepping the live set ───────────────────────────────────────────────────
; Every residual of one thread inherits that thread's start offset.
(declare pd-threads (-> I64 (List Pat) (List Thread) (List Thread)))
(def pd-threads
  (lam (f ps acc)
    (case ps
      (nil acc)
      ((cons h t) (cons (th f h) (pd-threads f t acc))))))

(declare step-set (-> Win I64 (List Thread) (List Thread)))
(def step-set
  (lam (k b ts)
    (case ts
      (nil nil)
      ((cons h r)
        (case h ((th f p) (pd-threads f (pd k b p) (step-set k b r))))))))

; ─── reading a byte, and reading the live set ────────────────────────────────
; The one place -1 survives. It reads as `off the end of the buffer`, a byte
; value rather than a which-of-N classification, so pattern-boundary-sums
; leaves it alone.
(declare at-byte (-> Bytes I64 I64))
(def at-byte
  (lam (bs i)
    (cond ((<i i 0) (- 0 1))
          ((<i i (blen bs)) (bget bs i))
          (else (- 0 1)))))

; The least start among the threads that accept at k. Structural on ts.
(declare accept-from (-> Win (List Thread) (Maybe I64)))
(def accept-from
  (lam (k ts)
    (case ts
      (nil none)
      ((cons h r)
        (case h
          ((th f p)
            (case (nullable k p)
              (false (accept-from k r))
              (true
                (case (accept-from k r)
                  (none (some f))
                  ((some g)
                    (case (<i f g) (true (some f)) (false (some g)))))))))))))

(declare accepts (-> Win (List Thread) Bool))
(def accepts
  (lam (k ts) (case (accept-from k ts) (none false) ((some g) true))))

; ─── find-at: the anchored entry ─────────────────────────────────────────────
; run-from keeps the longest end offset reached from one fixed start. Total by
; the numeric measure: i steps by exactly +1 under the strict guard (<i i n)
; with n passed unchanged, so the measure is n - i (totality.md:80-89).
(declare run-from (-> Bytes I64 I64 (List Thread) (Maybe I64) (Maybe I64)))
(def run-from
  (lam (bs i n ts best)
    (let ((k (win (at-byte bs (- i 1)) (at-byte bs i))))
      (let ((best2 (case (accepts k ts) (true (some i)) (false best))))
        (case (<i i n)
          (false best2)
          (true
            (let ((ts2 (norm (step-set k (bget bs i) ts))))
              (case ts2
                (nil best2)                ; no continuation survives
                ((cons h t) (run-from bs (+ i 1) n ts2 best2))))))))))

; The failure carries no field and there is exactly one of it, so the sum is
; (Maybe Span) and a bespoke result type would name nothing.
(declare find-at (-> Pat Bytes I64 (Maybe Span)))
(def find-at
  (lam (p bs from)
    (case (run-from bs from (blen bs) (cons (th from p) nil) none)
      (none none)
      ((some e) (some (span from e))))))

; ─── find-all: ONE pass, leftmost-longest, non-overlapping ───────────────────
; Restarting find-at at every offset is n passes, which is the defect this
; module exists to remove. The live set carries each thread's start instead,
; and the pass visits every offset once.
(declare th-any-le (-> I64 (List Thread) Bool))
(def th-any-le
  (lam (f ts)
    (case ts
      (nil false)
      ((cons h r)
        (case h
          ((th g p) (case (<=i g f) (true true) (false (th-any-le f r)))))))))

; Non-overlap: after a span ends at t, a thread that started before t is dead.
(declare th-since (-> I64 (List Thread) (List Thread)))
(def th-since
  (lam (t ts)
    (case ts
      (nil nil)
      ((cons h r)
        (case h
          ((th g p)
            (case (<i g t)
              (true  (th-since t r))
              (false (cons h (th-since t r))))))))))

; The pending span is committed once no live thread can still start at or
; before it: at that point no longer match and no earlier match remains
; reachable. Total by the same numeric measure as run-from: every self-call is
; (+ i 1) under (<i i n) with n unchanged. `acc` is built by consing and
; reversed on the way out.
(declare scan-go
  (-> Pat Bytes I64 I64 (List Thread) (Maybe Span) (List Span) (List Span)))
(def scan-go
  (lam (p bs n i ts best acc)
    (let ((k (win (at-byte bs (- i 1)) (at-byte bs i))))
      (let ((ts1 (cons (th i p) ts)))       ; a thread may start at every offset
        (let ((best1
                (case (accept-from k ts1)
                  (none best)
                  ((some g)
                    (case best
                      (none (some (span g i)))
                      ((some s)
                        (case s
                          ((span f e)
                            (case (<=i g f)
                              (true  (some (span g i)))   ; leftmoster, or longer
                              (false (some (span f e))))))))))))
          (case (<i i n)
            (false
              (case best1
                (none (reverse Span acc))
                ((some s) (reverse Span (cons s acc)))))
            (true
              (let ((ts2 (norm (step-set k (bget bs i) ts1))))
                (case best1
                  (none (scan-go p bs n (+ i 1) ts2 none acc))
                  ((some s)
                    (case s
                      ((span f t)
                        (case (th-any-le f ts2)
                          (true  (scan-go p bs n (+ i 1) ts2 (some (span f t)) acc))
                          (false (scan-go p bs n (+ i 1) (th-since t ts2) none
                                   (cons (span f t) acc))))))))))))))))

(declare find-all (-> Pat Bytes (List Span)))
(def find-all (lam (p bs) (scan-go p bs (blen bs) 0 nil none nil)))

(declare count-matches (-> Pat Bytes I64))
(def count-matches (lam (p bs) (length Span (find-all p bs))))

; ─── LState: the line pass ───────────────────────────────────────────────────
; The PState idiom of lib/protocol/vt-parser.chiral:11-20, at two constructors.
; Code is skipped before any pattern sees a line: a fenced block goes whole and
; an inline span is blanked, so an identifier or a quoted check name stays out
; of the findings.
(data LState () (ls-prose) (ls-fence))

; The first non-blank offset at or after i, or n when the rest is blank. Total
; by the numeric measure: the step is exactly +1 under the strict guard
; (<i i n) with n passed unchanged, so the measure is n - i (totality.md:81-89).
(declare ls-nonblank (-> Bytes I64 I64 I64))
(def ls-nonblank
  (lam (bs i n)
    (case (<i i n)
      (false n)
      (true
        (let ((c (bget bs i)))
          (case (or (=i c 32) (=i c 9))
            (true  (ls-nonblank bs (+ i 1) n))
            (false i)))))))

; A toggler is leading blanks then three backtick bytes (96), which is the awk
; baseline's fence test at tools/prose-lint/prose-lint.sh:89. A longer run of
; backticks toggles too, because both tests read the first three and stop.
; Total: a case chain over three fixed offsets with no recursion. The nesting
; keeps every bget behind the one bounds test that covers it.
(declare line-is-fence (-> Str Bool))
(def line-is-fence
  (lam (ln)
    (let ((bs (str->bytes ln)))
      (let ((n (blen bs)))
        (let ((i (ls-nonblank bs 0 n)))
          (case (<=i (+ i 3) n)
            (false false)
            (true
              (case (=i (bget bs i) 96)
                (false false)
                (true
                  (case (=i (bget bs (+ i 1)) 96)
                    (false false)
                    (true (=i (bget bs (+ i 2)) 96))))))))))))

; The whole toggle. A fence line flips the state and answers false, so the
; toggling line reaches no pattern; the awk baseline does the same at
; tools/prose-lint/prose-lint.sh:89-91, where the toggle arm and the fenced arm
; both end in `next`. Total: two cases over two closed sums, no recursion.
(declare line-step (-> LState Str (Pair LState Bool)))   ; snd: scan this line?
(def line-step
  (lam (st ln)
    (case (line-is-fence ln)
      (true
        (case st
          ((ls-prose) (pair ls-fence false))
          ((ls-fence) (pair ls-prose false))))
      (false
        (case st
          ((ls-prose) (pair ls-prose true))
          ((ls-fence) (pair ls-fence false)))))))

; ─── blank-spans: an inline span becomes spaces of the same length ───────────
; The replacement is spaces, both backticks included, so an offset found on the
; blanked copy is still valid on the original. That is the length-preserving
; rule lib/prelude/string.chiral:96-99 states for the ASCII case fold, carried
; to a span of any width. The awk baseline deletes the span instead
; (tools/prose-lint/prose-lint.sh:93), which shortens the line and can glue the
; two sides of a span into a match that the source never held.
(def ls-space Str " ")

(declare ls-spaces (-> I64 Str))
(def ls-spaces (lam (k) (bytes->str (brepeat (str->bytes ls-space) k))))

; `pend` holds the open span's original text with its opening backtick. A
; closing backtick turns that length into spaces; reaching the end of the line
; with `pend` still open emits the text verbatim, which is how the awk gsub
; leaves an unpaired backtick alone.
;
; Total by the numeric measure: the step is exactly +1 under the strict guard
; (<i i n) with n passed unchanged, measure n - i (totality.md:81-89).
(declare blank-go (-> Bytes I64 I64 Str (Maybe Str) Str))
(def blank-go
  (lam (bs i n acc pend)
    (case (<i i n)
      (false (case pend (none acc) ((some t) (str-cat acc t))))
      (true
        (let ((one (bytes->str (bslice bs i (+ i 1)))))
          (case pend
            (none
              (case (=i (bget bs i) 96)
                (true  (blank-go bs (+ i 1) n acc (some one)))
                (false (blank-go bs (+ i 1) n (str-cat acc one) none))))
            ((some t)
              (case (=i (bget bs i) 96)
                (true  (blank-go bs (+ i 1) n
                         (str-cat acc (ls-spaces (+ (str-len t) 1))) none))
                (false (blank-go bs (+ i 1) n acc (some (str-cat t one))))))))))))

(declare blank-spans (-> Str Str))
(def blank-spans
  (lam (s) (let ((bs (str->bytes s))) (blank-go bs 0 (blen bs) "" none))))
