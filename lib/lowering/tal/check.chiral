; E18 (checker half): the typed-assembly floor checker. Ported from
; scaffold/chirality/tal.py check_fn (:119) / _check_block (:126) / _check_args (:246)
; / _fields (:255). Re-verifies every lowered instruction against its type
; annotation, INDEPENDENTLY of the kernel (the point of preserve-and-recheck).
; A register-file Gamma (REnv, I64 reg -> TalTy) is THREADED not mutated; the
; verdict is a TckR VALUE (tck-ok extended-env | tck-err msg), never a raised
; TalError; the instruction union is a coverage-checked `case` over `data Instr`
; (a new IR ctor with no rule = a COMPILE error, not tal.py's runtime catch-all).
; PURE (->), total (structural on Block<->TalTerm<->Branch). tal.py stays the oracle.
;
; SCOPE (SPEC / example §6): the PURE floor -- const/prim/call/con + the byte
; ops (bnew/bget/bput/blen) + ret/case. The sys/bptr sysface rules are the
; port/effect story (E51/E76), OMITTED here. Byte typed-init (linear bput-before-
; read) is scaffold-honest residue (decision #a). const range is vacuous at the
; chirality floor: an I64 field cannot hold an out-of-range value (tal.py needs the
; check only because Python ints are unbounded).
;
; This element PROVIDES ck-fn/ck-prog to E16 (lowering) and E17 (optimizer).
;
; E154 (flat emitted-label namespace): eleven internals here are `tck-` prefixed
; -- TckR/tck-ok/tck-err, TckCovR/tck-cov-ok, tck-find-ctor, tck-sig-assoc,
; tck-find-data, tck-ce-prims, tck-ce-fns, tck-ce-datas. Every one of them was
; already a top-level name in the compiler's blob (typing/kernel.chiral's own
; CkR, surface/data.chiral's CovR, kernel's find-ctor, and five byte-identical
; twins of lowering/upper/lower.chiral:163-194), so an `(import
; "lowering/tal/check")` beside the kernel was `load: data redeclared: CkR`
; before any type-checking ran. Two co-blobbed modules cannot define the same
; emitted label; typing/diag.chiral's `dg-` prefix is the same hand-patch for
; the same defect. The five twins are DUPLICATION rather than a conflict of
; meaning and their honest fix is a shared module. That is recorded as EN-16 in
; records/enforcement-arc.md and left there: lower.chiral is inside the blob, so
; extracting from it owes a full rebuild-and-promote.
;
; ck-fn and ck-prog, the two names this module exports, collide with nothing and
; keep their spelling.
(import "prelude/prelude")

; ---- the CHECKER's typed IR is now the shared lib/tal-ssa.chiral: TalTy /
; Instr / Block / TalTerm / Branch / TFn / Prog / TalSig + the check env
; (DCtor / DData / CEnv). It mirrors tal.py's annotated tuples and is re-checked
; independently of the kernel. NOT lib/tal-ir.chiral (the type-ERASED executable
; IR the emitter consumes); the two join by erasure.
(import "lowering/tal/ssa")

; Gamma + the verdict (errors are values).
(data REnv () (renv-nil) (renv-cons (r I64) (t TalTy) (rest REnv)))
(data TckR    () (tck-ok (env REnv)) (tck-err (msg Str)))
; the branch fold's result: covered-ctor set, or an error.
(data TckCovR () (tck-cov-ok (covered (List Str))) (cov-err (msg Str)))

(def tck-ce-prims (-> CEnv (List (Pair Str TalSig))) (lam (c) (case c ((cenv p f d l) p))))
(def tck-ce-fns   (-> CEnv (List (Pair Str TalSig))) (lam (c) (case c ((cenv p f d l) f))))
(def tck-ce-datas (-> CEnv (List DData))             (lam (c) (case c ((cenv p f d l) d))))

; ---- lookups + structural type equality --------------------------------------
(declare renv-get (-> REnv I64 (Maybe TalTy)))
(def renv-get (lam (env r)
  (case env
    ((renv-nil) (none))
    ((renv-cons r2 t rest) (case (=i r r2) (true (some t)) (false (renv-get rest r)))))))

(declare tal-ty=? (-> TalTy TalTy Bool))
(declare tys=?    (-> (List TalTy) (List TalTy) Bool))
(declare targs=?  (-> (List TalTy) (List TalTy) Bool))
; B1/B2: word-compatibility, not nominal equality. tt-word matches any one-word
; type (either side); tt-data recurses through the same relation on its type-args
; (so (List I64) matches (List Word)). Mirrors lower.py's _wcompat.
(def tal-ty=? (lam (a b)
  (case a
    ((tt-word)  true)
    ((tt-i64)   (case b ((tt-i64) true) ((tt-word) true) (_ false)))
    ((tt-str)   (case b ((tt-str) true) ((tt-word) true) (_ false)))
    ((tt-bytes) (case b ((tt-bytes) true) ((tt-word) true) (_ false)))
    ((tt-data dn1 as1) (case b
      ((tt-data dn2 as2) (and (str-eq dn1 dn2) (targs=? as1 as2)))
      ((tt-word) true)
      (_ false))))))
; B3 (EN-09/EN-10/EN-12, records/enforcement-arc.md): an EMPTY type-argument
; list is the wildcard at the argument-list level that tt-word is at the whole-
; type level. LCore is type-erased (lower.chiral:116-123) and expr-con
; (lower.chiral:296) therefore annotates every constructed value (tt-data dn
; nil) while a declared type carries its arguments, so nominal tys=? refused
; 99.2% of the ck-prog disagreement. targs distinguish nothing a machine can
; observe and no other rule reads them: ck-con below and ck-term's case arm
; both resolve a data type by NAME alone. Author call, records/author-calls.md
; "The `ck-prog` repair shape", 2026-09-03. The data NAME still has to match,
; and a ground type still never matches a data type -- tal-ty=?'s tt-i64 /
; tt-str / tt-bytes arms are untouched, which is why the six genuine lowering
; defects of EN-13 still refuse.
(def targs=? (lam (as bs)
  (case as
    (nil true)
    (_ (case bs
      (nil true)
      (_ (tys=? as bs)))))))
(def tys=? (lam (as bs)
  (case as
    (nil (case bs (nil true) (_ false)))
    ((cons x xr) (case bs (nil false) ((cons y yr) (and (tal-ty=? x y) (tys=? xr yr))))))))

(declare tck-sig-assoc (-> (List (Pair Str TalSig)) Str (Maybe TalSig)))
(def tck-sig-assoc (lam (ps k)
  (case ps
    (nil (none))
    ((cons p r) (case p ((pair pk pv) (case (str-eq pk k) (true (some pv)) (false (tck-sig-assoc r k)))))))))
(declare tck-find-data (-> (List DData) Str (Maybe (List DCtor))))
(def tck-find-data (lam (ds dn)
  (case ds
    (nil (none))
    ((cons d r) (case d ((ddata dn2 ctors) (case (str-eq dn2 dn) (true (some ctors)) (false (tck-find-data r dn)))))))))
(declare tck-find-ctor (-> (List DCtor) Str (Maybe (List TalTy))))
(def tck-find-ctor (lam (cs cn)
  (case cs
    (nil (none))
    ((cons c r) (case c ((dctor cn2 ftys) (case (str-eq cn2 cn) (true (some ftys)) (false (tck-find-ctor r cn)))))))))

; B1 recovery (EN-11, records/enforcement-arc.md): the data name a case
; dispatches on, recovered from the first arm's constructor when the scrutinee
; register carries the erased one-word type. ssa.chiral:17-20 defines tt-word as
; representation-compatible with any one-word type and says tal-ty=? is what
; checks it; tal-ty=?'s first arm above duly makes tt-word match everything, so
; a case arm that refuses a tt-word scrutinee contradicted this module's own IR
; spec. The lowering already performs exactly this recovery -- case-sty calling
; ctor-data, lower.chiral:168-188 -- and it stays inside the lowering's
; bookkeeping, so the register reaches the TFn still typed tt-word. Author call,
; records/author-calls.md "The `ck-prog` repair shape", 2026-09-03.
; The recovery is scoped to tt-word. A tt-i64 / tt-str / tt-bytes scrutinee is
; still refused, and covers-all? below still runs on the recovered ctor list, so
; a non-exhaustive tt-word case is still refused too.
(declare ctor-dn (-> (List DData) Str (Maybe Str)))
(def ctor-dn (lam (ds cn)
  (case ds
    (nil (none))
    ((cons d r) (case d ((ddata dn cs)
      (case (tck-find-ctor cs cn)
        ((some ftys) (some dn))
        (none (ctor-dn r cn)))))))))
(declare ck-scrut-dn (-> (List DData) TalTy (List Branch) (Maybe Str)))
(def ck-scrut-dn (lam (ds sty branches)
  (case sty
    ((tt-data dn targs) (some dn))
    ((tt-word) (case branches
      (nil (none))
      ((cons b r) (case b ((branch cn dsts body) (ctor-dn ds cn))))))
    (_ (none)))))

; ---- argument arity + type check (tal.py _check_args) -------------------------
(declare ck-args (-> REnv (List TalTy) (List I64) Bool))
(def ck-args (lam (env expect srcs)
  (case expect
    (nil (case srcs (nil true) (_ false)))
    ((cons e er) (case srcs
      (nil false)
      ((cons s sr) (case (renv-get env s)
        (none false)
        ((some got) (case (tal-ty=? got e) (true (ck-args env er sr)) (false false))))))))))

; ck-app: args typed against the sig, sig.ret must equal the annotation, dst set
(declare ck-app (-> REnv TalSig (List I64) I64 TalTy TckR))
(def ck-app (lam (env sig srcs dst ty)
  (case sig ((talsig argtys sigret)
    (case (ck-args env argtys srcs)
      (false (tck-err "argument arity or type mismatch"))
      (true (case (tal-ty=? sigret ty)
        (false (tck-err "return type annotation does not match signature"))
        (true (tck-ok (renv-cons dst ty env))))))))))

; ck-src / ck-void: the byte-floor arg check, with / without a dst
(declare ck-src (-> REnv (List TalTy) (List I64) I64 TalTy TckR))
(def ck-src (lam (env expect srcs dst rty)
  (case (ck-args env expect srcs) (true (tck-ok (renv-cons dst rty env))) (false (tck-err "argument arity or type mismatch")))))
(declare ck-void (-> REnv (List TalTy) (List I64) TckR))
(def ck-void (lam (env expect srcs)
  (case (ck-args env expect srcs) (true (tck-ok env)) (false (tck-err "argument arity or type mismatch")))))

; const-fits?: an I64 literal always inhabits tt-i64 (bounded by the field type);
; a tt-str/tt-bytes/tt-data annotation on an I64 value never fits (tal.py's type
; branch). The range check is vacuous here (decision above).
(declare const-fits? (-> TalTy I64 Bool))
(def const-fits? (lam (ty v) (case ty ((tt-i64) true) ((tt-word) true) ((tt-str) true) ((tt-bytes) true) (_ false))))

; ck-con: annotation must be (tt-data dn ...) with matching dn; fields vs decl
(declare ck-con (-> CEnv REnv I64 Str Str (List I64) TalTy TckR))
(def ck-con (lam (ce env dst dn cn srcs ty)
  (case ty
    ((tt-data tydn targs)
      (case (str-eq tydn dn)
        (false (tck-err "con: annotation data name does not match"))
        (true (case (tck-find-data (tck-ce-datas ce) dn)
          (none (tck-err "con: unknown data type"))
          ((some ctors) (case (tck-find-ctor ctors cn)
            (none (tck-err "con: not a constructor of the data type"))
            ((some ftys) (case (ck-args env ftys srcs)
              (true (tck-ok (renv-cons dst ty env)))
              (false (tck-err "con: field arity or type mismatch"))))))))))
    (_ (tck-err "con: annotation is not a data type")))))

; ---- one instruction, one local rule (exhaustive over Instr) ------------------
(declare ck-instr (-> CEnv REnv Instr TckR))
(def ck-instr (lam (ce env i)
  (case i
    ((i-const dst ty v)
      (case (const-fits? ty v)
        (true  (tck-ok (renv-cons dst ty env)))
        (false (tck-err "const: literal does not inhabit its annotation"))))
    ((i-prim dst op srcs ty)
      (case (tck-sig-assoc (tck-ce-prims ce) op)
        ((some sig) (ck-app env sig srcs dst ty))
        (none       (tck-err "prim: no tal signature"))))
    ((i-call dst f srcs ty)
      (case (tck-sig-assoc (tck-ce-fns ce) f)
        ((some sig) (ck-app env sig srcs dst ty))
        (none       (tck-err "call: unknown tal function"))))
    ((i-con dst dn cn srcs ty) (ck-con ce env dst dn cn srcs ty))
    ((i-bnew dst n)     (ck-src env (cons (tt-i64) nil) (cons n nil) dst (tt-bytes)))
    ((i-bget dst ptr idx) (ck-src env (cons (tt-bytes) (cons (tt-i64) nil)) (cons ptr (cons idx nil)) dst (tt-i64)))
    ((i-bput ptr idx v) (ck-void env (cons (tt-bytes) (cons (tt-i64) (cons (tt-i64) nil))) (cons ptr (cons idx (cons v nil)))))
    ((i-blen dst src)   (ck-src env (cons (tt-bytes) nil) (cons src nil) dst (tt-i64))))))

; ---- blocks / terminators / fn / prog ----------------------------------------
(declare ck-instrs   (-> CEnv REnv (List Instr) TckR))
(declare ck-block    (-> CEnv REnv Block TalTy TckR))
(declare ck-term     (-> CEnv REnv TalTerm TalTy TckR))
(declare ck-branches (-> CEnv REnv (List DCtor) (List Branch) TalTy TckCovR))
(def ck-instrs (lam (ce env instrs)
  (case instrs
    (nil (tck-ok env))
    ((cons i rest) (case (ck-instr ce env i)
      ((tck-err m) (tck-err m))
      ((tck-ok env2) (ck-instrs ce env2 rest)))))))
(def ck-block (lam (ce env blk ret)
  (case blk ((block instrs term)
    (case (ck-instrs ce env instrs)
      ((tck-err m) (tck-err m))
      ((tck-ok env2) (ck-term ce env2 term ret)))))))

(declare bind-dsts (-> REnv (List I64) (List TalTy) REnv))
(def bind-dsts (lam (env dsts ftys)
  (case dsts
    (nil env)
    ((cons d dr) (case ftys (nil env) ((cons t tr) (bind-dsts (renv-cons d t env) dr tr)))))))
(declare len=? (-> (List I64) (List TalTy) Bool))
(def len=? (lam (xs ys)
  (case xs (nil (case ys (nil true) (_ false)))
    ((cons a ar) (case ys (nil false) ((cons b br) (len=? ar br)))))))
(declare covers-all? (-> (List Str) (List DCtor) Bool))
(declare str-in (-> Str (List Str) Bool))
(def str-in (lam (x xs) (case xs (nil false) ((cons y r) (case (str-eq x y) (true true) (false (str-in x r)))))))
(def covers-all? (lam (covered ctors)
  (case ctors
    (nil true)
    ((cons c r) (case c ((dctor cn ftys) (case (str-in cn covered) (true (covers-all? covered r)) (false false))))))))

(def ck-term (lam (ce env term ret)
  (case term
    ((t-ret src) (case (renv-get env src)
      ((some got) (case (tal-ty=? got ret) (true (tck-ok env)) (false (tck-err "ret: type does not match declared return"))))
      (none (tck-err "ret: type does not match declared return"))))
    ((tt-case src branches dflt) (case (renv-get env src)
      (none (tck-err "case on non-data register"))
      ((some sty) (case (ck-scrut-dn (tck-ce-datas ce) sty branches)
        (none (tck-err "case on non-data register"))
        ((some dn) (case (tck-find-data (tck-ce-datas ce) dn)
          (none (tck-err "case: unknown data type"))
          ((some ctors) (case (ck-branches ce env ctors branches ret)
            ((cov-err m) (tck-err m))
            ((tck-cov-ok covered) (case dflt
              ((some blk) (ck-block ce env blk ret))
              (none (case (covers-all? covered ctors)
                (true (tck-ok env))
                (false (tck-err "non-exhaustive tal case")))))))))))))))))
(def ck-branches (lam (ce env ctors branches ret)
  (case branches
    (nil (tck-cov-ok nil))
    ((cons b rest) (case b ((branch cn dsts body)
      (case (tck-find-ctor ctors cn)
        (none (cov-err "case branch is not a constructor of the scrutinee type"))
        ((some ftys) (case (len=? dsts ftys)
          (false (cov-err "case branch binds the wrong number of fields"))
          (true (case (ck-block ce (bind-dsts env dsts ftys) body ret)
            ((tck-err m) (cov-err m))
            ((tck-ok ignore) (case (ck-branches ce env ctors rest ret)
              ((cov-err m) (cov-err m))
              ((tck-cov-ok cov) (tck-cov-ok (cons cn cov))))))))))))))))

(declare seed-params (-> I64 (List TalTy) REnv))
(def seed-params (lam (i ptys)
  (case ptys (nil (renv-nil)) ((cons t rest) (renv-cons i t (seed-params (+ i 1) rest))))))
(declare ck-fn (-> CEnv TFn TckR))
(def ck-fn (lam (ce fn)
  (case fn ((tfn name params ret body nregs) (ck-block ce (seed-params 0 params) body ret)))))

(declare prog-fns (-> (List TFn) (List (Pair Str TalSig))))
(def prog-fns (lam (fns)
  (case fns
    (nil nil)
    ((cons f rest) (case f ((tfn name params ret body nregs)
      (cons (pair name (talsig params ret)) (prog-fns rest))))))))
(declare ck-fns (-> CEnv (List TFn) TckR))
(def ck-fns (lam (ce fns)
  (case fns
    (nil (tck-ok (renv-nil)))
    ((cons f rest) (case (ck-fn ce f)
      ((tck-err m) (tck-err m))
      ((tck-ok ignore) (ck-fns ce rest)))))))
; ck-prog: derive the fn-sig table from the Prog, then fold ck-fn. cenv0 carries
; the extern sigs + data decls (its fns field is ignored/rebuilt here).
(declare ck-prog (-> CEnv Prog TckR))
(def ck-prog (lam (cenv0 p)
  (case p ((prog fns)
    (case cenv0 ((cenv prims ignore datas lits)
      (ck-fns (cenv prims (prog-fns fns) datas lits) fns)))))))
