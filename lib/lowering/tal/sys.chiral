; ti-bput(base_m8, off, 0) lands on base+off (the +8 payload skip). Pure byte
; op, no ti-sys, not a crossing (called only by nb-pool-close).
(def nb-pool-zero-t TIFn
  (ti-fn "nb-pool-zero" 3 8
    (t-seq (ti-prim 3 (op-lti) 1 2)                         ; off < size ?
      (ti-tcase 3 false
        (cons (pair (pair 0 nil)                            ; more to zero
          (t-seq (ti-const 4 0)
          (t-seq (ti-bput 0 1 4)                            ; base+off := 0
          (t-seq (ti-const 5 1)
          (t-seq (ti-prim 6 (op-add) 1 5)                   ; off + 1
          (t-seq (ti-call 7 "nb-pool-zero" (cons 0 (cons 6 (cons 2 nil))))
            (ti-ret 7)))))))
        (cons (pair (pair 1 nil)                            ; done
          (t-seq (ti-const 4 0) (ti-ret 4)))
        nil))
        none))))

; nb-pool-close(pool) -> Unit: zeroize [base,base+size) then munmap(base,size).
; The memfd fd is discharged separately by fd-close on the PoolR.fd field.
; reg0 = pool cell. Returns the munmap rc (Unit-erased at the boundary, the
