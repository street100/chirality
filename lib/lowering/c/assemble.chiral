; The C-mode assembler: the replacement for asm-reloc's `assemble` /
; `materialize` when the target is C-as-portable-assembly (E166, SPEC step 1).
;
; `assemble` exists to turn a flat (List Asm) into machine code: it places every
; label at a byte offset and then resolves each relocation into a signed
; displacement. NONE of that means anything in C -- the C compiler owns layout,
; and a `call` is a name, not a distance. So the C mode keeps the same input
; (the very same (List Asm) `emit-core` produces for any conforming Mach) and
; does the two things that DO mean something on this target:
;
;   * it renders the stream's text in order, and
;   * it turns each label into the C construct that label actually IS.
;
; ── the boundary sum ────────────────────────────────────────────────────────
; A label arrives as a bare `Str` that silently encodes which-of-three it is:
; a function entry, a local jump target, or a literal data cell. That is a sum
; wearing a disguise (docs/pattern-boundary-sums.md), and it is classified
; ONCE, here, by `c-classify` -- against the emitted-function-name list handed
; in by the caller. No arm below re-sniffs a name.
;
; ── why this is its own file ────────────────────────────────────────────────
; `asm-reloc.chiral` is target-independent by construction ("kept a-rel
; target-independent"). Putting a C mode inside it would make a general module
; target-aware. SPEC decision 2.
;
; ── contract with `mach-c` (arrives in step 2) ──────────────────────────────
; This module emits the FRAME; the Mach arms emit the statements.
;   * a function label opens `long m_<name>(void) {` and the next function
;     label (or a literal, or end of stream) closes it with `}`. Arguments
;     travel through the machine's own argument file (`stp`/`lda`/`ldr`), so
;     the C signature takes none.
;   * a literal label opens `unsigned char m_<name>[] = ` and `mach-c`'s `dat`
;     arm supplies the initializer and the terminating `};`.
;   * `a-rel` contributes ONLY its name, to a forward-declaration prologue --
;     which is what makes a call to a function defined later, or a `lea` of a
;     literal cell defined after all the code, legal C.
;   * `a-align` emits nothing (SPEC decision 8): only mach-x64:559 produces one
;     (page alignment for mprotect) and C alignment is the C compiler's job.
;     It is still `case`d exhaustively -- coverage-checked, not defaulted.

(import "prelude/prelude")
(import "prelude/collections")
(import "prelude/string")
(import "lowering/mach/asm-reloc")

(module lowering/c/assemble (cat A) (alt upper))

; ── CLbl: what a label IS, decided once at the boundary ─────────────────────
; c-lit carries the literal's INDEX, not its name: emit-core mints literal
; labels as "$lit<i>" (emit-core.chiral:143), so the index is the whole content.
(data CLbl ()
  (c-fn (n Str))
  (c-local (n Str))
  (c-lit (i I64)))

; ── c-mangle: chirality label -> C identifier, TOTALLY and INJECTIVELY ──────────
; Injectivity is the load-bearing property: two chirality names colliding into one
; C identifier is a silently miscompiled leg, which is strictly worse than no
; leg at all. It holds because the escape character escapes ITSELF -- every `_`
; in the output introduces an escape, so the output decodes uniquely.
;
;   [A-Za-z0-9] -> verbatim        _ -> _U        - -> _D        $ -> _S
;   every other byte -> _x<two lowercase hex digits>
;
; The three named escapes are SPEC decision 6. The hex fallback is NOT in that
; decision and is added deliberately: decision 6 covers `-` (everywhere) and
; `$` (closconv.chiral:1097-1098's $clo0/$apply0), but the live def-name
; alphabet in scaffold/lib also contains `*`, `=`, `>` and `?` -- `offs->tree`
; is a real, called def in asm-reloc.chiral:68. Escaping only three characters
; would emit `m_offs->tree`, which is not a C identifier at all. `x` is not one
; of {U,D,S} and the hex run is always exactly two digits, so adding it keeps
; the decode unique.
(def ca-hexdigits Str "0123456789abcdef")

(def ca-hexdig (-> I64 Str)
  (lam (v) (str-sub ca-hexdigits v (+ v 1))))

(def ca-cident? (-> I64 Bool)
  (lam (c)
    (or (and (<=i 48 c) (<=i c 57))
      (or (and (<=i 65 c) (<=i c 90))
          (and (<=i 97 c) (<=i c 122))))))

(def ca-esc (-> Bytes I64 Str)
  (lam (b i)
    (let ((c (bget b i)))
      (cond ((ca-cident? c) (bytes->str (bslice b i (+ i 1))))
            ((=i c 95) "_U")                                   ; _
            ((=i c 45) "_D")                                   ; -
            ((=i c 36) "_S")                                   ; $
            (else (str-cat "_x" (str-cat (ca-hexdig (/ c 16))
                                         (ca-hexdig (% c 16)))))))))

; total: structural on the byte count n.
(declare ca-mangle-go (-> Bytes I64 I64 Str Str))
(def ca-mangle-go
  (lam (b i n acc)
    (case (=i i n)
      (true acc)
      (false (ca-mangle-go b (+ i 1) n (str-cat acc (ca-esc b i)))))))

(def c-mangle (-> Str Str)
  (lam (s)
    (let ((b (str->bytes s)))
      (str-cat "m_" (ca-mangle-go b 0 (blen b) "")))))

; ── c-classify: the ONE place a label name is inspected ─────────────────────
; ⚑ COST, measured against a precedent, NOT fixed here. `ca-member?` is a
; linear scan, so classification is O(labels x fns). asm-reloc.chiral:63-66
; records that exactly this shape -- "~15k relocations against ~6k labels ...
; the emit's dominant cost (~10^8 interpreted string compares)" -- is what
; forced `place` onto an E27 ordered Map. A self-compile through this module
; will hit the same wall. The fix is the same one (build a (Map Str I64) once
; in `c-assemble` and thread it), but it changes `c-classify`'s signature away
; from the (List Str) the SPEC step 1 names, so it belongs to the step-5
; measurement checkpoint (SPEC decision 10) and its author call, not here.
(def ca-member? (-> (List Str) Str Bool)
  (lam (names s)
    (case names
      (nil false)
      ((cons h rest) (case (str-eq h s) (true true) (false (ca-member? rest s)))))))

; is every byte of s a decimal digit? (an empty s is NOT all-digits)
(declare ca-digits-go (-> Bytes I64 I64 Bool))
(def ca-digits-go
  (lam (b i n)
    (case (=i i n)
      (true true)
      (false (let ((c (bget b i)))
               (case (and (<=i 48 c) (<=i c 57))
                 (false false)
                 (true (ca-digits-go b (+ i 1) n))))))))

(def ca-all-digits? (-> Str Bool)
  (lam (s)
    (let ((b (str->bytes s)))
      (case (=i (blen b) 0) (true false) (false (ca-digits-go b 0 (blen b)))))))

(def ca-lit-prefix Str "$lit")

; emit-core.chiral:143 mints these; reproduced rather than imported because
; emit-core imports `alloc` and this module must stay under it.
(def ca-lit-label (-> I64 Str)
  (lam (i) (str-cat ca-lit-prefix (i64->str i))))

(def c-classify (-> (List Str) Str CLbl)
  (lam (fns l)
    (cond ((ca-member? fns l) (c-fn l))
          (else
            (let ((tail (str-strip-prefix ca-lit-prefix l)))
              (cond ((and (str-starts-with ca-lit-prefix l) (ca-all-digits? tail))
                     (c-lit (str->i64 tail)))
                    (else (c-local l))))))))

; ── rendering ───────────────────────────────────────────────────────────────
(def ca-txt (-> Str Bytes) (lam (s) (str->bytes s)))

(def ca-open-fn (-> Str Bytes)
  (lam (n) (ca-txt (str-cat "long " (str-cat (c-mangle n) "(void) {\n")))))

(def ca-open-lit (-> I64 Bytes)
  (lam (i) (ca-txt (str-cat "\nunsigned char "
                     (str-cat (c-mangle (ca-lit-label i)) "[] = ")))))

; a C label must be followed by a statement; the empty one always is legal.
(def ca-label (-> Str Bytes)
  (lam (n) (ca-txt (str-cat (c-mangle n) ": ;\n"))))

; close the function currently open, if one is
(def ca-close (-> Bool (List Bytes) (List Bytes))
  (lam (open acc)
    (case open
      (false acc)
      (true (cons (ca-txt "}\n\n") acc)))))

; ── the forward-declaration prologue ────────────────────────────────────────
; Every a-rel name, classified. A local jump target needs no declaration, so
; the c-local arm contributes nothing -- the boundary sum doing its job.
; Repeats are harmless in C (a declaration may be repeated), so no dedup pass.
(declare ca-decls (-> (List Str) (List Asm) (List Bytes) (List Bytes)))
(def ca-decls
  (lam (fns xs acc)
    (case xs
      (nil acc)
      ((cons a rest)
        (case a
          ((a-rel sz enc l)
            (ca-decls fns rest
              (case (c-classify fns l)
                ((c-fn n) (cons (ca-txt (str-cat "long " (str-cat (c-mangle n) "(void);\n"))) acc))
                ((c-lit i) (cons (ca-txt (str-cat "extern unsigned char "
                                           (str-cat (c-mangle (ca-lit-label i)) "[];\n"))) acc))
                ((c-local n) acc))))
          (_ (ca-decls fns rest acc)))))))

; ── the body walk ───────────────────────────────────────────────────────────
; Structural on xs, with a REVERSED accumulator flipped once by the caller.
; `open` is the one bit of state: is a C function body currently unterminated?
(declare ca-body (-> (List Str) (List Asm) Bool (List Bytes) (List Bytes)))
(def ca-body
  (lam (fns xs open acc)
    (case xs
      (nil (ca-close open acc))
      ((cons a rest)
        (case a
          ((a-bytes b) (ca-body fns rest open (cons b acc)))
          ((a-align n) (ca-body fns rest open acc))          ; decision 8: nothing
          ((a-rel sz enc l) (ca-body fns rest open acc))     ; name only, in the prologue
          ((a-label l)
            (case (c-classify fns l)
              ((c-fn n) (ca-body fns rest true (cons (ca-open-fn n) (ca-close open acc))))
              ((c-local n) (ca-body fns rest open (cons (ca-label n) acc)))
              ((c-lit i) (ca-body fns rest false (cons (ca-open-lit i) (ca-close open acc)))))))))))

; ── c-assemble: the entry point, paralleling asm-reloc's `assemble` ─────────
; Pure (->) where `assemble` is (=>): there is no label table to resolve, so
; there is no unknown-label alarm to raise. The result is C text; the caller
; (emit-c, step 4) writes it out and hands it to the C toolchain.
(def c-assemble (-> (List Str) (List Asm) Bytes)
  (lam (fns xs)
    (bcat
      (bcat-all (reverse Bytes (ca-decls fns xs (the (List Bytes) nil))))
      (bcat-all (reverse Bytes (ca-body fns xs false (the (List Bytes) nil)))))))
