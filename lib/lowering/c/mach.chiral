; A THIRD conforming Mach: C-as-portable-assembly (E166, SPEC step 2).
;
; Same move as mach-listing.chiral -- text into a-bytes, e-noenc on every
; relocation, all 37 arms -- with the one difference that changes everything:
; THIS TARGET RUNS. So each arm must be semantics-preserving C, not a pretty
; rendering. `emit-core` drives it with no change; `c-assemble` (step 1) turns
; the flat (List Asm) into a translation unit; a freestanding shim (step 3)
; supplies the helpers named below.
;
; ── the frame contract, owned by c-assemble ─────────────────────────────────
; c-assemble emits `long m_<name>(void) {` for a function label, `m_<n>: ;` for
; a local one, `unsigned char m_<n>[] = ` for a literal, and the closing `}`.
; So `pro` emits NO opening brace (the example's §5 draft did -- it would
; double-brace every function), and `dat` supplies the literal's initializer
; AND its terminating `};`.
;
; ── the argument file ───────────────────────────────────────────────────────
; c-assemble's signatures take (void), so outgoing arguments cannot ride C
; parameters: they ride `m_arg`, one global array, exactly as they ride the
; SysV argument registers on x64. `pro` copies m_arg[0..5] into the LOCALS
; a0..a5 at entry, and those locals are what the resident-argreg ops
; (binr/binir/fcpr/fcir) read. That is why `clb` can honestly return nil where
; x64 returns a clobber set: on this target a "resident argument register" is a
; function-local that no emitted statement ever writes, so nothing clobbers it.
; The price is `ldr j i`: on x64 i==j is FREE (one register, both roles), here
; the incoming local and the outgoing slot are different objects, so it always
; copies. mach-listing's and the example's "nothing when i==j" would be a
; miscompile here.
;
; ── wrapping, Euclidean, masked: why nine ops are calls ─────────────────────
; chirality I64 is two's-complement WRAPPING. C's signed + - * << are UNDEFINED on
; overflow and gcc optimizes on the assumption they cannot happen, so an infix
; rendering would be a leg gcc is licensed to reinterpret -- the one thing this
; element cannot trade away. Only the six ops whose C meaning is total stay
; infix (band bor bxor eqi lti lei); the other nine route to shim helpers:
;   add sub mul  : wrap in u64
;   shl sar shr  : wrap AND mask the count to 6 bits -- x86 `sar/shr/shl rax,
;                  cl` already masks (mach-x64.chiral:321,323,331), so chirality's
;                  shift semantics ARE count-mod-64 and C must say so
;   div mod      : EUCLIDEAN, not truncating, plus the D3 guard
;                  (mach-x64.chiral:175-185): divisor 0 traps, divisor -1
;                  branches
;   mulhi        : no ISO-C spelling at all
;
; ── pointers are addresses, and that is forced, not chosen ──────────────────
; ⚑ DEVIATION from SPEC step 3's "m_bptr, the only int->ptr cast". An index
; model cannot work: `lea` (emit-core.chiral:162) puts a LITERAL cell's address
; into the same register file that `bln`/`bgt`/`bpr` consume, and c-assemble
; already fixed literals as standalone `unsigned char m_<n>[]` objects -- they
; are not inside any heap array, so no single index space addresses both. A
; cell pointer is therefore a `long` holding a real address, exactly as on x64,
; and every cast stays inside the shim behind m_getf/m_setf/m_bget/m_bput/
; m_blen/m_tag/m_addr/m_bptr. The trusted drop is the same size; it is named
; here rather than in one `volatile`.
;
; ── naming ──────────────────────────────────────────────────────────────────
; Helpers are mc-/c- prefixed: mach-listing.chiral owns TOP-LEVEL `line`, `r`,
; `lcat`, and emitted names share one flat namespace until E154 (SPEC decision
; 7). Every chirality name reaching C goes through c-assemble's `c-mangle` -- there
; is no second scheme.
;
; ── obligations this file places on step 3 (scaffold/rt/chirality-rt.c) ─────────
; The prototypes are `mc-preamble` below, which step 4's emit-c must place
; FIRST in the translation unit (`fin` is trailing material, so it cannot carry
; them). Two sizing facts travel with them: `m_arg` is declared [64], so a call
; past 64 arguments is a constant-index out-of-bounds gcc can see; and `m_trap`
; is the ud2 idiom (SPEC decision 3b), reached from a jump table's impossible
; default and from the fixed-heap bounds check.
; ⚑ Also for step 5: `tca` renders as `return f();`, a C tail call. gcc enables
; -foptimize-sibling-calls at -O2, NOT at -O1, and this compiler recurses
; through tail calls -- the leg script must pass it explicitly or the C stack
; is the limit.
; ⚑ And a second cost branch for SPEC decision 10's measurement checkpoint,
; beside the `c-classify` one c-assemble already records: `c-byte-list` renders
; one literal byte per str-cat, so the whole literal pool costs O(bytes^2).
; If the self-compile stalls there, the fix is the same Bytes builder (`bcat`
; into a (List Bytes), flattened once) -- a measurement, not a guess.

(import "prelude/prelude")
(import "prelude/list")
(import "lowering/mach/asm-reloc")
(import "lowering/mach/mach")
(import "lowering/c/assemble")

(module lowering/c/mach (cat A) (alt upper))

; ── text ────────────────────────────────────────────────────────────────────
(def mc-s3 (-> Str Str Str Str) (lam (a b c) (str-cat a (str-cat b c))))
(def mc-s4 (-> Str Str Str Str Str) (lam (a b c d) (str-cat a (mc-s3 b c d))))
(def mc-s5 (-> Str Str Str Str Str Str) (lam (a b c d e) (str-cat a (mc-s4 b c d e))))
(def mc-s6 (-> Str Str Str Str Str Str Str) (lam (a b c d e f) (str-cat a (mc-s5 b c d e f))))

(def mc-txt (-> Str (List Asm)) (lam (s) (one-b (str->bytes s))))

; one indented C statement
(def mc-line (-> Str (List Asm)) (lam (s) (mc-txt (mc-s3 "  " s "\n"))))

(def mc-lcat (-> (List Asm) (List Asm) (List Asm))
  (lam (xs ys) (case xs (nil ys) ((cons h t) (cons h (mc-lcat t ys))))))

(def mc-r (-> I64 Str) (lam (n) (mc-s3 "r[" (i64->str n) "]")))
(def mc-a (-> I64 Str) (lam (n) (str-cat "a" (i64->str n))))
(def mc-g (-> I64 Str) (lam (n) (mc-s3 "m_arg[" (i64->str n) "]")))

; An I64 immediate as a C constant. The `L` suffix keeps a value past INT_MAX a
; long. LONG_MIN has no C literal (its digits exceed LONG_MAX before the unary
; minus applies), so it is spelled as a subtraction -- detected without naming
; the value: it is the one nonzero fixpoint of negation in two's complement.
(def mc-imm (-> I64 Str)
  (lam (v)
    (case (and (not (=i v 0)) (=i v (- 0 v)))
      (true "(-9223372036854775807L - 1L)")
      (false (str-cat (i64->str v) "L")))))

(def mc-set (-> Str Str (List Asm))
  (lam (d rhs) (mc-line (mc-s4 d " = " rhs ";"))))

; ── the Op table ────────────────────────────────────────────────────────────
(data COp () (c-infix (s Str)) (c-call (fn Str)))

(def c-op (-> Op COp)
  (lam (op)
    (case op
      ((op-band) (c-infix "&"))   ((op-bor) (c-infix "|"))
      ((op-bxor) (c-infix "^"))
      ; ⚑ THE THREE COMPARISONS ARE DELIBERATELY INVERTED. DO NOT "correct" them.
      ; Bool is (data Bool () (true) (false)) -- prelude.chiral:18 -- so `true` is
      ; tag 0, and a comparison materialized as a VALUE must yield the TAG, not
      ; C truth. mach-x64 does exactly this: :367 op-eqi -> x-setcc 149 = SETNE
      ; (not sete), :369 op-lti -> 157 = SETGE, :371 op-lei -> 159 = SETG, and
      ; the immediate path :981 carries the same 149. So `a != b` is 0 exactly
      ; when a == b, which IS `true`. Spelling these as ==, <, <= negates every
      ; materialized Bool: it made `or`/`and`/`not` return their opposites,
      ; is-trivia true for every byte, skip-trivia eat the whole source,
      ; read-all-str return (a-ok nil), and the compiler report
      ; "no such def: compile-main". Measured and fixed 2026-08-24; this is the
      ; second time the inversion has been got wrong in this element.
      ((op-eqi) (c-infix "!="))
      ((op-lti) (c-infix ">="))   ((op-lei) (c-infix ">"))
      ((op-add) (c-call "m_add")) ((op-sub) (c-call "m_sub"))
      ((op-mul) (c-call "m_mul")) ((op-shl) (c-call "m_shl"))
      ((op-sar) (c-call "m_sar")) ((op-shr) (c-call "m_shr"))
      ((op-div) (c-call "m_div")) ((op-mod) (c-call "m_mod"))
      ((op-mulhi) (c-call "m_mulhi")))))

; the BARE expression -- no dst, no semicolon -- because fjc needs it inside an
; `if (...)`, where an assignment is a syntax error. The infix form is
; parenthesized so no C precedence rule can reassociate it.
(def c-expr (-> Op Str Str Str)
  (lam (op x y)
    (case (c-op op)
      ((c-infix s) (mc-s5 "(" x (mc-s3 " " s " ") y ")"))
      ((c-call f)  (mc-s5 f "(" x ", " (str-cat y ")"))))))

(def c-bin-text (-> Str Op Str Str Str)
  (lam (dst op x y) (mc-s4 dst " = " (c-expr op x y) ";")))

; ── argument placement ──────────────────────────────────────────────────────
; `cal` places ALL args itself (mach.chiral's contract), and x-cal accepts any
; arity by spilling past six to the SysV stack zone -- so c-args must not
; refuse either, or mach-c would reject a program mach-x64 accepts.
(def c-args (-> (List I64) I64 (List Asm))
  (lam (args pos)
    (case args
      (nil (the (List Asm) nil))
      ((cons slot rest)
        (mc-lcat (mc-set (mc-g pos) (mc-r slot)) (c-args rest (+ pos 1)))))))

; `lda` is the one that DOES refuse, reproducing mach-x64.chiral:1663 exactly:
; the two legs must accept the same language or a DDC comparison is comparing
; two different programs.
(def c-lda (=> I64 I64 (List Asm))
  (lam (ap slot)
    (case (<=i ap 5)
      (true (mc-set (mc-g ap) (mc-r slot)))
      (false (halt (List Asm)
        "emit(c): call/def with >6 args; mach-x64 refuses these (mach-x64.chiral:1663), so mach-c does too")))))

; the six syscall operands, padded with 0 -- the crossing's shape is fixed at
; six on both legs (mach-x64's x-sysargs has exactly six registers).
(def c-sysargs (-> (List I64) I64 Str)
  (lam (args k)
    (case (=i k 6)
      (true "")
      (false
        (case args
          (nil (str-cat ", 0L" (c-sysargs (the (List I64) nil) (+ k 1))))
          ((cons s rest) (mc-s3 ", " (mc-r s) (c-sysargs rest (+ k 1)))))))))

; ── the heap face ───────────────────────────────────────────────────────────
; A value cell is [tag][field...]; a byte cell is [len][payload], both exactly
; as mach-x64 lays them out, so the shim's arithmetic is x-alo's arithmetic.
; `_p` is the temporary the aliasing case needs: x-alo stores rax to dst AFTER
; writing the fields, precisely so `(alo d tag (list d ...))` is correct.
(def c-fields (-> (List I64) I64 (List Asm))
  (lam (fs i)
    (case fs
      (nil (the (List Asm) nil))
      ((cons f rest)
        (mc-lcat (mc-line (mc-s5 "m_setf(_p, " (i64->str i) ", " (mc-r f) ");"))
          (c-fields rest (+ i 1)))))))

(def c-alo (-> I64 I64 (List I64) (List Asm))
  (lam (dst tag fs)
    (mc-lcat
      (mc-set "_p" (mc-s5 "m_alloc(" (mc-imm tag) ", " (i64->str (length I64 fs)) ")"))
      (mc-lcat (c-fields fs 0) (mc-set (mc-r dst) "_p")))))

(def c-bnw (-> I64 I64 (List Asm))
  (lam (dst len) (mc-set (mc-r dst) (mc-s3 "m_balloc(" (mc-r len) ")"))))

; ── literal cells ───────────────────────────────────────────────────────────
; The same bytes x-dat emits: an 8-byte little-endian length, the payload, then
; zero padding to a multiple of 8 -- rendered as a C initializer because
; c-assemble opened `unsigned char m_<n>[] = ` and expects this arm to close it.
(def c-len-list (-> I64 I64 Str)
  (lam (v k)
    (case (=i k 8)
      (true "")
      (false (mc-s3 "," (i64->str (% v 256)) (c-len-list (/ v 256) (+ k 1)))))))

(def c-byte-list (-> Bytes I64 I64 Str)
  (lam (b i n)
    (case (=i i n)
      (true "")
      (false (mc-s3 "," (i64->str (bget b i)) (c-byte-list b (+ i 1) n))))))

(def c-pad-list (-> I64 Str)
  (lam (k) (case (=i k 0) (true "") (false (str-cat ",0" (c-pad-list (- k 1)))))))

(def c-dat-text (-> Bytes Str)
  (lam (b)
    (let ((n (blen b)))
      (mc-s6 "{" (i64->str (% n 256)) (c-len-list (/ n 256) 1)
             (c-byte-list b 0 n) (c-pad-list (% (- 8 (% n 8)) 8)) "};\n"))))

; ── lookup / jump tables ────────────────────────────────────────────────────
; ltb is a `static const` table indexed in place -- x-ltb's inline table with
; no bounds check, for the same reason: ctor tags are dense 0..n-1 and coverage
; is total. jtb is a `switch`, NEVER `goto *tbl[i]`: computed goto is a GNU
; extension CompCert refuses, and this leg exists to be swappable onto it.
(def c-vals-tail (-> (List I64) Str)
  (lam (vs) (case vs (nil "") ((cons v rest) (mc-s3 "," (mc-imm v) (c-vals-tail rest))))))

(def c-vals (-> (List I64) Str)
  (lam (vs) (case vs (nil "0") ((cons v rest) (str-cat (mc-imm v) (c-vals-tail rest))))))

(def c-jtb-cases (-> (List Str) I64 (List Asm))
  (lam (ls i)
    (case ls
      (nil (the (List Asm) nil))
      ((cons l rest)
        (mc-lcat
          (cons (a-rel 0 e-noenc l)
            (mc-line (mc-s5 "case " (i64->str i) ": goto " (c-mangle l) ";")))
          (c-jtb-cases rest (+ i 1)))))))

; ── the shim prototype block ────────────────────────────────────────────────
; Step 4 (emit-c) must place this FIRST: `fin` is trailing material by
; definition, and C wants a declaration before every use.
(def mc-preamble (List Asm)
  (mc-txt (str-cat
"/* generated by chirality mach-c (E166). helpers: scaffold/rt/chirality-rt.c */\nextern long m_arg[64];\nlong m_add(long, long);\nlong m_sub(long, long);\nlong m_mul(long, long);\nlong m_shl(long, long);\nlong m_sar(long, long);\nlong m_shr(long, long);\nlong m_div(long, long);\nlong m_mod(long, long);\nlong m_mulhi(long, long);\n"
"long m_alloc(long, long);\nvoid m_setf(long, long, long);\nlong m_getf(long, long);\nlong m_tag(long);\nlong m_balloc(long);\nlong m_bget(long, long);\nvoid m_bput(long, long, long);\nlong m_blen(long);\nlong m_bptr(long);\nlong m_addr(unsigned char *);\nlong m_sys(long, long, long, long, long, long, long);\nvoid m_trap(void);\nvoid m_gcheck(long, long);\nvoid m_gcheckb(long);\n")))

; ── the Mach ────────────────────────────────────────────────────────────────
; 37 arms, in mach.chiral's field order. Only stp/lda/fjc/clb are (=>); the
; example's §2 finding 1 says "only two" and is WRONG -- mach.chiral:66,68,118,
; 122 declare four.
(def mc Mach
  (mach

    ; pro -- declarations only; c-assemble already opened the brace.
    (lam (nregs)                                                        ; pro
      (mc-lcat
        (mc-line (mc-s3 "long r[" (i64->str (+ nregs 1))
                        "]; long _ca = 0; long _cb = 0; long _sc = 0; long _p = 0;"))
        (mc-lcat (mc-line "long a0 = m_arg[0]; long a1 = m_arg[1]; long a2 = m_arg[2];")
          (mc-lcat (mc-line "long a3 = m_arg[3]; long a4 = m_arg[4]; long a5 = m_arg[5];")
            (mc-line "(void)r; (void)_ca; (void)_cb; (void)_sc; (void)_p; (void)a0; (void)a1; (void)a2; (void)a3; (void)a4; (void)a5;")))))

    ; stp -- prologue-only (emit-core.chiral:518-522), so reading the incoming
    ; locals for 0..5 and the global file past that is sound: no call has run.
    (lam (ap slot)                                                      ; stp
      (case (<=i ap 5)
        (true (mc-set (mc-r slot) (mc-a ap)))
        (false (mc-set (mc-r slot) (mc-g ap)))))

    c-lda                                                               ; lda

    (lam (slot val) (mc-set (mc-r slot) (mc-imm val)))                  ; con
    (lam (slot tag) (mc-set (mc-r slot) (mc-imm tag)))                  ; dcon

    (lam (op dst a b)                                                   ; bin
      (mc-line (c-bin-text (mc-r dst) op (mc-r a) (mc-r b))))

    ; cal -- args into the file, then a nullary call; the a-rel keeps the
    ; callee NAME in the stream for c-assemble's forward-declaration pass, and
    ; the displacement is meaningless in C, hence e-noenc.
    (lam (dst fname args)                                               ; cal
      (mc-lcat (c-args args 0)
        (cons (a-rel 0 e-noenc fname)
          (mc-set (mc-r dst) (str-cat (c-mangle fname) "()")))))

    (lam (slot) (mc-line (mc-s3 "return " (mc-r slot) ";")))            ; ret

    (lam (slot) (mc-set "_sc" (mc-r slot)))                             ; lsc

    (lam (tag skip)                                                     ; cjne
      (cons (a-rel 0 e-noenc skip)
        (mc-line (mc-s5 "if (_sc != " (mc-imm tag) ") goto " (c-mangle skip) ";"))))

    c-alo                                                               ; alo

    (lam (dst src idx)                                                  ; fld
      (mc-set (mc-r dst) (mc-s5 "m_getf(" (mc-r src) ", " (i64->str idx) ")")))

    (lam (slot) (mc-set "_sc" (mc-s3 "m_tag(" (mc-r slot) ")")))        ; lsb

    (the (List Asm) nil)                                                ; fin
                                        ; the heap lives in the shim, not here

    c-bnw                                                               ; bnw

    (lam (dst ptr idx)                                                  ; bgt
      (mc-set (mc-r dst) (mc-s5 "m_bget(" (mc-r ptr) ", " (mc-r idx) ")")))

    (lam (ptr idx val)                                                  ; bpt
      (mc-line (mc-s6 "m_bput(" (mc-r ptr) ", " (mc-r idx) ", " (str-cat (mc-r val) ");"))))

    (lam (dst src) (mc-set (mc-r dst) (mc-s3 "m_blen(" (mc-r src) ")"))) ; bln

    (lam (dst label)                                                    ; lea
      (cons (a-rel 0 e-noenc label)
        (mc-set (mc-r dst) (mc-s3 "m_addr(" (c-mangle label) ")"))))

    (lam (b) (mc-txt (c-dat-text b)))                                   ; dat

    ; sys -- the single crossing. Every syscall chirality performs arrives here and
    ; nowhere else, which is why the shim is a shim and not a runtime.
    (lam (dst nr args)                                                  ; sys
      (mc-set (mc-r dst)
        (mc-s4 "m_sys(" (mc-imm nr) (c-sysargs args 0) ")")))

    (lam (dst src) (mc-set (mc-r dst) (mc-s3 "m_bptr(" (mc-r src) ")"))) ; bpr

    (lam (op dst a imm)                                                 ; bini
      (mc-line (c-bin-text (mc-r dst) op (mc-r a) (mc-imm imm))))

    ; tca -- args already placed by lda; a C tail call. See the -O1 note above.
    (lam (fname)                                                        ; tca
      (cons (a-rel 0 e-noenc fname)
        (mc-line (mc-s3 "return " (c-mangle fname) "();"))))

    (lam (dst scrut vals)                                               ; ltb
      (mc-line (mc-s6 "{ static const long _t[] = {" (c-vals vals) "}; "
                      (mc-r dst) (mc-s3 " = _t[" (mc-r scrut) "]; }") "")))

    (lam (a b) (mc-line (mc-s5 "_ca = " (mc-r a) "; _cb = " (mc-r b) ";")))  ; fcp
    (lam (a v) (mc-line (mc-s5 "_ca = " (mc-r a) "; _cb = " (mc-imm v) ";"))) ; fci

    ; fjc -- x86 flags have no C spelling, so the compare is split honestly:
    ; fcp/fci stash the operands, fjc applies the op and branches.
    ; ⚑ NO `? 0 : 1` HERE. c-op's comparisons now yield the chirality TAG directly
    ; (0 == true), so the expression IS the tag and the ternary would invert it
    ; back. The earlier `? 0 : 1` was compensating for c-op's inverted spelling
    ; -- two errors that cancelled, which is exactly why the FUSED path worked
    ; while every materialized Bool was wrong. Fix one and you must fix both.
    (lam (op tag skip)                                                  ; fjc
      (cons (a-rel 0 e-noenc skip)
        (mc-line (mc-s6 "if (" (c-expr op "_ca" "_cb") " != " (mc-imm tag)
                        ") goto " (str-cat (c-mangle skip) ";")))))

    (lam (scrut labels)                                                 ; jtb
      (mc-lcat (mc-line (mc-s3 "switch (" (mc-r scrut) ") {"))
        (mc-lcat (c-jtb-cases labels 0)
          (mc-lcat (mc-line "default: m_trap();") (mc-line "}")))))

    ; clb -- nothing is clobbered: a resident argument register is a function
    ; local here (see the header), and no emitted statement writes one.
    (lam (k) (the (List I64) nil))                                      ; clb

    (lam (op dst i b)                                                   ; binr
      (mc-line (c-bin-text (mc-r dst) op (mc-a i) (mc-r b))))
    (lam (op dst i imm)                                                 ; binir
      (mc-line (c-bin-text (mc-r dst) op (mc-a i) (mc-imm imm))))
    (lam (i b) (mc-line (mc-s5 "_ca = " (mc-a i) "; _cb = " (mc-r b) ";")))   ; fcpr
    (lam (i v) (mc-line (mc-s5 "_ca = " (mc-a i) "; _cb = " (mc-imm v) ";"))) ; fcir

    ; ldr -- ALWAYS copies. On x64 i==j is free because one register plays both
    ; roles; here the incoming local and the outgoing file are distinct.
    (lam (j i) (mc-set (mc-g j) (mc-a i)))                              ; ldr

    ; galo/gbnw (E91) -- unreachable under alloc-fixed, but total and pure, so
    ; they cannot halt. They render as alo/bnw preceded by a bounds-check CALL:
    ; the trap lives in the shim (SPEC decision 3b), and the check names the
    ; allocation that blew the reserve (decision 11) by tag and size.
    (lam (dst tag fs)                                                   ; galo
      (mc-lcat
        (mc-line (mc-s5 "m_gcheck(" (mc-imm tag) ", " (i64->str (+ 1 (length I64 fs))) ");"))
        (c-alo dst tag fs)))
    (lam (dst len)                                                      ; gbnw
      (mc-lcat (mc-line (mc-s3 "m_gcheckb(" (mc-r len) ");")) (c-bnw dst len)))))
