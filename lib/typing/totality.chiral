; E11: the single-function totality classifier (structural + numeric-measure
; termination). Ported from scaffold/chirality/data.py `_totality_reason` (:867)
; and its helpers: the inner `walk` (:884), `_num_delta` (:745), `_guard_bound`
; (:780), `_meet` (:825), `_num_dec_ok` (:843), `_passes_unchanged` (:833),
; `_term_spine`. The gate is PURE (`->`) and returns a Verdict VALUE
; (errors-as-values) instead of mutating sig.totality + raising; it walks a
; finite Term tree by structural recursion, so chirality's own totality gate
; certifies it. data.py stays the oracle; enforcement (require_total escalation)
; is the caller's job (surface.py verify_profiles), unchanged.
;
; SCOPE (E11 = the single-function classifier only): mutual / lexicographic
; recursion is E50 (data.py `_check_recgroup`); the enforce-by-default flip is
; the map's EXTEND facet, gated on E47+E50. Both out of scope here.
;
; The chirality-specific obligation (finding SPEC 2.4): because the floor is wrapping
; two's-complement I64, a numeric measure MUST exclude the wraparound point --
; a vacuous extreme bound (i <= MAX, step i+1) would "prove" a loop that wraps
; and never halts. num-dec-ok carries that proof in I64 arithmetic against the
; real I64-MAX/I64-MIN constants.
(import "prelude")

; ---- the slice of the term ADT the checker judges over (Term <-> Arm mutual,
; expressible since E79). t-var carries a de Bruijn LEVEL directly (the port
; simplification of data.py's depth-1-index conversion); t-app is flat (head +
; arg list, the spine already unwound); t-glob heads both self-calls AND prim
; ops ("+"/"-"/"<i"/"<=i"/"=i"). t-lit is the port's addition over the example's
; 5 constructors -- the numeric cases (b)/(c) need integer literals, which the
; example Term lacked. -----------------------------------------------------------
(data Term ()
  (t-var  (lvl  I64))                        ; de Bruijn level
  (t-lam  (body Term))                       ; a leading binder = recursion param
  (t-app  (head Term) (args (List Term)))    ; flat application spine
  (t-case (scrut Term) (arms (List Arm)))
  (t-glob (name Str))                        ; global / self-call / prim-op head
  (t-lit  (val I64)))                         ; i64 literal (step / bound constant)
(data Arm () (arm (ctor Str) (nvars I64) (body Term)))

; --- well-founded evidence threaded down each path ----------------------------
(data SizeTok ()
  (st-root    (param I64))                   ; the param itself: not-smaller
  (st-smaller (param I64)))                   ; a case-bound field: strictly smaller

; a per-variable bound keyed by its own level: constant interval (lo/hi, none =
; unbounded) plus STRICT symbolic bounds lt/gt (levels this var is strictly
; less/greater than) -- the faithful port of data.py's (lo, hi, lt, gt).
(data Bound ()
  (bnd (lvl I64) (lo (Maybe I64)) (hi (Maybe I64)) (lt (List I64)) (gt (List I64))))

; errors are values: the verdict is RETURNED, never thrown.
(data Verdict () (total) (not-total (reason Str)))
; the walk's result sum: accumulated per-call decreasing sets, or a bail reason.
(data Walked () (v-ok (calls (List (List I64)))) (v-err (reason Str)))

; Working-type reps (SPEC decision #3), assoc-lists keyed by de Bruijn level --
; the concrete mirror of data.py's `size` / `bounds` dicts:
;   Sizes  = (List (Pair I64 SizeTok))   ; level -> size token
;   Bounds = (List Bound)                ; bound carries its own level key
;   Calls  = (List (List I64))           ; one decreasing-position set per call
;   DecSet = (List I64)                  ; argument positions that decrease

; the I64 floor whose wraparound the numeric branch excludes (data.py:737-738).
; prelude does not export these -- the port owns them.
(def I64-MAX I64 9223372036854775807)
(def I64-MIN I64 (- (- 0 9223372036854775807) 1))

; ---- generic list helpers ----------------------------------------------------
(declare nth (-> (0 A (type 0)) (List A) I64 (Maybe A)))
(def nth (lam (A xs i)
  (case xs
    (nil (none))
    ((cons h t) (case (<=i i 0) (true (some h)) (false (nth A t (- i 1))))))))

(declare lapp (-> (0 A (type 0)) (List A) (List A) (List A)))
(def lapp (lam (A xs ys)
  (case xs (nil ys) ((cons h t) (cons h (lapp A t ys))))))

(declare i64-in (-> I64 (List I64) Bool))
(def i64-in (lam (x xs)
  (case xs (nil false)
    ((cons y r) (case (=i x y) (true true) (false (i64-in x r)))))))

(declare i64-inter (-> (List I64) (List I64) (List I64)))
(def i64-inter (lam (a b)                    ; keep a's elems that are in b
  (case a (nil nil)
    ((cons x r) (case (i64-in x b)
      (true  (cons x (i64-inter r b)))
      (false (i64-inter r b)))))))

; ---- term inspectors ---------------------------------------------------------
(declare lit-of (-> Term (Maybe I64)))
(def lit-of (lam (z) (case z ((t-lit k) (some k)) (_ (none)))))

(declare plevel (-> Term I64 (Maybe I64)))    ; a param var (level < np) -> its level
(def plevel (lam (z np)
  (case z ((t-var l) (case (<i l np) (true (some l)) (false (none)))) (_ (none)))))

(declare args2 (-> (List Term) (Maybe (Pair Term Term))))
(def args2 (lam (args)                        ; exactly two args -> (pair a0 a1)
  (case args
    ((cons a0 r0) (case r0
      ((cons a1 r1) (case r1 (nil (some (pair a0 a1))) (_ (none))))
      (_ (none))))
    (_ (none)))))

(declare is-cmp (-> Str Bool))
(def is-cmp (lam (op) (or (str-eq op "<i") (or (str-eq op "<=i") (str-eq op "=i")))))

(declare is-self (-> Term Str Bool))
(def is-self (lam (head name) (case head ((t-glob g) (str-eq g name)) (_ false))))

(declare sz-param (-> SizeTok I64))
(def sz-param (lam (tok) (case tok ((st-root p) p) ((st-smaller p) p))))

; ---- numeric step detection (data.py `_num_delta`) ---------------------------
(declare plus-delta  (-> Term Term I64 (Maybe (Pair I64 I64))))
(def plus-delta (lam (x y np)                 ; (+ p k) or (+ k p) -> (level, k)
  (case (plevel x np)
    ((some lx) (case (lit-of y) ((some k) (some (pair lx k))) (none (none))))
    (none (case (plevel y np)
            ((some ly) (case (lit-of x) ((some k) (some (pair ly k))) (none (none))))
            (none (none)))))))
(declare minus-delta (-> Term Term I64 (Maybe (Pair I64 I64))))
(def minus-delta (lam (x y np)                ; (- p k) -> (level, -k)
  (case (plevel x np)
    ((some lx) (case (lit-of y) ((some k) (some (pair lx (- 0 k)))) (none (none))))
    (none (none)))))
(declare num-delta (-> Term I64 (Maybe (Pair I64 I64))))
(def num-delta (lam (a np)
  (case a
    ((t-app head args) (case head
      ((t-glob op) (case (args2 args)
        (none (none))
        ((some xy) (case xy ((pair x y)
          (case (str-eq op "+")
            (true (plus-delta x y np))
            (false (case (str-eq op "-")
              (true (minus-delta x y np))
              (false (none))))))))))
      (_ (none))))
    (_ (none)))))

; ---- bound environment (data.py `_meet` + dict get/insert) -------------------
(declare bounds-get (-> (List Bound) I64 Bound))
(def bounds-get (lam (bs j)                    ; missing -> NOBOUND
  (case bs
    (nil (bnd j (none) (none) nil nil))
    ((cons b rest) (case b ((bnd p lo hi lt gt)
      (case (=i p j) (true b) (false (bounds-get rest j)))))))))

(declare max-def (-> (Maybe I64) (Maybe I64) (Maybe I64)))    ; higher floor (max)
(def max-def (lam (a b)
  (case a (none b) ((some x) (case b (none (some x)) ((some y) (some (max x y))))))))
(declare min-def (-> (Maybe I64) (Maybe I64) (Maybe I64)))    ; lower ceiling (min)
(def min-def (lam (a b)
  (case a (none b) ((some x) (case b (none (some x)) ((some y) (some (min x y))))))))

(declare meet-bnd (-> Bound Bound Bound))      ; intersect two bounds at one level
(def meet-bnd (lam (b0 b1)
  (case b0 ((bnd p lo0 hi0 lt0 gt0) (case b1 ((bnd q lo1 hi1 lt1 gt1)
    (bnd p (max-def lo0 lo1) (min-def hi0 hi1) (lapp I64 lt0 lt1) (lapp I64 gt0 gt1))))))))

(declare ins-at (-> (List Bound) I64 Bound (List Bound)))
(def ins-at (lam (bs L f)                      ; meet f into the bound at level L
  (case bs
    (nil (cons f nil))
    ((cons b rest) (case b ((bnd p lo hi lt gt)
      (case (=i p L) (true (cons (meet-bnd b f) rest)) (false (cons b (ins-at rest L f))))))))))
(declare ins-bnd (-> (List Bound) Bound (List Bound)))
(def ins-bnd (lam (bs f) (case f ((bnd fl lo hi lt gt) (ins-at bs fl f)))))
(declare extend-bounds (-> (List Bound) (List Bound) (List Bound)))
(def extend-bounds (lam (bounds facts)
  (case facts (nil bounds) ((cons f rest) (extend-bounds (ins-bnd bounds f) rest)))))

; ---- guard -> facts (data.py `_guard_bound`): the intervals/symbolic bounds a
; comparison-guarded branch proves. Local to totality, not shared with the
; refinement engine (SPEC decision #4). ----------------------------------------
(declare const-of (-> Str Bool I64 Bool (Maybe (Pair (Maybe I64) (Maybe I64)))))
(def const-of (lam (op var-left k is-true)     ; the (lo, hi) a var-vs-const guard proves
  (case (str-eq op "=i")
    (true (case is-true (true (some (pair (some k) (some k)))) (false (none))))
    (false (case (str-eq op "<i")
      (true (case var-left
        (true  (case is-true (true (some (pair (none) (some (- k 1))))) (false (some (pair (some k) (none))))))
        (false (case is-true (true (some (pair (some (+ k 1)) (none)))) (false (some (pair (none) (some k))))))))
      (false                                    ; "<=i"
        (case var-left
          (true  (case is-true (true (some (pair (none) (some k)))) (false (some (pair (some (+ k 1)) (none))))))
          (false (case is-true (true (some (pair (some k) (none)))) (false (some (pair (none) (some (- k 1))))))))))))))

(declare var-lit (-> Term Term (Maybe (Pair I64 I64))))
(def var-lit (lam (v other)                    ; (var, lit) -> (level, k)
  (case v ((t-var l) (case (lit-of other) ((some k) (some (pair l k))) (none (none)))) (_ (none)))))

(declare mk-const-fact (-> Str Bool I64 I64 Bool (List Bound)))
(def mk-const-fact (lam (op var-left lv k is-true)
  (case (const-of op var-left k is-true)
    (none nil)
    ((some ivl) (case ivl ((pair lo hi) (cons (bnd lv lo hi nil nil) nil)))))))

(declare sym-facts (-> Str Term Term Bool (List Bound)))
(def sym-facts (lam (op x y is-true)           ; x < y (strict, true) -> symbolic bounds
  (case (and (str-eq op "<i") is-true)
    (false nil)
    (true (case x ((t-var lx) (case y ((t-var ly)
      (cons (bnd lx (none) (none) (cons ly nil) nil)
      (cons (bnd ly (none) (none) nil (cons lx nil)) nil)))
      (_ nil))) (_ nil))))))

(declare guard-facts (-> Str Term Term Bool (List Bound)))
(def guard-facts (lam (op x y is-true)
  (case (is-cmp op)
    (false nil)
    (true (case (var-lit x y)                   ; x var, y lit
      ((some p) (case p ((pair lx k) (mk-const-fact op true lx k is-true))))
      (none (case (var-lit y x)                 ; y var, x lit
        ((some p) (case p ((pair ly k) (mk-const-fact op false ly k is-true))))
        (none (sym-facts op x y is-true)))))))))

(declare guard-bound (-> Term Str (List Bound)))
(def guard-bound (lam (scrut cname)
  (case (or (str-eq cname "true") (str-eq cname "false"))
    (false nil)
    (true (case scrut
      ((t-app head args) (case head
        ((t-glob op) (case (args2 args)
          (none nil)
          ((some xy) (case xy ((pair x y) (guard-facts op x y (str-eq cname "true")))))))
        (_ nil)))
      (_ nil))))))

; ---- size environment (structural order) -------------------------------------
(declare sizes-get (-> (List (Pair I64 SizeTok)) I64 (Maybe SizeTok)))
(def sizes-get (lam (sizes l)
  (case sizes
    (nil (none))
    ((cons e rest) (case e ((pair k tok) (case (=i k l) (true (some tok)) (false (sizes-get rest l)))))))))

(declare add-fields (-> (List (Pair I64 SizeTok)) I64 I64 I64 (List (Pair I64 SizeTok))))
(def add-fields (lam (sizes p nvars depth)     ; levels depth..depth+nvars-1 = st-smaller p
  (case (<=i nvars 0)
    (true sizes)
    (false (add-fields (cons (pair depth (st-smaller p)) sizes) p (- nvars 1) (+ depth 1))))))
(declare extend-sizes (-> (List (Pair I64 SizeTok)) Term I64 I64 (List (Pair I64 SizeTok))))
(def extend-sizes (lam (sizes scrut nvars depth)
  (case scrut
    ((t-var l) (case (sizes-get sizes l)
      ((some tok) (add-fields sizes (sz-param tok) nvars depth))
      (none sizes)))                            ; no token -> fields carry no size info
    (_ sizes))))

; ---- the numeric-decrease test (data.py `_num_dec_ok`) -- the wraparound
; obligation lives here (finding SPEC 2.4). -------------------------------------
(declare pos-safe (-> I64 (Maybe I64) Bool))
(def pos-safe (lam (d hi)                       ; d>0 and hi<=MAX-d : i+d cannot overflow
  (case (<i 0 d)
    (false false)
    (true (case hi (none false) ((some h) (<=i h (- I64-MAX d))))))))
(declare neg-safe (-> I64 (Maybe I64) Bool))
(def neg-safe (lam (d lo)                       ; d<0 and lo>=MIN-d : i+d cannot underflow
  (case (<i d 0)
    (false false)
    (true (case lo (none false) ((some l) (<=i (- I64-MIN d) l)))))))

(declare arg-is-var-at (-> (List Term) I64 Bool))
(def arg-is-var-at (lam (allargs L)             ; args[L] passed unchanged (var at level L)
  (case (nth Term allargs L)
    (none false)
    ((some t) (case t ((t-var l2) (=i l2 L)) (_ false))))))
(declare passes-unchanged (-> (List Term) (List I64) Bool))
(def passes-unchanged (lam (allargs levels)
  (case levels
    (nil false)
    ((cons L rest) (case (arg-is-var-at allargs L) (true true) (false (passes-unchanged allargs rest)))))))

(declare num-dec-ok (-> Term I64 I64 (List Term) (List Bound) Bool))
(def num-dec-ok (lam (a j np allargs bounds)
  (case (num-delta a np)
    (none false)
    ((some pd) (case pd ((pair lvl d)
      (case (and (=i lvl j) (not (=i d 0)))
        (false false)
        (true (case (bounds-get bounds j)
          ((bnd bp lo hi lt gt)
            (or (pos-safe d hi)
            (or (neg-safe d lo)
            (or (and (=i d 1)       (passes-unchanged allargs lt))
                (and (=i d (- 0 1)) (passes-unchanged allargs gt)))))))))))))))

; ---- scoring one self-call: structural OR numeric per argument position -------
(declare struct-dec? (-> Term I64 (List (Pair I64 SizeTok)) Bool))
(def struct-dec? (lam (a j sizes)               ; (t-var l), size (st-smaller j)
  (case a
    ((t-var l) (case (sizes-get sizes l)
      ((some tok) (case tok ((st-smaller p) (=i p j)) (_ false)))
      (none false)))
    (_ false))))

(declare score-from (-> I64 I64 (List Term) (List Term) (List (Pair I64 SizeTok)) (List Bound) (List I64)))
(def score-from (lam (j np cursor allargs sizes bounds)
  (case cursor
    (nil nil)
    ((cons a rest)
      (case (or (struct-dec? a j sizes) (num-dec-ok a j np allargs bounds))
        (true  (cons j (score-from (+ j 1) np rest allargs sizes bounds)))
        (false (score-from (+ j 1) np rest allargs sizes bounds)))))))
(declare score-args (-> I64 (List Term) (List (Pair I64 SizeTok)) (List Bound) (List I64)))
(def score-args (lam (np args sizes bounds) (score-from 0 np args args sizes bounds)))

; ---- calls accumulator + uniform-decreasing-position intersection ------------
(declare calls-push (-> (List (List I64)) (List I64) (List (List I64))))
(def calls-push (lam (calls dec) (cons dec calls)))
(declare calls-empty? (-> (List (List I64)) Bool))
(def calls-empty? (lam (calls) (case calls (nil true) (_ false))))
(declare inter-fold (-> (List I64) (List (List I64)) (List I64)))
(def inter-fold (lam (acc rest)
  (case rest (nil acc) ((cons d more) (inter-fold (i64-inter acc d) more)))))
(declare first-of (-> (List I64) (Maybe I64)))
(def first-of (lam (xs) (case xs (nil (none)) ((cons x r) (some x)))))
(declare intersect-all (-> (List (List I64)) (Maybe I64)))
(def intersect-all (lam (calls)                 ; some position decreasing on EVERY call
  (case calls (nil (none)) ((cons first rest) (first-of (inter-fold first rest))))))

; ---- the walk: gather decreasing positions by structural recursion on Term ---
(declare walk       (-> Str I64 Term I64 (List (Pair I64 SizeTok)) (List Bound) (List (List I64)) Walked))
(declare walk-list  (-> Str I64 (List Term) I64 (List (Pair I64 SizeTok)) (List Bound) (List (List I64)) Walked))
(declare walk-arms  (-> Str I64 Term (List Arm) I64 (List (Pair I64 SizeTok)) (List Bound) (List (List I64)) Walked))
(def walk (lam (name np t depth sizes bounds calls)
  (case t
    ((t-app head args)
      (case (is-self head name)
        (true  (walk-list name np args depth sizes bounds
                          (calls-push calls (score-args np args sizes bounds))))
        (false (walk-list name np (cons head args) depth sizes bounds calls))))
    ((t-case scrut arms)
      (case (walk name np scrut depth sizes bounds calls)
        ((v-err r) (v-err r))
        ((v-ok calls1) (walk-arms name np scrut arms depth sizes bounds calls1))))
    ((t-glob g)
      (case (str-eq g name)
        (true  (v-err "the definition is used as a value, not called directly -- its recursion cannot be checked for termination"))
        (false (v-ok calls))))
    ((t-lam body) (walk name np body (+ depth 1) sizes bounds calls))
    (_ (v-ok calls)))))                          ; t-var / t-lit: leaves
(def walk-list (lam (name np ts depth sizes bounds calls)
  (case ts
    (nil (v-ok calls))
    ((cons x rest)
      (case (walk name np x depth sizes bounds calls)
        ((v-err r) (v-err r))
        ((v-ok calls1) (walk-list name np rest depth sizes bounds calls1)))))))
(def walk-arms (lam (name np scrut arms depth sizes bounds calls)
  (case arms
    (nil (v-ok calls))
    ((cons a rest)
      (case a ((arm cname nvars body)
        (case (walk name np body (+ depth nvars)
                    (extend-sizes sizes scrut nvars depth)
                    (extend-bounds bounds (guard-bound scrut cname))
                    calls)
          ((v-err r) (v-err r))
          ((v-ok calls1) (walk-arms name np scrut rest depth sizes bounds calls1)))))))))

; ---- count / strip the leading recursion binders -----------------------------
(declare count-lams (-> Term I64 I64))
(def count-lams (lam (t acc) (case t ((t-lam body) (count-lams body (+ acc 1))) (_ acc))))
(declare strip-lams (-> Term Term))
(def strip-lams (lam (t) (case t ((t-lam body) (strip-lams body)) (_ t))))
(declare sizes-init (-> I64 (List (Pair I64 SizeTok))))
(declare mk-roots (-> I64 I64 (List (Pair I64 SizeTok))))
(def mk-roots (lam (i np) (case (<i i np) (false nil) (true (cons (pair i (st-root i)) (mk-roots (+ i 1) np))))))
(def sizes-init (lam (np) (mk-roots 0 np)))

; ---- the gate: PURE, structurally recursive on the finite Term tree ----------
; foetus -- collect one decreasing-position set per self-call, then intersect;
; total iff some position decreases on EVERY self-call.
(declare check-termination (-> Str Term Verdict))
(def check-termination (lam (name body)
  (let ((np (count-lams body 0)))
    (let ((spine (strip-lams body)))
      (case (walk name np spine np (sizes-init np) nil nil)
        ((v-err reason) (not-total reason))     ; used-as-value / mutual rec
        ((v-ok calls)
          (case (calls-empty? calls)
            (true (total))                        ; non-recursive
            (false (case (intersect-all calls)
              ((some j) (total))                  ; uniform decreasing position
              (none (not-total "no argument position decreases in every recursive call by a measure the checker can see -- structural (a case-bound field) or numeric (a parameter stepped toward a constant bound a guard proves). See docs/totality.md.")))))))))))
