; E14: the pretty-printer (display, NON-trusted). Ported from pretty.py
; show_term. Pure (->): a display function provably crosses no port. Total:
; structural on Term. Exhaustive: no <k> catch-all -- a new former with no arm
; is a compile error. nth-name's "#i" fallback keeps it total over any index,
; in-scope or not. Renders the core former subset (Type/Var/Lam/App/Let); the
; rest (Pi/TCon/Con/Refine/Case/Global) are the same walk, more arms.
(import "prelude")

; E161: "a display function provably crosses no port" was the prose above; this
; is the same sentence where something derives it. The port-set half is not
; written here any more -- the datasheet reads it off this module's own
; bindings, and there are none to bind.
(module pretty (cat A) (alt upper))

(data Term ()
  (t-type (n I64))
  (t-var  (i I64))
  (t-lam  (nm Str) (body Term))
  (t-app  (fn Term) (arg Term))
  (t-let  (nm Str) (rhs Term) (body Term)))

(def sp     (-> Str Str Str) (lam (a b) (str-cat a (str-cat " " b))))
(def parens (-> Str Str)     (lam (s) (str-cat "(" (str-cat s ")"))))

(declare names-snoc (-> (List Str) Str (List Str)))     ; append at the end
(def names-snoc
  (lam (ns n) (case ns (nil (cons n nil)) ((cons x r) (cons x (names-snoc r n))))))
(declare nlen (-> (List Str) I64))
(def nlen (lam (ns) (case ns (nil 0) ((cons x r) (+ 1 (nlen r))))))
(declare get-at (-> (List Str) I64 Str))
(def get-at
  (lam (ns i) (case ns (nil "#?")
                ((cons x r) (case (=i i 0) (true x) (false (get-at r (- i 1))))))))
; names[len-1-i] if i in range, else "#i" (never errors -> total printer)
(def nth-name (-> (List Str) I64 Str)
  (lam (ns i) (case (<i i (nlen ns))
                (true  (get-at ns (- (- (nlen ns) 1) i)))
                (false (str-cat "#" (i64->str i))))))

(declare show-term (-> (List Str) Term Str))
(def show-term
  (lam (names t)
    (case t
      ((t-type n)     (parens (sp "type" (i64->str n))))
      ((t-var i)      (nth-name names i))
      ((t-lam nm b)   (parens (sp "lam" (sp (parens nm)
                        (show-term (names-snoc names nm) b)))))
      ((t-app f a)    (parens (sp (show-term names f) (show-term names a))))
      ((t-let nm r b) (parens (sp "let"
                        (sp (parens (sp nm (show-term names r)))
                            (show-term (names-snoc names nm) b))))))))
