; Maybe combinators. The orchestration layer threads optional lookups (config
; keys, response fields) through these instead of open-coding case at each site.

(import "prelude/prelude")

; E161: all pure, all category A, in the checked form. The port-set half is not
; written: it is DERIVED on this module's datasheet from what it binds, and this
; module binds no extern at all, so its `crossings` is empty by derivation.
(module prelude/maybe (cat A) (alt upper))

(def maybe-map (-> (0 A (type 0)) (0 B (type 0)) (-> A B) (Maybe A) (Maybe B))
  (lam (A B f m)
    (case m (none none) ((some x) (some (f x))))))

(def maybe-then (-> (0 A (type 0)) (0 B (type 0)) (-> A (Maybe B)) (Maybe A) (Maybe B))
  (lam (A B f m)
    (case m (none none) ((some x) (f x)))))

(def with-default (-> (0 A (type 0)) A (Maybe A) A)
  (lam (A d m)
    (case m (none d) ((some x) x))))

; join strings with a separator -- building URLs, header lists, JSON fragments.
