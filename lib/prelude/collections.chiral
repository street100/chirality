; Collections over the prelude's List and Pair, written in chirality.
; This is the library floor the self-hosted checker will stand on (the Sig
; registries become association lists before they become anything faster).
; Higher-order and polymorphic, so most of it does not lower to tal, which is
; fine: the checker runs upper during bootstrap.

(import "prelude")

; E161: "All pure, all category A" was the prose above; this is the checked form
; of it. The port-set half is no longer written: it is DERIVED on this module's
; datasheet from what it binds, and this module binds no extern at all, so its
; `crossings` is empty by derivation rather than by claim.
(module collections (cat A) (alt upper))

(def length (-> (0 A (type 0)) (List A) I64)
  (lam (A xs)
    (case xs
      (nil 0)
      ((cons h t) (+ 1 (length A t))))))

(def append (-> (0 A (type 0)) (List A) (List A) (List A))
  (lam (A xs ys)
    (case xs
      (nil ys)
      ((cons h t) (cons h (append A t ys))))))

(def rev-onto (-> (0 A (type 0)) (List A) (List A) (List A))
  (lam (A xs acc)
    (case xs
      (nil acc)
      ((cons h t) (rev-onto A t (cons h acc))))))

(def reverse (-> (0 A (type 0)) (List A) (List A))
  (lam (A xs)
    (rev-onto A xs nil)))

(def map-list (-> (0 A (type 0)) (0 B (type 0)) (-> A B) (List A) (List B))
  (lam (A B f xs)
    (case xs
      (nil nil)
      ((cons h t) (cons (f h) (map-list A B f t))))))

(def filter (-> (0 A (type 0)) (-> A Bool) (List A) (List A))
  (lam (A p xs)
    (case xs
      (nil nil)
      ((cons h t)
        (let ((r (p h))) (cond (r (cons h (filter A p t))) (else (filter A p t))))))))

(def foldl (-> (0 A (type 0)) (0 B (type 0)) (-> B A B) B (List A) B)
  (lam (A B f z xs)
    (case xs
      (nil z)
      ((cons h t) (foldl A B f (f z h) t)))))

(def any-list (-> (0 A (type 0)) (-> A Bool) (List A) Bool)
  (lam (A p xs)
    (case xs
      (nil false)
      ((cons h t) (let ((r (p h))) (cond (r true) (else (any-list A p t))))))))

(def head (-> (0 A (type 0)) (List A) (Maybe A))
  (lam (A xs) (case xs (nil none) ((cons h t) (some h)))))

(def cat-maybes (-> (0 A (type 0)) (List (Maybe A)) (List A))
  (lam (A xs)
    (case xs
      (nil nil)
      ((cons h t)
        (case h
          (none (cat-maybes A t))
          ((some x) (cons x (cat-maybes A t))))))))

(def find (-> (0 A (type 0)) (-> A Bool) (List A) (Maybe A))
  (lam (A p xs)
    (case xs
      (nil none)
      ((cons h t) (let ((r (p h))) (cond (r (some h)) (else (find A p t))))))))

(def foldr (-> (0 A (type 0)) (0 B (type 0)) (-> A B B) B (List A) B)
  (lam (A B f z xs)
    (case xs
      (nil z)
      ((cons h t) (f h (foldr A B f z t))))))

(def concat (-> (0 A (type 0)) (List (List A)) (List A))
  (lam (A xss)
    (case xss
      (nil nil)
      ((cons h t) (append A h (concat A t))))))

; Maybe combinators: the orchestration layer threads optional lookups (config
; keys, response fields) through these instead of open-coding case at each site.

(def maybe-map (-> (0 A (type 0)) (0 B (type 0)) (-> A B) (Maybe A) (Maybe B))
  (lam (A B f m)
    (case m (none none) ((some x) (some (f x))))))

(def maybe-then (-> (0 A (type 0)) (0 B (type 0)) (-> A (Maybe B)) (Maybe A) (Maybe B))
  (lam (A B f m)
    (case m (none none) ((some x) (f x)))))

(def with-default (-> (0 A (type 0)) A (Maybe A) A)
  (lam (A d m)
    (case m (none d) ((some x) x))))

; join strings with a separator -- building URLs, header lists, JSON fragments.
(def str-join (-> Str (List Str) Str)
  (lam (sep xs)
    (case xs
      (nil "")
      ((cons h t)
        (case t
          (nil h)
          ((cons h2 t2) (str-cat h (str-cat sep (str-join sep t)))))))))

; association lists: the map until there is a better map.
; keyed by a caller-supplied equality, so one alist works for Str and I64.
; SUPERSEDED SEED (E27, 2026-07-28): the ordered Map below is the graduation
; of alist-get/put/has -- new registries take the tree; these stay for the
; callers that only need a tiny linear-scan map and for the migration trail.

(def alist-get (-> (0 K (type 0)) (0 V (type 0))
                   (-> K K Bool) (List (Pair K V)) K (Maybe V))
  (lam (K V eq xs k)
    (case xs
      (nil none)
      ((cons h t)
        (case h
          ((pair hk hv)
            (let ((r (eq hk k))) (cond (r (some hv)) (else (alist-get K V eq t k))))))))))

(def alist-put (-> (0 K (type 0)) (0 V (type 0))
                   (-> K K Bool) (List (Pair K V)) K V (List (Pair K V)))
  (lam (K V eq xs k v)
    (case xs
      (nil (cons (pair k v) nil))
      ((cons h t)
        (case h
          ((pair hk hv)
            (let ((r (eq hk k))) (cond (r (cons (pair k v) t)) (else (cons (pair hk hv) (alist-put K V eq t k v)))))))))))

(def alist-has (-> (0 K (type 0)) (0 V (type 0))
                   (-> K K Bool) (List (Pair K V)) K Bool)
  (lam (K V eq xs k)
    (let (r (alist-get K V eq xs k))
      (case r
        (none false)
        ((some v) true)))))

; ---------------------------------------------------------------- E27: Map
; A height-balanced (AVL) persistent ordered map, keyed by an explicitly
; supplied TOTAL comparator (-> K K Ord). Trichotomy is an exhaustive case
; the coverage checker verifies; iteration (m-fold) is ascending by the
; comparator REGARDLESS of insertion order -- that determinism is the whole
; point: this order is the canonical registry order the fixpoint's
; determinism debts pin against (DETERMINISM-DEBTS D-2). Every operation is
; pure and structurally recursive (proven total); the pre-insert map stays
; valid. bytes-cmp is E25-gated (no byte-compare primitive yet); tyv-cmp is
; the assigned D-1 follow-on.

(data Ord () (lt) (eq) (gt))

(def i64-cmp (-> I64 I64 Ord)
  (lam (a b)
    (cond ((=i a b) eq)
          ((<i a b) lt)
          (else gt))))

(data Map ((K (type 0)) (V (type 0)))
  (mtip)
  (mnode (l (Map K V)) (k K) (v V) (r (Map K V)) (h I64)))

(def m-empty (-> (0 K (type 0)) (0 V (type 0)) (Map K V))
  (lam (K V) mtip))

(def i64-max2 (-> I64 I64 I64)
  (lam (a b) (cond ((<i a b) b) (else a))))

(def m-height (-> (0 K (type 0)) (0 V (type 0)) (Map K V) I64)
  (lam (K V m) (case m (mtip 0) ((mnode l k v r h) h))))

; rebuild a node, recomputing its height from the (already-balanced) children
(def mk-node (-> (0 K (type 0)) (0 V (type 0)) (Map K V) K V (Map K V) (Map K V))
  (lam (K V l k v r)
    (mnode l k v r (+ 1 (i64-max2 (m-height K V l) (m-height K V r))))))

; balance factor: height(l) - height(r); AVL keeps it within [-1, 1]
(def m-bal (-> (0 K (type 0)) (0 V (type 0)) (Map K V) I64)
  (lam (K V m)
    (case m
      (mtip 0)
      ((mnode l k v r h) (- (m-height K V l) (m-height K V r))))))

(def rot-right (-> (0 K (type 0)) (0 V (type 0)) (Map K V) (Map K V))
  (lam (K V m)
    (case m
      (mtip mtip)
      ((mnode l k v r h)
        (case l
          (mtip m)
          ((mnode ll lk lv lr lh)
            (mk-node K V ll lk lv (mk-node K V lr k v r))))))))

(def rot-left (-> (0 K (type 0)) (0 V (type 0)) (Map K V) (Map K V))
  (lam (K V m)
    (case m
      (mtip mtip)
      ((mnode l k v r h)
        (case r
          (mtip m)
          ((mnode rl rk rv rr rh)
            (mk-node K V (mk-node K V l k v rl) rk rv rr)))))))

; AVL rebalance (height-balanced; noted per SPEC step 3): one single or
; double rotation restores the invariant after one insert/delete.
(def rebalance (-> (0 K (type 0)) (0 V (type 0)) (Map K V) (Map K V))
  (lam (K V m)
    (case m
      (mtip mtip)
      ((mnode l k v r h)
        (let ((hl (m-height K V l)) (hr (m-height K V r)))
          (cond
            ((<i (+ hr 1) hl)                          ; left-heavy
              (cond ((<i (m-bal K V l) 0)              ; left-right: double
                      (rot-right K V (mk-node K V (rot-left K V l) k v r)))
                    (else (rot-right K V (mk-node K V l k v r)))))
            ((<i (+ hl 1) hr)                          ; right-heavy
              (cond ((<i 0 (m-bal K V r))              ; right-left: double
                      (rot-left K V (mk-node K V l k v (rot-right K V r))))
                    (else (rot-left K V (mk-node K V l k v r)))))
            (else (mk-node K V l k v r))))))))

(def m-lookup (-> (0 K (type 0)) (0 V (type 0)) (-> K K Ord) K (Map K V) (Maybe V))
  (lam (K V cmp k m)
    (case m
      (mtip none)
      ((mnode l nk nv r h)
        (let (c (cmp k nk))
          (case c
            (lt (m-lookup K V cmp k l))
            (eq (some nv))
            (gt (m-lookup K V cmp k r))))))))

; last-write-wins on eq (the dict contract); the pre-insert map stays valid
(def m-insert (-> (0 K (type 0)) (0 V (type 0)) (-> K K Ord) K V (Map K V) (Map K V))
  (lam (K V cmp k v m)
    (case m
      (mtip (mnode mtip k v mtip 1))
      ((mnode l nk nv r h)
        (let (c (cmp k nk))
          (case c
            (lt (rebalance K V (mk-node K V (m-insert K V cmp k v l) nk nv r)))
            (eq (mnode l k v r h))
            (gt (rebalance K V (mk-node K V l nk nv (m-insert K V cmp k v r))))))))))

; the pure insert-once primitive: a collision is a VALUE (none), not an
; alarm -- the alarm-carrying facet is E26's, layered over this
(def m-insert-new (-> (0 K (type 0)) (0 V (type 0)) (-> K K Ord) K V (Map K V)
                      (Maybe (Map K V)))
  (lam (K V cmp k v m)
    (case m
      (mtip (some (mnode mtip k v mtip 1)))
      ((mnode l nk nv r h)
        (let (c (cmp k nk))
          (case c
            (lt (maybe-map (Map K V) (Map K V)
                  (lam (l2) (rebalance K V (mk-node K V l2 nk nv r)))
                  (m-insert-new K V cmp k v l)))
            (eq none)
            (gt (maybe-map (Map K V) (Map K V)
                  (lam (r2) (rebalance K V (mk-node K V l nk nv r2)))
                  (m-insert-new K V cmp k v r)))))))))

; pop the least entry: the delete splice's successor source
(data MinR ((K (type 0)) (V (type 0)))
  (minr-none)
  (minr (k K) (v V) (rest (Map K V))))

(def m-pop-min (-> (0 K (type 0)) (0 V (type 0)) (Map K V) (MinR K V))
  (lam (K V m)
    (case m
      (mtip minr-none)
      ((mnode l k v r h)
        (let (pop (m-pop-min K V l))
          (case pop
            (minr-none (minr k v r))
            ((minr mnk mnv rest)
              (minr mnk mnv (rebalance K V (mk-node K V rest k v r))))))))))

(def m-delete (-> (0 K (type 0)) (0 V (type 0)) (-> K K Ord) K (Map K V) (Map K V))
  (lam (K V cmp k m)
    (case m
      (mtip mtip)
      ((mnode l nk nv r h)
        (let (c (cmp k nk))
          (case c
            (lt (rebalance K V (mk-node K V (m-delete K V cmp k l) nk nv r)))
            (gt (rebalance K V (mk-node K V l nk nv (m-delete K V cmp k r))))
            (eq (let (pop (m-pop-min K V r))
                  (case pop
                    (minr-none l)
                    ((minr sk sv rest)
                      (rebalance K V (mk-node K V l sk sv rest))))))))))))

; in-order fold: ascending by the comparator -- THE deterministic iteration
(def m-fold (-> (0 K (type 0)) (0 V (type 0)) (0 B (type 0))
                (-> B K V B) B (Map K V) B)
  (lam (K V B f z m)
    (case m
      (mtip z)
      ((mnode l k v r h)
        (m-fold K V B f (f (m-fold K V B f z l) k v) r)))))

; ---- the Set surface: one core, two surfaces -----------------------------
; Set K is spelled (Map K Unit) directly (a type-level alias def awaits the
; real surface syntax, E49-era); the ops fix V = Unit.

(def s-empty (-> (0 K (type 0)) (Map K Unit))
  (lam (K) mtip))

(def s-member (-> (0 K (type 0)) (-> K K Ord) K (Map K Unit) Bool)
  (lam (K cmp k s)
    (case (m-lookup K Unit cmp k s)
      (none false)
      ((some u) true))))

(def s-add (-> (0 K (type 0)) (-> K K Ord) K (Map K Unit) (Map K Unit))
  (lam (K cmp k s) (m-insert K Unit cmp k unit s)))

(def s-add-new (-> (0 K (type 0)) (-> K K Ord) K (Map K Unit)
                   (Maybe (Map K Unit)))
  (lam (K cmp k s) (m-insert-new K Unit cmp k unit s)))

; ------------------------------------------------- E152: List sort's owner
; THE sorting entry point for List. Comparator-passed exactly like
; m-lookup / m-insert: the caller supplies the TOTAL (-> A A Ord), this module
; supplies the order-preserving machinery and nothing else -- there is no
; ambient Ord class and no per-type sort. STABLE: elements the comparator
; calls (eq) come out in INPUT order, which is what makes sorting composable
; (sort by the minor key, then by the major key, and the minor order
; survives). Pure `->`, no mutation, no loop: a top-down merge sort over
; persistent conses, so the input list stays valid.
;
; Termination: ms-take / ms-drop are structural on the list; ms-sort-n's
; measure is the numeric `n` (the length of xs) -- it recurses only under the
; (<i n 2) guard's else branch, i.e. with n >= 2, on h = (/ n 2) and (- n h),
; both >= 1 and both < n. ms-merge is structural on one argument per branch
; (the two output lists' total length is the measure).

; the first n elements (fewer if the list is shorter); n <= 0 gives nil
(def ms-take (-> (0 A (type 0)) I64 (List A) (List A))
  (lam (A n xs)
    (case xs
      (nil nil)
      ((cons h t)
        (cond ((<i n 1) nil)
              (else (cons h (ms-take A (- n 1) t))))))))

; everything after the first n elements; n <= 0 gives the list unchanged
(def ms-drop (-> (0 A (type 0)) I64 (List A) (List A))
  (lam (A n xs)
    (case xs
      (nil nil)
      ((cons h t)
        (cond ((<i n 1) xs)
              (else (ms-drop A (- n 1) t)))))))

; merge two ascending runs into one ascending run. THE LEFT RUN WINS TIES:
; (cmp y x) is consulted and only a strict (lt) takes from the right, so on
; (eq) the left element goes first. That is exactly where stability comes
; from -- in ms-sort-n the left run always holds the earlier input positions.
(def ms-merge (-> (0 A (type 0)) (-> A A Ord) (List A) (List A) (List A))
  (lam (A cmp xs ys)
    (case xs
      (nil ys)
      ((cons x xr)
        (case ys
          (nil xs)
          ((cons y yr)
            (let ((c (cmp y x)))
              (case c
                (lt (cons y (ms-merge A cmp xs yr)))
                (eq (cons x (ms-merge A cmp xr ys)))
                (gt (cons x (ms-merge A cmp xr ys)))))))))))

; sort the first `n` elements' worth of xs, where n is (length xs)
(def ms-sort-n (-> (0 A (type 0)) (-> A A Ord) I64 (List A) (List A))
  (lam (A cmp n xs)
    (cond ((<i n 2) xs)
          (else
            (let ((h (/ n 2)))
              (ms-merge A cmp
                (ms-sort-n A cmp h (ms-take A h xs))
                (ms-sort-n A cmp (- n h) (ms-drop A h xs))))))))

(def list-sort (-> (0 A (type 0)) (-> A A Ord) (List A) (List A))
  (lam (A cmp xs)
    (ms-sort-n A cmp (length A xs) xs)))

; ------------------------------------------------- E156: adjacent-run dedup
; list-dedup-adj: drop every element that is (eq) to its IMMEDIATE PREDECESSOR.
; Binder order matches list-sort exactly -- (0 A) type, comparator, list -- so
; the two compose with no adapter and the arg-order convention E151b already
; refused to relitigate stays put.
;
; CONTRACT. This is `uniq`, NOT `sort -u`: on an unsorted list it compresses
; RUNS only. De-duplication is GLOBAL solely as the COMPOSITION with list-sort,
; and only because a sort groups (eq) elements adjacently.
; SURVIVOR: the FIRST element of each run. Composed after the STABLE list-sort
; that is the earliest occurrence in INPUT order. The rule is written down here
; because it is not observable through a comparator whose (eq) implies value
; equality (str-cmp on Str) and IS observable through one whose (eq) does not
; (a key projection) -- see .planning/specs/E156-sort-adopt-SPEC.md §3 D5. The
; fused ins-sorted/sort-dedup this replaces kept the LAST, by accident of
; recursion order, and no comment anywhere said so.
;
; Termination: dd-skip is structural on ys, list-dedup-adj on xs -- no fuel,
; total by E11.
; dd-skip: emit ys with every (eq)-to-`keep` element removed, opening a new run
; at each survivor. `dd-` matches the `ms-` internals convention of list-sort
; (and the flat emitted-label namespace workaround, E154). It is defined BEFORE
; its caller: the loader resolves names in blob order, so a forward reference is
; `load: unknown name dd-skip` -- the same reason ms-take/ms-merge precede
; ms-sort-n above.
(declare dd-skip (-> (0 A (type 0)) (-> A A Ord) A (List A) (List A)))
(def dd-skip
  (lam (A cmp keep ys)
    (case ys
      (nil nil)
      ((cons y r)
        (case (cmp keep y)
          ((eq) (dd-skip A cmp keep r))                ; duplicate: DROP the later one
          ((lt) (cons y (dd-skip A cmp y r)))          ; a new run opens at y
          ((gt) (cons y (dd-skip A cmp y r))))))))     ; unsorted input: same move

(declare list-dedup-adj (-> (0 A (type 0)) (-> A A Ord) (List A) (List A)))
(def list-dedup-adj
  (lam (A cmp xs)
    (case xs
      (nil nil)
      ((cons x r) (cons x (dd-skip A cmp x r))))))     ; x survives; drop its run
