; The comparison verdict, and the one comparator the prelude can supply.
; Ord is its own module because it is the currency every ordered structure
; takes: prelude/list's sort and prelude/map's tree both name it, and neither
; needs the other. A comparator is always passed in by the caller; there is no
; ambient Ord class and no per-type default beyond i64-cmp.

(import "prelude/prelude")

; E161: all pure, all category A, in the checked form. The port-set half is not
; written: it is DERIVED on this module's datasheet from what it binds, and this
; module binds no extern at all, so its `crossings` is empty by derivation.
(module prelude/ord (cat A) (alt upper))

(data Ord () (lt) (eq) (gt))

(def i64-cmp (-> I64 I64 Ord)
  (lam (a b)
    (cond ((=i a b) eq)
          ((<i a b) lt)
          (else gt))))
