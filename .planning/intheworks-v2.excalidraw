      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Fails coverage: re-carve with the uncovered remainder\nnamed as input.\nFails disjointness: re-carve with the overlap named.\nPasses: the mechanical process creates the streams from\nthe final format.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "e0021",
      "originalText": "Fails coverage: re-carve with the uncovered remainder\nnamed as input.\nFails disjointness: re-carve with the overlap named.\nPasses: the mechanical process creates the streams from\nthe final format.",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "e0023",
      "type": "text",
      "x": 0,
