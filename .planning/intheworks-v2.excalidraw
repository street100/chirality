      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SPAN\nIs the recalled set the right width for what was asked?\nToo wide means the ask was vague. Too narrow means it\nwas mis-scoped.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "e0032",
      "originalText": "SPAN\nIs the recalled set the right width for what was asked?\nToo wide means the ask was vague. Too narrow means it\nwas mis-scoped.",
      "lineHeight": 1.25,
      "autoResize": false
    },
