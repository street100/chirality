      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Source message in scratchpad. Carve it into distinct\nthoughts, one per intended stream. Emit as a formatted\nset, each piece citing the source entry.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "e0015",
      "originalText": "Source message in scratchpad. Carve it into distinct\nthoughts, one per intended stream. Emit as a formatted\nset, each piece citing the source entry.",
      "lineHeight": 1.25,
      "autoResize": false
    },
