    {
      "id": "e0008",
      "type": "text",
      "x": 690,
      "y": 46,
      "width": 620,
      "height": 315.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
