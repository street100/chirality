      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The inverse of Split, called automatically per split.\nCollect the terminal entries of the child streams and\ncompose them against the source entry the split cited.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "e0057",
      "originalText": "The inverse of Split, called automatically per split.\nCollect the terminal entries of the child streams and\ncompose them against the source entry the split cited.",
      "lineHeight": 1.25,
      "autoResize": false
    },
