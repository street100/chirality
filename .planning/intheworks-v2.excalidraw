      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Insufficient, another tool could reach it: loop to ACT\nwith that tool named.\nInsufficient, no tool can reach it: emit as unreachable.\nSufficient: emit with a confidence measure.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "e0049",
      "originalText": "Insufficient, another tool could reach it: loop to ACT\nwith that tool named.\nInsufficient, no tool can reach it: emit as unreachable.\nSufficient: emit with a confidence measure.",
      "lineHeight": 1.25,
      "autoResize": false
    },
