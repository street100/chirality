      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Contradiction: Split a new TOT whose subject is the\ncontradiction. Do not resolve it here.\nAgreement: write the composed result into the parent\nstream as a new entry.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "e0063",
      "originalText": "Contradiction: Split a new TOT whose subject is the\ncontradiction. Do not resolve it here.\nAgreement: write the composed result into the parent\nstream as a new entry.",
      "lineHeight": 1.25,
      "autoResize": false
    },
