    {
      "id": "OYAspG9kxCZTkmDJpQDZt",
      "type": "text",
      "x": -2932.8122897802755,
      "y": 23.55422667944663,
      "width": 704.8082275390625,
      "height": 765,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 921698302,
      "version": 2699,
      "versionNonce": 1465234046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789090769086,
      "created": 1789088498963,
      "link": null,
      "locked": false,
      "text": "Substantiate:\nProcess for checking info\n\nFirst process:\nInfo to check\nDirections to form a recall node pass\nagainst info\n\nSecond process:\nDirections to use relevant dispatch-able\ntools to falsify or substantiate\nwhichever claim is needed to be covered\nInfo to check\nRecalled info\n\nThird process:\nConfidence measure pass and add",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "oSrjdUlQ7IFOSqWWoCkHs",
      "originalText": "Substantiate:\nProcess for checking info\n\nFirst process:\nInfo to check\nDirections to form a recall node pass against info\n\nSecond process:\nDirections to use relevant dispatch-able tools to falsify or substantiate whichever claim is needed to be covered\nInfo to check\nRecalled info\n\nThird process:\nConfidence measure pass and add",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
