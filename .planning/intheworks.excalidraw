      "locked": false,
      "text": "Entry \nOrigin stream is created (As a streamlike thing, but\nmessages are modifiable entries with previous states\nstored). Then, message is input whole into stream as\nfirst entry",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "A9vA4dRIvsV52XrlWXxy7",
      "originalText": "Entry \nOrigin stream is created (As a streamlike thing, but messages are modifiable entries with previous states stored). Then, message is input whole into stream as first entry",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
