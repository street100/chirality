    {
      "id": "O5KqX3PG3p_-R-ZM4XbvW",
      "type": "text",
      "x": -4609.441166963796,
      "y": -1019.404228228308,
      "width": 1200.240478515625,
      "height": 765,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0FV",
      "roundness": null,
      "seed": 1284743294,
      "version": 1064,
      "versionNonce": 1084853246,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789089173733,
      "created": 1789088739654,
      "link": null,
      "locked": false,
      "text": "Mechanically, the idea is they are message streams with types of\nmessages and an edit history for each individually \n\nTo hopefully provide clarification about the levels of use:\n\nOrigin Stream:\nThe initial stream that starts with the first message in a\nconversation\n\nMajor Streams:\nStreams that branch around the splitting up of the origin stream of\neach conversation\n\nTOT (Train of thought) Streams:\nStreams that form inside of major streams, for specific and tight\nscoped lines of thought inside them.\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "bbMmenMx5f_KEM2L7-i-B",
      "originalText": "Mechanically, the idea is they are message streams with types of messages and an edit history for each individually \n\nTo hopefully provide clarification about the levels of use:\n\nOrigin Stream:\nThe initial stream that starts with the first message in a conversation\n\nMajor Streams:\nStreams that branch around the splitting up of the origin stream of each conversation\n\nTOT (Train of thought) Streams:\nStreams that form inside of major streams, for specific and tight scoped lines of thought inside them.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
