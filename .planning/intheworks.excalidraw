    {
      "id": "9a3TCdk0ELc0gPup1Fxi_",
      "type": "text",
      "x": -3877.9793763242783,
      "y": 13.975589970912893,
      "width": 854.7123413085938,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 1943280638,
      "version": 2623,
      "versionNonce": 1106186238,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789090603790,
      "created": 1789088306986,
      "link": null,
      "locked": false,
      "text": "Recall:\nfor recalling info through recursive dispatch.\n\nFirst process:\nInfo to recall about\nDirections about and to use of types of memory\nto recall info in a specific format\n\nSecond process:\nDirections to create a level of check about the\nspan of recalled info\nRecalled info\nInfo to recall about\n\nThird process:\nDirections to either hand back off to the first\nprocess with a clearer piece to recall about +\noriginal recall (as new fields) or pass result\n\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "yB4v62s9cNZvxxrwad1mm",
      "originalText": "Recall:\nfor recalling info through recursive dispatch.\n\nFirst process:\nInfo to recall about\nDirections about and to use of types of memory to recall info in a specific format\n\nSecond process:\nDirections to create a level of check about the span of recalled info\nRecalled info\nInfo to recall about\n\nThird process:\nDirections to either hand back off to the first process with a clearer piece to recall about + original recall (as new fields) or pass result\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oSrjdUlQ7IFOSqWWoCkHs",
