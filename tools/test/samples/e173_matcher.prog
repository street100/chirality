; e173_matcher.prog — E173 slice 1's fixture. The Phase 19 value half.
;
; ⚑ THIS PROGRAM MAKES NO ASSERTION AND ALWAYS EXITS 0. It PRINTS the values;
; every comparison is the gate's, in bash. A fixture that grades itself can be
; wrong in the same direction twice, and a fixture that exits at its first
; failing case masks every later row from every mutant. Fields are separated by
; a single byte 1 (SOH), which no field can contain: the alphabet below is
; ASCII letters, digits, punctuation and newlines.
;
;   1  G1  cls-has at both edges of every class constant, and a UTF-8 lead byte
;   2  G2  nullable over all seven Pat arms, in two windows
;   3  G3  the live-set maximum WITH norm, over 100 lower bytes
;   4  G4  the live-set maximum WITHOUT norm, over the same input
;   5  G6a norm's survivor, from a list handed to it in the WRONG order
;   6  G6b find-all over overlapping alternatives: earliest start, longest end
;   7  G6c find-all over a self-overlapping literal: the spans do not overlap
;   8  G6d find-at over the same alternatives: the LONGEST accept, not the first
;   9  G7a the line-pass input, verbatim, so the gate hands awk the same bytes
;  10  G7b which of those lines line-step lets a pattern see
;  11  G7c blank-spans over a line carrying an inline span
;  12  G10 the sentinel: reaching it is what says the star terminated
;
; ⚑ FIELD 3 IS WHERE A NON-TERMINATING `pd` DIVERGES, and field 12 is how the
; gate reads that. The compiler refuses nothing here: lib/typing/totality.chiral
; is the built E11 classifier and no module imports it, so a self-call that does
; not shrink compiles clean (status-ledger.md:156). The divergence is therefore
; OBSERVED at run time under a bounded stack rather than refused at check time.
;
; ⚑ FIELD 9 CARRIES THE TEXT ITSELF. The line pass is graded against awk's fence
; toggle, and two spellings of the input are two inputs; the gate reads the
; bytes back out of this field and hands those to awk.

(import "prelude/prelude")
(import "prelude/list")
(import "prelude/string")
(import "ports/stdio")
(import "text/matcher")

(def mx-mark Str (bytes->str (bslice (pack-u32 1) 0 1)))

(def bit (-> Bool Str) (lam (b) (case b (true "1") (false "0"))))

; ─── G1: the class edges ─────────────────────────────────────────────────────
; Both edges of every range, the byte outside each edge, and byte 194 — a UTF-8
; lead byte, which fails every ASCII class and passes c-any.
(declare probe (-> Cls (List I64) Str))
(def probe
  (lam (c bs)
    (case bs
      (nil "")
      ((cons h t) (str-cat (bit (cls-has c h)) (probe c t))))))

(def g1-lower (List I64) (cons 96 (cons 97 (cons 122 (cons 123 nil)))))
(def g1-digit (List I64) (cons 47 (cons 48 (cons 57 (cons 58 nil)))))
(def g1-word  (List I64)
  (cons 64 (cons 65 (cons 90 (cons 91 (cons 95 (cons 96 nil)))))))

(def g1 Str
  (str-cat (probe cls-lower g1-lower)
    (str-cat (probe cls-digit g1-digit)
      (str-cat (probe cls-word g1-word)
        (str-cat (bit (cls-has cls-lower 194))
          (str-cat (bit (cls-has cls-digit 194))
            (str-cat (bit (cls-has cls-word 194))
                     (bit (cls-has (c-any) 194)))))))))

; ─── G2: nullable over all seven arms, in two windows ────────────────────────
; The first window is OFF THE FRONT of the buffer, which is a-bol's offset-0
; case and the only reading that distinguishes it from `prev is a newline`.
(def g2-w0 Win (win (- 0 1) 66))          ; before byte 0, here 'B'
(def g2-w1 Win (win 65 10))               ; prev 'A', here a newline

(def g2-pats (List Pat)
  (cons (p-nil)
    (cons (p-lit "a")
      (cons (p-cls cls-lower)
        (cons (p-ast (a-bol))
          (cons (p-cat (p-ast (a-bol)) (p-nil))
            (cons (p-alt (p-cls cls-lower) (p-ast (a-bol)))
              (cons (p-star (p-cls cls-lower)) nil))))))))

(declare nprobe (-> Win (List Pat) Str))
(def nprobe
  (lam (k ps)
    (case ps
      (nil "")
      ((cons h t) (str-cat (bit (nullable k h)) (nprobe k t))))))

(def g2 Str (str-cat (nprobe g2-w0 g2-pats) (nprobe g2-w1 g2-pats)))

; ─── G3 / G4: the bound, and whose bound it is ───────────────────────────────
; The live-set size at every offset, seeded exactly as scan-go seeds it: a fresh
; thread may start at each offset, so the size read is |ts| + 1. `nm` picks
; whether the step is normed, which is the only difference between the two
; numbers the gate compares.
;
; Total by the numeric measure: i steps by exactly +1 under the strict guard
; (<i i n) with n passed unchanged, measure n - i (totality.md:81-89).
;
; ⚑ THE RUNNING MAXIMUM GOES THROUGH prelude `max`, AND IT HAS TO. Spelled
; inline as (let ((sz (length Thread ts1))) (case (<i hi sz) (true sz) (false
; hi))) this file does not load: `load: cannot prove refinement`, measured. The
; case guard narrows a LET-BOUND I64 against another let-bound I64 and the
; resulting obligation is not discharged. Two params of a named function are
; fine, which is what prelude/prelude.chiral:150 is.
(declare mx-go (-> Bool Pat Bytes I64 I64 (List Thread) I64 I64))
(def mx-go
  (lam (nm p bs n i ts hi)
    (let ((ts1 (cons (th i p) ts)))
      (let ((hi2 (max hi (length Thread ts1))))
        (case (<i i n)
          (false hi2)
          (true
            (let ((k (win (at-byte bs (- i 1)) (at-byte bs i))))
              (let ((raw (step-set k (bget bs i) ts1)))
                (mx-go nm p bs n (+ i 1)
                  (case nm (true (norm raw)) (false raw)) hi2)))))))))

(def mx-pat Pat (p-star (p-cls cls-lower)))
(def mx-bytes Bytes (brepeat (str->bytes "a") 100))

(def g3 Str (i64->str (mx-go true  mx-pat mx-bytes (blen mx-bytes) 0 nil 0)))
(def g4 Str (i64->str (mx-go false mx-pat mx-bytes (blen mx-bytes) 0 nil 0)))

; ─── G6a: norm's survivor is the LEAST start, whatever order it arrives in ───
(declare th-firsts (-> (List Thread) Str))
(def th-firsts
  (lam (ts)
    (case ts
      (nil "")
      ((cons h t)
        (case h
          ((th f p)
            (str-cat (i64->str f)
              (str-cat (case t (nil "") ((cons a b) ",")) (th-firsts t)))))))))

(def g6a Str
  (let ((r (norm (cons (th 1 pat-not-but) (cons (th 0 pat-not-but) nil)))))
    (str-cat (i64->str (length Thread r)) (str-cat ":" (th-firsts r)))))

; ─── G6b / G6c / G6d: leftmost-longest, and non-overlap ──────────────────────
(declare spans->str (-> (List Span) Str))
(def spans->str
  (lam (ss)
    (case ss
      (nil "")
      ((cons h t)
        (case h
          ((span f e)
            (let ((one (str-cat (i64->str f) (str-cat "-" (i64->str e)))))
              (case t
                (nil one)
                ((cons a b) (str-cat one (str-cat "," (spans->str t))))))))))))

(def mspan->str (-> (Maybe Span) Str)
  (lam (m)
    (case m
      (none "none")
      ((some s)
        (case s
          ((span f e) (str-cat (i64->str f) (str-cat "-" (i64->str e)))))))))

; "ab" and "abc" both start at the same offset; the longer one is the answer.
(def g6-alt Pat (p-alt (p-lit "ab") (p-lit "abc")))

(def g6b Str (spans->str (find-all g6-alt (str->bytes "xabc"))))
(def g6c Str (spans->str (find-all (p-lit "aa") (str->bytes "aaaa"))))
(def g6d Str (mspan->str (find-at g6-alt (str->bytes "abc") 0)))

; ─── G7: the line pass, against awk's fence toggle ───────────────────────────
; Nine lines: prose, a fence pair around code, prose, an INDENTED and
; info-stringed fence pair around code, and a line carrying an inline span.
(def g7-lines (List Str)
  (cons "alpha beta"
    (cons "```"
      (cons "code line inside"
        (cons "```"
          (cons "gamma delta"
            (cons "  ```sh"
              (cons "more code"
                (cons "```"
                  (cons "text with `a span` in it" nil))))))))))

(def g7-text Str (str-join "\n" g7-lines))

(declare keepbits (-> LState (List Str) Str))
(def keepbits
  (lam (st ls)
    (case ls
      (nil "")
      ((cons h t)
        (case (line-step st h)
          ((pair st2 k) (str-cat (bit k) (keepbits st2 t))))))))

(def g7b Str (keepbits (ls-prose) g7-lines))
(def g7c Str (blank-spans "text with `a span` in it"))

; ─── the stream ──────────────────────────────────────────────────────────────
(def emit (=> Str Unit)
  (lam (s) (let ((_ (put s))) (put mx-mark))))

(def compile-main (=> I64 I64)
  (lam (n)
    (let ((_ (emit g1)))
    (let ((_ (emit g2)))
    (let ((_ (emit g3)))
    (let ((_ (emit g4)))
    (let ((_ (emit g6a)))
    (let ((_ (emit g6b)))
    (let ((_ (emit g6c)))
    (let ((_ (emit g6d)))
    (let ((_ (emit g7-text)))
    (let ((_ (emit g7b)))
    (let ((_ (emit g7c)))
    (let ((_ (emit "END")))
      0))))))))))))))
