; opt_census_control.prog -- R5's control in tools/test/opt-census.sh.
;
; The same foldable `(* 6 7)` as `opt_census_outline.prog` with no `case`, so
; nothing outlines, `re-check` accepts the folded residual, and the `chk-ok`
; guard has nothing to refuse. Two compilers differing only in that guard must
; emit IDENTICAL bytes here.
;
; ⚑ THE ROW IS UNSOUND WITHOUT IT. R5's counter-mutation edits a source line in
; `optimize.chiral`, so the two COMPILER binaries differ for that reason alone.
; This control is what proves the difference R5 reports on the outlining fixture
; comes from the guard and not from the edit.
(import "prelude/prelude")
(import "ports/stdio")

(def probe (-> I64 I64)
  (lam (n) (+ (* 6 7) n)))

(def compile-main (=> I64 I64)
  (lam (n) (do (put (str-cat (i64->str (probe 1)) "\n")) 0)))
