; E170 Phase 12 -- RE-FOUNDING `base <: refine` ONLY-IF-TOP, which today has no
; isolated coverage outside the leg E170 deletes.
;
; The finding (.planning/RUNG1-CHECKLIST.md:454, measured 2026-08-26 at 3c5d35c):
; `grep -ln "base<:refine\|only-if-TOP" scaffold/tests/*.py` finds ONE file,
; `test_refine_kernel_chirality.py`, and it is a differential. The rule is one
; conjunct of one function -- `subtype-into` at kernel.chiral:811-812,
; `(and (subtype lvl a bb) (c-is-top bc))` -- and dropping the second conjunct
; makes every base a subtype of every refinement of it, which is the refinement
; system meaning nothing. E170 D1 records that the Rocq leg re-founds zero of
; the 335 today.
;
; ⚑ THE SHAPE IS REFUSAL-UNIVERSALITY, AND THIS IS THE TREE'S FIRST ONE. No
; test in the 709 quantifies a refusal over a family, so there is no in-tree
; precedent to copy. ⚑ It is NOT the corpus survey's `B3` and must not be
; counted as one: `B3` is quantification over a family of CONFIGURATIONS
; (.planning/RUNG1-CHECKLIST.md:310), it is still 0, and the checklist row that
; owns it -- "every rule, under a profile that lacks it" -- is still open,
; because there is still no closed sum of profiles to quantify over. Closing
; that row by relabelling this fixture would be the move that section exists to
; refuse. What a single fixture ("this one refinement is refused")
; cannot distinguish is a rule that refuses the case it names and admits the
; rest. So the refusal is quantified: 22 non-TOP constraints, generated by
; walking the CLOSED `SymOp` sum (`refine.chiral:11`, five arms) across three
; constants and once symbolically, plus two multi-atom constraints, against
; three base values -- 66 refusals, every one of which must hold. The family is
; generated from a sum the compiler enumerates, not written out, so a sixth
; operator would widen it without an edit here.
;
; ⚑ WHAT STOPS "REFUSE EVERYTHING" FROM PASSING IT, which is the failure mode a
; refusal-universality check has and an outcome-locking one does not. Three
; controls, each its own expectation so the report names which:
;   B  the family really is non-TOP, decided by this file's OWN structural
;      predicate rather than by `c-is-top` -- deciding family membership with
;      the function under test is how a vacuous family passes;
;   C  the TOP refinement IS admitted (the rule is only-if, not never), a base
;      is a subtype of itself, and a refinement is a subtype of a WEAKER
;      refinement -- so `subtype`'s other refinement legs still work;
;   D  the refusal is direction-specific: `{base | c} <: base` -- forgetting a
;      refinement -- is admitted for every c in the same family.
; Without C and D a `subtype` that returned `false` everywhere would score A
; green, which is exactly the gate-that-cannot-fail class this floor exists for.
;
; ⚑ THE MUTANTS RUN. Harness-run against a scratch copy of scaffold/lib, because
; `mut-run` observes the base by PATH and the mutant by SELF-CONTAINED TEXT
; (test-floor.chiral:611-627) and a checker-rule mutant is neither. The first
; one's label is the `MutRun` below, which test-e168-floor.sh greps this file
; for so the written claim cannot drift from the mutation it names.
;   (i)  kernel.chiral subtype-into: drop the (c-is-top bc) conjunct. Measured:
;        exit 1, check A "want int 0, got int 66" -- every refusal in the family
;        becomes an admission, which also confirms the family really is 22 x 3.
;   (ii) kernel.chiral subtype-into: (and (subtype lvl a bb) false). Measured:
;        exit 1, check C "want int 0, got int 1" -- refusing everything no
;        longer passes, so the control is armed and A is not vacuous.
;
; ⚑ AND THEY ARE ISOLATING, measured 2026-08-26 as a 6x3 matrix over the three
; fixtures this lane adds: each mutant reddens its own fixture and leaves the
; other two green -- a clean diagonal, which is how "isolated" is established
; here rather than asserted.
;
; exit 0 = every check green; 1 = the floor's report on stdout names which.

(import "evidence/test-floor")
(import "typing/kernel")

; ---- the family ------------------------------------------------------------
; every arm of the closed SymOp sum. A sixth operator added to refine.chiral
; widens the family here without an edit, which is the point of generating it
; from the sum rather than listing constraints.
(def rtop-ops (List SymOp)
  (cons (s-ge) (cons (s-gt) (cons (s-le) (cons (s-lt) (cons (s-ne) nil))))))

; a negative, a zero and a positive bound: the constants an interval-with-holes
; constraint can be built at. `c-atom` folds each into `c-top`, so every one of
; the 15 results has exactly one non-empty field.
(def rtop-ks (-> I64 (List I64))
  (lam (n) (cons (- 0 3) (cons 0 (cons 7 nil)))))

(declare rtop-row (-> SymOp (List I64) (List Constraint)))
(def rtop-row
  (lam (op ks)
    (case ks
      (nil (the (List Constraint) nil))
      ((cons k r) (cons (c-atom c-top op k) (rtop-row op r))))))

(declare rtop-consts (-> (List SymOp) (List Constraint)))
(def rtop-consts
  (lam (ops)
    (case ops
      (nil (the (List Constraint) nil))
      ((cons o r) (append Constraint (rtop-row o (rtop-ks 0)) (rtop-consts r))))))

; the symbolic half: a bound against the variable at level 0, one per operator.
; `satisfies` cannot decide these for a bare constant, which is precisely why a
; base must not be admitted into them.
(declare rtop-syms (-> (List SymOp) (List Constraint)))
(def rtop-syms
  (lam (ops)
    (case ops
      (nil (the (List Constraint) nil))
      ((cons o r) (cons (c-sym-atom c-top o 0) (rtop-syms r))))))

; two multi-atom constraints, so the family is not all single-field: a closed
; interval and an interval with a hole in it.
(def rtop-extra (List Constraint)
  (cons (c-atom (c-atom c-top (s-ge) 0) (s-le) 9)
  (cons (c-atom (c-atom (c-atom c-top (s-ge) 0) (s-le) 9) (s-ne) 4) nil)))

(def rtop-family (List Constraint)
  (append Constraint (rtop-consts rtop-ops)
    (append Constraint (rtop-syms rtop-ops) rtop-extra)))

; three bases, because `subtype` reaches `subtype-into` from TWO arms -- the
; `v-type` arm (kernel.chiral:803) and the catch-all (kernel.chiral:809) -- and a
; family that exercised only one would leave the other uncovered.
(def rtop-bases (List Value)
  (cons (v-primty "I64") (cons (v-type 0) (cons (v-primty "Str") nil))))

; ---- B's predicate: non-TOP, decided HERE ----------------------------------
; Deliberately NOT `c-is-top`. If the family's own membership were decided by
; the function the rule under test consults, a mutation of that function would
; empty the family and check A would pass over nothing.
(def rtop-nontop? (-> Constraint Bool)
  (lam (c)
    (case c
      ((constraint lo hi ex sym)
        (or (case lo (none false) ((some l) true))
          (or (case hi (none false) ((some h) true))
            (or (case ex (nil false) (_ true))
                (case sym (nil false) (_ true)))))))))

; ---- the folds: a FAILURE COUNT over bases x constraints -------------------
(declare rtop-row-count (-> (-> Value Constraint Bool) Value (List Constraint) I64))
(def rtop-row-count
  (lam (p b cs)
    (case cs
      (nil 0)
      ((cons c r) (+ (case (p b c) (true 0) (false 1)) (rtop-row-count p b r))))))

(declare rtop-count (-> (-> Value Constraint Bool) (List Value) I64))
(def rtop-count
  (lam (p bs)
    (case bs
      (nil 0)
      ((cons b r) (+ (rtop-row-count p b rtop-family) (rtop-count p r))))))

(declare rtop-count1 (-> (-> Constraint Bool) (List Constraint) I64))
(def rtop-count1
  (lam (p cs)
    (case cs
      (nil 0)
      ((cons c r) (+ (case (p c) (true 0) (false 1)) (rtop-count1 p r))))))

; ---- A: the refusal, universally ------------------------------------------
(def rtop-refused? (-> Value Constraint Bool)
  (lam (b c) (not (subtype 0 b (v-refine b c)))))

; ---- D: the other direction is NOT refused --------------------------------
(def rtop-forgets? (-> Value Constraint Bool)
  (lam (b c) (subtype 0 (v-refine b c) b)))

; ---- C: the controls -------------------------------------------------------
; A refinement that entails a weaker one, so the refine<:refine leg is exercised
; too: {x | x >= 5} is a subtype of {x | x >= 3}, and not the reverse.
(def rtop-narrow Constraint (c-atom c-top (s-ge) 5))
(def rtop-wide   Constraint (c-atom c-top (s-ge) 3))
(def rtop-i64 Value (v-primty "I64"))

(def rtop-control-fails (-> I64 I64)
  (lam (n)
    ; the TOP refinement IS admitted -- the rule is only-if, not never
    (+ (case (subtype 0 rtop-i64 (v-refine rtop-i64 c-top)) (true 0) (false 1))
      ; a base is a subtype of itself, so a red A is not subtype refusing all
      (+ (case (subtype 0 rtop-i64 rtop-i64) (true 0) (false 1))
        ; forgetting a TOP refinement is admitted
        (+ (case (subtype 0 (v-refine rtop-i64 c-top) rtop-i64) (true 0) (false 1))
          ; the refine<:refine leg: narrower entails wider
          (+ (case (subtype 0 (v-refine rtop-i64 rtop-narrow) (v-refine rtop-i64 rtop-wide)) (true 0) (false 1))
            ; and not the reverse -- entailment is a direction, not agreement
            (case (subtype 0 (v-refine rtop-i64 rtop-wide) (v-refine rtop-i64 rtop-narrow)) (true 1) (false 0))))))))

; ===========================================================================
; the gate. Four expectations, all rank 3 (`pv-meaning`), no differential.
; ===========================================================================
(def rtop-checks (List Expect)
  (cons (ex (obk-given "a base is REFUSED as a subtype of every non-TOP refinement of itself -- all 22 constraints in the generated family, against all 3 bases")
            (ob-int 0) (pv-meaning "a value of the base type satisfies no non-trivial predicate merely by being of that type, so the only refinement it can be silently promoted into is the one that demands nothing"))
  (cons (ex (obk-given "the family is genuinely non-TOP, decided by this file's own structural predicate and not by c-is-top")
            (ob-int 0) (pv-meaning "a refusal quantified over an EMPTY family is vacuous; membership must not be decided by the function the rule under test consults"))
  (cons (ex (obk-given "and the refusal is not subtype refusing everything: the TOP refinement IS admitted, a base is a subtype of itself, forgetting a refinement is admitted, and a narrower refinement is a subtype of a wider one but not the reverse")
            (ob-int 0) (pv-meaning "only-if is a biconditional in one direction only: TOP is admitted and non-TOP is not, and the other refinement legs of subtype are untouched by this rule"))
  (cons (ex (obk-given "the refusal is direction-specific: {base | c} <: base is admitted for every constraint in the same family")
            (ob-int 0) (pv-meaning "forgetting a refinement is always sound -- a value that satisfies a predicate is still a value of the base type -- so the rule is about the direction, not about refinements"))
    nil)))))

; ⚑ THE WRITTEN CLAIM. test-e168-floor.sh greps this file for this exact label
; before it runs the mutation the label names.
(def rtop-adequacy MutRun
  (mu-killed "lib/typing/kernel.chiral subtype-into: drop the (c-is-top bc) conjunct"
             (ob-int 0) (ob-int 66)))

(def rtop-suite (List Suite)
  (cons (suite "base <: refine only-if-TOP"
          (cons (gate "base <: refine -- the refusal, its family, and its controls"
                  rtop-checks (the (List DiffExpect) nil) rtop-adequacy)
            nil))
    nil))

(def rtop-obs (List (List Obs))
  (cons (cons (ob-int (rtop-count rtop-refused? rtop-bases))
        (cons (ob-int (rtop-count1 rtop-nontop? rtop-family))
        (cons (ob-int (rtop-control-fails 0))
        (cons (ob-int (rtop-count rtop-forgets? rtop-bases)) nil))))
    nil))

(def compile-main (=> I64 I64)
  (lam (n) (suite-main rtop-suite rtop-obs)))
