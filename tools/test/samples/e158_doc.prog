; e158_doc.prog -- the E158 layout-algebra runtime gate (Phase 14).
;
; E158 splits a formatter into the two halves that are one today: a TEMPLATE
; (what the structure is) and a FLATTEN (how it becomes characters at a width).
; `Doc` is the template, six constructors and no `d-union`, and `doc->str` is
; the first of three exits. `dg-doc` is `dg-msg`'s SIBLING over E157's `Reason`.
;
; ⚑ THIS PROGRAM MAKES NO ASSERTION AND ALWAYS EXITS 0. It PRINTS the values;
; every comparison is the gate's, in bash (tools/test/doc.sh). Fields are
; separated by a single byte 1 (SOH), the device at samples/e173_matcher.prog:199
; and samples/e182_arity.prog:37, which no field below can contain.
;
; ⚑ WHY, AND WHAT IT REPLACES. This file used to grade itself with a
; first-failure reducer and return the 1-based number of the FIRST failing case.
; records/gate-audit.md GA-23 measured the two costs. A fixture that grades
; itself can be wrong twice in the same direction; and one that stops at its
; first failure MASKS every later row from every mutant, so nine of the fourteen
; cases carried no mutant at all and doc.sh had to write a standalone probe
; (`g2only.prog`) to say one thing about a row the exit code could not reach.
; The upgrade is tools/test/arity.sh:27-31's, adopted verbatim: the fixture
; prints, bash grades, and every mutant pins the WHOLE verdict line. The case
; numbers, their order and their meanings are UNCHANGED.
;
; ⚑ WHAT THIS GATE MUST NOT DO. `dg-msg`'s nine goldens in tools/test/diag.sh
; pin byte-identity, and that constraint is E157's: it is what made a
; per-message `Judg` the cheap way out at 38 arms. `doc->str` MUST NOT INHERIT
; IT. Nothing here or in doc.sh compares `doc->str` output byte-for-byte against
; a golden sentence; the evidence rows are substring survival. The only `dg-msg`
; reference below is field 16, which case 14's ABSENCE control reads. Cross-
; asserting the two exits re-imports the exact constraint `Doc` exists to lift;
; tools/test/doc.sh's G7 makes that a checked row rather than a promise.
;
; ⚑ EVERY TOP-LEVEL BINDING IS PREFIXED `dt-`. Three neighbouring censuses grep
; `lib prog tools` for `^\((def|data|declare) <name>` -- doc.sh:380 over
; prelude/doc.chiral's names, render-doc.sh:436 over protocol/render-doc.chiral's
; and row.sh:742 over protocol/render.chiral's -- and this file is under `tools/`.
;
; ⚑ THE NINTH REASON ARM (`r-relayed`) IS NOT BUILT HERE, and the reason is
; E157's, not a gap. `diag.sh`'s G4 is a CONTAINMENT invariant: only a layer
; below the checker may construct an `r-relayed`, and it enforces that with a
; tree-wide `grep -RIn` for the constructor form over `lib prog tools`, minus a
; hard-coded list of three files where one is supposed to appear.
; `samples/e157_diag.prog` is on that list; this file, written after it, is not,
; so one honest gate fixture here turns E157's Phase 13 red. Adding a line to
; that list would move `diag.sh`, which E158's own G7(b) pins byte-for-byte. So
; the r-relayed evidence row lives in `doc.sh` instead, on a scratch root the
; gate writes outside the tree, where E157's census correctly never looks. The
; row is not weakened, it is asserted with its own mutant, only relocated.
;
; The rows are laws, not typography. Field, case, row:
;   1     1   G4f    the group FITS at 40, no break introduced
;   2     2   G4b    ...and it BREAKS at 10, at the frame's own indent
;   3,4   3   G1     the FLAT LAW, both sides
;   5,6,7 4   G2     width independence at 1, 40 and 1000000
;   8     5   G3red  r-redeclared names its subject
;   8     6   G3dcl  BOTH declarations reach the output, and they differ
;   9     7   G3mis  r-mismatch keeps both terms
;   10    8   G3use  r-usage keeps both quantities
;   11    9   G3lin  r-linear keeps the offending quantity
;   12   10   G3arr  r-arrow keeps the extern and the linear result
;   13   11   G3unb  r-unbound keeps the namespace searched
;   14   12   G3skp  r-skipped keeps E97's chain
;   15   13   G3jud  r-judged: the subject IS the evidence
;   10,16 14  G3c    the control: dg-msg drops both quantities, dg-doc keeps them
;   17        the sentinel: reaching it says the stream completed

(import "prelude/prelude")
(import "prelude/string")
(import "prelude/doc")
(import "ports/stdio")
(import "typing/diag")

(def dt-mark Str (bytes->str (bslice (pack-u32 1) 0 1)))
(def dt-emit (=> Str Unit) (lam (s) (let ((_ (put s))) (put dt-mark))))

; ── the documents ────────────────────────────────────────────────────────────
; dt-g4: the group decision. Flat it is "header one two" (14 columns), so at
; w=40 it fits and at w=10 it cannot, and the nest is 4 so the broken form is
; visible as "\n    one".
(def dt-g4 Doc
  (d-group
    (d-cat (d-text "header")
      (d-nest 4
        (d-cat (d-line (brk-space))
          (d-cat (d-text "one")
            (d-cat (d-line (brk-space)) (d-text "two"))))))))

; dt-g1 + dt-g1-flat: the FLAT LAW's two sides. dt-g1 uses ALL SIX Doc
; constructors; dt-g1-flat is the same document with every d-line replaced by
; its Brk's flat text (brk-soft -> "", brk-space -> " "). brk-hard is excluded
; on purpose: it has no flat text, it breaks in either mode, so the flat law is
; over the non-hard breaks, which is exactly what makes d-group sound.
(def dt-g1 Doc
  (d-group
    (d-cat (d-tag "h" (d-text "alpha"))
      (d-nest 2
        (d-cat (d-line (brk-space))
          (d-cat (d-text "beta")
            (d-cat (d-line (brk-soft)) (d-text "gamma"))))))))

(def dt-g1-flat Doc
  (d-group
    (d-cat (d-tag "h" (d-text "alpha"))
      (d-nest 2
        (d-cat (d-text " ")
          (d-cat (d-text "beta")
            (d-cat (d-text "") (d-text "gamma"))))))))

; dt-g2: nested groups, so the three widths really do take different decisions.
(def dt-g2 Doc
  (d-group
    (d-cat (d-text "aa")
      (d-nest 2
        (d-cat (d-line (brk-space))
          (d-group
            (d-cat (d-text "bbbb")
              (d-cat (d-line (brk-space)) (d-text "cccc")))))))))

; ── the reasons (E157 values, unchanged by E158) ─────────────────────────────
; Two DIFFERENT declarations of one name, one constructor and two. The loader
; binds exactly this pair and `dg-msg` collapses both into "data redeclared: Box".
(def dt-box1 DataDecl
  (data-decl "Box" nil (cons (ctor "mk" (cons (field 2 "v" (t-primty "I64")) nil)) nil)))
(def dt-box2 DataDecl
  (data-decl "Box" nil
    (cons (ctor "mk"  (cons (field 2 "v" (t-primty "I64")) nil))
    (cons (ctor "mk2" (cons (field 2 "w" (t-primty "I64")) nil)) nil))))

(def dt-redecl Reason
  (r-redeclared (subj-data "Box") (dc-data dt-box1) (dc-data dt-box2)))

; declared 1, observed omega: a linear binder used twice. `dg-usage-msg` answers
; this with "linear binder usage mismatch" and drops BOTH quantities.
(def dt-usage Reason (r-usage (subj-lam-binder) (q1) (qw)))

; the element's exit, at the width every evidence row uses
(def dt-r80 (-> Reason Str) (lam (r) (doc->str 80 (dg-doc r))))

(def compile-main (=> I64 I64)
  (lam (n)
    (let ((_ (dt-emit (doc->str 40 dt-g4))))
    (let ((_ (dt-emit (doc->str 10 dt-g4))))
    (let ((_ (dt-emit (doc->str 1000000 dt-g1))))
    (let ((_ (dt-emit (doc->str 1000000 dt-g1-flat))))
    (let ((_ (dt-emit (doc->str 1 dt-g2))))
    (let ((_ (dt-emit (doc->str 40 dt-g2))))
    (let ((_ (dt-emit (doc->str 1000000 dt-g2))))
    (let ((_ (dt-emit (dt-r80 dt-redecl))))
    (let ((_ (dt-emit (dt-r80 (r-mismatch (subj-none) (t-primty "I64") (t-primty "Str"))))))
    (let ((_ (dt-emit (dt-r80 dt-usage))))
    (let ((_ (dt-emit (dt-r80 (r-linear (subj-let-binder) (qw))))))
    (let ((_ (dt-emit (dt-r80 (r-arrow (subj-extern "mint") "Cap")))))
    (let ((_ (dt-emit (dt-r80 (r-unbound (subj-def "nosuch"))))))
    (let ((_ (dt-emit (dt-r80 (r-skipped (cons (mk-skrec "lowerme" (sk-callee "callee")) nil))))))
    (let ((_ (dt-emit (dt-r80 (r-judged (subj-ctor "Nope") (jg-ctor-arity))))))
    (let ((_ (dt-emit (dg-msg dt-usage))))
    (let ((_ (dt-emit "END")))
      0)))))))))))))))))))
