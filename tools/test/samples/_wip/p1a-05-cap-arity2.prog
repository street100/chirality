; V5: arity-2 field, capture.
(import "prelude/prelude")
(data Voc () (voc (draw (-> I64 I64 I64)) (n I64)))
(declare mk-a (-> I64 Voc))
(def mk-a (lam (k) (voc (lam (x y) (+ (+ x y) k)) 1)))
(declare compile-main (-> Unit I64))
(def compile-main (lam (u) (- (case (mk-a 1) ((voc d n) (d 10 20))) 31)))
