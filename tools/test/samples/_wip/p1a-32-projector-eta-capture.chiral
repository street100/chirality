; V32: eta-expanded projector + a CAPTURING the-lam instance.
(import "prelude/prelude")
(data Voc () (voc (draw (-> I64 I64)) (n I64)))
(declare voc-draw (-> Voc (-> I64 I64)))
(def voc-draw (lam (v) (the (-> I64 I64) (lam (y) (case v ((voc d n) (d y)))))))
(declare mk-a (-> I64 Voc)) (def mk-a (lam (k) (voc (the (-> I64 I64) (lam (x) (+ x k))) 1)))
(declare compile-main (-> Unit I64)) (def compile-main (lam (u) (- ((voc-draw (mk-a 1)) 10) 11)))
