; V27: TWO cs-lam sites on the SAME arrow family (does multi-site $clo dispatch work?)
(import "prelude/prelude")
(data Voc () (voc (draw (-> I64 I64)) (n I64)))
(declare pick (-> I64 I64 Voc))
(def pick (lam (which k)
  (case (=i which 0)
    (true  (voc (the (-> I64 I64) (lam (x) (+ x k))) 1))
    (false (voc (the (-> I64 I64) (lam (x) (* x k))) 2)))))
(declare use (-> Voc I64 I64)) (def use (lam (v x) (case v ((voc d n) (d x)))))
(declare compile-main (-> Unit I64))
(def compile-main (lam (u) (- (+ (use (pick 0 1) 10) (use (pick 1 3) 10)) 41)))
