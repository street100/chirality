; V25: projector + NAMED global stored, record built INSIDE a fn (vs p1a-20's const).
(import "prelude/prelude")
(data Voc () (voc (draw (-> I64 I64)) (n I64)))
(declare add1 (-> I64 I64)) (def add1 (lam (x) (+ x 1)))
(declare voc-draw (-> Voc (-> I64 I64))) (def voc-draw (lam (v) (case v ((voc d n) d))))
(declare mk-a (-> I64 Voc)) (def mk-a (lam (k) (voc add1 1)))
(declare compile-main (-> Unit I64)) (def compile-main (lam (u) (- ((voc-draw (mk-a 1)) 10) 11)))
