; V17: same, but via PARTIAL APPLICATION of uncurried globals (cs-g sites).
(import "prelude/prelude")
(data Voc () (voc (draw (-> I64 I64)) (n I64)))
(declare voc-draw (-> Voc (-> I64 I64)))
(def voc-draw (lam (v) (case v ((voc d n) d))))
(declare addk (-> I64 I64 I64)) (def addk (lam (k x) (+ x k)))
(declare mulk (-> I64 I64 I64)) (def mulk (lam (k x) (* x k)))
(declare subk (-> I64 I64 I64)) (def subk (lam (k x) (- x k)))
(declare mk-a (-> I64 Voc)) (def mk-a (lam (k) (voc (addk k) 1)))
(declare mk-b (-> I64 Voc)) (def mk-b (lam (k) (voc (mulk k) 2)))
(declare mk-c (-> I64 Voc)) (def mk-c (lam (k) (voc (subk k) 3)))
(declare compile-main (-> Unit I64))
(def compile-main (lam (u)
  (- (+ ((voc-draw (mk-a 1)) 10) (+ ((voc-draw (mk-b 2)) 10) ((voc-draw (mk-c 5)) 10))) 36)))
