; V14: bare capturing lam in ctor position, but wrapped in (the (-> ...) ...).
; lam-lit accepts (c-ann (c-lam ..) arrow) even with expected=none.
(import "prelude/prelude")
(data Voc () (voc (draw (-> I64 I64)) (n I64)))
(declare mk-a (-> I64 Voc))
(def mk-a (lam (k) (voc (the (-> I64 I64) (lam (x) (+ x k))) 1)))
(declare compile-main (-> Unit I64))
(def compile-main (lam (u) (- (case (mk-a 1) ((voc d n) (d 10))) 11)))
